 97+  E8F1 4F                       ld      c, a
 98+  E8F2 77                       ld      (hl), a
 99+  E8F3
100+  E8F3                          ; Если ком строка переполнена, выходим
101+  E8F3 3E A4                    ld      a, vars.cmdLineCtrl & 0FFh
