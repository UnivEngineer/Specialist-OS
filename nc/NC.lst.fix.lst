 33+  E875 32 F8 FF    >            ld (IO_COLOR), a
 33+  E878             >        ENDIF
 34+  E878 CD 20 F0                 call    drawCursor
 35+  E87B
 36+  E87B                          ; Положение курсора в ком строке
 37+  E87B 2A 60 F7                 ld      hl, (vars.cmdLinePos)
 38+  E87E 22 FC 8F                 ld      (bios_vars.cursorY), hl
 39+  E881
 40+  E881                          ; Ждем нажатия клавиши
 41+  E881                          COLOR   COLOR_CMDLINE
 41+  E881             >        IF ENABLE_COLOR
 41+  E881 3E 70       >            ld a, COLOR_CMDLINE
 41+  E883 32 F8 FF    >            ld (IO_COLOR), a
