124   F115                  INCLUDE "loadFiles.inc"
  1+  F115              ;----------------------------------------------------------------------------
  2+  F115              ; MXOS NC.COM
  3+  F115              ; Загрузить список файлов с накопителя
  4+  F115              ;
  5+  F115              ; вход:
  6+  F115              ;   a = номер накопителя
  7+  F115              ;
  8+  F115              ; 2013-12-18 Дизассемблировано vinxru
  9+  F115              ; 2022-02-16 Доработано SpaceEngineer
