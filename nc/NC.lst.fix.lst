123+  EFCD CD 8C F3                 call    readBytePanel
124+  EFD0
125+  EFD0                          ; a = положение курсора относительно начала списка файлов панели
126+  EFD0 90                       sub     b
127+  EFD1
128+  EFD1                          ; если курсор выше первого файла панели, скроллим вниз
129+  EFD1 DA DC EF                 jp c,   scrollDown
130+  EFD4
131+  EFD4                          ; если курсор ниже последнего файла панели, скроллим вверх
132+  EFD4 D6 24                    sub     FILE_LIST_SIZE
133+  EFD6 D2 E5 EF                 jp nc,  scrollUp
134+  EFD9
135+  EFD9                          ; иначе выходим
136+  EFD9 C3 5C E8                 jp      mainDriveChanged
137+  EFDC
138+  EFDC              scrollDown: ; скроллинг списка вниз
139+  EFDC 80                       add     a, b
140+  EFDD
141+  EFDD                          ; если скроллить некуда, выходим
142+  EFDD D2 5C E8                 jp nc,  mainDriveChanged
143+  EFE0
144+  EFE0                          ; направление перерисовки списока файлов - сверху вниз
145+  EFE0 06 00                    ld      b, 0
146+  EFE2 C3 ED EF                 jp      scrollExit
147+  EFE5
148+  EFE5              scrollUp:   ; скроллинг списка вверх
149+  EFE5 04                       inc     b
150+  EFE6 80                       add     a, b
151+  EFE7
152+  EFE7                          ; если скроллить некуда, выходим
153+  EFE7 B9                       cp      c       ; c = количество файлов
154+  EFE8 D2 5C E8                 jp nc,  mainDriveChanged
155+  EFEB
156+  EFEB                          ; направление перерисовки списока файлов - снизу вверх
157+  EFEB 06 01                    ld      b, 1
158+  EFED
159+  EFED              scrollExit: ; сохраняем новое значение panelA_firstFile
160+  EFED 21 5C F7                 ld      hl, state.panelA_firstFile
161+  EFF0 CD 7B F3                 call    writeBytePanel
162+  EFF3
163+  EFF3                          ; перерисовываем только список файлов
164+  EFF3                          ; b = направление
165+  EFF3 CD 07 F3                 call    printFilePanel
166+  EFF6
167+  EFF6                          ; выходим
168+  EFF6 C3 5C E8                 jp      mainDriveChanged
169+  EFF9
