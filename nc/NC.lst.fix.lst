 23+  E9A7 EB                       ex      de, hl
 24+  E9A8
 25+  E9A8                          ; Загрузить файл A:NC.EXT по адресу 0
 26+  E9A8 21 D2 F7                 ld      hl, vars.tempFileDescr
 27+  E9AB 11 00 00                 ld      de, 0
 28+  E9AE 0E 01                    ld      c, 1
 29+  E9B0 CD 54 C8                 call    bios_fileGetSetAddr ; изменить адрес загрузки файла на de = 0
 30+  E9B3 CD 48 C8                 call    bios_fileLoad
 31+  E9B6 DA F9 E9                 jp c,   Enter_stdExec
 32+  E9B9
 33+  E9B9                          ; Переключить диск обратно
 34+  E9B9                          ;mov    a, b
 35+  E9B9                          ;mvi    e, 1
 36+  E9B9                          ;call   bios_fileGetSetDrive
 37+  E9B9
 38+  E9B9                          ; Получить имя выбранного файла
