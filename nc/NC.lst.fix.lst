129   F398                  INCLUDE "printFileName.inc"
  1+  F398              ;----------------------------------------------------------------------------
  2+  F398              ; MXOS NC.COM
  3+  F398              ; Вывод имени файла в обычном виде с точкой
  4+  F398              ;
  5+  F398              ; вход:
  6+  F398              ;   hl - адрес дескриптора файла
  7+  F398              ;
  8+  F398              ; выход:
  9+  F398              ;   hl - указывает на следующее за расширением поле в дескрипторе файла
 10+  F398              ;
 11+  F398              ; 2022-01-31 SpaceEngineer
 12+  F398              ;----------------------------------------------------------------------------
 13+  F398
 14+  F398              ;printFileName:
 15+  F398              ;        push  bc
 16+  F398              ;        ld    c, ' '               ; прерываем печать имени по пробелу
 17+  F398              ;        ld    b, FILE_NAME_LENGTH  ; длина имени
 18+  F398              ;        call  printString2
 19+  F398              ;        ld    c, '.'
 20+  F398              ;        call  bios_printChar       ; печатаем точку
 21+  F398              ;        ld    b, 3                 ; длина расширения
 22+  F398              ;        call  printString2
 23+  F398              ;        pop   bc
 24+  F398              ;        ret
 25+  F398              ;
 26+  F398
 27+  F398              ;----------------------------------------------------------------------------
 28+  F398              ; MXOS NC.COM
 29+  F398              ; Вывод имени файла - 8 символов, путое место, 3 символа.
 30+  F398              ; Короткие имена дополняются пробелами, чтобы стереть предыдущий текст.
 31+  F398              ; Выводит только реальные символы, чтобы не портить экран при
 32+  F398              ; неотформатированном или повреждённом диске.
 33+  F398              ;
 34+  F398              ; вход:
 35+  F398              ;   hl - адрес дескриптора файла
 36+  F398              ;
 37+  F398              ; 2022-02-16 SpaceEngineer
 38+  F398              ;----------------------------------------------------------------------------
 39+  F398
 40+  F398              printFileNamOnPanel:
 41+  F398 E5                   push    hl
 42+  F399 C5                   push    bc
 43+  F39A 01 00 08             ld      bc, FILE_NAME_LENGTH << 8   ; b = длина имени, с = 0 (без терминатора)
 44+  F39D CD AE F3             call    printString2
 45+  F3A0 0E 18                ld      c, 18h                      ; курсор вправо
 46+  F3A2 CD 09 C8             call    bios_printChar
 47+  F3A5 01 00 03             ld      bc, 3 << 8                  ; b = длина расширения, с = 0 (без терминатора)
 48+  F3A8 CD AE F3             call    printString2
 49+  F3AB C1                   pop     bc
 50+  F3AC E1                   pop     hl
 51+  F3AD C9                   ret
 52+  F3AE
130   F3AE                  INCLUDE "printString2.inc"
  1+  F3AE              ;----------------------------------------------------------------------------
  2+  F3AE              ; MXOS NC.COM
  3+  F3AE              ; Вывод строки по адресу hl длиной b или до терминатора.
  4+  F3AE              ; Выводит только реальные символы, чтобы не портить экран при
  5+  F3AE              ; неотформатированном или повреждённом диске.
  6+  F3AE              ;
  7+  F3AE              ; вход:
  8+  F3AE              ;   hl = адрес строки
  9+  F3AE              ;   b  = макс. длина печати
 10+  F3AE              ;   c  = терминатор
 11+  F3AE              ;
 12+  F3AE              ; выход:
 13+  F3AE              ;   hl = адрес конца строки + 1
 14+  F3AE              ;
 15+  F3AE              ; 2022-01-31 SpaceEngineer
 16+  F3AE              ;----------------------------------------------------------------------------
 17+  F3AE
 18+  F3AE              printString2:
 19+  F3AE F5               push    af
 20+  F3AF D5               push    de
 21+  F3B0
 22+  F3B0              printString2loop:
 23+  F3B0 7E               ld      a, (hl)
 24+  F3B1 B9               cp      c
 25+  F3B2 DA C1 F3         jp c,   printString2exit
 26+  F3B5
 27+  F3B5 C5               push    bc
 28+  F3B6 E5               push    hl
 29+  F3B7
 30+  F3B7 CD 69 C8         call    bios_printCharReal
 31+  F3BA
 32+  F3BA E1               pop     hl
 33+  F3BB C1               pop     bc
 34+  F3BC
 35+  F3BC 23               inc     hl
 36+  F3BD 05               dec     b
 37+  F3BE C2 B0 F3         jp nz,  printString2loop
 38+  F3C1
 39+  F3C1              printString2exit:
 40+  F3C1 D1               pop     de
 41+  F3C2 F1               pop     af
 42+  F3C3 C9               ret
 43+  F3C4
131   F3C4                  INCLUDE "setCursorPosPanel.inc"
  1+  F3C4              ;----------------------------------------------------------------------------
  2+  F3C4              ; MXOS NC.COM
  3+  F3C4              ; Установка положения курсора с учетом активной панели
  4+  F3C4              ; вход:
  5+  F3C4              ;   hl - координаты курсора на панели
  6+  F3C4              ;
  7+  F3C4              ; 2013-12-18 Дизассемблировано vinxru
