 16+  E94A CD 8C F3             call    readBytePanel
 17+  E94D C6 41                add     'A'
 18+  E94F
 19+  E94F                      ; Выводим его в ком строку
 20+  E94F 2A 62 F7             ld      hl, (vars.cmdLineEnd)
 21+  E952 77                   ld      (hl), a
 22+  E953 23                   inc     hl
 23+  E954
 24+  E954                      ; Выводим двоеточние
 25+  E954 36 3A                ld      (hl), ':'
 26+  E956 23                   inc     hl
 27+  E957
 28+  E957                      ; Выводим имя файла
 29+  E957 EB                   ex      de, hl
 30+  E958 CD 6D F4             call    compactName
 31+  E95B
 32+  E95B                      ; Ограничение длины
 33+  E95B 1B                   dec     de
 34+  E95C 3E A4                ld      a, vars.cmdLineCtrl & 0FFh
 35+  E95E BB                   cp      e
 36+  E95F D2 63 E9             jp nc,  loc_D146
 37+  E962 5F                   ld      e, a
 38+  E963              loc_D146:
 39+  E963                      ; Терминатор
 40+  E963 AF                   xor     a
 41+  E964 12                   ld      (de), a
 42+  E965 C9                   ret
 43+  E966
 44+  E966              ;----------------------------------------------------------------------------
 45+  E966              ; MXOS NC.COM
 46+  E966              ; Поместить выбранный файл в ком строку
 47+  E966              ;
 48+  E966              ; вход:
 49+  E966              ;   hl - адрес дескриптора файла
