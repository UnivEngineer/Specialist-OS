 40+  E9BC 7E                       ld      a, (hl)
 41+  E9BD 3C                       inc     a
 42+  E9BE CA 73 E8                 jp z,   mainLoop ; Ничего не выбрано
 43+  E9C1
 44+  E9C1                          ; hl = указатель на расширение файла
 45+  E9C1 11 08 00                 ld      de, FILE_DESCRIPTOR.ext
 46+  E9C4 19                       add     hl, de
 47+  E9C5
 48+  E9C5 11 00 00                 ld      de, 0
 49+  E9C8
 50+  E9C8                          ; Сравниваем с расширеним из файла,
 51+  E9C8                          ; нечувствительно к регистру
 52+  E9C8              Enter_extLoop:
 53+  E9C8 E5                       push    hl
 54+  E9C9 0E 03                    ld      c, 3
 55+  E9CB CD 7B C8                 call    bios_stricmp
 56+  E9CE C2 6B EA                 jp nz,  Enter_nextExt
 57+  E9D1
 58+  E9D1                          ; Найдено расширение
 59+  E9D1 E1                       pop     hl
 60+  E9D2 13                       inc     de
 61+  E9D3
 62+  E9D3                          ; Копирование имени выбранного файла в ком строку
 63+  E9D3              Enter_5:
 64+  E9D3 21 69 F7                 ld      hl, vars.cmdLine
 65+  E9D6              Enter_4:
 66+  E9D6 1A                       ld      a, (de)
 67+  E9D7 77                       ld      (hl),a
 68+  E9D8 FE 0D                    cp      0Dh
 69+  E9DA CA E6 E9                 jp z,   Enter_3
 70+  E9DD 3C                       inc     a
 71+  E9DE CA E6 E9                 jp z,   Enter_3
 72+  E9E1 23                       inc     hl
 73+  E9E2 13                       inc     de
 74+  E9E3 C3 D6 E9                 jp      Enter_4
 75+  E9E6
 76+  E9E6              ; ---------------------------------------------------------------------------
 77+  E9E6
 78+  E9E6              Enter_3:
 79+  E9E6 36 20                    ld      (hl), ' '
 80+  E9E8 23                       inc     hl
 81+  E9E9 36 00                    ld      (hl), 0
 82+  E9EB 22 62 F7                 ld      (vars.cmdLineEnd), hl
 83+  E9EE
 84+  E9EE                          ; Вывод командной строки на экран
 85+  E9EE                          COLOR   COLOR_CMDSCREEN
 85+  E9EE             >        IF ENABLE_COLOR
 85+  E9EE 3E F0       >            ld a, COLOR_CMDSCREEN
 85+  E9F0 32 F8 FF    >            ld (IO_COLOR), a
 85+  E9F3             >        ENDIF
 86+  E9F3 21 69 F7                 ld      hl, vars.cmdLine
 87+  E9F6 CD 18 C8                 call    bios_printString
 88+  E9F9
 89+  E9F9              Enter_stdExec:
 90+  E9F9                          ; Получить выбранный файл
 91+  E9F9 CD C1 F0                 call     getSelectedFile
 92+  E9FC
 93+  E9FC                          ; Ничего не выбрано
 94+  E9FC 7E                       ld      a, (hl)
 95+  E9FD 3C                       inc     a
 96+  E9FE CA 73 E8                 jp z,   mainLoop
 97+  EA01
 98+  EA01                          ; ?
 99+  EA01 CD 66 E9                 call    selFileToCmdLine
100+  EA04
101+  EA04              EnterCmdLine:
102+  EA04                          ; Команда X: без имени переключает активную панель на диск X.
103+  EA04 2A 62 F7                 ld      hl, (vars.cmdLineEnd)
104+  EA07 11 6B F7                 ld      de, vars.cmdLine + 2
105+  EA0A CD 27 C4                 call    bios_cmp_hl_de
106+  EA0D C2 53 EA                 jp nz,  EnterExec
107+  EA10
108+  EA10 3A 6A F7                 ld      a, (vars.cmdLine + 1)
109+  EA13 FE 3A                    cp      ':'
110+  EA15 C2 53 EA                 jp nz,  EnterExec
111+  EA18
112+  EA18 3A 69 F7                 ld      a, (vars.cmdLine)
113+  EA1B E6 DF                    and     0DFh
114+  EA1D D6 41                    sub     'A'
115+  EA1F FE 08                    cp      8
116+  EA21 D2 53 EA                 jp nc,  EnterExec
117+  EA24 4F                       ld      c, a
118+  EA25
119+  EA25                          ; Не переключаться на букву без установленного драйвера.
120+  EA25 C5                       push    bc
121+  EA26 CD 4F EE                 call    buildDriveList
122+  EA29 C1                       pop     bc
123+  EA2A CD 96 EE                 call    findDrive
124+  EA2D DA 53 EA                 jp c,   EnterExec
125+  EA30
126+  EA30 79                       ld      a, c
127+  EA31 21 58 F7                 ld      hl, state.panelA_drive
128+  EA34 CD 7B F3                 call    writeBytePanel
129+  EA37 AF                       xor     a
130+  EA38 21 56 F7                 ld      hl, state.panelA_info
131+  EA3B CD 7B F3                 call    writeBytePanel
132+  EA3E 21 5C F7                 ld      hl, state.panelA_firstFile
133+  EA41 CD 7B F3                 call    writeBytePanel
134+  EA44 21 5E F7                 ld      hl, state.panelA_curFile
135+  EA47 CD 7B F3                 call    writeBytePanel
136+  EA4A
137+  EA4A CD F9 EF                 call    clearCmdLine
138+  EA4D CD 7A EA                 call    saveState
139+  EA50 C3 46 E8                 jp      mainReload
140+  EA53
141+  EA53              EnterExec:
142+  EA53                          ; Очистка экрана
143+  EA53                          COLOR   COLOR_CMDSCREEN
143+  EA53             >        IF ENABLE_COLOR
143+  EA53 3E F0       >            ld a, COLOR_CMDSCREEN
143+  EA55 32 F8 FF    >            ld (IO_COLOR), a
143+  EA58             >        ENDIF
144+  EA58 0E 1F                    ld      c, 1Fh
145+  EA5A CD 09 C8                 call    bios_printChar
146+  EA5D
147+  EA5D                          ; Помещаем в конец ком строки 0Dh
148+  EA5D 2A 62 F7                 ld      hl, (vars.cmdLineEnd)
149+  EA60 36 0D                    ld      (hl), 0Dh
150+  EA62
151+  EA62                          ; Сохраняем состояние
152+  EA62 CD 7A EA                 call    saveState
153+  EA65
154+  EA65                          ; Запускаем файл
155+  EA65 21 69 F7                 ld      hl, vars.cmdLine
156+  EA68 C3 5D C8                 jp      bios_fileExec
157+  EA6B
158+  EA6B              ; ---------------------------------------------------------------------------
159+  EA6B
160+  EA6B              Enter_nextExt:
161+  EA6B E1                       pop     hl
162+  EA6C
163+  EA6C              Enter_2:
164+  EA6C 1A                       ld      a, (de)
165+  EA6D 13                       inc     de
166+  EA6E FE 0D                    cp      0Dh
167+  EA70 CA C8 E9                 jp z,   Enter_extLoop
168+  EA73 3C                       inc     a
169+  EA74 C2 6C EA                 jp      nz, Enter_2
170+  EA77 C3 F9 E9                 jp      Enter_stdExec
