 46+  E88A                          COLOR   COLOR_FILE
 46+  E88A             >        IF ENABLE_COLOR
 46+  E88A 3E B1       >            ld a, COLOR_FILE
 46+  E88C 32 F8 FF    >            ld (IO_COLOR), a
 46+  E88F             >        ENDIF
 47+  E88F CD 20 F0                 call    drawCursor
 48+  E892 F1                       pop     af
 49+  E893
 50+  E893                          ; Анализ нажатой клавиши
 51+  E893 4F                       ld      c, a
 52+  E894 DA 2F E9                 jp c,   but_ctrl
 53+  E897 A7                       and     a     ; F1 (00h)
 54+  E898 CA 4B ED                 jp z,   but_F1
 55+  E89B 3D                       dec     a     ; F2 (01h)
 56+  E89C CA 19 ED                 jp z,   but_F2
 57+  E89F 3D                       dec     a     ; F3 (02h)
 58+  E8A0 CA 32 EF                 jp z,   but_F3
 59+  E8A3 3D                       dec     a     ; F4 (03h)
 60+  E8A4 CA 7F E9                 jp z,   but_F4
 61+  E8A7 3D                       dec     a     ; F5 (04h)
 62+  E8A8 CA 8C EB                 jp z,   but_F5
 63+  E8AB 3D                       dec     a     ; F6 (05h)
 64+  E8AC CA 49 EB                 jp z,   but_F6
 65+  E8AF 3D                       dec     a     ; F7 (06h)
 66+  E8B0 CA 46 EB                 jp z,   but_F7
 67+  E8B3 3D                       dec     a     ; F8 (07h)
 68+  E8B4 CA 9E EC                 jp z,   but_F8
 69+  E8B7 3D                       dec     a     ; стрелка влево (08h)
 70+  E8B8 CA 95 EF                 jp z,   but_Left
 71+  E8BB 3D                       dec     a     ; Tab/Таб (09h)
 72+  E8BC CA 0F EF                 jp z,   but_Tab
 73+  E8BF 3D                       dec     a     ; End/ПС (0Ah)
 74+  E8C0 CA AB EF                 jp z,   but_End
 75+  E8C3 D6 02                    sub     2     ; Home/стрелка влево-вверх (0Ch)
 76+  E8C5 CA A4 EF                 jp z,   but_Home
 77+  E8C8 3D                       dec     a     ; Enter/ВК (0Dh)
 78+  E8C9 CA 8F E9                 jp z,   but_Enter
 79+  E8CC D6 0B                    sub     0Bh   ; стрелка вправо (18h)
 80+  E8CE CA 7D EF                 jp z,   but_Right
 81+  E8D1 3D                       dec     a     ; стрелка вверх (19h)
 82+  E8D2 CA 6F EF                 jp z,   but_Up
 83+  E8D5 3D                       dec     a     ; стрелка вниз (1Ah)
 84+  E8D6 CA 5A EF                 jp z,   but_Down
 85+  E8D9 3D                       dec     a     ; Esc/АР2 (1Bh)
 86+  E8DA CA 29 E9                 jp z,   but_Esc
 87+  E8DD C6 1B                    add     1Bh
 88+  E8DF FE 7F                    cp      7Fh   ; Del/ЗБ (7Fh)
 89+  E8E1 CA 0E E9                 jp z,   but_Bkspc
 90+  E8E4 FE 8A                    cp      8Ah   ; F9 (8Ah)
 91+  E8E6 CA 73 E8                 jp z,   mainLoop
 92+  E8E9 FE 20        mainLoop_e: cp      20h   ; Пробел (20h)
 93+  E8EB DA 73 E8                 jp c,   mainLoop
 94+  E8EE
 95+  E8EE                          ; Вывод символов в ком строку
