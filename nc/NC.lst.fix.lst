119   F020                  INCLUDE "drawCursor.inc"
  1+  F020              ;----------------------------------------------------------------------------
  2+  F020              ; MXOS NC.COM
  3+  F020              ; Рисование курсора
  4+  F020              ;
  5+  F020              ; 2013-12-18 Дизассемблировано vinxru
  6+  F020              ;----------------------------------------------------------------------------
  7+  F020
  8+  F020              drawCursor: ; Цвет устаналвиается перед выводом
  9+  F020
 10+  F020                          ; Если файлов нет, выходим
 11+  F020 21 5A F7                 ld    hl, state.panelA_filesCnt
 12+  F023 CD 8C F3                 call  readBytePanel
 13+  F026 A7                       and   a
 14+  F027                  IF ENABLE_COLOR
 15+  F027 C8                       ret Z
 16+  F028                  ELSE
 17+  F028 ~                        jp z, drawCursor_0
 18+  F028                  ENDIF
 19+  F028                          ; C какого файла начинается список файлов на панели
 20+  F028 21 5C F7                 ld    hl, state.panelA_firstFile
 21+  F02B CD 8C F3                 call  readBytePanel
 22+  F02E 4F                       ld    c, a
 23+  F02F
 24+  F02F                          ; Номер выбранного файла
 25+  F02F 21 5E F7                 ld    hl, state.panelA_curFile
 26+  F032 CD 8C F3                 call  readBytePanel
 27+  F035 91                       sub   c
 28+  F036
 29+  F036                          ; Рассчиытваем координату X (точнее, адрес)
 30+  F036 26 91                    ld    h, 90h + (P_FILE_LIST_X1 * 2 / 8)
 31+  F038 FE 12                    cp    FILE_LIST_SIZE/2
 32+  F03A DA 41 F0                 jp c, drawCursor_1
 33+  F03D D6 12                    sub   FILE_LIST_SIZE/2
 34+  F03F 26 9D                    ld    h, 90h + (P_FILE_LIST_X2 * 2 / 8)
 35+  F041
 36+  F041              drawCursor_1:
 37+  F041                          ; Рассчиытваем координату Y (точнее, адрес)
 38+  F041                          ; a = a * 10 + P_FILE_LIST_Y - 8
 39+  F041 87                       add   a, a
 40+  F042 4F                       ld    c, a
 41+  F043 87                       add   a, a
 42+  F044 87                       add   a, a
 43+  F045 81                       add   a, c
 44+  F046 C6 18                    add   P_FILE_LIST_Y - 8
 45+  F048 6F                       ld    l, a
 46+  F049
 47+  F049                          ; Ширина курсора в байтах, высота в пикселях
 48+  F049 01 0A 0A                 ld    bc, (10 << 8) + 10
 49+  F04C
 50+  F04C                          ; Если правая панель, сдвигаем курсор на пол экрана
 51+  F04C              drawCursor_2:
 52+  F04C 3A 55 F7                 ld    a, (state.activePanel)
 53+  F04F A7                       and   a
 54+  F050 CA 55 F0                 jp z, drawCursor_3
 55+  F053 3E 18                    ld    a, 18h
 56+  F055              drawCursor_3:
 57+  F055 84                       add   a, h
 58+  F056 67                       ld    h, a
 59+  F057
 60+  F057                          ; Рисуем курсор (hl = адрес, b = ширина, c = высота)
 61+  F057 CD AD F0                 call  inverseRect
 62+  F05A C9                       ret
 63+  F05B
 64+  F05B              ; ---------------------------------------------------------------------------
 65+  F05B
 66+  F05B                  IF ENABLE_COLOR==0
 67+  F05B ~            drawCursor_0:
 68+  F05B ~                        ld    hl, 92D6h
 69+  F05B ~                        ld    b, 2
 70+  F05B ~                        jp    drawCursor_2
 71+  F05B                  ENDIF
 72+  F05B
120   F05B                  INCLUDE "printInfoLine.inc"
  1+  F05B              ;----------------------------------------------------------------------------
  2+  F05B              ; MXOS NC.COM
  3+  F05B              ; Вывод инфомарции о файле внизу окна
  4+  F05B              ;
  5+  F05B              ; 2013-12-18 Дизассемблировано vinxru
  6+  F05B              ;----------------------------------------------------------------------------
  7+  F05B
  8+  F05B              printInfoLine:
  9+  F05B                      ; Если файлов нет, выходим
 10+  F05B 21 5A F7             ld      hl, state.panelA_filesCnt
 11+  F05E CD 8C F3             call    readBytePanel
 12+  F061 A7                   and     a
 13+  F062 C8                   ret z
 14+  F063
 15+  F063                      COLOR   COLOR_INFOLINE
 15+  F063             >        IF ENABLE_COLOR
 15+  F063 3E B1       >            ld a, COLOR_INFOLINE
 15+  F065 32 F8 FF    >            ld (IO_COLOR), a
 15+  F068             >        ENDIF
 16+  F068
 17+  F068 21 DE 0F             ld      hl, (P_FILE_NAME_X << 8) + P_FILE_NAME_Y
 18+  F06B CD C4 F3             call    setCursorPosPanel
 19+  F06E
 20+  F06E                      ; ld      c, '\'
 21+  F06E                      ; call    bios_printChar
 22+  F06E
 23+  F06E                      ; Устанавливаем hl на описатель файла
 24+  F06E CD C1 F0             call    getSelectedFile
 25+  F071 E5                   push    hl
 26+  F072
 27+  F072                      ; Печатаем имя файла в компактном виде
 28+  F072 11 D2 F7             ld      de, vars.tempFileDescr  ; буфер
 29+  F075 CD 6D F4             call    compactName
 30+  F078 21 D2 F7             ld      hl, vars.tempFileDescr
 31+  F07B 06 0E                ld      b, FILE_NAME_LENGTH + 6 ; макс длина строки (name.ext + ' ' + терминатор)
 32+  F07D 0E 14                ld      c, 20                   ; терминатор - пробел или меньше
 33+  F07F CD AE F3             call    printString2
 34+  F082
 35+  F082                      ; После имени файла, если оно короткое, надо напечатать
 36+  F082                      ; пробелы, чтобы стереть предыдущий текст. После работы
 37+  F082                      ; printString2 у нас в b как раз количество символов,
 38+  F082                      ; оставшихся до FILE_NAME_LENGTH + 6
 39+  F082 CD 16 F0     		call    printSpaces	; b - кол-во пробелов
 40+  F085
 41+  F085                      ; Смещаем курсор
 42+  F085 21 DE 39             ld      hl, (P_FILE_DATA_X << 8) + P_FILE_DATA_Y
 43+  F088 CD C4 F3             call    setCursorPosPanel
 44+  F08B
 45+  F08B                      ; Устанавливаем hl на поле адреса загрузки
 46+  F08B E1                   pop     hl
 47+  F08C E5                   push    hl
 48+  F08D 01 0D 00             ld      bc, FILE_INFO.loadAddress + 1 ; bc = смещение
 49+  F090 09                   add     hl, bc
 50+  F091
 51+  F091                      ; Читаем старший и младший байты адреса загрузки
 52+  F091                      ; и тут же печатаем их в HEX форме
 53+  F091 7E                   ld      a, (hl)
 54+  F092 CD 15 C8             call    bios_printHexByte
 55+  F095 2B                   dec     hl
 56+  F096 7E                   ld      a, (hl)
 57+  F097 CD 15 C8             call    bios_printHexByte
 58+  F09A
 59+  F09A                      ; Смещаем курсор
 60+  F09A 0E 18        		LD 	    c, 18h  ; код символа "вправо"
 61+  F09C CD 09 C8     		call	bios_printChar
 62+  F09F
 63+  F09F                      ; Устанавливаем hl на поле размера файла
 64+  F09F E1                   pop     hl
 65+  F0A0 01 0E 00             ld      bc, FILE_INFO.size ; bc = смещение
 66+  F0A3 09                   add     hl, bc
 67+  F0A4
 68+  F0A4                      ; Читаем размер файла в de и печатаем в десятичной форме
 69+  F0A4 5E                   ld      e, (hl)
 70+  F0A5 23                   inc     hl
 71+  F0A6 56                   ld      d, (hl)
 72+  F0A7 13                   inc     de          ; в дескрипторе файла хранится размер-1
 73+  F0A8 06 20                ld      b, 20h
 74+  F0AA C3 6C C8             jp      bios_printDecWord
 75+  F0AD
121   F0AD                  INCLUDE "inverseRect.inc"
  1+  F0AD              ;----------------------------------------------------------------------------
  2+  F0AD              ; MXOS NC.COM
  3+  F0AD              ; Инвертирвоание прямоугольной области на экране
  4+  F0AD              ;
  5+  F0AD              ; вход:
  6+  F0AD              ;   hl = адрес
  7+  F0AD              ;   b = ширина в байтах
  8+  F0AD              ;   c = высота всегда
  9+  F0AD              ;
 10+  F0AD              ; 2013-12-18 Дизассемблировано vinxru
 11+  F0AD              ;----------------------------------------------------------------------------
 12+  F0AD
 13+  F0AD              inverseRect:
 14+  F0AD D5                       push    de
 15+  F0AE 59                       ld      e, c
 16+  F0AF
 17+  F0AF                          ; Цикл по горизонтали
 18+  F0AF 4B           ir_loop_x:  ld      c, e    ; c = высота
 19+  F0B0 E5                       push    hl
 20+  F0B1
 21+  F0B1                          ; Цикл по вертикали
 22+  F0B1 7E           ir_loop_y:  ld      a, (hl)
 23+  F0B2 2F                       cpl
 24+  F0B3 77                       ld      (hl), a
 25+  F0B4
 26+  F0B4                          ; Повтор цикла по вертикали
 27+  F0B4 23                       inc     hl
 28+  F0B5 0D                       dec     c
 29+  F0B6 C2 B1 F0                 jp nz,  ir_loop_y
 30+  F0B9
 31+  F0B9                          ; Повтор цикла по горизонтали
 32+  F0B9 E1                       pop     hl
 33+  F0BA 24                       inc     h
 34+  F0BB 05                       dec     b
 35+  F0BC C2 AF F0                 jp nz,  ir_loop_x
 36+  F0BF
 37+  F0BF D1                       pop     de
 38+  F0C0 C9                       ret
 39+  F0C1
122   F0C1                  INCLUDE "getSelectedFile.inc"
  1+  F0C1              ;----------------------------------------------------------------------------
  2+  F0C1              ; MXOS NC.COM
  3+  F0C1              ; Получить информацию о выбранном файле (FILE_INFO)
  4+  F0C1              ;
  5+  F0C1              ; выход:
  6+  F0C1              ;   hl - адрес структуры FILE_INFO
  7+  F0C1              ;
  8+  F0C1              ; 2013-12-18 Дизассемблировано vinxru
  9+  F0C1              ;----------------------------------------------------------------------------
