  8+  E800              Start:      ; Отключаем инверсию
  9+  E800 21 00 00                 ld      hl, 0
 10+  E803 22 FA 8F                 ld      (bios_vars.inverse), hl
 11+  E806
 12+  E806                          ; Загружаем состояние. Если ZF, значит, уже запускали NC.COM.
 13+  E806                          ; Иначе сохраняем состояние.
 14+  E806 CD 96 EA                 call    loadState
 15+  E809 CA 17 E8                 jp z,   formatCalled
 16+  E80C
 17+  E80C                          ; loadState оставляет побайтовый драйвер ДОЗУ при первом запуске.
 18+  E80C 06 00                    ld      b, 0
 19+  E80E CD 6F C8                 call    bios_setRAMDDriver
 20+  E811
 21+  E811                          ; H используется по умолчанию только при установленном драйвере.
 22+  E811 CD 40 EE                 call    initRightDrive
 23+  E814
 24+  E814                          ; Сохраняем исправленное начальное состояние.
 25+  E814 CD 7A EA                 call    saveState
 26+  E817
