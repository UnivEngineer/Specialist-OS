 34+  ED3E
 35+  ED3E                          ; Перезагружаем и перерисовываем первую панель, только если она в режиме информации
 36+  ED3E 3A 56 F7                 ld    a, (state.panelA_info)
 37+  ED41 A7                       and   a
 38+  ED42 CA 7A ED                 jp z, saveStateAndReload
 39+  ED45 CD EE F0                 call  loadAndPrintA
 40+  ED48
 41+  ED48                          ; Сохраняем состояние и выходим
 42+  ED48 C3 7A ED                 jp    saveStateAndReload
 43+  ED4B
 44+  ED4B              ; ---------------------------------------------------------------------------
 45+  ED4B
 46+  ED4B              but_F1:     ; Временно устанавливаем state.activePanel=2
