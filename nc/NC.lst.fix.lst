179   F6F8 7F           v_window:   DB 01111111b            ; Верхний левый угол
180   F6F9 40                       DB 01000000b
181   F6FA 5F                       DB 01011111b
182   F6FB 50                       DB 01010000b            ; Левый край
183   F6FC 5F                       DB 01011111b            ; Нижний левый угол
184   F6FD 40                       DB 01000000b
185   F6FE 7F                       DB 01111111b
186   F6FF
187   F6FF FF                       DB 11111111b            ; Верх окна
188   F700 00                       DB 00000000b
189   F701 FF                       DB 11111111b
190   F702
191   F702 00                       DB 00000000b            ; Содержимое окна
192   F703
193   F703 FF                       DB 11111111b            ; Низ окна
194   F704 00                       DB 00000000b
195   F705 FF                       DB 11111111b
196   F706
197   F706 FE                       DB 11111110b            ; Правый верхний угол
198   F707 02                       DB 00000010b
199   F708 FA                       DB 11111010b
200   F709 0A                       DB 00001010b            ; Правая граница
201   F70A FA                       DB 11111010b            ; Правый нижний угол
202   F70B 02                       DB 00000010b
203   F70C FE                       DB 11111110b
204   F70D
205   F70D                          MACRO G_WINDOW A,X,Y,W,H
206   F70D ~                            DB A|2, Y, 90h+(X>>3), H-6, (W>>3)-2
207   F70D                          ENDM
208   F70D
209   F70D                          MACRO G_LINE A,X,Y,W
210   F70D ~                            DB A|1, Y, 90h+(X>>3), (((X&7)+W+7)>>3)-2, 0FFh>>(X&7), (0FF00h>>((W+X)&7)) & 0FFh
211   F70D                          ENDM
212   F70D
213   F70D                          MACRO G_VLINE A,X,Y,H
214   F70D ~                            DB A|3, Y, 90h+(X>>3), H, 80h>>(X&7)
215   F70D                          ENDM
216   F70D
217   F70D              g_filePanel:
218   F70D                          G_WINDOW 0, 0, 0, 192, 230        ; 2, 0, 90h, 0E0h, 16h
218   F70D 02 00 90 E0 >                DB 0|2, 0, 90h+(0>>3), 230-6, (192>>3)-2
218   F711 16          >
219   F712                          G_LINE   0, 4, 208, 184           ; 1, 0D0h, 90h, 16h, 0Fh, 0F0h
219   F712 01 D0 90 16 >                DB 0|1, 208, 90h+(4>>3), (((4&7)+184+7)>>3)-2, 0FFh>>(4&7), (0FF00h>>((184+4)&7)) & 0FFh
219   F716 0F F0       >
220   F718                          G_VLINE  0, 96, 3, 205            ; 3, ?, 9Ch, 0CDh, 80h
220   F718 03 03 9C CD >                DB 0|3, 3, 90h+(96>>3), 205, 80h>>(96&7)
220   F71C 80          >
221   F71D 00                       DB 0
222   F71E
