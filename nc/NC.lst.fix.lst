 27+  F129 CD 3F C8                 call    bios_fileList
 28+  F12C
 29+  F12C                          ; Сохранение количествава файлов
 30+  F12C 7B                       ld      a, e                ; считаем, что файлов в каталоге меньше 256
 31+  F12D 21 5A F7                 ld      hl, state.panelA_filesCnt
 32+  F130 C3 7B F3                 jp      writeBytePanel
 33+  F133
125   F133                  INCLUDE "printInfoPanel.inc"
  1+  F133              ;----------------------------------------------------------------------------
  2+  F133              ; MXOS NC.COM
  3+  F133              ; Рисование информационной панели
