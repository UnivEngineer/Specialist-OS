 58+  E969             >        IF ENABLE_COLOR
 58+  E969 3E 70       >            ld a, COLOR_CMDLINE
 58+  E96B 32 F8 FF    >            ld (IO_COLOR), a
 58+  E96E             >        ENDIF
 59+  E96E 2A 62 F7             ld      hl, (vars.cmdLineEnd)
 60+  E971 CD 18 C8             call    bios_printString
 61+  E974
 62+  E974                      ; Дописываем имя файла
 63+  E974 EB                   ex      de, hl
 64+  E975 22 62 F7             ld      (vars.cmdLineEnd), hl
 65+  E978
 66+  E978                      ; Сохраняем новое положение
 67+  E978 2A FC 8F             ld      hl, (bios_vars.cursorY)
 68+  E97B 22 60 F7             ld      (vars.cmdLinePos), hl
 69+  E97E C9                   ret
