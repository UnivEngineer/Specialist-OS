  9+  F3C4
 10+  F3C4              setCursorPosPanel:
 11+  F3C4                          ; Сохраняем регистры
 12+  F3C4 E5                       push  hl
 13+  F3C5 F5                       push  af
 14+  F3C6
 15+  F3C6 3A 55 F7                 ld    a, (state.activePanel)
 16+  F3C9 A7                       and   a
 17+  F3CA CA CF F3                 jp z, loc_D9BA
 18+  F3CD 3E 60                    ld    a, 96       ; Половина экрана
 19+  F3CF 84           loc_D9BA:   add   a, h
 20+  F3D0 67                       ld    h, a
 21+  F3D1 22 FC 8F                 ld    (bios_vars.cursorY), hl
 22+  F3D4
 23+  F3D4                          ; Восстанавливаем регистры
 24+  F3D4 F1                       pop   af
 25+  F3D5 E1                       pop   hl
 26+  F3D6 C9                       ret
 27+  F3D7
132   F3D7                  INCLUDE "draw.inc"
  1+  F3D7              ;----------------------------------------------------------------------------
  2+  F3D7              ; MXOS NC.COM
  3+  F3D7              ; Рисование окошек
  4+  F3D7              ;
  5+  F3D7              ; 2013-12-18 Дизассемблировано vinxru
  6+  F3D7              ;----------------------------------------------------------------------------
  7+  F3D7
  8+  F3D7              draw:       ; Читаем 5 байт из hl в a, hl, c, b.
  9+  F3D7                          ; При этом de = hl+5
 10+  F3D7 7E                       ld    a, (hl)
 11+  F3D8 23                       inc   hl
 12+  F3D9 5E                       ld    e, (hl)
 13+  F3DA 23                       inc   hl
 14+  F3DB 56                       ld    d, (hl)
 15+  F3DC 23                       inc   hl
 16+  F3DD 4E                       ld    c, (hl)
 17+  F3DE 23                       inc   hl
 18+  F3DF 46                       ld    b, (hl)
 19+  F3E0 23                       inc   hl
 20+  F3E1 EB                       ex    de, hl
 21+  F3E2
 22+  F3E2                          ; Если a=0 (первый байт), то выйти
 23+  F3E2 A7                       and   a
 24+  F3E3 C8                       ret z
 25+  F3E4
 26+  F3E4                          ; Если не установлен 7-ой бит и активная панель правая, то X += 192
 27+  F3E4 FA EA F3                 jp M, draw_0
 28+  F3E7 CD 16 F4                 call  activePanelPos
 29+  F3EA              draw_0:
 30+  F3EA
 31+  F3EA                          ; Если a&0xF==3, то заполнить c байт памяти байтом b
 32+  F3EA E6 0F                    and   0Fh
 33+  F3EC FE 03                    cp    3
 34+  F3EE CA FD F3                 jp z, draw3
 35+  F3F1
 36+  F3F1                          ; Если a&0xF==1, то нарисовать веритикальную линию
 37+  F3F1                          ; b-первый байт, c-средняя длина, *de++ - последний байт
 38+  F3F1 FE 01                    cp    1
 39+  F3F3 CA 04 F4                 jp z, draw1
 40+  F3F6
 41+  F3F6                          ; Нарисовать окно
 42+  F3F6 CD 24 F4                 call  draw_window
 43+  F3F9
 44+  F3F9              draw_next:  ; hl=de и следующий цикл
 45+  F3F9 EB                       ex    de, hl
 46+  F3FA C3 D7 F3                 jp    draw
 47+  F3FD
 48+  F3FD              ; ---------------------------------------------------------------------------
 49+  F3FD              ; Заполнить c байт памяти байтом b
 50+  F3FD
 51+  F3FD 78           draw3:      ld    a, b
 52+  F3FE CD 66 F4                 call  memset_hl_a_c
 53+  F401 C3 F9 F3                 jp    draw_next
 54+  F404
 55+  F404              ; ---------------------------------------------------------------------------
 56+  F404              ; Линия hl-адрес, b-первый байт, c-средняя длина, *de++ - последний байт
 57+  F404
 58+  F404              draw1:      ; *hl++ |= b
 59+  F404 78                       ld    a, b
 60+  F405 B6                       or    (hl)
 61+  F406 77                       ld    (hl), a
 62+  F407 24                       inc   h
 63+  F408
 64+  F408              loc_D9F3:
 65+  F408 36 FF                    ld    (hl), 0FFh
 66+  F40A 24                       inc   h
 67+  F40B 0D                       dec   c
 68+  F40C C2 08 F4                 jp nz, loc_D9F3
 69+  F40F
 70+  F40F                          ; hl |= *de++
 71+  F40F 1A                       ld    a, (de)
 72+  F410 13                       inc   de
 73+  F411 B6                       or    (hl)
 74+  F412 77                       ld    (hl), a
 75+  F413
 76+  F413 C3 F9 F3                 jp    draw_next
 77+  F416
 78+  F416              ; ---------------------------------------------------------------------------
 79+  F416              ; Если активная правая панель, сдвинуть адрес на пол экрана
 80+  F416
 81+  F416              activePanelPos:
 82+  F416 F5                       push  af
 83+  F417 3A 55 F7                 ld    a, (state.activePanel)
 84+  F41A A7                       and   a
 85+  F41B CA 20 F4                 jp z, loc_DA0B
 86+  F41E 3E 18                    ld    a, 24
 87+  F420 84           loc_DA0B:   add   a, h
 88+  F421 67                       ld    h, a
 89+  F422 F1                       pop   af
 90+  F423 C9                       ret
 91+  F424
 92+  F424              ; ---------------------------------------------------------------------------
 93+  F424              ; Рисуем окно (b=ширина-2, с=высота-6)
 94+  F424
 95+  F424              draw_window:
 96+  F424                          ; Если h - 90h + b >= 0x2F, то есть X + b + 2 > ширина экрана, то выйти
 97+  F424 7C                       ld    a, h
 98+  F425 D6 90                    sub   90h
 99+  F427 80                       add   a, b
100+  F428 FE 2F                    cp    2Fh
101+  F42A D0                       ret nc
102+  F42B
103+  F42B                          ; Сохранить регистры
104+  F42B E5                       push  hl
105+  F42C C5                       push  bc
106+  F42D D5                       push  de
107+  F42E
108+  F42E                          ; Линия
109+  F42E 11 F8 F6                 ld    de, v_window
110+  F431 CD 48 F4                 call  line313
111+  F434
112+  F434                          ; Повтор b раз
113+  F434              draw_window_2:
114+  F434 D5                       push  de
115+  F435 CD 48 F4                 call  line313
116+  F438 05                       dec   b
117+  F439 CA 40 F4                 jp z, draw_window_3
118+  F43C D1                       pop   de
119+  F43D C3 34 F4                 jp    draw_window_2
120+  F440
121+  F440              ; ---------------------------------------------------------------------------
122+  F440
123+  F440              draw_window_3:
124+  F440 F1                       pop   af
125+  F441
126+  F441                          ; Линия
127+  F441 CD 48 F4                 call  line313
128+  F444
129+  F444                          ; Восстановить регистры и выйти
130+  F444 D1                       pop   de
131+  F445 C1                       pop   bc
132+  F446 E1                       pop   hl
133+  F447 C9                       ret
134+  F448
135+  F448              ; ---------------------------------------------------------------------------
136+  F448              ; Вертикальная линия. Задается три верхних байта, заполнитель и три нижних
137+  F448
138+  F448              line313:    ; Сохраняем регистры
139+  F448 C5                       push  bc
140+  F449 E5                       push  hl
141+  F44A
142+  F44A                          ; Копируем 3 байта (сверху-вниз)
143+  F44A CD 59 F4                 call  memcpy_hl_de_3
144+  F44D
145+  F44D                          ; 4 ый байт повторяем С-раз (сверху-вниз)
146+  F44D 1A                       ld    a, (de)
147+  F44E CD 66 F4                 call  memset_hl_a_c
148+  F451 13                       inc   de
149+  F452
150+  F452                          ; Копируем 3 байта (сверху-вниз)
151+  F452 CD 59 F4                 call  memcpy_hl_de_3
152+  F455
153+  F455                          ; Восстаналиваем регистры
154+  F455 E1                       pop   hl
155+  F456 C1                       pop   bc
156+  F457
157+  F457                          ; Вправо
158+  F457 24                       inc   h
159+  F458 C9                       ret
160+  F459
133   F459                  INCLUDE "tools.inc"
  1+  F459              ;----------------------------------------------------------------------------
  2+  F459              ; MXOS NC.COM
  3+  F459              ; Копирвоание 3-х байт из адреса de в адрес hl
  4+  F459              ;
  5+  F459              ; 2013-12-18 Дизассемблировано vinxru
  6+  F459              ;----------------------------------------------------------------------------
  7+  F459
  8+  F459              memcpy_hl_de_3:
  9+  F459 1A                   ld    a, (de)
 10+  F45A 77                   ld    (hl), a
 11+  F45B 23                   inc   hl
 12+  F45C 13                   inc   de
 13+  F45D
 14+  F45D 1A                   ld    a, (de)
 15+  F45E 77                   ld    (hl), a
 16+  F45F 23                   inc   hl
 17+  F460 13                   inc   de
 18+  F461
 19+  F461 1A                   ld    a, (de)
 20+  F462 77                   ld    (hl), a
 21+  F463 23                   inc   hl
 22+  F464 13                   inc   de
 23+  F465
 24+  F465 C9                   ret
 25+  F466
 26+  F466              ;----------------------------------------------------------------------------
 27+  F466              ; MXOS NC.COM
 28+  F466              ; Заполнение памяти по адресу hl байтом a длинной c
 29+  F466              ;
 30+  F466              ; 2013-12-18 Дизассемблировано vinxru
 31+  F466              ;----------------------------------------------------------------------------
 32+  F466
 33+  F466              memset_hl_a_c:
 34+  F466 77                   ld      (hl), a
 35+  F467 23                   inc     hl
 36+  F468 0D                   dec     c
 37+  F469 C2 66 F4             jp nz,  memset_hl_a_c
 38+  F46C C9                   ret
 39+  F46D
134   F46D                  INCLUDE "compactName.inc"
  1+  F46D              ;----------------------------------------------------------------------------
  2+  F46D              ; MXOS NC.COM
  3+  F46D              ; Убрать из имени пробелы
  4+  F46D              ;
  5+  F46D              ; вход:
  6+  F46D              ;   hl - откуда
  7+  F46D              ;   de - куда
  8+  F46D              ;
  9+  F46D              ; сохраняемые регистры:
 10+  F46D              ;   hl, bc
 11+  F46D              ;
 12+  F46D              ; 2013-12-18 Дизассемблировано vinxru
 13+  F46D              ;----------------------------------------------------------------------------
 14+  F46D
 15+  F46D              compactName:
 16+  F46D                          ; Сохраняем регистры
 17+  F46D E5                       push    hl
 18+  F46E C5                       push    bc
 19+  F46F
 20+  F46F                          ; Копируем до пробела, но не более FILE_NAME_LENGTH букв
 21+  F46F 01 08 00                 ld      bc, FILE_NAME_LENGTH
 22+  F472 7E           compactName_1:      ld  a, (hl)
 23+  F473 FE 20                    cp      ' '
 24+  F475 CA 7F F4                 jp z,   compactName_2
 25+  F478 12                       ld      (de),a
 26+  F479 23                       inc     hl
 27+  F47A 13                       inc     de
 28+  F47B 0D                       dec     c
 29+  F47C C2 72 F4                 jp nz,  compactName_1
 30+  F47F
 31+  F47F              compactName_2:
 32+  F47F                          ; Пропущенные символы исходной строки
 33+  F47F 09                       add     hl, bc
 34+  F480
 35+  F480                          ; Точка
 36+  F480 3E 2E                    ld      a, '.'
 37+  F482 12                       ld      (de),a
 38+  F483 13                       inc     de
 39+  F484
 40+  F484                          ; Копируем до пробела, но не более 3 букв
 41+  F484 0E 03                    ld      c, 3
 42+  F486              compactName_3:
 43+  F486 7E                       ld      a, (hl)
 44+  F487 FE 20                    cp      ' '
 45+  F489 CA 93 F4                 jp z,   compactName_4
 46+  F48C 12                       ld      (de),a
 47+  F48D 23                       inc     hl
 48+  F48E 13                       inc     de
 49+  F48F 0D                       dec     c
 50+  F490 C2 86 F4                 jp nz,  compactName_3
 51+  F493
 52+  F493              compactName_4:
 53+  F493 EB                       ex      de, hl
 54+  F494 F5                       push    af
 55+  F495
 56+  F495                          ; Если последний символ '.', то удаляем его
 57+  F495 2B                       dec     hl
 58+  F496 7E                       ld      a, (hl)
 59+  F497 FE 2E                    cp      '.'
 60+  F499 CA 9D F4                 jp z,   compactName_5
 61+  F49C 23                       inc     hl
 62+  F49D
 63+  F49D              compactName_5:
 64+  F49D                          ; Добавляем пробел и конец строки
 65+  F49D 36 20                    ld      (hl), ' '
 66+  F49F 23                       inc     hl
 67+  F4A0 36 0D                    ld      (hl), 0Dh
 68+  F4A2 23                       inc     hl
 69+  F4A3 36 00                    ld      (hl), 0
 70+  F4A5
 71+  F4A5                          ; Результат в de
 72+  F4A5 EB                       ex    de, hl
 73+  F4A6
 74+  F4A6                          ; Восстаналиваем регистры и выходим
 75+  F4A6 F1                       pop   af
 76+  F4A7 C1                       pop   bc
 77+  F4A8 E1                       pop   hl
 78+  F4A9 C9                       ret
 79+  F4AA
135   F4AA                  INCLUDE "input.inc"
  1+  F4AA              ;----------------------------------------------------------------------------
  2+  F4AA              ; MXOS NC.COM
  3+  F4AA              ; Ввод строки
  4+  F4AA              ;
  5+  F4AA              ; 2013-12-18 Дизассемблировано vinxru
  6+  F4AA              ;----------------------------------------------------------------------------
  7+  F4AA
  8+  F4AA              input:      ; Вывод строки
  9+  F4AA E5                       push    hl
 10+  F4AB 21 B2 F7                 ld      hl, vars.input
 11+  F4AE CD F3 EA                 call    printStringInv
 12+  F4B1 E1                       pop     hl
 13+  F4B2
 14+  F4B2                          ; Включаем инверсию
 15+  F4B2 3E 01                    ld      a, 1
 16+  F4B4 32 FA 8F                 ld      (bios_vars.inverse),a
 17+  F4B7
 18+  F4B7              input_loop: ; Ввод символа
 19+  F4B7 CD 03 C8                 call  bios_getch
 20+  F4BA
 21+  F4BA                          ; Enter или ESC
 22+  F4BA FE 0D                    cp      0Dh
 23+  F4BC CA EF F4                 jp z,   input_exit
 24+  F4BF FE 1B                    cp      1Bh
 25+  F4C1 CA EF F4                 jp z,   input_exit
 26+  F4C4
 27+  F4C4                          ; Если служебная клавиша или пробел, то пропускаем
 28+  F4C4 FE 21                    cp      21h
 29+  F4C6 DA B7 F4                 jp c,   input_loop
 30+  F4C9
 31+  F4C9                          ; Сохраняем для вывода
 32+  F4C9 4F                       ld      c, a
 33+  F4CA
 34+  F4CA                          ; Помещаем символ в буфер
 35+  F4CA 12                       ld      (de),a
 36+  F4CB
 37+  F4CB                          ; Удаление
 38+  F4CB FE 7F                    cp      7Fh
 39+  F4CD CA DD F4                 jp z,   input_bkspc
 40+  F4D0
 41+  F4D0                          ; Если переполнение
 42+  F4D0 3E C9                    ld      a, (vars.input + P_INPUT_WIDTH) & 0FFh  ; a = младший байт адреса пследнего байта буфера
 43+  F4D2 BB                       cp      e
 44+  F4D3 CA B7 F4                 jp z,   input_loop
 45+  F4D6
 46+  F4D6                          ; Вывод символа на экран
 47+  F4D6 CD 09 C8                 call    bios_printChar
 48+  F4D9
 49+  F4D9                          ; Увеличение длины строки
 50+  F4D9 13                       inc     de
 51+  F4DA
 52+  F4DA C3 B7 F4                 jp      input_loop
 53+  F4DD
 54+  F4DD              ; ---------------------------------------------------------------------------
 55+  F4DD
 56+  F4DD              input_bkspc:
 57+  F4DD                          ; Если это начало строки, выходим
 58+  F4DD 3E B2                    ld      a, vars.input & 0FFh
 59+  F4DF BB                       cp      e
 60+  F4E0 CA B7 F4                 jp z,   input_loop
 61+  F4E3
 62+  F4E3                          ; Уменьшаем длину строки
 63+  F4E3 1D                       dec     e
 64+  F4E4
 65+  F4E4                          ; Стираем символ с экрана
 66+  F4E4 E5                       push    hl
 67+  F4E5 21 96 F5                 ld      hl, asc_DC17
 68+  F4E8 CD 18 C8                 call    bios_printString
 69+  F4EB E1                       pop     hl
 70+  F4EC
 71+  F4EC C3 B7 F4                 jp      input_loop
 72+  F4EF
 73+  F4EF              ; ---------------------------------------------------------------------------
 74+  F4EF
 75+  F4EF              input_exit:
 76+  F4EF                          ; Сохраняем ESC или Enter для выхода
 77+  F4EF 4F                       ld      c, a
 78+  F4F0
 79+  F4F0                          ; Записываем в конец строки 0Dh, 0
 80+  F4F0 EB                       ex      de, hl
 81+  F4F1 36 0D                    ld      (hl), 0Dh
 82+  F4F3 23                       inc     hl
 83+  F4F4 AF                       xor     a
 84+  F4F5 77                       ld      (hl), a
 85+  F4F6
 86+  F4F6                          ; Восстанавливаем инверсию
 87+  F4F6 32 FA 8F                 ld      (bios_vars.inverse),a
 88+  F4F9
 89+  F4F9                          ; Выход
 90+  F4F9 79                       ld      a, c
 91+  F4FA C9                       ret
 92+  F4FB
