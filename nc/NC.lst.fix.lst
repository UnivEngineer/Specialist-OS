 13+  E998
 14+  E998                          ; Запомнить текущий диск в регистре b
 15+  E998 1E 00                    ld      e, 0
 16+  E99A CD 42 C8                 call    bios_fileGetSetDrive
 17+  E99D 47                       ld      b, a
 18+  E99E
 19+  E99E                          ; Подготовить имя файла A:NC.EXT
 20+  E99E 21 E7 F6                 ld      hl, aNcExt
 21+  E9A1 11 D2 F7                 ld      de, vars.tempFileDescr; vars.tempFileDescr используется как буфер
