 38+  E82D
 39+  E82D                          ; Раскрашиваем строку с кнопками
 40+  E82D                          COLOR   COLOR_HELP_TEXT
 40+  E82D             >        IF ENABLE_COLOR
 40+  E82D 3E 30       >            ld a, COLOR_HELP_TEXT
 40+  E82F 32 F8 FF    >            ld (IO_COLOR), a
 40+  E832             >        ENDIF
 41+  E832 21 F7 92                 ld      hl, 92F7h           ; адрес первого прямоугольника
 42+  E835 16 08                    ld      d, 8                ; количество прямоугольников
 43+  E837              colToolbarLoop:
 44+  E837 01 09 04                 ld      bc, (4 << 8) + 9    ; b = ширина = 4 байта, c = высота 9 пикселей
 45+  E83A CD AD F0                 call    inverseRect
 46+  E83D 24                       inc     h
 47+  E83E 24                       inc     h
 48+  E83F 15                       dec     d
 49+  E840 C2 37 E8                 jp nz,  colToolbarLoop
 50+  E843
 51+  E843                          ; Очищаем командную строку
