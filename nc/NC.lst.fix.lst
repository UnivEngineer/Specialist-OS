244   F754              ;-----------------------------------------------------------------------
245   F754              ; Размер буфера для листинга директории (штук дескрипторов файлов)
246   F754
247   F754                  IF FULL_PANELS
248   F754 ~            FILE_LIST_SIZE    = 40
249   F754                  ELSE
250   F754              FILE_LIST_SIZE    = 36
251   F754                  ENDIF
252   F754
253   F754              ;-----------------------------------------------------------------------
254   F754              ; Коодинаты элементов панелей от левого верхнего угла экрана
255   F754              ; x - удвоенные пиксели, y - пиксели
256   F754
257   F754              P_NAME_X1         = 17  ; Заголовок панели "NAME" (2 колонки)
258   F754              P_NAME_X2         = 65
259   F754              P_NAME_Y          = 16
260   F754
261   F754              P_FILE_LIST_X1    = 6   ; Файловая таблица (2 колонки)
262   F754              P_FILE_LIST_X2    = 54
263   F754
264   F754                  IF FULL_PANELS
265   F754 ~            P_FILE_LIST_Y     = 12
266   F754                  ELSE
267   F754              P_FILE_LIST_Y     = 32
268   F754                  ENDIF
269   F754
270   F754              P_FILE_LIST_H     = FILE_LIST_SIZE / 2  ; Высота файловой таблицы в строках
271   F754              P_FILE_LIST_Y_MAX = P_FILE_LIST_H * 10 + P_FILE_LIST_Y
272   F754
273   F754              P_DRIVE_LETTER_X  = 9   ; Буква имени диска внизу панели
274   F754              P_DRIVE_LETTER_Y  = 222
275   F754              P_FILE_NAME_X     = 15  ; Имя файла внизу панели
276   F754              P_FILE_NAME_Y     = 222
277   F754              P_FILE_DATA_X     = 57  ; Данные о файле (адрес загрузки, размер)
278   F754              P_FILE_DATA_Y     = 222
279   F754
280   F754              P_INPUT_WIDTH     = 23  ; Длина поля ввода имени файла в символах
281   F754
282   F754              ;-----------------------------------------------------------------------
283   F754              ; Переменные
284   F754              ;-----------------------------------------------------------------------
285   F754
286   F754              ; Блок переменных состояния
287   F754              ; Сохраняется в неиспользуемом секторе нулевой страницs RAM-диска
288   F754
289   F754                  STRUCT NC_STATE
290   F754 ~            initState           DB    5Ah   ; признак, что NC.COM уже запускался
291   F754 ~            activePanel         DB    0     ; номер активной панели
292   F754 ~            panelA_info         DB    0     ; 1 = панель A в режиме информации
293   F754 ~            panelB_info         DB    0     ; 1 = панель B в режиме информации
294   F754 ~            panelA_drive        DB    0     ; номер диска панели A
295   F754 ~            panelB_drive        DB    7     ; номер диска панели B
296   F754 ~            panelA_filesCnt     DB    0     ; количество файлов на панели A
297   F754 ~            panelB_filesCnt     DB    0     ; количество файлов на панели B
298   F754 ~            panelA_firstFile    DB    0     ; c какого файла начинается панель A
299   F754 ~            panelB_firstFile    DB    0     ; c какого файла начинается панель B
300   F754 ~            panelA_curFile      DB    0     ; на каком файле курсор на панели A
301   F754 ~            panelB_curFile      DB    0     ; на каком файле курсор на панели B
302   F754                  ENDS
303   F754
304   F754 5A 00 00 00  state   NC_STATE
304   F758 00 07 00 00
304   F75C 00 00 00 00
305   F760              stateEnd:           ; адрес конца блока переменных состояния
306   F760
307   F760              ; Другие переменные - не включены в бинарник (машинный код не
308   F760              ; генерируется, при первом запуске переменные могут содержать мусор)
309   F760
310   F760                  STRUCT NC_VARIABLES
311   F760 ~            cmdLinePos      DW    0
312   F760 ~            cmdLineEnd      DW    0
313   F760 ~            chooseDrive     DB    0
314   F760 ~            copyLoadAddr    DW    0
315   F760 ~            diskInfoPtr     DW    0         ; адрес структуны DISK_INFO
316   F760 ~            cmdLine         BLOCK 59, 0FFh  ; командная строка
317   F760 ~            cmdLineCtrl     DB    0FFh      ; контроль переполнения командной строки
318   F760 ~            driveCount     DB    0         ; число установленных дисковых драйверов
319   F760 ~            driveList      BLOCK 8, 0     ; номера дисков с установленным драйвером
320   F760 ~                            BLOCK 4, 0FFh ; резерв внутри прежнего блока переменных
321   F760 ~
322   F760 ~            input           BLOCK 21, 0FFh
323   F760 ~                            BLOCK 11
324   F760 ~            tempFileDescr   FILE_DESCRIPTOR
325   F760                  ENDS
326   F760
327   F760              vars    NC_VARIABLES = $        ; адрес начала блока переменнных
328   F760              varsEnd = vars + NC_VARIABLES   ; адрес конца  блока переменнных
329   F760
330   F760              ; Адрес буфера для листинга директории (FILE_LIST_SIZE структур FILE_INFO + 1 = 577 байт)
331   F760              ;FILE_LIST_BUFFER = 8800h
332   F760              FILE_LIST_BUFFER      = varsEnd
333   F760              FILE_LIST_BUFFER_SIZE = FILE_LIST_SIZE * FILE_INFO_SIZE + 1
334   F760
335   F760              ;-----------------------------------------------------------------------
336   F760              ; Проверяем, что программа помещается в память вместе со своими буферами
337   F760              ;-----------------------------------------------------------------------
338   F760
339   F760              ; Конец NC.COM после разворачивания в памяти
340   F760              NC_END = FILE_LIST_BUFFER + FILE_LIST_BUFFER_SIZE
341   F760
342   F760              ; Максимальный допустимый размер NC.COM
343   F760                  IF NEW_MEMORY_MAP
344   F760              NC_END_MAX = FAT_CACHE_ADDR  ; до дискового кэша
345   F760                  ELSE
346   F760 ~            NC_END_MAX = 0E200h          ; до адреса 0E200h
347   F760                  ENDIF
348   F760
349   F760              ; Проверка
350   F760                  IF NC_END >= NC_END_MAX
351   F760 ~                    ASSERT 0
352   F760 ~                    DISPLAY /l, "Error! NC.COM did not fit (", NC_END, " > ", NC_END_MAX, ")"
353   F760                  ENDIF
354   F760
355   F760                  END
