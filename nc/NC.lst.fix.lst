 20+  F149 21 3A F5                 ld      hl, aCommanderVer
 21+  F14C CD 18 C8                 call    bios_printString
 22+  F14F
 23+  F14F                          ; Печать "(C) OMSK 1992"
 24+  F14F                          ;ld      hl, 1D1Ah
 25+  F14F 21 1A 0E                 ld      hl, 0E1Ah
 26+  F152 CD C4 F3                 call    setCursorPosPanel
 27+  F155 21 50 F5                 ld      hl, aCopyright
 28+  F158 CD 18 C8                 call    bios_printString
 29+  F15B
