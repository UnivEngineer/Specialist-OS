121+  EC6E 32 F8 FF    >            ld (IO_COLOR), a
121+  EC71             >        ENDIF
122+  EC71 21 90 50                 ld      hl, 5090h
123+  EC74 22 FC 8F                 ld      (bios_vars.cursorY), hl
