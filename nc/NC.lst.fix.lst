  8+  ED19              but_F2:     ; Временно устанавливаем state.activePanel=1
  9+  ED19 3A 55 F7                 ld    a, (state.activePanel)
 10+  ED1C F5                       push  af
 11+  ED1D 3E 01                    ld    a, 1
 12+  ED1F 32 55 F7                 ld    (state.activePanel), a
 13+  ED22
