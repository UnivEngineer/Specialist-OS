  9+  F133             >        IF ENABLE_COLOR
  9+  F133 3E F1       >            ld a, COLOR_BORDER
  9+  F135 32 F8 FF    >            ld (IO_COLOR), a
  9+  F138             >        ENDIF
 10+  F138
