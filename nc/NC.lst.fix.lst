128   F37B                  INCLUDE "rwBytePanel.inc"
  1+  F37B              ;----------------------------------------------------------------------------
  2+  F37B              ; MXOS NC.COM
  3+  F37B              ; Запись значения в переменную панели
  4+  F37B              ; [hl + state.activePanel] = a
