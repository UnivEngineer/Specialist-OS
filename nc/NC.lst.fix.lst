 99   E946                  INCLUDE "selFileToCmdLine.inc"
  1+  E946              ;----------------------------------------------------------------------------
  2+  E946              ; MXOS NC.COM
  3+  E946              ; Сформировать строку пути выбраного файла
  4+  E946              ;
  5+  E946              ; вход:
  6+  E946              ;   hl - адрес дескриптора файла
