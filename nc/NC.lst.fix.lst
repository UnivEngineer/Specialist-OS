116+  EC5F 32 F8 FF    >            ld (IO_COLOR), a
116+  EC62             >        ENDIF
117+  EC62                          CENTER_LINE 20, 80h
117+  EC62 21 80 42    >        ld  hl, ((60h - 20 * 3 / 2) << 8) + 80h
117+  EC65 22 FC 8F    >        ld  (bios_vars.cursorY), hl
