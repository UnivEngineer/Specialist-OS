114   EF0F                  INCLUDE "butTab.inc"
  1+  EF0F              ;----------------------------------------------------------------------------
  2+  EF0F              ; MXOS NC.COM
  3+  EF0F              ; Клавиша TAB - Смена активной панели
  4+  EF0F              ;
  5+  EF0F              ; 2013-12-18 Дизассемблировано vinxru
  6+  EF0F              ;----------------------------------------------------------------------------
  7+  EF0F
  8+  EF0F              but_Tab:    ; Получаем видимость панели
  9+  EF0F 21 56 F7                 ld      hl, state.panelA_info
 10+  EF12 3A 55 F7                 ld      a, (state.activePanel)
 11+  EF15 A7                       and     a
 12+  EF16 C2 1A EF                 jp nz,  loc_D6C7
 13+  EF19 23                       inc     hl
 14+  EF1A 4F           loc_D6C7:   ld      c, a
 15+  EF1B 7E                       ld      a, (hl)
 16+  EF1C
 17+  EF1C                          ; Панель не видима, выходим
 18+  EF1C A7                       and     a
 19+  EF1D C2 5C E8                 jp nz,  mainDriveChanged
 20+  EF20
 21+  EF20                          ; Меняем активную панель на противоположную
 22+  EF20 79                       ld      a, c
 23+  EF21 EE 01                    xor     1
 24+  EF23 32 55 F7                 ld      (state.activePanel),a
 25+  EF26
 26+  EF26                          ; Перезагружаем список файлов
 27+  EF26 21 58 F7                 ld      hl, state.panelA_drive
 28+  EF29 CD 8C F3                 call    readBytePanel
 29+  EF2C CD 15 F1                 call    loadFiles   ; На входе нужен a=накопитель
 30+  EF2F
 31+  EF2F C3 7A ED                 jp      saveStateAndReload
 32+  EF32
115   EF32                  INCLUDE "butF3.inc"
  1+  EF32              ;----------------------------------------------------------------------------
  2+  EF32              ; MXOS NC.COM
  3+  EF32              ; Клавиша F3 - отобразить информацию о накопителе
  4+  EF32              ;
  5+  EF32              ; 2013-12-18 Дизассемблировано vinxru
  6+  EF32              ;----------------------------------------------------------------------------
  7+  EF32
  8+  EF32              but_F3:     ; Временный выбор противоположной панели
  9+  EF32 3A 55 F7                 ld    a, (state.activePanel)
 10+  EF35 F5                       push  af
 11+  EF36 EE 01                    xor   1
 12+  EF38 32 55 F7                 ld    (state.activePanel),a
 13+  EF3B
 14+  EF3B                          ; Меняем видимость панели
 15+  EF3B 21 56 F7                 ld    hl, state.panelA_info
 16+  EF3E CD 8C F3                 call  readBytePanel
 17+  EF41 EE 01                    xor   1
 18+  EF43 CD 7B F3                 call  writeBytePanel
 19+  EF46
 20+  EF46                          ; Восстанавлаием активную панель
 21+  EF46 F1                       pop   af
 22+  EF47 32 55 F7                 ld    (state.activePanel),a
 23+  EF4A A7                       and   a
 24+  EF4B CA 54 EF                 jp z, loc_D701
 25+  EF4E
 26+  EF4E                          ; Перерисовываем панель
