102   EA7A                  INCLUDE "saveLoadState.inc"
  1+  EA7A              ;----------------------------------------------------------------------------
  2+  EA7A              ; MXOS NC.COM
  3+  EA7A              ; Cохранение состояния в ДОЗУ
  4+  EA7A              ;
  5+  EA7A              ; 2013-12-18 Дизассемблировано vinxru
  6+  EA7A              ;----------------------------------------------------------------------------
  7+  EA7A
  8+  EA7A              saveState:
  9+  EA7A                          ; Устанавливаем побайтовый драйвер
 10+  EA7A 06 01                    ld      b, 1
 11+  EA7C CD 6F C8                 call    bios_setRAMDDriver
 12+  EA7F
 13+  EA7F 11 54 F7                 ld      de, state           ; откуда (в ОЗУ)
 14+  EA82 21 00 FF                 ld      hl, 0FF00h          ; куда (в ДОЗУ)
 15+  EA85 06 0C                    ld      b,  stateEnd-state  ; сколько байт
 16+  EA87
 17+  EA87              saveStateLoop:
 18+  EA87 1A                       ld      a, (de)
 19+  EA88 4F                       ld      c, a                ; записываемый байт в c
 20+  EA89 AF                       xor     a                   ; 0 страница ДОЗУ
 21+  EA8A CD D0 FF                 call    bios_RAMDWrite
 22+  EA8D 23                       inc     hl
 23+  EA8E 13                       inc     de
 24+  EA8F 05                       dec     b
 25+  EA90 C2 87 EA                 jp nz,  saveStateLoop
 26+  EA93
 27+  EA93                          ; Восстанавливаем блочный драйвер
 28+  EA93                          ; b уже 0 здесь
 29+  EA93 C3 6F C8                 jp      bios_setRAMDDriver
 30+  EA96
 31+  EA96
 32+  EA96              ;----------------------------------------------------------------------------
 33+  EA96              ; MXOS NC.COM
 34+  EA96              ; Загрузка состояния из ДОЗУ
 35+  EA96              ;
 36+  EA96              ; выход:
 37+  EA96              ;   флаг  z, если в ДОЗУ есть метка "запускалось"
 38+  EA96              ;   флаг nz, если в ДОЗУ нет  метки "запускалось"
 39+  EA96              ;   Дравер не восстанавливается!
 40+  EA96              ;
 41+  EA96              ; 2022-02-02 SpaceEngineer
 42+  EA96              ;----------------------------------------------------------------------------
 43+  EA96
 44+  EA96              loadState:
 45+  EA96                          ; Устанавливаем побайтовый драйвер
 46+  EA96 06 01                    ld      b, 1
 47+  EA98 CD 6F C8                 call    bios_setRAMDDriver
 48+  EA9B
 49+  EA9B                          ; Если в рам-диске по адресу 0FF00h (последний неполный сектор)
 50+  EA9B                          ; нет специальной метки, значит, не запускали форматирование.
 51+  EA9B 21 00 FF                 ld      hl, 0FF00h          ; адрес в странице
 52+  EA9E AF                       xor     a                   ; 0 страница ДОЗУ
 53+  EA9F CD C0 FF                 call    bios_RAMDRead
 54+  EAA2 79                       ld      a, c                ; считанный байт в c
 55+  EAA3 FE 5A                    cp      5Ah
 56+  EAA5 C0                       ret nz                      ; метки нет - выходим с флагом nz
 57+  EAA6
 58+  EAA6                          ; Иначе загружаем состояние
 59+  EAA6 11 54 F7                 ld      de, state           ; куда (в ОЗУ)
 60+  EAA9 21 00 FF                 ld      hl, 0FF00h          ; откуда (в ДОЗУ)
 61+  EAAC 06 0C                    ld      b,  stateEnd-state  ; сколько байт байт
 62+  EAAE
 63+  EAAE              loadStateLoop:
 64+  EAAE AF                       xor     a                   ; 0 страница ДОЗУ
 65+  EAAF CD C0 FF                 call    bios_RAMDRead
 66+  EAB2 79                       ld      a, c                ; считанный байт в c
 67+  EAB3 12                       ld      (de), a
 68+  EAB4 23                       inc     hl
 69+  EAB5 13                       inc     de
 70+  EAB6 05                       dec     b
 71+  EAB7 C2 AE EA                 jp nz,  loadStateLoop
 72+  EABA
 73+  EABA                          ; Восстанавливаем блочный драйвер
 74+  EABA                          ; b уже 0 здесь
 75+  EABA CD 6F C8                 call    bios_setRAMDDriver
 76+  EABD
 77+  EABD AF                       xor     a   ; для выхода с флагом z
 78+  EABE C9                       ret
 79+  EABF
