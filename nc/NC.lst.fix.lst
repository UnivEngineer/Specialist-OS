 28+  F2E8             >        IF ENABLE_COLOR
 28+  F2E8 3E E1       >            ld a, COLOR_PANELNAME
 28+  F2EA 32 F8 FF    >            ld (IO_COLOR), a
 28+  F2ED             >        ENDIF
 29+  F2ED 21 10 11             ld      hl, (P_NAME_X1 << 8) + P_NAME_Y
 30+  F2F0 CD C4 F3             call    setCursorPosPanel
 31+  F2F3 21 E2 F6             ld      hl, aNameName
 32+  F2F6 CD 18 C8             call    bios_printString
 33+  F2F9
