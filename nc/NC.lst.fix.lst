224   F71E 02 00 90 E0 >                DB 0|2, 0, 90h+(0>>3), 230-6, (192>>3)-2
224   F722 16          >
225   F723                          G_LINE   0, 4, 31, 184            ; 1, 1Fh, 90h, 16h, 0Fh, 0F0h
225   F723 01 1F 90 16 >                DB 0|1, 31, 90h+(4>>3), (((4&7)+184+7)>>3)-2, 0FFh>>(4&7), (0FF00h>>((184+4)&7)) & 0FFh
225   F727 0F F0       >
