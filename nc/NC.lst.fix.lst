 12+  F37B
 13+  F37B              writeBytePanel:
 14+  F37B C5                       push  bc
 15+  F37C E5                       push  hl
 16+  F37D F5                       push  af
 17+  F37E 4F                       ld    c, a
 18+  F37F 3A 55 F7                 ld    a, (state.activePanel)
 19+  F382 A7                       and   a
 20+  F383 CA 87 F3                 jp z, loc_D97E
 21+  F386 23                       inc   hl
 22+  F387 71           loc_D97E:   ld    (hl), c
 23+  F388 F1                       pop   af
 24+  F389 E1                       pop   hl
 25+  F38A C1                       pop   bc
 26+  F38B C9                       ret
 27+  F38C
 28+  F38C              ;----------------------------------------------------------------------------
 29+  F38C              ; MXOS NC.COM
 30+  F38C              ; Чтение значения из переменной панели
 31+  F38C              ; a = [hl + state.activePanel]
 32+  F38C              ;
 33+  F38C              ; вход:
 34+  F38C              ;   hl = адрес переменной панели A (state.panelA_info, state.panelA_drive и т.п.)
 35+  F38C              ;
 36+  F38C              ; выход:
 37+  F38C              ;   a = значение переменной
 38+  F38C              ;
 39+  F38C              ; 2013-12-18 Дизассемблировано vinxru
 40+  F38C              ;----------------------------------------------------------------------------
 41+  F38C
 42+  F38C              readBytePanel:
 43+  F38C E5                       push  hl
 44+  F38D 3A 55 F7                 ld    a, (state.activePanel)
 45+  F390 A7                       and   a
 46+  F391 CA 95 F3                 jp z, loc_D98C
 47+  F394 23                       inc   hl
 48+  F395 7E           loc_D98C:   ld    a, (hl)
