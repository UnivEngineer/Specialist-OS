110   EBAF                  INCLUDE "copyFileInt.inc"
  1+  EBAF              ;----------------------------------------------------------------------------
  2+  EBAF              ; MXOS NC.COM
  3+  EBAF              ; Копирование выбранного файла через временный 32-байтовый дескриптор.
  4+  EBAF              ;
  5+  EBAF              ; Файл пока целиком загружается в 0000h. Размер ограничен 36 КБ, чтобы не
  6+  EBAF              ; затереть экран и системную область. Потоковое копирование будет отдельным
  7+  EBAF              ; изменением DOS ABI.
  8+  EBAF              ;----------------------------------------------------------------------------
  9+  EBAF
 10+  EBAF              copyFileInt:
 11+  EBAF                          ; Явно выбрать диск активной панели.
 12+  EBAF 21 58 F7                 ld      hl, state.panelA_drive
 13+  EBB2 CD 8C F3                 call    readBytePanel
 14+  EBB5 1E 01                    ld      e, 1
 15+  EBB7 CD 42 C8                 call    bios_fileGetSetDrive
 16+  EBBA
 17+  EBBA                          ; Скопировать имя выбранного файла в полный дескриптор.
 18+  EBBA CD C1 F0                 call    getSelectedFile
 19+  EBBD 11 D2 F7                 ld      de, vars.tempFileDescr
 20+  EBC0 0E 0B                    ld      c, FILE_NAME_LENGTH + 3
 21+  EBC2              copyFileNameLoop:
 22+  EBC2 7E                       ld      a, (hl)
 23+  EBC3 12                       ld      (de), a
 24+  EBC4 23                       inc     hl
 25+  EBC5 13                       inc     de
 26+  EBC6 0D                       dec     c
 27+  EBC7 C2 C2 EB                 jp nz,  copyFileNameLoop
 28+  EBCA
 29+  EBCA                          ; Получить полный дескриптор до загрузки и проверить размер.
 30+  EBCA 21 D2 F7                 ld      hl, vars.tempFileDescr
 31+  EBCD CD 51 C8                 call    bios_fileLoadInfo
 32+  EBD0 DA 37 EC                 jp c,   copyFileReadError
 33+  EBD3
 34+  EBD3 21 F0 F7                 ld      hl, vars.tempFileDescr + FILE_DESCRIPTOR.size + 2
 35+  EBD6 7E                       ld      a, (hl)
 36+  EBD7 23                       inc     hl
 37+  EBD8 B6                       or      (hl)
 38+  EBD9 C2 56 EC                 jp nz,  copyFileTooLarge
 39+  EBDC 2A EE F7                 ld      hl, (vars.tempFileDescr + FILE_DESCRIPTOR.size)
 40+  EBDF 7C                       ld      a, h
 41+  EBE0 FE 90                    cp      090h
 42+  EBE2 D2 56 EC                 jp nc,  copyFileTooLarge
 43+  EBE5
 44+  EBE5 2A E4 F7                 ld      hl, (vars.tempFileDescr + FILE_DESCRIPTOR.loadAddress)
 45+  EBE8 22 65 F7                 ld      (vars.copyLoadAddr), hl
 46+  EBEB
 47+  EBEB                          ; Загрузить исходный файл в буфер 0000h.
 48+  EBEB 21 D2 F7                 ld      hl, vars.tempFileDescr
 49+  EBEE 11 00 00                 ld      de, 0
 50+  EBF1 CD 66 C8                 call    bios_fileLoad2
 51+  EBF4 DA 37 EC                 jp c,   copyFileReadError
 52+  EBF7
 53+  EBF7                          ; Подготовить имя назначения. fileNamePrepare одновременно
 54+  EBF7                          ; выбирает диск из префикса X:.
 55+  EBF7 21 B2 F7                 ld      hl, vars.input
 56+  EBFA 11 D2 F7                 ld      de, vars.tempFileDescr
 57+  EBFD CD 5A C8                 call    bios_fileNamePrepare
 58+  EC00
 59+  EC00                          ; Не передавать невалидный v_diskInfo файловым функциям.
 60+  EC00 06 03                    ld      b, 3
 61+  EC02 CD 63 C8                 call    bios_diskDriver
 62+  EC05 7A                       ld      a, d
 63+  EC06 B3                       or      e
 64+  EC07 CA 3D EC                 jp z,   copyFileNoDriver
 65+  EC0A 01 22 00                 ld      bc, DISK_INFO.isValid
 66+  EC0D 09                       add     hl, bc
 67+  EC0E 7E                       ld      a, (hl)
 68+  EC0F FE 02                    cp      DISK_VALID
 69+  EC11 C2 43 EC                 jp nz,  copyFileNotFormatted
 70+  EC14
 71+  EC14                          ; fileCreate берёт данные по loadAddress, поэтому источник 0000h.
 72+  EC14 AF                       xor     a
 73+  EC15 32 E4 F7                 ld      (vars.tempFileDescr + FILE_DESCRIPTOR.loadAddress), a
 74+  EC18 32 E5 F7                 ld      (vars.tempFileDescr + FILE_DESCRIPTOR.loadAddress + 1), a
 75+  EC1B
 76+  EC1B 21 D2 F7                 ld      hl, vars.tempFileDescr
 77+  EC1E CD 45 C8                 call    bios_fileCreate
 78+  EC21 DA 49 EC                 jp c,   copyFileCreateError
 79+  EC24
 80+  EC24                          ; Вернуть файлу исходный адрес загрузки.
 81+  EC24 2A 65 F7                 ld      hl, (vars.copyLoadAddr)
 82+  EC27 EB                       ex      de, hl
 83+  EC28 21 D2 F7                 ld      hl, vars.tempFileDescr
 84+  EC2B 0E 01                    ld      c, 1
 85+  EC2D CD 54 C8                 call    bios_fileGetSetAddr
 86+  EC30 D0                       ret nc
 87+  EC31
 88+  EC31 21 D5 F5                 ld      hl, aCantSetFileAddr
 89+  EC34 C3 59 EC                 jp      copyFileShowError
 90+  EC37
 91+  EC37              copyFileReadError:
 92+  EC37 21 C3 F5                 ld      hl, aCantReadFile
 93+  EC3A C3 59 EC                 jp      copyFileShowError
 94+  EC3D
 95+  EC3D              copyFileNoDriver:
 96+  EC3D 21 F5 F5                 ld      hl, aDestNoDriver
 97+  EC40 C3 59 EC                 jp      copyFileShowError
 98+  EC43
 99+  EC43              copyFileNotFormatted:
100+  EC43 21 0A F6                 ld      hl, aDestNotFormatted
101+  EC46 C3 59 EC                 jp      copyFileShowError
102+  EC49
103+  EC49              copyFileCreateError:
104+  EC49 A7                       and     a
105+  EC4A 21 AF F5                 ld      hl, aRootDirFull
106+  EC4D CA 59 EC                 jp z,   copyFileShowError
