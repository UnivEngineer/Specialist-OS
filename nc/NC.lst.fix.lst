127+  F352
128+  F352                      ; Предыдущий файл
129+  F352 C5                   push    bc
130+  F353 01 F0 FF             ld      bc, -FILE_INFO_SIZE
131+  F356 09                   add     hl, bc
132+  F357 C1                   pop     bc
133+  F358
134+  F358                      ; Курсор на предыдущую строку
135+  F358 7B                   ld      a, e
136+  F359 D6 0A                sub     10
137+  F35B 5F                   ld      e, a
138+  F35C
139+  F35C                      ; Курсор на предыдущий столбец
140+  F35C FE 20                cp      P_FILE_LIST_Y
141+  F35E D2 4A F3             jp nc,  pfdu_Loop
142+  F361 7A                   ld      a, d
143+  F362 11 CA 06             ld      de, (P_FILE_LIST_X1 << 8) + P_FILE_LIST_Y_MAX - 10
144+  F365 FE 14                cp      20
145+  F367 D2 4A F3             jp nc,  pfdu_Loop
146+  F36A
147+  F36A C9                   ret
