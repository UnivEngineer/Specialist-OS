 11+  F0C1              getSelectedFile:
 12+  F0C1 D5                   push    de
 13+  F0C2
 14+  F0C2                      ; С какого файла начинается список файлов панели
 15+  F0C2 21 5C F7             ld      hl, state.panelA_firstFile
 16+  F0C5 CD 8C F3             call    readBytePanel
 17+  F0C8 5F                   ld      e, a
 18+  F0C9
 19+  F0C9                      ; Номер текущего файла
 20+  F0C9 21 5E F7             ld      hl, state.panelA_curFile
 21+  F0CC CD 8C F3             call    readBytePanel
 22+  F0CF 93                   sub     e
 23+  F0D0
 24+  F0D0                      ; Адрес описателя текущего файла в буфере:
 25+  F0D0                      ; hl = FILE_LIST_BUFFER + FILE_INFO_SIZE * curFile[state.activePanel];
 26+  F0D0
 27+  F0D0 21 10 00             ld      hl, FILE_INFO_SIZE
 28+  F0D3 5F                   ld      e, a
 29+  F0D4 16 00                ld      d, 0
 30+  F0D6 CD 84 C8             call    bios_mul_hl_de
 31+  F0D9
 32+  F0D9 11 F2 F7             ld      de, FILE_LIST_BUFFER
 33+  F0DC 19                   add     hl, de
 34+  F0DD
 35+  F0DD D1                   pop     de
 36+  F0DE C9                   ret
 37+  F0DF
123   F0DF                  INCLUDE "loadAndPrint.inc"
  1+  F0DF              ;----------------------------------------------------------------------------
