 23+  F0EE 3A 55 F7                 ld      a, (state.activePanel)
 24+  F0F1 F5                       push    af
 25+  F0F2 3E 00                    ld      a, 0
 26+  F0F4 32 55 F7                 ld      (state.activePanel),a
 27+  F0F7
 28+  F0F7                          ; Панель видима?
 29+  F0F7 3A 56 F7                 ld      a, (state.panelA_info)
 30+  F0FA
 31+  F0FA              loadAndPrint:
 32+  F0FA A7                       and     a
 33+  F0FB C2 04 F1                 jp nz,  loadAndPrint_2
