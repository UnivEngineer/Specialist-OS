 29+  E817              formatCalled:
 30+  E817                          ; Выводим строку с кнопками
 31+  E817                          COLOR   COLOR_HELP_F
 31+  E817             >        IF ENABLE_COLOR
 31+  E817 3E 60       >            ld a, COLOR_HELP_F
 31+  E819 32 F8 FF    >            ld (IO_COLOR), a
 31+  E81C             >        ENDIF
 32+  E81C 0E 1F                    ld      c, 1Fh  ; очистка экрана
 33+  E81E CD 09 C8                 call    bios_printChar
 34+  E821 21 FF 01                 ld      hl, 1FFh
 35+  E824 22 FC 8F                 ld      (bios_vars.cursorY), hl
 36+  E827 21 FB F4                 ld      hl, aF1LeftF2RighF3
