 24+  ED83              tapeWrite_1:
 25+  ED83                          ; Сдвинуть d
 26+  ED83 7A                       ld    a, d
 27+  ED84 07                       rlca
 28+  ED85 57                       ld    d, a
 29+  ED86
 30+  ED86                          ; Вывести бит на ленту
 31+  ED86 E6 01                    and   1
 32+  ED88 F6 0E                    or    0Eh
 33+  ED8A 32 E3 FF                 ld    (IO_KEYB_MODE),a
 34+  ED8D 5F                       ld    e, a
 35+  ED8E
 36+  ED8E                          ; Задержка
 37+  ED8E CD 00 ED                 call  writeDelay
 38+  ED91
 39+  ED91                          ; Вывести инверсный бит на магнитофон
 40+  ED91 7B                       ld    a, e
 41+  ED92 EE 01                    xor   1
 42+  ED94 32 E3 FF                 ld    (IO_KEYB_MODE),a
 43+  ED97
 44+  ED97                          ; Задержка
 45+  ED97 CD 00 ED                 call  writeDelay
 46+  ED9A
 47+  ED9A                          ; Повторить 8 раз
 48+  ED9A 0D                       dec   c
