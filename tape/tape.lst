303+  0000              ; Буферы в памяти
304+  0000              ;-----------------------------------------------------------------------
305+  0000
306+  0000              ; Дисковый кэш
307+  0000              FAT_CACHE_ADDR = 0FB00h ; адрес кэша секторов fat в памяти
308+  0000              FAT_CACHE_SIZE = 1024   ; размер кэша в байтах
309+  0000              FAT_CACHE_CAPACITY = FAT_CACHE_SIZE / SECTOR_SIZE   ; сколько секторов вмещается в кэш
310+  0000
