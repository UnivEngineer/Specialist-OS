 18   ED06                  INCLUDE "tapeRead.inc"
# file opened: D:\Projects\Specialist-OS\tape\tapeRead.inc
  1+  ED06              ;+---------------------------------------------------------------------------
  2+  ED06              ; MXOS
  3+  ED06              ; Чтение байта с ленты
  4+  ED06              ;
  5+  ED06              ; На входе
  6+  ED06              ;  a=255 пропуск пилот-тона до байта до E6h, загрузка первого байта после
  7+  ED06              ;  a=8   загрузка байта (8 бит)
  8+  ED06              ;
  9+  ED06              ; На выходе
 10+  ED06              ;  c - байт
 11+  ED06              ;  de, hl - сохраняются
 12+  ED06              ;
 13+  ED06              ; 2013-12-12 Дизассемблировано vinxru
 14+  ED06              ;----------------------------------------------------------------------------
 15+  ED06
 16+  ED06              tapeRead:   ; Сохраняем регистры
 17+  ED06 C5                       push  bc
 18+  ED07 D5                       push  de
 19+  ED08
 20+  ED08                          ; Тут будет принятый байт
 21+  ED08 0E 00                    ld    c, 0
 22+  ED0A
 23+  ED0A                          ; d=8 если загрузка (счетчик бит) или 0FFh если ожидание
 24+  ED0A 57                       ld    d, a
 25+  ED0B
 26+  ED0B              tapeRead_0: ; Получаем состояние
 27+  ED0B                          ; Счётчик отсутствия фронтов. Если лента остановлена или
 28+  ED0B                          ; файловое окно эмулятора отменено, периодически проверяем
 29+  ED0B                          ; обычную клавиатуру. При нормальном фронте полного сканирования нет.
 30+  ED0B 06 00                    ld    b, 0
 31+  ED0D 3A E1 FF                 ld    a, (IO_KEYB_B)
 32+  ED10 E6 01                    and   1
 33+  ED12 5F                       ld    e, a
 34+  ED13
 35+  ED13                          ; Сдвигаем c
 36+  ED13 79                       ld    a, c
 37+  ED14 E6 7F                    and   7Fh
 38+  ED16 07                       rlca
 39+  ED17 4F                       ld    c, a
 40+  ED18
 41+  ED18              tapeRead_1: ; Получаем состояние
 42+  ED18 3A E1 FF                 ld    a, (IO_KEYB_B)
 43+  ED1B
 44+  ED1B                          ; Если нажата клавиша, выходим
 45+  ED1B FE 80                    cp    80h
 46+  ED1D DA A2 ED                 jp c, tapeReadError
 47+  ED20
 48+  ED20                          ; Ждем изменения сигнала
 49+  ED20 E6 01                    and   1
 50+  ED22 BB                       cp    e
 51+  ED23 C2 40 ED                 jp nz, tapeRead_edge
 52+  ED26
 53+  ED26 05                       dec   b
 54+  ED27 C2 18 ED                 jp nz, tapeRead_1
 55+  ED2A
 56+  ED2A                          ; Около 8,5 мс без фронта при 2 МГц. Полное сканирование
 57+  ED2A                          ; клавиатуры выполняется только при остановившемся сигнале.
 58+  ED2A CD 12 C8                 call  bios_keyCheck
 59+  ED2D FE FF                    cp    0FFh
 60+  ED2F C2 A2 ED                 jp nz, tapeReadError
 61+  ED32 CD FF E9                 call  tapePrepareHardware
 62+  ED35 3A E1 FF                 ld    a, (IO_KEYB_B)
 63+  ED38 E6 01                    and   1
 64+  ED3A 5F                       ld    e, a
 65+  ED3B 06 00                    ld    b, 0
 66+  ED3D C3 18 ED                 jp    tapeRead_1
 67+  ED40
 68+  ED40                          ; Сохраняем бит
 69+  ED40              tapeRead_edge:
 70+  ED40 B1                       or    c
 71+  ED41 4F                       ld    c, a
 72+  ED42
 73+  ED42                          ; Задержка
 74+  ED42 CD 74 ED                 call  readDelay
 75+  ED45
 76+  ED45 3A E1 FF                 ld    a, (IO_KEYB_B)
 77+  ED48 E6 01                    and   1
 78+  ED4A 5F                       ld    e, a
 79+  ED4B
 80+  ED4B                          ; Если происходит загрузка данных, переходим на tapeRead_4
 81+  ED4B 7A                       ld    a, d
 82+  ED4C B7                       or    a
 83+  ED4D F2 69 ED                 jp p, tapeRead_4
 84+  ED50
 85+  ED50                          ; Если происходит ожидание
 86+  ED50                          ; Если не найден 0E6h, переходим tapeRead_2
 87+  ED50 79                       ld    a, c
 88+  ED51 FE E6                    cp    0E6h
 89+  ED53 C2 5D ED                 jp nz,  tapeRead_2
 90+  ED56
 91+  ED56                          ; Начинаем загрузку без инверсии
 92+  ED56 AF                       xor   a
 93+  ED57 32 F3 8F                 ld    (bios_vars.tapeInverse),a
 94+  ED5A C3 67 ED                 jp    tapeRead_3
 95+  ED5D
 96+  ED5D              tapeRead_2: ; Если не найден 19h, переходим на tapeRead_0
 97+  ED5D FE 19                    cp    19h
 98+  ED5F C2 0B ED                 jp nz,  tapeRead_0
 99+  ED62
100+  ED62                          ; Начинаем загрузку с инверсией
101+  ED62 3E FF                    ld    a, 0FFh
102+  ED64 32 F3 8F                 ld    (bios_vars.tapeInverse),a
103+  ED67
104+  ED67                          ; Загружаем 8 бит
105+  ED67 16 09        tapeRead_3: ld    d, 9
106+  ED69
107+  ED69                          ; Повторяем 8 байт
108+  ED69 15           tapeRead_4: dec   d
109+  ED6A C2 0B ED                 jp nz,  tapeRead_0
110+  ED6D
111+  ED6D                          ; Инверсия байта
112+  ED6D 3A F3 8F                 ld    a, (bios_vars.tapeInverse)
113+  ED70 A9                       xor   c
114+  ED71
115+  ED71                          ; Восстаналиваем регистры
116+  ED71 D1                       pop   de
117+  ED72 C1                       pop   bc
118+  ED73 C9                       ret
119+  ED74
