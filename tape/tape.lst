278+  0000              ;-----------------------------------------------------------------------
279+  0000              ; Информация об активном накопителе (диске)
280+  0000              ;-----------------------------------------------------------------------
281+  0000
282+  0000                  STRUCT DISK_INFO
283+  0000 ~            sectorSize          BLOCK   2   ; размер сектора, байт (256, 512, 1024)
284+  0000 ~            sectorsPerCluster   BLOCK   2   ; размер кластера, секторов (1, 2, 4, 8)
285+  0000 ~            resSectors          BLOCK   2   ; сколько секторов занимает зарезервированная область = первый сектор таблицы fat
286+  0000 ~            fatSectors          BLOCK   2   ; сколько секторов занимает таблица fat
287+  0000 ~            dirSectors          BLOCK   2   ; сколько секторов занимает корневой каталог
288+  0000 ~            totalSectors        BLOCK   2   ; сколько всего секторов на диске
289+  0000 ~            rootDirMaxFiles     BLOCK   2   ; максимум файлов в корневом каталоге
290+  0000 ~            descrPerSector      BLOCK   2   ; сколько дескрипторов файлов вмещается в один сектор
291+  0000 ~            fatNumCells         BLOCK   2   ; количество ячеек в таблице fat (= fatSectors * sectorSize / 2)
292+  0000 ~            dirStartSector      BLOCK   2   ; первый сектор корневого каталога
293+  0000 ~            dataStartSector     BLOCK   2   ; первый сектор области данных
294+  0000 ~            volumeLabel         BLOCK  12   ; метка тома и 0 в конце
295+  0000 ~            isValid             BLOCK   1   ; 0 = нет драйвера, 1 = диск не распознан, 2 = диск распознан, корректно отформатирован
296+  0000                  ENDS
297+  0000
298+  0000              DISK_NO_DRIVER = 0
299+  0000              DISK_INVALID   = 1
300+  0000              DISK_VALID     = 2
