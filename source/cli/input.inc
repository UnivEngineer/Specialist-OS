;----------------------------------------------------------------------------
; MXOS
;
; Принять команду в однострочном редакторе CLI.
;
; вход:
;   CMD_LINE доступен для записи, экранный курсор установлен после приглашения.
;
; выход:
;   В CMD_LINE находится строка с завершающим нулём. Возвращается код завершающей
;   клавиши в a. Escape очищает редактируемую строку. bc, de и hl рабочие.
;----------------------------------------------------------------------------

cliInput:
    xor a
    ld (cliHistoryBrowse),a
    ld hl,CMD_LINE
    ld de,CMD_LINE
    ld bc,0
    jp lineEdit
    DEFINE LINEEDIT_HISTORY
    INCLUDE "../include/lineedit.inc"
