; Общий хвост MAIN, DOS и EXEC в IO.SYS. Исполняется в текущей странице.
    ASSERT $ <= io_pitRead
    DS io_pitRead-$,0
    ASSERT IO_TIMER_CH1 == IO_TIMER_CH0+PIT_CH1
    ASSERT IO_TIMER_CH2 == IO_TIMER_CH0+PIT_CH2
    ASSERT IO_TIMER_MODE == IO_TIMER_CH0+PIT_CONTROL

;----------------------------------------------------------------------------
; MXOS
;
; Защёлкнуть счётчик 2 и прочитать одно согласованное 16-битное значение.
;
; вход:
;   ВИ53 настроен на чтение младшего, затем старшего байта.
;
; выход:
;   HL = значение счётчика, A = его младший байт. BC, DE и флаги сохранены.
;   54 такта с RET, 71 с CALL и RET.
;----------------------------------------------------------------------------

    ld hl,IO_TIMER_MODE
    ld (hl),080h
    dec hl
    ld a,(hl)
    ld h,(hl)
    ld l,a
    ret

;----------------------------------------------------------------------------
; MXOS
;
; Получить адрес регистров программируемого таймера текущей платформы.
;
; вход:
;   Параметров нет.
;
; выход:
;   CF=0, HL = адрес канала 0 в памяти. Для профиля IN/OUT контракт задаёт
;   CF=1, L = порт канала 0 и H=0. A, BC и DE сохранены.
;   Регистры каналов 1, 2 и управления следуют подряд за каналом 0.
;----------------------------------------------------------------------------

    ASSERT $ == io_pitGetPort
    ld hl,IO_TIMER_CH0
    or a
    ret
    ASSERT $ == MEM_IMAGE_LOCAL_START
