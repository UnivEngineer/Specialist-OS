; Аппаратные процедуры ВВ55 из MAIN-сегмента IO.SYS.
    INCLUDE "timer-hardware.inc"

;+---------------------------------------------------------------------------
; MXOS
; Звуковой сигнал (вызывается при выводе кода 7)
;
; Исторические GETCH и BEL используют программный сигнал через PC5.
; Каналы ВИ53 сохраняют настройку вызывающей программы. Все регистры сохраняются.
;
; 2013-12-12 Дизассемблировано vinxru
;----------------------------------------------------------------------------

beep:       ; Сохраняем все регистры. de не используется ниже
            push  af
            push  bc
            push  hl

            ; Частота и длительность сигнала
            ld    hl, (bios_vars.beepFreq)

beep_0:     ; Единицу на динамик
            ld    a, 0Bh
            ld    (IO_KEYB_MODE),a

            ; Задержка l тактов
            call  delay_l

            ; Ноль на динамик
            ld    a, 0Ah
            ld    (IO_KEYB_MODE),a

            ; Задержка l тактов
            call  delay_l

            ; Повторяем h раз
            dec   h
            jp nz,  beep_0

            ; Ничего не делаем
            nop

            ; Восстаналиваем все регистры и выходим. de не используется
            pop   hl
            pop   bc
            pop   af
            ret

;----------------------------------------------------------------------------
; MXOS
;
; Считать контакты Ctrl/ПС и вернуть ВВ55 к опросу всей матрицы.
;
; вход:
;   Параметров нет.
;
; выход:
;   D = инверсная выборка строк при замкнутом столбце Ctrl/ПС.
;   A = 82h. BC, E, HL и флаги сохранены.
;----------------------------------------------------------------------------

ioKeyReadCtrl:
            ld    a,083h
            ld    (IO_KEYB_MODE),a
            ld    a,0F7h
            ld    (IO_KEYB_A),a
            ld    a,(IO_KEYB_B)
            cpl
            ld    d,a

;----------------------------------------------------------------------------
; MXOS
;
; Установить режим 82h или 91h клавиатурного ВВ55.
;
; вход:
;   Параметров нет.
;
; выход:
;   A = записанный режим, BC, DE, HL и флаги сохранены.
;----------------------------------------------------------------------------

ioKeyMode82:
            ld    a,082h
            ld    (IO_KEYB_MODE),a
            ret

ioKeyMode91:
            ld    a,091h
            ld    (IO_KEYB_MODE),a
            ret

;----------------------------------------------------------------------------
; MXOS
;
; Считать порт B клавиатурного ВВ55 в установленном режиме.
;
; вход:
;   ВВ55 настроен вызывающим.
;
; выход:
;   A = уровни контактов порта B, BC, DE, HL и флаги сохранены.
;----------------------------------------------------------------------------

ioKeyReadRows:
            ld    a,(IO_KEYB_B)
            ret

;----------------------------------------------------------------------------
; MXOS
;
; Сбросить три канала ВИ53 и выключить программный звук через PC5.
;
; вход:
;   Параметров нет.
;
; выход:
;   Выходы ВИ53 отключены, PC5 сброшен, A = 0Ah.
;   BC, DE, HL и флаги сохранены.
;----------------------------------------------------------------------------

ioResetSound:
            ld    a,0B6h
            ld    (IO_TIMER_MODE),a
            ld    a,076h
            ld    (IO_TIMER_MODE),a
            ld    a,036h
            ld    (IO_TIMER_MODE),a
            ld    a,00Ah
            ld    (IO_KEYB_MODE),a
            ret
