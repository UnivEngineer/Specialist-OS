; Физический мост A:, компонуется в BIOS. F240h — JMP из MEM.
mainBlockIO:
    or a
    jp z,mainIoBad
    ld (io_vars.romBufferPage),a
    ex de,hl
    ld (mainIoCopy+1),hl
    ld a,(io_vars.romBufferPage)
    ld (mainIoCopy),a
    xor a
    ld (mainIoCopy+3),a
    ld hl,mainIoRequest
    ld (mainIoCopy+4),hl
    ld hl,5
    ld (mainIoCopy+6),hl
    ld hl,mainIoCopy
    call bankCopyFar
    jp c,mainIoBad
    ; Границы физического носителя и локального буфера до переключения ROM.
    ld a,(mainIoRequest)
    dec a
    cp 2
    jp nc,mainIoDispatch
    ld b,3
    ld a,SYSTEM_DRIVE
    call bios_blockIO
    jp c,mainIoFailed
    ex de,hl
    ld a,h
    ld (io_vars.romBlocksHi),a
    ex de,hl
    ld hl,(mainIoRequest+1)
    call bios_cmp_hl_de
    jp nc,mainIoBad
    ld hl,(mainIoRequest+3)
    ld a,h
    cp 0FEh
    jp c,mainIoDispatch
    jp nz,mainIoBad
    ld a,l
    or a
    jp nz,mainIoBad
mainIoDispatch:
    ld a,(mainIoRequest)
    cp 3
    jp z,mainIoQuery
    cp 0FFh
    jp z,mainIoQuery
    cp 2
    jp z,mainIoRead
    dec a
    jp nz,mainIoBad
    ; Прямую запись выполняем только для установленного AT29C-драйвера.
    ld b,0FFh
    ld a,SYSTEM_DRIVE
    call bios_blockIO
    jp c,mainIoFailed
    ld a,b
    cp DISK_TECH_MX_SYSTEM_FLASH
    jp nz,mainIoFailed
    ; Сначала полный сектор в верхнюю MAIN, затем штатный AT29-драйвер.
    ld a,(io_vars.romBufferPage)
    ld (mainIoCopy),a
    ld hl,(mainIoRequest+3)
    ld (mainIoCopy+1),hl
    xor a
    ld (mainIoCopy+3),a
    ld hl,BIOS_DISK_BUFFER
    ld (mainIoCopy+4),hl
    ld hl,256
    ld (mainIoCopy+6),hl
    ld hl,mainIoCopy
    call bankCopySector
    jp c,mainIoFailed
    ld hl,(mainIoRequest+1)
    ex de,hl
    ld hl,BIOS_DISK_BUFFER
    ld b,1
    ld a,SYSTEM_DRIVE
    call bios_blockIO
    ret nc
    jp mainIoFailed
