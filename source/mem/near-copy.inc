;----------------------------------------------------------------------------
; MXOS
;
; Скопировать диапазон внутри текущей страницы с учётом перекрытия.
;
; вход:
;   HL = проверенный MEM_COPY_REQUEST в текущей странице или общем окне.
;   Установлен полный профиль MEM и действителен стек инициатора.
;
; выход:
;   A=0, CF=0. BC/DE/HL разрушены, банк, SP и окно сохранены.
;----------------------------------------------------------------------------
memNativeCopy:
    inc hl
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    inc hl
    ld c,(hl)
    inc hl
    ld b,(hl)
    inc hl
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    add hl,de
    ex de,hl
    call bankUnifiedCore
    xor a
    ret
