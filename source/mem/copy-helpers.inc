    IFDEF COPY_HELPER_BYTES

;----------------------------------------------------------------------------
; MXOS
;
; Скопировать подряд байты вперёд в текущей странице.
;
; вход:
;   hl = источник, de = назначение, b = число байт; ноль кодирует 256. Назначение не
;   должно затирать ещё не прочитанные данные.
;
; выход:
;   hl и de указывают за скопированными данными. b = 0, z = 1, a = последний байт, c и
;   cf сохранены.
;----------------------------------------------------------------------------

memCopyBytesBody:
    ld a,(hl)
    ld (de),a
    inc hl
    inc de
    dec b
    jp nz,memCopyBytesBody
    ret

    ELSE
; Известные пакеты 8/32 байта: B=число четвёрок, HL -> DE.
; Произвольный размер по-прежнему обслуживает memCopyBytesBody.

;----------------------------------------------------------------------------
; MXOS
;
; Скопировать подряд группы по четыре байта без переключения страниц.
;
; вход:
;   hl = источник, de = назначение, b = число четвёрок; ноль кодирует 256 четвёрок.
;   Допустимо прямое копирование.
;
; выход:
;   hl и de сдвинуты на фактическую длину, b = 0, z = 1. a = последний байт; c и cf
;   сохранены.
;----------------------------------------------------------------------------

memCopyQuadsBody:
    DUP 4
    ld a,(hl)
    ld (de),a
    inc hl
    inc de
    EDUP
    dec b
    jp nz,memCopyQuadsBody
    ret

    ENDIF
