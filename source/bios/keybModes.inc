; Фиксированные входы Загрузчика C254h/C25Ah, единственные тела процедур.
; Вход: нет. Выход: A=82h/91h; BC/DE/HL и флаги сохраняются.
; Каждая: 6 байт, 30 тактов без CALL, одна запись в ВВ55.
; Адрес ВВ55 пока MX; аппаратный STD-контракт — следующий этап.

;----------------------------------------------------------------------------
; MXOS
;
; Установить режим 82h для клавиатурного ВВ55.
;
; вход:
;   Регистровых параметров нет.
;
; выход:
;   В IO_KEYB_MODE записано 82h, a = 82h. bc, de, hl и флаги сохранены.
;----------------------------------------------------------------------------

setKeybMode82:
            ld      a, 82h
            ld      (IO_KEYB_MODE),a
            ret

; ---------------------------------------------------------------------------

;----------------------------------------------------------------------------
; MXOS
;
; Установить режим 91h для клавиатурного ВВ55.
;
; вход:
;   Регистровых параметров нет.
;
; выход:
;   В IO_KEYB_MODE записано 91h, a = 91h. bc, de, hl и флаги сохранены.
;----------------------------------------------------------------------------

setKeybMode91:
            ld      a, 91h
            ld      (IO_KEYB_MODE),a
            ret

