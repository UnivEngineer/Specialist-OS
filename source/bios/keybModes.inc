; Фиксированные входы Загрузчика C254h/C25Ah ведут в MAIN IO.
; Входа нет. A=82h/91h, BC/DE/HL и флаги сохранены.
; Размер каждого слота 6 байт. Вход добавляет 10 тактов к телу IO.

;----------------------------------------------------------------------------
; MXOS
;
; Установить режим 82h для клавиатурного ВВ55.
;
; вход:
;   Регистровых параметров нет.
;
; выход:
;   В IO_KEYB_MODE записано 82h, a = 82h. bc, de, hl и флаги сохранены.
;----------------------------------------------------------------------------

setKeybMode82:
    DOS_ABI_GATE bios_setKeybMode82, ioKeyMode82, 1
    DS 3,0

; ---------------------------------------------------------------------------

;----------------------------------------------------------------------------
; MXOS
;
; Установить режим 91h для клавиатурного ВВ55.
;
; вход:
;   Регистровых параметров нет.
;
; выход:
;   В IO_KEYB_MODE записано 91h, a = 91h. bc, de, hl и флаги сохранены.
;----------------------------------------------------------------------------

setKeybMode91:
    DOS_ABI_GATE bios_setKeybMode91, ioKeyMode91, 1
    DS 3,0

