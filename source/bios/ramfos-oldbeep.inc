;----------------------------------------------------------------------------
; MXOS
;
; Программный сигнал с историческими параметрами RAMFOS.
;
; вход:
;   C64Eh/C64Fh содержат задержку и число повторов.
;
; выход:
;   Сигнал PC5 завершён, AF, BC, DE, HL и флаги сохранены.
;----------------------------------------------------------------------------

ramfosOldBeep:
    push af
    push bc
    push hl
    ld hl,(ramfos_oldBeep)
    jp beep_0
