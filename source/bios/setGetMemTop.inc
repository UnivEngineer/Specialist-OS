;+---------------------------------------------------------------------------
; MXOS
; C830h: установить верхнюю доступную границу памяти, как в Monitor-2.
;
; На входе
;  HL - новая граница (любое 16-битное значение).
;
; На выходе
;  AF/BC/DE/HL и флаги сохраняются. Изменяется только v_memTop.
;  4 байта, 26 тактов без входного JP/CALL, одна запись слова в RAM.
;
; 2013-12-12 Дизассемблировано vinxru
;----------------------------------------------------------------------------

setMemTop:  ld    (v_memTop), hl
            ret

;----------------------------------------------------------------------------
; C833h: получить верхнюю доступную границу памяти, как в Monitor-2.
;
; На выходе
;  HL - сохранённая граница памяти.
;
; Сохраняются AF/BC/DE и флаги; изменяется HL.
; 4 байта, 26 тактов без входного JP/CALL, одно чтение слова из RAM.
;----------------------------------------------------------------------------
            
getMemTop:  ld    hl, (v_memTop)
            ret

