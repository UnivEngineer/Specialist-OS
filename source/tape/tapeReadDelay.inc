;----------------------------------------------------------------------------
; MXOS
;
; Выдержать программную задержку магнитофона по настройке BIOS.
;
; вход:
;   bios_vars.readDelay = байтовый счётчик. Нулевое значение соответствует 256
;   итерациям.
;
; выход:
;   a = исходный счётчик, b = 0, z = 1. c, de, hl и cf сохранены.
;
; 2013-12-12 Дизассемблировано vinxru
;----------------------------------------------------------------------------

readDelay:  ld    a, (bios_vars.readDelay)

;----------------------------------------------------------------------------
; MXOS
;
; Выдержать заданное число итераций общего цикла чтения и записи.
;
; вход:
;   a = число итераций, ноль задаёт 256.
;
; выход:
;   b = 0, z = 1. a, c, de, hl и cf сохранены.
;----------------------------------------------------------------------------

delay_a:    ld    b, a
delay_l_0:  dec   b
            jp nz,  delay_l_0
            ret

