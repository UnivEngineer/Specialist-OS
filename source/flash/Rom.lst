130+  0000              bios_printChar          = 0C809h ; Вывод символа на экран
131+  0000              bios_tapeWrite          = 0C80Ch ; Запись байта на магнитофон
132+  0000              bios_input              = 0C80Fh ; Ввод строки с клавиатуры
133+  0000              bios_keyCheck           = 0C812h ; Получить код нажатой клавиши, = bios_keyScan
134+  0000              bios_printHexByte       = 0C815h ; Вывод HEX числа на экран (байт)
135+  0000              bios_printString        = 0C818h ; Вывод строки на экран
136+  0000              bios_keyScan            = 0C81Bh ; Получить код нажатой клавиши
137+  0000              bios_getCursorPos       = 0C81Eh ; Получить координаты курсора в hl (координаты в пикселях)
138+  0000              bios_setCursorPos       = 0C821h ; Установить координаты курсора из hl (координаты в пикселях)
139+  0000              bios_tapeLoad           = 0C824h ; Загрузить программу с магнитофона
140+  0000              bios_tapeSave           = 0C827h ; Сохранить программу на магнитофон
