168   DE79                  ASSERT_DONT_FIT 0E000h
168   DE79             >         IF $ > 0E000h
168   DE79 ~           >           ASSERT 0
168   DE79 ~           >           DISPLAY /l, "Error! Image did not fit (", $, " > ", adr, ")"
