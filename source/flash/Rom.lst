 16   0000
 17   0000              ; Команды для дрыгания ножками ВВ55
 18   0000              LATCH_0 = 0Ah   ; пин защёлки ИР22 = 0
 19   0000              LATCH_1 = 0Bh   ; пин защёлки ИР22 = 1
 20   0000              WRITE_0 = 0Ch   ; пин записи = 0
 21   0000              WRITE_1 = 0Dh   ; пин записи = 1
 22   0000              READ_0  = 0Eh   ; пин чтения = 0
 23   0000              READ_1  = 0Fh   ; пин чтения = 1
 24   0000
 25   0000              ; Маски управляющих пинов ВВ55
 26   0000              MASK_STADBY = 0C0h  ; пин защёлки ИР22 = 0, пин записи = 1, пин чтения = 1
 27   0000              MASK_READ   = 040h  ; пин защёлки ИР22 = 0, пин записи = 1, пин чтения = 0
 28   0000
 29   0000              ; Накопитель, куда назначается драйвер
 30   0000              DRIVE       = 7     ; "H"
 31   0000
 32   0000              ; Объем накопителя по умолчанию (64 кб)
 33   0000              DISK_SECTORS = 64 * 4
 34   0000
 35   0000              ; Схема ром-диска:
 36   0000              ; Порт A - данные (ввод)
 37   0000              ; Порт B - адрес [A0-A7]  (вывод)
 38   0000              ; Порт C - адрес [A8-A15] (вывод)
 39   0000              ; Вывод С6 порта клавиатуры (пин 11) - включение ПЗУ (лог. 1)
 40   0000
 41   0000              ;----------------------------------------------------------------------------
 42   0000
 43   0000                  ORG     0DE00h
 44   DE00
 45   DE00                  ; Установить драйвер для накопителя 7 ("H")
 46   DE00 3E 07            ld      a, DRIVE
 47   DE02 21 0C DE         ld      hl, Driver
 48   DE05 CD 60 C8         call    bios_installDriver
 49   DE08
 50   DE08                  ; Запоминаем адрес структуры DISK_INFO и выходим
 51   DE08 22 77 DE         ld      (v_diskInfo), hl
 52   DE0B C9               ret
 53   DE0C
 54   DE0C              Driver:
 55   DE0C
 56   DE0C                  ; Анализ номера функции
 57   DE0C 78               ld      a, b
 58   DE0D FE 01            cp      1
 59   DE0F C2 17 DE         jp nz,  DriverNotWrite
 60   DE12 32 F9 8F         ld      (bios_vars.diskWriteErr), a
 61   DE15 37               scf
 62   DE16 C9               ret                 ; запись - не поддерживается
 63   DE17              DriverNotWrite:
 64   DE17 FE 02            cp      2
 65   DE19 CA 40 DE         jp z,   FuncRead    ; чтение
 66   DE1C FE 03            cp      3
 67   DE1E CA 22 DE         jp z,   FuncSize    ; размер
 68   DE21 C9               ret                 ; иначе выход
 69   DE22
 70   DE22              ;-----------------------------------------------------------------------------------
 71   DE22              ; Функция 3 - определение объема накопителя
 72   DE22              ; выход:
 73   DE22              ;  de = количество секторов (1 - диск не отформатирован)
 74   DE22
 75   DE22              FuncSize:
 76   DE22                  ; Читаем поле isValid из структуры DISK_INFO
 77   DE22 2A 77 DE         ld      hl, (v_diskInfo)            ; hl = адрес структуры
 78   DE25 11 22 00         ld      de, DISK_INFO.isValid       ; de = смещение поля
 79   DE28 19               add     hl, de                      ; hl = адрес поля
 80   DE29 7E               ld      a, (hl)                     ; a = isValid
 81   DE2A
 82   DE2A                  ; Если диск не отформатирован, возвращаем de = DISK_SECTORS
 83   DE2A 11 00 01         ld      de, DISK_SECTORS
 84   DE2D FE 02            cp      DISK_VALID
 85   DE2F C2 3C DE         jp nz,  fsExit
 86   DE32
 87   DE32                  ; Иначе возвращаем в de поле totalSectors из структуры DISK_INFO
 88   DE32 2A 77 DE         ld      hl, (v_diskInfo)            ; hl = адрес структуры
 89   DE35 11 0A 00         ld      de, DISK_INFO.totalSectors  ; de = смещение поля
 90   DE38 19               add     hl, de                      ; hl = адрес поля
 91   DE39 5E               ld      e, (hl)
 92   DE3A 23               inc     hl
 93   DE3B 56               ld      d, (hl)
 94   DE3C
 95   DE3C              fsExit:
 96   DE3C                  ; Возвращаем в hl адрес структуры DISK_INFO
 97   DE3C 2A 77 DE         ld      hl, (v_diskInfo)
 98   DE3F C9               ret
 99   DE40
100   DE40              ;----------------------------------------------------------------------------
101   DE40              ; Функция 2 - чтение сектора
102   DE40              ; вход:
103   DE40              ;   de = номер сектора
104   DE40              ;   hl = адрес буфера в памяти
105   DE40
106   DE40              FuncRead:
107   DE40                  ; Сохранение регистров
108   DE40 E5               push    hl
109   DE41 D5               push    de
110   DE42 C5               push    bc
111   DE43
112   DE43                  ; Настройка портов ВВ55
113   DE43 3E 90            ld      a, 90h              ; порт A - ввод, порты B и C - вывод
114   DE45 32 E7 FF         ld      (IO_PROG_MODE), a
115   DE48 3E 0D            ld      a, 0Dh              ; вывод С6 порта клавиатуры = 1
116   DE4A 32 E3 FF         ld      (IO_KEYB_MODE), a
117   DE4D
118   DE4D                  ; de = адрес начала сектора в 64к странице ром-диска
119   DE4D                  ; а номер страницы (d) теряется, т.к. поддерживается только одна страница
120   DE4D 53               ld      d, e
121   DE4E 1E 00            ld      e, 0
122   DE50
123   DE50              ReadLoop:
124   DE50 EB               ex      de, hl          ; hl = адрес в ПЗУ, de = адрес в памяти
125   DE51 22 E5 FF         ld      (IO_PROG_B), hl ; порт B = младший байт адреса, порт C = старший байт адреса
126   DE54 3A E4 FF         ld      a, (IO_PROG_A)  ; a = байт из ПЗУ
127   DE57 EB               ex      de, hl          ; hl = адрес в памяти, de = адрес в ПЗУ
128   DE58 77               ld      (hl), a         ; сохраняем байт в память
129   DE59 23               inc     hl              ; следующий адрес в памяти
130   DE5A 1C               inc     e               ; следующий адрес в ПЗУ
131   DE5B C2 50 DE         jp nz,  ReadLoop        ; повтор цикла, пока адрес в ПЗУ не пересечет XX00h
132   DE5E
133   DE5E                  ; Восстановление портов, регистров и выход
134   DE5E F5               push    af
135   DE5F 3E 0C            ld      a, 0Ch          ; вывод С6 порта клавиатуры = 0
136   DE61 32 E3 FF         ld      (IO_KEYB_MODE), a
137   DE64 3E 9B            ld      a, 9Bh          ; Порты A, B, C - ввод
138   DE66 32 E7 FF         ld      (IO_PROG_MODE), a
139   DE69 F1               pop     af
140   DE6A C1               pop     bc
141   DE6B D1               pop     de
142   DE6C E1               pop     hl
143   DE6D C9               ret
144   DE6E
145   DE6E              ;----------------------------------------------------------------------------
146   DE6E              ; Чтение байта из чипа флеш памяти
147   DE6E              ; вход:
148   DE6E              ;   de = адрес в 64к странице
149   DE6E              ; выход:
150   DE6E              ;   a  = байт данных
151   DE6E              ;   пин чтения остаётся активным (C7 = 0)
152   DE6E
153   DE6E              ReadByteFromChip:
154   DE6E EB               ex      de, hl
155   DE6F 22 E5 FF         ld      (IO_PROG_B), hl
156   DE72 3A E4 FF         ld      a, (IO_PROG_A)
157   DE75 EB               ex      de, hl
158   DE76 C9               ret
159   DE77
