226+  0000              ; Структура файловой системы
227+  0000              ;-----------------------------------------------------------------------
228+  0000
229+  0000              ; Структура каталога
230+  0000              FILE_DESCR_SIZE  = 32   ; размер дескриптора файла в каталоге (байт)
231+  0000              FILE_NAME_LENGTH = 8    ; длина имени файла  (байт)
232+  0000              FAT_ITEM_SIZE    = 2    ; размер записи в таблице FAT (байт)
233+  0000
234+  0000              SECTOR_SIZE  = 00100h   ; размер сектора 256 байт
235+  0000              CLUSTER_SIZE = 00100h   ; размер кластера 256 байт
236+  0000
237+  0000              ; Специальные коды кластеров FAT
238+  0000              FAT12_BAD = 00FF7h  ; плохой кластер
239+  0000              FAT16_BAD = 0FFF7h
240+  0000              FAT12_EOC = 00FFFh  ; последний кластер файла
241+  0000              FAT16_EOC = 0FFFFh
242+  0000              FAT12_RES = 00FFFh  ; зарезервированный кластер
243+  0000              FAT16_RES = 0FFFFh
244+  0000
245+  0000              ;-----------------------------------------------------------------------
246+  0000              ; Десткриптор файла (одна запись в каталоге) FAT12/16/32
247+  0000              ;-----------------------------------------------------------------------
248+  0000
249+  0000                  STRUCT FILE_DESCRIPTOR  ; 32 байта
250+  0000 ~            name            BLOCK   FILE_NAME_LENGTH    ; смещение 00h, 8 байт  - имя файла
251+  0000 ~            ext             BLOCK   3                   ; смещение 08h, 3 байта - расширение имени файла
252+  0000 ~            attrib          BLOCK   1                   ; смещение 0Bh, 1 байт  - атрибуты файла
253+  0000 ~            ntReserved      BLOCK   1                   ; смещение 0Ch, 1 байт  - используются в Windows NT
254+  0000 ~            createTimeTenth BLOCK   1                   ; смещение 0Dh, 1 байт  - (только FAT32) время создания файла, десятки миллисекунд (0-199)
255+  0000 ~            createTime      BLOCK   2                   ; смещение 0Eh, 2 байта - (только FAT32) время создания файла, секунды*2 (0-43200)
256+  0000 ~            createDate      BLOCK   2                   ; смещение 10h, 2 байта - (только FAT32) дата  создания файла
257+  0000 ~            loadAddress     BLOCK   2  ; accDate        ; смещение 12h, 2 байта - начальный адрес загрузки в ОЗУ, он же и стартовый (!!! временный костыль, в FAT32 это accDate - дата доступа к файлу !!!)
258+  0000 ~            firstClusterHi  BLOCK   2                   ; смещение 14h, 2 байта - номер первого кластера в FAT, старшее слово
259+  0000 ~            writeTime       BLOCK   2                   ; смещение 16h, 2 байта - время модификации файла, секунды*2 (0-43200)
260+  0000 ~            writeDate       BLOCK   2                   ; смещение 18h, 2 байта - дата  модификации файла
261+  0000 ~            firstCluster    BLOCK   2                   ; смещение 1Ah, 2 байта - номер первого кластера в FAT, младшее слово
262+  0000 ~            size            BLOCK   4                   ; смещение 1Ch, 4 байта - размер файла в байтах
263+  0000                  ENDS
264+  0000
265+  0000              ;-----------------------------------------------------------------------
266+  0000              ; Информация о файле (компактный вариант дескриптора)
267+  0000              ; Почти совместимо с дескриптором оригинального Коммандера
268+  0000              ;-----------------------------------------------------------------------
269+  0000
270+  0000              FILE_INFO_SIZE = 16     ; размер структуры (байт)
271+  0000
272+  0000                  STRUCT FILE_INFO    ; 16 байт
273+  0000 ~            name            BLOCK   FILE_NAME_LENGTH    ; смещение 00h, 8 байт  - имя файла
274+  0000 ~            ext             BLOCK   3                   ; смещение 08h, 3 байта - расширение имени файла
275+  0000 ~            attrib          BLOCK   1                   ; смещение 0Bh, 1 байт  - атрибуты файла
276+  0000 ~            loadAddress     BLOCK   2                   ; смещение 0Eh, 2 байта - начальный адрес загрузки в ОЗУ, он же и стартовый
277+  0000 ~            size            BLOCK   2                   ; смещение 0Ch, 2 байта - размер файла в байтах
278+  0000                  ENDS
279+  0000
280+  0000              ;-----------------------------------------------------------------------
281+  0000              ; Информация об активном накопителе (диске)
282+  0000              ;-----------------------------------------------------------------------
283+  0000
284+  0000                  STRUCT DISK_INFO
285+  0000 ~            sectorSize          BLOCK   2   ; размер сектора, байт (256, 512, 1024)
286+  0000 ~            sectorsPerCluster   BLOCK   2   ; размер кластера, секторов (1, 2, 4, 8)
287+  0000 ~            resSectors          BLOCK   2   ; сколько секторов занимает зарезервированная область = первый сектор таблицы fat
288+  0000 ~            fatSectors          BLOCK   2   ; сколько секторов занимает таблица fat
289+  0000 ~            dirSectors          BLOCK   2   ; сколько секторов занимает корневой каталог
290+  0000 ~            totalSectors        BLOCK   2   ; сколько всего секторов на диске
291+  0000 ~            rootDirMaxFiles     BLOCK   2   ; максимум файлов в корневом каталоге
292+  0000 ~            descrPerSector      BLOCK   2   ; сколько дескрипторов файлов вмещается в один сектор
293+  0000 ~            fatNumCells         BLOCK   2   ; количество ячеек в таблице fat (= fatSectors * sectorSize / 2)
294+  0000 ~            dirStartSector      BLOCK   2   ; первый сектор корневого каталога
295+  0000 ~            dataStartSector     BLOCK   2   ; первый сектор области данных
296+  0000 ~            volumeLabel         BLOCK  12   ; метка тома и 0 в конце
297+  0000 ~            isValid             BLOCK   1   ; 0 = нет драйвера, 1 = диск не распознан, 2 = диск распознан, корректно отформатирован
298+  0000                  ENDS
299+  0000
300+  0000              DISK_NO_DRIVER = 0
301+  0000              DISK_INVALID   = 1
302+  0000              DISK_VALID     = 2
303+  0000
304+  0000              ;-----------------------------------------------------------------------
305+  0000              ; Буферы в памяти
306+  0000              ;-----------------------------------------------------------------------
307+  0000
308+  0000              ; Дисковый кэш
309+  0000              FAT_CACHE_ADDR = 0FB00h ; адрес кэша секторов fat в памяти
310+  0000              FAT_CACHE_SIZE = 1024   ; размер кэша в байтах
311+  0000              FAT_CACHE_CAPACITY = FAT_CACHE_SIZE / SECTOR_SIZE   ; сколько секторов вмещается в кэш
312+  0000
313+  0000              ; Буфер для загрузки BAT файла
314+  0000                  IF NEW_MEMORY_MAP
315+  0000              BAT_BUFFER = 0E800h
316+  0000                  ELSE
317+  0000 ~            BAT_BUFFER = 0FC00h
318+  0000                  ENDIF
319+  0000
320+  0000              ; Командная строка и стек
321+  0000              CMD_LINE   = 0FF00h  ; 192 байта, но в конце стек
322+  0000              STACK_ADDR = 0FFC0h  ; стек
323+  0000
324+  0000              ;-----------------------------------------------------------------------
325+  0000              ; Всякие полезности
326+  0000              ;-----------------------------------------------------------------------
327+  0000
328+  0000              ; Макрос для заполнения памяти от текущего адреса до указанного
329+  0000                  MACRO ORG_PAD adr
330+  0000 ~                     IF $ > adr
331+  0000 ~                       ; вывод сообщения об ошибке
332+  0000 ~                       ASSERT 0
333+  0000 ~                       DISPLAY /l, "Error! ORG_PAD failed! ", $, " is more than ", adr
334+  0000 ~                     ELSE
335+  0000 ~                       ; заполнение памяти
336+  0000 ~                       BLOCK adr-$, 0FFh
337+  0000 ~                     ENDIF
338+  0000 ~                     ORG adr
339+  0000                  ENDM
340+  0000
341+  0000                  MACRO ORG_PAD0 adr
342+  0000 ~                     IF $ > adr
343+  0000 ~                       ; вывод сообщения об ошибке
344+  0000 ~                       ASSERT 0
345+  0000 ~                       DISPLAY /l, "Error! ORG_PAD0 failed! ", $, " is more than ", adr
346+  0000 ~                     ELSE
347+  0000 ~                       ; заполнение памяти
348+  0000 ~                       BLOCK adr-$, 0
349+  0000 ~                     ENDIF
350+  0000 ~                     ORG adr
351+  0000                  ENDM
352+  0000
353+  0000              ; Макросы для проверки текущего адреса
354+  0000                  MACRO ASSERT_EQUAL adr
355+  0000 ~                     IF $ != adr
356+  0000 ~                       ASSERT 0
357+  0000 ~                       DISPLAY /l, "Error! Entry point has been shifted (", $, " != ", adr, ")"
358+  0000 ~                     ENDIF
359+  0000                  ENDM
360+  0000
361+  0000                  MACRO ASSERT_DONT_FIT adr
362+  0000 ~                     IF $ > adr
363+  0000 ~                       ASSERT 0
364+  0000 ~                       DISPLAY /l, "Error! Image did not fit (", $, " > ", adr, ")"
365+  0000 ~                     ENDIF
366+  0000                  ENDM
367+  0000
