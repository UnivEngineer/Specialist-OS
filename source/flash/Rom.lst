# file opened: D:\Projects\Specialist-OS\source\flash\Rom.asm
  1   0000              ;----------------------------------------------------------------------------
  2   0000              ; MXOS
  3   0000              ; ROM.COM - драйвер ром-диска через ВВ55
  4   0000              ; Адаптация оригинального DISK-H.COM
  5   0000              ; Прддерживается только одна 64к страница
  6   0000              ;
  7   0000              ; Драйвер имеет три функции (номер передаётся в регистре b):
  8   0000              ;   b == 1 - записать сектор (256 байт, номер сектора в de, адрес буфера в hl);
  9   0000              ;   b == 2 - считать  сектор (256 байт, номер сектора в de, адрес буфера в hl);
 10   0000              ;   b == 3 - выдать размер диска в секторах (резльтат в de, адрес DISK_INFO в hl).
 11   0000              ;
 12   0000              ; 2022-02-15 Разработано SpaceEngineer
 13   0000              ;----------------------------------------------------------------------------
 14   0000
 15   0000                  INCLUDE "../include/mxos.inc"
# file opened: D:\Projects\Specialist-OS\source\flash\../include/mxos.inc
  1+  0000              ;-----------------------------------------------------------------------
  2+  0000              ; MXOS
  3+  0000              ; Точки входа и настройки сборки MXOS
  4+  0000              ;
  5+  0000              ; Новая карта памяти:
  6+  0000              ;   8FDF-8FFF - [  32 B] Переменные
  7+  0000              ;   9000-BFFF - [12  KB] Экран
  8+  0000              ;   C000-DBFF - [7168 B] DOS.SYS
  9+  0000              ;   DC00-DDFF - [ 512 B] драйверные расширения (например, FlashSys.com)
 10+  0000              ;   DE00-DFFF - [ 512 B] Драйвер флеш-диска
 11+  0000              ;   E000-E7FF - [2048 B] Шрифт
 12+  0000              ;   E800-FAFF - [4864 B] Системные программы (NC.COM, E.COM, DL-RED.COM, FORMAT.COM, MON2.COM, ...)
 13+  0000              ;   FB00-FEFF - [1024 B] Дисковый кэш (fat + каталог)
 14+  0000              ;   FF00-FF81 - [ 130 B] Командная строка
 15+  0000              ;   FF82-FFBF - [  62 B] Стек
 16+  0000              ;   FFC0-FFEF - [  32 B] Непереключаемое ОЗУ, драйвер обмена с RAM диском
 17+  0000              ;   FFE0-FFFF - [  32 B] Оборудование
 18+  0000              ;
 19+  0000              ; Старая карта памяти:
 20+  0000              ;   8FDF-8FFF - [  32 B] Переменные
 21+  0000              ;   9000-BFFF - [12  KB] Экран
 22+  0000              ;   C000-CFFF - [4096 B] DOS.SYS
 23+  0000              ;   D000-E1FF - [4607 B] Системные программы (NC.COM, E.COM, DL-RED.COM)
 24+  0000              ;   E200-E5FF - [1024 B] Свободно (1024 байт)
 25+  0000              ;   E600-E7FF - [ 512 B] Драйвер магнитофона
 26+  0000              ;   E800-E8FF - [ 256 B] Свободно (256 байт)
 27+  0000              ;   E900-F0FF - [2048 B] Шрифт (можно отключить запуском ROMFNT.COM или опцией LOAD_FONT=0)
 28+  0000              ;   F100-F8FF - [2048 B] Системные программы (FORMAT.COM, MON2.COM, ...)
 29+  0000              ;   F900-F9FF - [ 256 B] Свободно (256 байт)
 30+  0000              ;   FA00-FAFF - [ 256 B] Драйвер флеш-диска
 31+  0000              ;   FB00-FEFF - [1024 B] Дисковый буфер (fat + каталог)
 32+  0000              ;   FF00-FF81 - [ 130 B] Командная строка
 33+  0000              ;   FF82-FFBF - [  62 B] Стек
 34+  0000              ;   FFC0-FFEF - [  32 B] Непереключаемое ОЗУ, драйвер обмена с RAM диском
 35+  0000              ;   FFE0-FFFF - [  32 B] Оборудование
 36+  0000              ;-----------------------------------------------------------------------
 37+  0000
 38+  0000
 39+  0000              ;-----------------------------------------------------------------------
 40+  0000              ; Конфигурация сборки
 41+  0000              ;-----------------------------------------------------------------------
 42+  0000
 43+  0000              NEW_MEMORY_MAP       =  1       ; Новая карта памяти
 44+  0000              RAMD_MAX_PAGE        =  16      ; Максимальное количество страниц RAM диска
 45+  0000              RAMD_PAGE_END        =  0FFBBh  ; Включить поддержку ДОЗУ большего чем 64 Кб
 46+  0000              ROM_64K              =  1       ; Включить поддержку ПЗУ 64 Кб Специалиста МХ2
 47+  0000              ENABLE_COLOR         =  1       ; Включить поддержку цвета
 48+  0000              EMBED_FONT           =  0       ; Встроить шрифт в программу (при запуске шрифт копируется на FONT_ADDR)
 49+  0000              LOAD_FONT            =  1       ; Загружать шрифт в ОЗУ
 50+  0000              COLOR_BIOS           =  0F0h    ; Цвет командной строки
 51+  0000              RAMFOS_COMPATIBILITY =  1       ; Совместимость с RAMFOS (WIP)
 52+  0000              BOOT_FROM_TAPE       =  0       ; Включить загрузку с ленты при нажатой клавише после сброса
 53+  0000
 54+  0000                  IF  NEW_MEMORY_MAP
 55+  0000              FONT_ADDR = 0E000h  ; Адрес шрфита
 56+  0000                  ELSE
 57+  0000 ~            FONT_ADDR = 0E900h  ; Адрес шрфита
 58+  0000                  ENDIF
 59+  0000
 60+  0000                  IF  LOAD_FONT
 61+  0000              FONT_ADDR_DIV_8 = FONT_ADDR/8
 62+  0000                  ELSE
 63+  0000 ~            FONT_ADDR_DIV_8 = -1
 64+  0000                  ENDIF
 65+  0000
 66+  0000              ;-----------------------------------------------------------------------
 67+  0000              ; Переменные ОС в подэкранном пространстве и их начальные значения
 68+  0000              ; Доступ к переменным из программ польователя:
 69+  0000              ; ld a, bios_vars.lastKey
 70+  0000              ;-----------------------------------------------------------------------
 71+  0000
 72+  0000                  STRUCT BIOS_VARIABLES
 73+  0000 ~            _reserv_1     DW      -1              ; 8FDFh -
 74+  0000 ~            tapeError     DW      0C800h          ; 8FE1h - Адрес, куда происходит переход при ошибке чтения с ленты
 75+  0000 ~            tapeAddr      DW      -1              ; 8FE3h - Адрес программы, загруженной с ленты
 76+  0000 ~            _reserv_2     DW      -1              ; 8FE5h -
 77+  0000 ~            charGen       DW      FONT_ADDR_DIV_8 ; 8FE7h - Адрес альтернативного знакогенератора / 8
 78+  0000 ~            cursorCfg     DB       21h ; 0A9h     ; 8FE9h - Внешний вид курсора (биты: 7 - мигание (если 0), 654 - положение (Y) от низа строки, 3210 - размер по высоте)
 79+  0000 ~            koi7          DB       0   ; 0FFh     ; 8FEAh - 0FFh = включен KOI-7, 0 = включен KOI-8
 80+  0000 ~            escMode       DB      -1              ; 8FEBh - Обработка ESC-последовательности
 81+  0000 ~            keyLocks      DB      0BAh ; 3Ah      ; 8FECh - Caps Lock или Рус/Lat (3A - прописные анг, BA - строчные анг, BB - прописные рус, 3B - строчные рус)
 82+  0000 ~            _reserv_3     DW      -1              ; 8FEDh -
 83+  0000 ~            lastLastKey   DB      -1              ; 8FEFh - Предпоследняя нажатая клавиша
 84+  0000 ~            lastKey       DB      -1              ; 8FF0h - Последняя нажатая клавиша
 85+  0000 ~            beepFreq      DB       5Fh            ; 8FF1h - Частота звукового сигнала (также влияет на длительность)
 86+  0000 ~            beepDuration  DB       20h            ; 8FF2h - Длительность звукового сигнала (сколько раз повторять посылку)
 87+  0000 ~            tapeInverse   DB      0FFh            ; 8FF3h - Признак инверсии данных с ленты
 88+  0000 ~            cursorDelay   DB       20h            ; 8FF4h - Задержка мигания курсора
 89+  0000 ~            antiBsDelay   DB      0E0h            ; 8FF5h - Задержка защиты от дребезга контактов клавиш
 90+  0000 ~            oldSP         DW      -1              ; 8FF6h - Используется для сохранения SP некоторыми функциями
 91+  0000 ~            ramPageCount  DB      RAMD_MAX_PAGE   ; 8FF8h - Количество детектированных 64кб страниц RAM-диска
 92+  0000 ~            diskWriteErr  DB       0              ; 8FF9h - Признак ошибки записи диска
 93+  0000 ~            inverse       DW       0              ; 8FFAh - Инвертирование текста (0=нормальный текст, 0FFFFh=инверсный)
 94+  0000 ~            cursorY       DB      -1              ; 8FFCh - Положение курсора по вертикали в пикселях
 95+  0000 ~            cursorX       DB      -1              ; 8FFDh - Положение курсора по горизонтали в пикселях / 2
 96+  0000 ~            writeDelay    DB      28h             ; 8FFEh - Скорость при записи на ленту
 97+  0000 ~            readDelay     DB      3Ch             ; 8FFFh - Скорость при чтении с ленты
 98+  0000                  ENDS
 99+  0000
100+  0000              ; Блок переменных BIOS начинается с адреса 8FDFh
101+  0000              bios_vars   BIOS_VARIABLES = 8FDFh
