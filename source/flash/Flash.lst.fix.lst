233   DF00              DisableWriteProtection:
234   DF00 D5               push    de
235   DF01 3E AA            ld      a, 0AAh
236   DF03 11 55 55         ld      de, 05555h
237   DF06 CD 3B DF         call    WriteByteToChip
238   DF09 3E 55            ld      a, 055h
239   DF0B 11 AA 2A         ld      de, 02AAAh
240   DF0E CD 3B DF         call    WriteByteToChip
241   DF11 3E A0            ld      a, 0A0h
242   DF13 11 55 55         ld      de, 05555h
243   DF16 CD 3B DF         call    WriteByteToChip
244   DF19 D1               pop     de
245   DF1A C9               ret
246   DF1B
247   DF1B              LatchHiAddr:
248   DF1B 3E 0B            ld      a, LATCH_1
249   DF1D 32 E7 FF         ld      (IO_PROG_MODE), a
250   DF20 7A               ld      a, d
251   DF21 32 E5 FF         ld      (IO_PROG_B), a
252   DF24 3E 0A            ld      a, LATCH_0
