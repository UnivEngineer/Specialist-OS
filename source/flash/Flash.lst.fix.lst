  6   0000              ;   b=1 - Р·Р°РїРёСЃСЊ СЃРµРєС‚РѕСЂР°, de=РЅРѕРјРµСЂ, hl=Р±СѓС„РµСЂ;
  7   0000              ;   b=2 - С‡С‚РµРЅРёРµ СЃРµРєС‚РѕСЂР°, de=РЅРѕРјРµСЂ, hl=Р±СѓС„РµСЂ;
