191+  0000
192+  0000              bios_RAMDRead   = 0FFC0h ; п/п чтения из ДОЗУ
193+  0000              bios_RAMDWrite  = 0FFD0h ; п/п записи в  ДОЗУ
194+  0000
195+  0000              ;-----------------------------------------------------------------------
