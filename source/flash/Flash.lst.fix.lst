225+  0000              ;-----------------------------------------------------------------------
226+  0000              ; Структура файловой системы
227+  0000              ;-----------------------------------------------------------------------
228+  0000
229+  0000              ; Структура каталога
230+  0000              FILE_DESCR_SIZE  = 32   ; размер дескриптора файла в каталоге (байт)
231+  0000              FILE_NAME_LENGTH = 8    ; длина имени файла  (байт)
232+  0000              FAT_ITEM_SIZE    = 2    ; размер записи в таблице FAT (байт)
233+  0000
234+  0000              SECTOR_SIZE  = 00100h   ; размер сектора 256 байт
235+  0000              CLUSTER_SIZE = 00100h   ; размер кластера 256 байт
236+  0000
237+  0000              ; Специальные коды кластеров FAT
238+  0000              FAT12_BAD = 00FF7h  ; плохой кластер
239+  0000              FAT16_BAD = 0FFF7h
240+  0000              FAT12_EOC = 00FFFh  ; последний кластер файла
241+  0000              FAT16_EOC = 0FFFFh
242+  0000              FAT12_RES = 00FFFh  ; зарезервированный кластер
243+  0000              FAT16_RES = 0FFFFh
244+  0000
245+  0000              ;-----------------------------------------------------------------------
246+  0000              ; Десткриптор файла (одна запись в каталоге) FAT12/16/32
247+  0000              ;-----------------------------------------------------------------------
248+  0000
249+  0000                  STRUCT FILE_DESCRIPTOR  ; 32 байта
250+  0000 ~            name            BLOCK   FILE_NAME_LENGTH    ; смещение 00h, 8 байт  - имя файла
251+  0000 ~            ext             BLOCK   3                   ; смещение 08h, 3 байта - расширение имени файла
252+  0000 ~            attrib          BLOCK   1                   ; смещение 0Bh, 1 байт  - атрибуты файла
253+  0000 ~            ntReserved      BLOCK   1                   ; смещение 0Ch, 1 байт  - используются в Windows NT
254+  0000 ~            createTimeTenth BLOCK   1                   ; смещение 0Dh, 1 байт  - (только FAT32) время создания файла, десятки миллисекунд (0-199)
255+  0000 ~            createTime      BLOCK   2                   ; смещение 0Eh, 2 байта - (только FAT32) время создания файла, секунды*2 (0-43200)
256+  0000 ~            createDate      BLOCK   2                   ; смещение 10h, 2 байта - (только FAT32) дата  создания файла
257+  0000 ~            loadAddress     BLOCK   2  ; accDate        ; смещение 12h, 2 байта - начальный адрес загрузки в ОЗУ, он же и стартовый (!!! временный костыль, в FAT32 это accDate - дата доступа к файлу !!!)
258+  0000 ~            firstClusterHi  BLOCK   2                   ; смещение 14h, 2 байта - номер первого кластера в FAT, старшее слово
259+  0000 ~            writeTime       BLOCK   2                   ; смещение 16h, 2 байта - время модификации файла, секунды*2 (0-43200)
260+  0000 ~            writeDate       BLOCK   2                   ; смещение 18h, 2 байта - дата  модификации файла
261+  0000 ~            firstCluster    BLOCK   2                   ; смещение 1Ah, 2 байта - номер первого кластера в FAT, младшее слово
262+  0000 ~            size            BLOCK   4                   ; смещение 1Ch, 4 байта - размер файла в байтах
263+  0000                  ENDS
264+  0000
265+  0000              ;-----------------------------------------------------------------------
266+  0000              ; Информация о файле (компактный вариант дескриптора)
267+  0000              ; Почти совместимо с дескриптором оригинального Коммандера
268+  0000              ;-----------------------------------------------------------------------
269+  0000
270+  0000              FILE_INFO_SIZE = 16     ; размер структуры (байт)
271+  0000
272+  0000                  STRUCT FILE_INFO    ; 16 байт
273+  0000 ~            name            BLOCK   FILE_NAME_LENGTH    ; смещение 00h, 8 байт  - имя файла
274+  0000 ~            ext             BLOCK   3                   ; смещение 08h, 3 байта - расширение имени файла
275+  0000 ~            attrib          BLOCK   1                   ; смещение 0Bh, 1 байт  - атрибуты файла
276+  0000 ~            loadAddress     BLOCK   2                   ; смещение 0Eh, 2 байта - начальный адрес загрузки в ОЗУ, он же и стартовый
277+  0000 ~            size            BLOCK   2                   ; смещение 0Ch, 2 байта - размер файла в байтах
278+  0000                  ENDS
279+  0000
280+  0000              ;-----------------------------------------------------------------------
281+  0000              ; Информация об активном накопителе (диске)
282+  0000              ;-----------------------------------------------------------------------
283+  0000
284+  0000                  STRUCT DISK_INFO
285+  0000 ~            sectorSize          BLOCK   2   ; размер сектора, байт (256, 512, 1024)
286+  0000 ~            sectorsPerCluster   BLOCK   2   ; размер кластера, секторов (1, 2, 4, 8)
287+  0000 ~            resSectors          BLOCK   2   ; сколько секторов занимает зарезервированная область = первый сектор таблицы fat
288+  0000 ~            fatSectors          BLOCK   2   ; сколько секторов занимает таблица fat
289+  0000 ~            dirSectors          BLOCK   2   ; сколько секторов занимает корневой каталог
290+  0000 ~            totalSectors        BLOCK   2   ; сколько всего секторов на диске
291+  0000 ~            rootDirMaxFiles     BLOCK   2   ; максимум файлов в корневом каталоге
292+  0000 ~            descrPerSector      BLOCK   2   ; сколько дескрипторов файлов вмещается в один сектор
293+  0000 ~            fatNumCells         BLOCK   2   ; количество ячеек в таблице fat (= fatSectors * sectorSize / 2)
294+  0000 ~            dirStartSector      BLOCK   2   ; первый сектор корневого каталога
295+  0000 ~            dataStartSector     BLOCK   2   ; первый сектор области данных
296+  0000 ~            volumeLabel         BLOCK  12   ; метка тома и 0 в конце
297+  0000 ~            isValid             BLOCK   1   ; 0 = нет драйвера, 1 = диск не распознан, 2 = диск распознан, корректно отформатирован
298+  0000                  ENDS
299+  0000
300+  0000              DISK_NO_DRIVER = 0
301+  0000              DISK_INVALID   = 1
302+  0000              DISK_VALID     = 2
303+  0000
304+  0000              ;-----------------------------------------------------------------------
305+  0000              ; Буферы в памяти
306+  0000              ;-----------------------------------------------------------------------
307+  0000
308+  0000              ; Дисковый кэш
309+  0000              FAT_CACHE_ADDR = 0FB00h ; адрес кэша секторов fat в памяти
310+  0000              FAT_CACHE_SIZE = 1024   ; размер кэша в байтах
311+  0000              FAT_CACHE_CAPACITY = FAT_CACHE_SIZE / SECTOR_SIZE   ; сколько секторов вмещается в кэш
312+  0000
313+  0000              ; Буфер для загрузки BAT файла
314+  0000                  IF NEW_MEMORY_MAP
315+  0000              BAT_BUFFER = 0E800h
316+  0000                  ELSE
317+  0000 ~            BAT_BUFFER = 0FC00h
318+  0000                  ENDIF
319+  0000
320+  0000              ; Командная строка и стек
321+  0000              CMD_LINE   = 0FF00h  ; 192 байта, но в конце стек
322+  0000              STACK_ADDR = 0FFC0h  ; стек
323+  0000
324+  0000              ;-----------------------------------------------------------------------
325+  0000              ; Всякие полезности
326+  0000              ;-----------------------------------------------------------------------
327+  0000
328+  0000              ; Макрос для заполнения памяти от текущего адреса до указанного
329+  0000                  MACRO ORG_PAD adr
330+  0000 ~                     IF $ > adr
331+  0000 ~                       ; вывод сообщения об ошибке
332+  0000 ~                       ASSERT 0
333+  0000 ~                       DISPLAY /l, "Error! ORG_PAD failed! ", $, " is more than ", adr
334+  0000 ~                     ELSE
335+  0000 ~                       ; заполнение памяти
336+  0000 ~                       BLOCK adr-$, 0FFh
337+  0000 ~                     ENDIF
338+  0000 ~                     ORG adr
339+  0000                  ENDM
340+  0000
341+  0000                  MACRO ORG_PAD0 adr
342+  0000 ~                     IF $ > adr
343+  0000 ~                       ; вывод сообщения об ошибке
344+  0000 ~                       ASSERT 0
345+  0000 ~                       DISPLAY /l, "Error! ORG_PAD0 failed! ", $, " is more than ", adr
346+  0000 ~                     ELSE
347+  0000 ~                       ; заполнение памяти
348+  0000 ~                       BLOCK adr-$, 0
349+  0000 ~                     ENDIF
350+  0000 ~                     ORG adr
351+  0000                  ENDM
352+  0000
353+  0000              ; Макросы для проверки текущего адреса
354+  0000                  MACRO ASSERT_EQUAL adr
355+  0000 ~                     IF $ != adr
356+  0000 ~                       ASSERT 0
357+  0000 ~                       DISPLAY /l, "Error! Entry point has been shifted (", $, " != ", adr, ")"
358+  0000 ~                     ENDIF
359+  0000                  ENDM
360+  0000
361+  0000                  MACRO ASSERT_DONT_FIT adr
362+  0000 ~                     IF $ > adr
363+  0000 ~                       ASSERT 0
364+  0000 ~                       DISPLAY /l, "Error! Image did not fit (", $, " > ", adr, ")"
365+  0000 ~                     ENDIF
366+  0000                  ENDM
367+  0000
368+  0000              ;-----------------------------------------------------------------------
369+  0000              ; Конец
370+  0000              ;-----------------------------------------------------------------------
371+  0000
 15   0000
 16   0000              LATCH_0 = 00Ah
 17   0000              LATCH_1 = 00Bh
 18   0000              WRITE_0 = 00Ch
 19   0000              WRITE_1 = 00Dh
 20   0000
 21   0000              MASK_STANDBY = 0C0h
 22   0000              MASK_READ    = 040h
 23   0000
 24   0000              PPI_MODE_WRITE = 080h
 25   0000              PPI_MODE_READ  = 090h
 26   0000
 27   0000              DRIVE        = 7
 28   0000              DISK_SECTORS = 4 * 512 * 4
 29   0000
 30   0000              ;----------------------------------------------------------------------------
 31   0000
 32   0000                  ORG     0DE00h
 33   DE00
 34   DE00 3E 07            ld      a, DRIVE
 35   DE02 21 0C DE         ld      hl, Driver
 36   DE05 CD 60 C8         call    bios_installDriver
 37   DE08 22 56 DF         ld      (v_diskInfo), hl
 38   DE0B C9               ret
 39   DE0C
 40   DE0C              ;----------------------------------------------------------------------------
 41   DE0C
 42   DE0C              Driver:
 43   DE0C 78               ld      a, b
 44   DE0D FE 03            cp      3
 45   DE0F CA 29 DE         jp z,   FuncSize
 46   DE12
 47   DE12 E5               push    hl
 48   DE13 D5               push    de
 49   DE14 C5               push    bc
 50   DE15
 51   DE15 3D               dec     a
 52   DE16 CA 6B DE         jp z,   FuncWrite
 53   DE19 3D               dec     a
 54   DE1A CA 47 DE         jp z,   FuncRead
 55   DE1D 37               scf
 56   DE1E
 57   DE1E              Exit:
 58   DE1E F5               push    af
 59   DE1F 3E C0            ld      a, MASK_STANDBY
 60   DE21 32 E6 FF         ld      (IO_PROG_C), a
 61   DE24 F1               pop     af
 62   DE25 C1               pop     bc
 63   DE26 D1               pop     de
 64   DE27 E1               pop     hl
 65   DE28 C9               ret
 66   DE29
 67   DE29              ;----------------------------------------------------------------------------
 68   DE29
 69   DE29              FuncSize:
 70   DE29 2A 56 DF         ld      hl, (v_diskInfo)
 71   DE2C 11 22 00         ld      de, DISK_INFO.isValid
 72   DE2F 19               add     hl, de
 73   DE30 7E               ld      a, (hl)
 74   DE31
 75   DE31 11 00 20         ld      de, DISK_SECTORS
 76   DE34 FE 02            cp      DISK_VALID
 77   DE36 C2 43 DE         jp nz,  fsExit
 78   DE39
 79   DE39 2A 56 DF         ld      hl, (v_diskInfo)
 80   DE3C 11 0A 00         ld      de, DISK_INFO.totalSectors
 81   DE3F 19               add     hl, de
 82   DE40 5E               ld      e, (hl)
 83   DE41 23               inc     hl
 84   DE42 56               ld      d, (hl)
 85   DE43
 86   DE43              fsExit:
 87   DE43 2A 56 DF         ld      hl, (v_diskInfo)
 88   DE46 C9               ret
 89   DE47
 90   DE47              ;----------------------------------------------------------------------------
 91   DE47              ; Р§С‚РµРЅРёРµ СЃРµРєС‚РѕСЂР°.
 92   DE47
 93   DE47              FuncRead:
 94   DE47 3E 90            ld      a, PPI_MODE_READ
 95   DE49 32 E7 FF         ld      (IO_PROG_MODE), a
 96   DE4C
 97   DE4C 7A               ld      a, d
 98   DE4D E6 1F            and     01Fh
 99   DE4F F6 40            or      MASK_READ
100   DE51 32 E6 FF         ld      (IO_PROG_C), a
101   DE54
102   DE54 53               ld      d, e
103   DE55 1E 00            ld      e, 0
104   DE57 CD 1B DF         call    LatchHiAddr
105   DE5A
106   DE5A              ReadLoop:
107   DE5A 7B               ld      a, e
108   DE5B 32 E5 FF         ld      (IO_PROG_B), a
109   DE5E 3A E4 FF         ld      a, (IO_PROG_A)
110   DE61 77               ld      (hl), a
111   DE62 23               inc     hl
112   DE63 1C               inc     e
113   DE64 C2 5A DE         jp nz,  ReadLoop
114   DE67
115   DE67 B7               or      a
116   DE68 C3 1E DE         jp      Exit
117   DE6B
118   DE6B              ;----------------------------------------------------------------------------
119   DE6B              ; Р—Р°РїРёСЃСЊ СЃРµРєС‚РѕСЂР°.
120   DE6B
121   DE6B              FuncWrite:
122   DE6B                  ; РћСЂРёРіРёРЅР°Р»СЊРЅС‹Рµ Р°РґСЂРµСЃР° РЅСѓР¶РЅС‹ РґР»СЏ РїРѕР»РЅРѕР№ РїСЂРѕРІРµСЂРєРё РїРѕСЃР»Рµ РїСЂРѕРіСЂР°РјРјРёСЂРѕРІР°РЅРёСЏ.
123   DE6B E5               push    hl
124   DE6C D5               push    de
125   DE6D
126   DE6D 3E 80            ld      a, PPI_MODE_WRITE
127   DE6F 32 E7 FF         ld      (IO_PROG_MODE), a
128   DE72
129   DE72                  ; C4:C3 РІС‹Р±РёСЂР°СЋС‚ РјРёРєСЂРѕСЃС…РµРјСѓ; SDP РІСЃРµРіРґР° РїРѕСЃС‹Р»Р°РµС‚СЃСЏ РІ РµС‘ РЅСѓР»РµРІСѓСЋ Р±Р°РЅРєСѓ.
130   DE72 7A               ld      a, d
131   DE73 E6 18            and     018h
132   DE75 47               ld      b, a
133   DE76 CD 00 DF         call    DisableWriteProtection
134   DE79
135   DE79                  ; D[4:0] Р·Р°РґР°С‘С‚ A20:A16, E Р·Р°РґР°С‘С‚ A15:A8.
136   DE79 7A               ld      a, d
137   DE7A E6 1F            and     01Fh
138   DE7C 32 58 DF         ld      (v_pageSelect), a
139   DE7F F6 C0            or      MASK_STANDBY
140   DE81 32 E6 FF         ld      (IO_PROG_C), a
141   DE84
142   DE84 42               ld      b, d
143   DE85 53               ld      d, e
144   DE86 1E 00            ld      e, 0
145   DE88 CD 1B DF         call    LatchHiAddr
146   DE8B
147   DE8B              ; 22 Р±Р°Р№С‚Р°, 100 С‚Р°РєС‚РѕРІ/Р±Р°Р№С‚ = 50 РјРєСЃ РїСЂРё 2 РњР“С†, РјРµРЅСЊС€Рµ tBLC=150 РјРєСЃ.
148   DE8B              WriteLoop:
149   DE8B 7B               ld      a, e
150   DE8C 32 E5 FF         ld      (IO_PROG_B), a
151   DE8F 7E               ld      a, (hl)
152   DE90 32 E4 FF         ld      (IO_PROG_A), a
153   DE93 3E 0C            ld      a, WRITE_0
154   DE95 32 E7 FF         ld      (IO_PROG_MODE), a
155   DE98 3E 0D            ld      a, WRITE_1
156   DE9A 32 E7 FF         ld      (IO_PROG_MODE), a
157   DE9D 23               inc     hl
158   DE9E 1C               inc     e
159   DE9F C2 8B DE         jp nz,  WriteLoop
160   DEA2
161   DEA2                  ; РћР¶РёРґР°РµРј DQ7 РїРѕСЃР»РµРґРЅРµРіРѕ Р±Р°Р№С‚Р°. 768 С‡С‚РµРЅРёР№ РґР°СЋС‚ Р·Р°РїР°СЃ СЃРІС‹С€Рµ tWC=10 РјСЃ.
162   DEA2 2B               dec     hl
163   DEA3 4E               ld      c, (hl)
164   DEA4 1D               dec     e
165   DEA5
166   DEA5 3E 90            ld      a, PPI_MODE_READ
167   DEA7 32 E7 FF         ld      (IO_PROG_MODE), a
168   DEAA 06 03            ld      b, 3
169   DEAC 2E 00            ld      l, 0
170   DEAE              PollLoop:
171   DEAE C5               push    bc
172   DEAF 3A 58 DF         ld      a, (v_pageSelect)
173   DEB2 47               ld      b, a
174   DEB3 CD 2A DF         call    ReadByteFromChip
175   DEB6 C1               pop     bc
176   DEB7 A9               xor     c
177   DEB8 E6 80            and     080h
178   DEBA CA CA DE         jp z,   PollDone
179   DEBD 2D               dec     l
180   DEBE C2 AE DE         jp nz,  PollLoop
181   DEC1 05               dec     b
182   DEC2 C2 AE DE         jp nz,  PollLoop
183   DEC5
184   DEC5 D1               pop     de
185   DEC6 E1               pop     hl
186   DEC7 C3 F7 DE         jp      WriteFailed
187   DECA
188   DECA              PollDone:
189   DECA D1               pop     de
190   DECB E1               pop     hl
191   DECC CD D2 DE         call    VerifySector
192   DECF C3 1E DE         jp      Exit
193   DED2
194   DED2              ;----------------------------------------------------------------------------
195   DED2              ; РџРѕР»РЅРѕРµ СЃСЂР°РІРЅРµРЅРёРµ Р·Р°РїРёСЃР°РЅРЅРѕРіРѕ СЃРµРєС‚РѕСЂР° СЃ РёСЃС…РѕРґРЅС‹Рј Р±СѓС„РµСЂРѕРј.
196   DED2              ;
197   DED2              ; Р’С…РѕРґ: de=Р»РѕРіРёС‡РµСЃРєРёР№ СЃРµРєС‚РѕСЂ, hl=Р±СѓС„РµСЂ.
198   DED2
199   DED2              VerifySector:
200   DED2 3E 90            ld      a, PPI_MODE_READ
201   DED4 32 E7 FF         ld      (IO_PROG_MODE), a
202   DED7
203   DED7 7A               ld      a, d
204   DED8 E6 1F            and     01Fh
205   DEDA F6 40            or      MASK_READ
206   DEDC 32 E6 FF         ld      (IO_PROG_C), a
207   DEDF
208   DEDF 53               ld      d, e
209   DEE0 1E 00            ld      e, 0
210   DEE2 CD 1B DF         call    LatchHiAddr
211   DEE5
212   DEE5              VerifyLoop:
213   DEE5 7B               ld      a, e
214   DEE6 32 E5 FF         ld      (IO_PROG_B), a
215   DEE9 3A E4 FF         ld      a, (IO_PROG_A)
216   DEEC BE               cp      (hl)
217   DEED C2 F7 DE         jp nz,  WriteFailed
218   DEF0 23               inc     hl
219   DEF1 1C               inc     e
220   DEF2 C2 E5 DE         jp nz,  VerifyLoop
221   DEF5
222   DEF5 B7               or      a
223   DEF6 C9               ret
224   DEF7
225   DEF7              WriteFailed:
226   DEF7 3E 01            ld      a, 1
227   DEF9 32 F9 8F         ld      (bios_vars.diskWriteErr), a
228   DEFC 37               scf
229   DEFD C3 1E DE         jp      Exit
230   DF00
231   DF00              ;----------------------------------------------------------------------------
