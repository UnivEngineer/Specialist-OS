268   DF3E CD 1B DF         call    LatchHiAddr
269   DF41 7B               ld      a, e
270   DF42 32 E5 FF         ld      (IO_PROG_B), a
271   DF45 78               ld      a, b
272   DF46 F6 C0            or      MASK_STANDBY
273   DF48 32 E6 FF         ld      (IO_PROG_C), a
274   DF4B 3E 0C            ld      a, WRITE_0
275   DF4D 32 E7 FF         ld      (IO_PROG_MODE), a
276   DF50 3E 0D            ld      a, WRITE_1
277   DF52 32 E7 FF         ld      (IO_PROG_MODE), a
278   DF55 C9               ret
