 113+ 0000              bios_drawCursorOld      = 0C006h ; [OLD] Нарисовать/стереть курсор
 114+ 0000              bios_clearScreenOld     = 0C010h ; [OLD] Оистка экрана
 115+ 0000              bios_printCharOld       = 0C037h ; [OLD] Вывод символа на экран
 116+ 0000              bios_beep_Old           = 0C170h ; [OLD] Звуковой сигнал
 117+ 0000              bios_delay_l            = 0C18Fh ; [OLD] Задержка l циклов
 118+ 0000              bios_delay_b            = 0C190h ; [OLD] Задержка b циклов
 119+ 0000              bios_getchOld           = 0C337h ; [OLD] Ожидание ввода с клавиатуры
 120+ 0000              bios_tapeReadOld        = 0C377h ; [OLD] Чтение байта с магнитофона
 121+ 0000              bios_tapeWriteOld       = 0C3D0h ; [OLD] Запись байта на магнитофон
 122+ 0000              bios_cmp_hl_de          = 0C427h ; [OLD] Сравнить hl и de
 123+ 0000              bios_memcpy_bc_hl       = 0C42Dh ; [OLD] Скопировать блок памяти
 124+ 0000              bios_printStringOld     = 0C438h ; [OLD] Вывод строки на экран
 125+ 0000
 126+ 0000              ; Стандартные точки C800h
 127+ 0000              bios_reboot             = 0C800h ; Запустить NC.COM
 128+ 0000              bios_getch              = 0C803h ; Ожидание ввода с клавиатуры
 129+ 0000              bios_tapeRead           = 0C806h ; Чтение байта с магнитофона
 130+ 0000              bios_printChar          = 0C809h ; Вывод символа на экран
 131+ 0000              bios_tapeWrite          = 0C80Ch ; Запись байта на магнитофон
 132+ 0000              bios_input              = 0C80Fh ; Ввод строки с клавиатуры
 133+ 0000              bios_keyCheck           = 0C812h ; Получить код нажатой клавиши, = bios_keyScan
 134+ 0000              bios_printHexByte       = 0C815h ; Вывод HEX числа на экран (байт)
 135+ 0000              bios_printString        = 0C818h ; Вывод строки на экран
 136+ 0000              bios_keyScan            = 0C81Bh ; Получить код нажатой клавиши
 137+ 0000              bios_getCursorPos       = 0C81Eh ; Получить координаты курсора в hl (координаты в пикселях)
 138+ 0000              bios_setCursorPos       = 0C821h ; Установить координаты курсора из hl (координаты в пикселях)
 139+ 0000              bios_tapeLoad           = 0C824h ; Загрузить программу с магнитофона
 140+ 0000              bios_tapeSave           = 0C827h ; Сохранить программу на магнитофон
 141+ 0000              bios_calcCS             = 0C82Ah ; Расчет контрольной суммы
 142+ 0000              bios_printHexWord       = 0C82Dh ; Вывод HEX числа на экран (слово)
 143+ 0000              bios_getMemTop          = 0C830h ; Получить объем доступной памяти
 144+ 0000              bios_setMemTop          = 0C833h ; Установить объем доступной памяти
 145+ 0000              bios_printer            = 0C836h ; Напечатать байт на принтере
 146+ 0000                  IF RAMFOS_COMPATIBILITY
 147+ 0000              bios_strToHex           = 0C839h ; [MXOS2] Преобразвоние строки в HEX формате в число
 148+ 0000                  ELSE
 149+ 0000 ~            bios_rebootAlt          = 0C839h ; Запустить NC.COM
 150+ 0000                  ENDIF
 151+ 0000              bios_rebootAlt2         = 0C83Ch ; Запустить NC.COM
 152+ 0000              bios_fileList           = 0C83Fh ; Получить список файлов
 153+ 0000              bios_fileGetSetDrive    = 0C842h ; Получить/установить активное устройство
