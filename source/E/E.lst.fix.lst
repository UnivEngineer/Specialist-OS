 213  E95D FE 07                CP    07H               ; F8 - отмена изменений в строке
 214  E95F CA DF F1             JP    Z,keyHandler_F8
 215  E962 FE 01                CP    01H               ; F2 - курсор на страницу вверх (PageUp)
 216  E964 CA 5D ED             JP    Z,keyHandler_F2
 217  E967 FE 02                CP    02H               ; F3 - курсор на страницу вниз (PageDn)
 218  E969 CA 82 ED             JP    Z,keyHandler_F3
 219  E96C FE 20                CP    20H               ; пробел
 220  E96E D2 8C EB             JP    NC,keyHandler_Space
 221  E971 B7                   OR    A                 ; F1 - Ins (перекл. режима Insert/Overwrite)
 222  E972 CA DB EB             JP    Z,keyHandler_F1
 223  E975
 224  E975                      ; Теперь проходм по таблице подпрограмм
 225  E975 21 88 E9             LD    HL, KeyHendlerTable
 226  E978              fkh_Loop:
 227  E978 7E                   LD    A,(HL)        ; код клавиши
 228  E979 B7                   OR    A             ; если 0 - достигнут конец таблицы
 229  E97A CA 16 F2             JP    Z,Beep4       ; бип 4 раза и выход
 230  E97D 23                   INC   HL
 231  E97E 5E                   LD    E,(HL)        ; de = адрес подпрограммы
 232  E97F 23                   INC   HL
 233  E980 56                   LD    D,(HL)
 234  E981 23                   INC   HL
 235  E982 B9                   CP    C             ; сравниваем a и запомненный в с код клавиши
 236  E983 C2 78 E9             JP    NZ,fkh_Loop   ; если не равно, повтор цикла
 237  E986 D5                   PUSH  DE            ; алрес п/п - в стек
 238  E987 C9                   RET                 ; переход на адрес п/п
