 247  E988                      ; Таблица переходов на подпрограммы
 248  E988                      ; код символа, адрес
 249  E988              KeyHendlerTable:
 250  E988 1A 58 EA             KEY_HANDLER  1Ah, keyHandler_Down   ; Вниз      - курсор вниз
 251  E98B 19 82 EA             KEY_HANDLER  19h, keyHandler_Up     ; Вверх     - курсор вверх
 252  E98E 08 FD EA             KEY_HANDLER  08h, keyHandler_Left   ; Влево     - курсор влево
 253  E991 18 F2 EA             KEY_HANDLER  18h, keyHandler_Right  ; Вправо    - курсор вправо
 254  E994 0D 22 EB             KEY_HANDLER  0Dh, keyHandler_Enter  ; Enter     - вставить строку ниже (не разбивает текущую строку!)
 255  E997 09 05 ED             KEY_HANDLER  09h, keyHandler_Tab    ; Tab       - курсор на 4 (8) позиций влево, с привязкой по сетке (?)
 256  E99A 1F E5 E9             KEY_HANDLER  1Fh, keyHandler_CTP    ; СТР       - выход без сохранения!
 257  E99D 02 F8 E9             KEY_HANDLER  02h, keyHandler_F3_2   ; F3 снова?
 258  E9A0 06 7A F0             KEY_HANDLER  06h, keyHandler_F7     ; F7        - поиск текста в строке курсора и ниже (перематывает документ на строку с текстом)
 259  E9A3 0C 1D EB             KEY_HANDLER  0Ch, keyHandler_Home   ; Home      - курсор в начало строки
 260  E9A6 0A 0D EB             KEY_HANDLER  0Ah, keyHandler_End    ; End (ПС)  - курсор в конец строки
 261  E9A9 1B AD E9             KEY_HANDLER  1Bh, keyHandler_Esc    ; Esc       - режим Esc-последовательности
 262  E9AC 00                   DB  00H
