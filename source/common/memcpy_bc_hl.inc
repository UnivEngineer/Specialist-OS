;----------------------------------------------------------------------------
; MXOS
;
; Фиксированный вход C42Dh.
; Перенести диапазон памяти с учётом перекрытия.
;
; вход:
;   hl = начало источника, de = первый адрес за ним, bc = начало назначения. Стек и
;   исполняемый код должны находиться вне переносимых данных.
;
; выход:
;   hl = конец источника, bc = адрес за последним записанным байтом. de сохранён, af
;   изменяется.
;----------------------------------------------------------------------------

memcpy_bc_hl:
            push    de
            call    moveCore
            pop     de
            ret
