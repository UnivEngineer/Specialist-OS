;----------------------------------------------------------------------------
; MXOS
;
; Сравнить два беззнаковых слова, начиная со старших байтов.
;
; вход:
;   hl и de = сравниваемые значения.
;
; выход:
;   z = 1 при равенстве, cf = 1 при hl < de. hl, de и bc сохранены. В a остаётся
;   последний сравнивавшийся байт hl.
;
; 2013-12-12 Дизассемблировано vinxru
;----------------------------------------------------------------------------

cmp_hl_de:
        ld    a, h
        cp    d
        ret   nz
        ld    a, l
        cp    e
        ret

