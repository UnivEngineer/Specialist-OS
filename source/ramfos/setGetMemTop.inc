;----------------------------------------------------------------------------
; RAMFOS
;
; Прочитать верхнюю границу памяти RAMFOS.
;
; вход:
;   Параметров нет. Граница хранится в слове v_memTop.
;
; выход:
;   hl = текущая граница. af, bc, de и флаги сохранены.
;
; Стандартная точка входа C830
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

getMemTop:	ld hl, (v_memTop)
		ret

;----------------------------------------------------------------------------
; RAMFOS
;
; Изменить верхнюю границу памяти RAMFOS.
;
; вход:
;   hl = новая граница, записываемая в v_memTop.
;
; выход:
;   v_memTop содержит переданное значение. Все регистры и флаги сохранены.
;
; Стандартная точка входа C833
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

setMemTop:	ld (v_memTop), hl
		ret

