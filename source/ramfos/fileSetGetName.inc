;+---------------------------------------------------------------------------
; RAMFOS
; Стандартная точка входа F845
; Получение имени последнего загруженного файла
;
; вход:
;   hl = адрес доступного для записи буфера на 12 байт.
;
; выход:
;   12 байт из v_header2_name скопированы в буфер. AF, BC, DE и HL сохранены.
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

fileGetName:	push hl
		push de
		push bc
		ld de, v_header2_name
		ex de, hl
		jp fileSetName_0

;----------------------------------------------------------------------------
; RAMFOS
; Стандартная точка входа F848
; Установить имя для функций сохранения и поиска.
;
; вход:
;   hl = адрес 12-байтового поля имени.
;
; выход:
;   12 байт скопированы в v_header2_name. AF, BC, DE и HL сохранены.
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

fileSetName:	push hl
		push de
		push bc
		ld de, v_header2_name
fileSetName_0:	ld c, 11
		jp memcpy_popa
