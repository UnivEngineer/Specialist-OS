;+---------------------------------------------------------------------------
; RAMFOS
; Стандартная точка входа C82A
; Расчет контрольной суммы
;
; На входе
;  hl - начальный адрес
;  de - конечный адрес
;
; На выходе
;  bc - сумма
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

calcCrc:	ld bc, 0
calcCrc_0:	ld a, (hl)
		 add a, c
		 ld c, a
		 push af
		  call	cmp_hl_de
		  jp z, pop_psw_ret
		 pop af
		 ld a, b
		 adc a, (hl)
		 ld b, a
		 call	cmp_hl_de
		 ret z
		 inc hl
		jp calcCrc_0
