fileSetType:	push hl
		push de
		push bc
		 ld de, v_header2_ext
		 ld c, 2 ; Размер -1
memcpy_popa:	push af
		  call	memcpy_de_hl_c
		 pop af
		pop bc
		pop de
		pop hl
		ret
