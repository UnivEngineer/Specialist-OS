;+---------------------------------------------------------------------------
; RAMFOS
; Стандартная точка входа C836
; Ввод командной строки
;
; На входе
;  hl   - адрес буфера
;  d    - длина буфера
;  e=XX - режим без очистки знакоместа, можно двигаться вправо
;  e=00 - с очисткой знакоместа, вправо двигаться нельзя
;
; На выходе
;  a        - Последняя нажатая клавиша
;  jz       - Нажат ESC
;  jc       - Нажат Enter
;  jnz, jnc - Остальные функциональные кнопки
;  jp       - Строка пустая
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

input:		 ; Сохраняем BC, HL
		push bc
		push hl

		; Зачем, не понял
		ld bc, 8000h

input_inrc:	inc c ; Ниже мы уменьшим C
input_inrd:	inc d ; Ниже мы уменьшим D
input_ignore:	call	keyWait
		cp 7Fh
		jp z, input_ignore
		cp 8
		jp z, input_del ; При переходе на удаление C и D больше на единицу
		cp 0Dh
		jp z, input_enter ; Выход с флагами nz, c
		cp 1Fh
		jp z, input_esc ; Выход с флагами z, nc
		; Если не места для новых символов
		dec d
		jp z, input_inrd
		; Вправо
		cp 18h
		jp z, input_right ; На входе С больше на единицу
		; Остальные служебные клавиши - выход
		cp 20h
		inc d ; Устанавливаем флаги nz
		jp c, input_cmc ; Выход с флагами nz, nc
		dec d
		; Увеличиваем B
		inc b
input_chr:	 ; Вывод символа на экран
		call	printCharA
		; Сохранение символа в памяти
		ld (hl), a
		inc hl
		; Уменьшаем счетчик свободных байт
		dec d
		; Следующий символ
		jp input_inrc

; ---------------------------------------------------------------------------

input_enter:	or a ; Устанавливаем флаг - не нуль
		dec b ; Если были введены символы, то флаг минус
input_cmc:	ccf ; Инвертируем CF
input_esc:	 ; Восстанавливаем DE, BC
		pop de
		pop bc
		ret

; ---------------------------------------------------------------------------

input_right:	 ; Если режим 0, то вправо двигаться нельзя
		inc e
		dec e
		jp z, input_inrd

		; Если в буфере служебные символы, зменяем их на пробел и выводим
		ld a, ' '
		cp (hl)
		jp nc, input_chr

		; Если обычные символы, выводм
		ld a, (hl)
		jp input_chr

; ---------------------------------------------------------------------------

input_del:	 ; Перед вызовом D была увеличена на единицу, надо уменьшить
		dec d

		; Если ни одного байта не введено, выходим и увеличиваем С обратно
		dec c
		jp z, input_inrc

                ; Если режим 0, то вместо удаленного символа ставим пробел
		dec e
		inc e
		call z, printCharA ; На входе A=8
		ld a, ' '
		call z, printCharA

		; Курсор влево
		ld a, 8
		call	printCharA

		; Уменьшаем указатель
		dec hl

		; Увеличиваем длину
		inc d
		jp input_inrd
