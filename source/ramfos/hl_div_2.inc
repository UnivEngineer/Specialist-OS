;----------------------------------------------------------------------------
; RAMFOS
;
; Разделить беззнаковое слово на два логическим сдвигом.
;
; вход:
;   hl = делимое.
;
; выход:
;   hl = частное, cf = младший бит делимого. a = младший байт частного, bc и de
;   сохранены.
;
; 2013-11-01 vinxru
;----------------------------------------------------------------------------

hl_div_2:	 ; Обнуляем флаг C
		xor a
		rrca
                ; Сдвигаем H		
		ld a, h
		rra
		ld h, a
                ; Сдвигаем L
		ld a, l
		rra
		ld l, a
		ret
