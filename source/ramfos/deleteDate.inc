;+---------------------------------------------------------------------------
; RAMFOS
; Удаление текущей даты
; Последующая перерисовка верхней строки в init приведет в вызову функции 
; ввода даты
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

    IF DATE_IN_RAM
		; Сохраняем признак того, что дата не введена
		ld a, 8Ch
		ld (v_header2_saved), a
    ELSE
		; Сохраняем признак того, что дата не введена в ДОЗУ
		; На входе A != 8Bh
		ld hl, (v_aramPageEnd)
		inc hl
		call	pageWrite
    ENDIF
		; Функция продолжается в init
