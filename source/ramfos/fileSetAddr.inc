;+---------------------------------------------------------------------------
; RAMFOS
; Стандартная точка входа F842
; Установка адреса загрузки в память текущего файла
;
; На входе
;   v_header2_name - имя файла
;   hl             - новый адрес
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

fileSetAddr:	 ; Ищем файл
		push hl
		 call	fileFind
		pop hl

		; Файл не найден
		ret nz

		; Устаналиваем адрес загрузки
		jp fileLoadSetAddr
