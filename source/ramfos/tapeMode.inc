;+---------------------------------------------------------------------------
; RAMFOS
; Переключение скорости записи на магнитофон и режима принтера
; Вызывается при нажатии на соответствующую клавишу
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

tapeMode:	 ; Эта хитрая программа просто обменивает местами
		; v_tapePulseB,A -> v_tapePulseB1,A1 -> v_tapePulseB2,A2
		ld d, 4 ; Надо сдвинуть 4 байта
tapeMode_0:	ld e, 11 ; Длина всего массива 12 байт
		 ld hl, v_tapePresets-1 ; Конец массива
		 ld a, (v_tapePulseB) ; Загружаем первое значение, которое сразу же поместим в конец
tapeMode_1:	ld c, a ; Сдвигаем 11 байт
		  ld a, (hl)
		  ld (hl), c
		  dec hl
		  dec e
		 jp nz, tapeMode_1
		 ld (hl), a ; И сохраняем 12 байт. Прошлое значение мы уже поместили в начало массива
		 dec d ; Повторяем это 4 раза
		jp nz, tapeMode_0

		; Меняем переменную v_tapeMode '0'->'1'->'2'->'0'
		ld a, (v_tapeMode)
		inc a
		cp '3'
		jp nz, tapeMode_2
		 ld a, '0'
tapeMode_2:	ld (v_tapeMode), a

		; Возвращаемся в функцию опроса клавиатуры
		jp specialKeysRet
