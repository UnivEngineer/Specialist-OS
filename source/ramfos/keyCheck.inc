;----------------------------------------------------------------------------
; RAMFOS
; Автоповтор клавиатуры и эхопечать (обертка над сканирование клавиатуры)
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

    IF FAST_PRINT == 0
keyScanWhilePrint:
		; Обработка клавиш во время вывода и эхопечать

		; Если v_cursorY=8 или 248, выходим 
		ld a, e
		cp 8
		ret z
		cp 248
		ret z

		; Если включен эхо режим на принтер
		ld a, (v_printerEcho)
		cp 0D2h
		jp z, doPrinterEcho
    ENDIF
		
keyCheck:
		; Какой то флаг
		ld a, (v_key2)
		or a
		ret nz

		; Что то считаем
		push hl
		push de
		 ld hl, (v_key0)
		 ex de, hl
		 ld hl, (v_key1)
		 call	sub_CEE2
		 ld (v_key1), hl ; Нажатая клавиша в L
		 ex de, hl
		 ld (v_key0), hl
		 ld (v_key2), a

		; pop d
		; pop h
		; ora a
		; ret
		jp popa_ora_a_ret

; ---------------------------------------------------------------------------

sub_CEE2:	 ; Получить код нажатой клавиши
		call	keyScan

		; Если нажатая клавиша не L
		cp l
		ld l, a
		jp nz, loc_CF01

		; Если клавиша не была нажата, выходим с кодом 0
		inc a
		ret z

		; Уменьшаем DE, и если он не нулевой, выходим с кодом 0
		dec de
		ld a, d
		or e
		ld a, 0
		ret nz

		; Звуковой сигнал
		call	keySound

		; Инициализируем счетчик
		ld de, 17Ch

		; Если H=0, выходим с кодом 0FFh
		dec h
		ld a, 0FFh
		ret z

		; Возвращаем H
		inc h

		; Инициализируем счетчик
		ld de, 1Ch
		ret
; ---------------------------------------------------------------------------

loc_CF01:	 ; Записываем H=1
		ld h, 1

		; Выходим с кодом 0
		xor a

		; Инициализируем счетчик
		ld de, 30h
		ret

; ---------------------------------------------------------------------------
