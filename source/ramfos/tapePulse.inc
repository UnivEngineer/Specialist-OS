tapePulse:	 ; Задержка на L
		dec l
		jp p, tapePulse

		; Высокий уровень
		ld a, 0Fh
		ld (IO_KEYB_MODE), a

		; Задержка на H	
tapePulse_0:	dec h
		jp p, tapePulse_0

		; Низкий уровень
		ld a, 0Eh
		ld (IO_KEYB_MODE), a
		ret
