;+---------------------------------------------------------------------------
; RAMFOS
; Запись блока данных в ДОЗУ/ПЗУ
;
; На входе:
;  bc - откуда, адрес в памяти
;  hl - куда, адрес в ДОЗУ/ПЗУ
;  de - длина-1
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

pageWriteBlock:	 ; Чтение байта
		ld a, (bc)
		; Запись байта
		push bc
		 ld c, a
		 call	pageWrite
		pop bc
		; Увеличение адресов
		inc hl
		inc bc
		; if(de == 0) break;
		ld a, e
		or d
		; de--
		dec de
		jp nz, pageWriteBlock
		ret
