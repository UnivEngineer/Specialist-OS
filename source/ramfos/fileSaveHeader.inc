fileSaveHeader:
		; Устанавливаем флаг "файл не был сохранен"
		ld a, 8Bh
		ld (v_header_saved), a

		; Сохранение заголовка на диск
		ld bc, v_header
		
;----------------------------------------------------------------------------
; RAMFOS
; Записать альтернативный заговлок файла на диск
; Используется для записи заговлока v_header2 при создании нового файла
;
; На входе
;  b - заголовок
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

fileSaveHeaderAny:
		ld de, FILE_HEADER_SIZE-1
		ld hl, (v_curFile)

		; Продолжение на pageWriteBlock
		
