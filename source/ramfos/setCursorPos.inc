;+---------------------------------------------------------------------------
; RAMFOS
; Стандартная точка входа C83C
; Устанвока/получения положения курсора. Координаты в символах.
;
; На входе
;  H - номер строки
;  L - номер колонки
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

setCursorPos:	push hl
		push af

		; Поменять H L местами
		ld a, l
		ld l, h
		ld h, a

		; l = l * 10 - 2
		ld a, -2
loc_CD1C:	add a, 10
		 dec l
		jp p, loc_CD1C
		ld l, a

		; h *= 3
		ld a, -3
loc_CD25:	add a, 3
		 dec h
		jp p, loc_CD25
		ld h, a

		; Сохранить положение курсора
		ld (v_cursorPos), hl

		pop af
		pop hl
		ret
