;+---------------------------------------------------------------------------
; RAMFOS
; Копирование ОЗУ в обратном направлении
;
; На входе
;  de - откуда
;  hl - куда
;  с  - размер/2
; 
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

memcpyb_hl_de_c2:
		dec l
		dec e
		ld a, (de)
		ld (hl), a

		dec l
		dec e
		ld a, (de)
		ld (hl), a

		dec c
		jp nz, memcpyb_hl_de_c2
		ret
