;+---------------------------------------------------------------------------
; RAMFOS
; Чтение ПЗУ Специалиста MX
;
; 2013-11-01 Разработано vinxru
;----------------------------------------------------------------------------

    IF BIG_ROM
bigRom:	push af

		; Если в HL было число < 8000h, то переходим к чтению ПЗУ MX
		ld a, h
		xor 80h
		jp m, bigRom_0

		; Сохраняем HL и вычитаем из него 8000h
		push hl
		 ld h, a
		 ; Первые 4 байта в ПЗУ СТД это программа инициализации
		 inc hl
		 inc hl
		 inc hl
		 inc hl
		 ; Включаем ПЗУ СТД
		 ld (IO_PAGE_STD), a
		 xor a
		 ld (IO_COLOR-800h), a
		 ; Чтение байта
		 ld c, (hl)
		 ; Включение ОЗУ MX и восстановление цвета
		 ld (IO_PAGE_RAM-800h), a
		 ld a, (v_color)
		 ld (IO_COLOR), a
		pop hl
		; Восстанавливаем в A значение
		pop af
		ret
		
bigRom_0:	 ; Включение ПЗУ MX
		ld (IO_PAGE_ROM), a
		; Чтение байта
		ld c, (hl)
		; Включение ОЗУ MX
		ld (IO_PAGE_RAM), a
		; Восстанавливаем в A значение
		pop af
		ret      
    ENDIF
