;+---------------------------------------------------------------------------
; RAMFOS
; Очистить верхнюю строку
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

clearTopLine2:	ld de, 0A0Ah ; строка 10, высота 10

;----------------------------------------------------------------------------
; RAMFOS
; Очистить произвольное кол-во строк
;
; На входе
;  d - номер строки, выше которой строки будут очищены. Сама строка не очищается
;  e - кол-во строк
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

clearLine:	ld a, (v_inverse)
		ld h, 90h ; Адрес
		ld b, 48 ; Кол-во столбцов
clearRect_0:	ld l, d
		 ld c, e
clearRect_1:	dec l
		  dec c
		  ld (hl), a
		  dec l
		  dec c
		  ld (hl), a
		 jp nz, clearRect_1
		 inc h
		 dec b
		jp nz, clearRect_0
		ret		
