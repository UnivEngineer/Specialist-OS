;+---------------------------------------------------------------------------
; RAMFOS
; Следующая страница
;
; На входе
;  b - страница
;
; На выходе
;  jc - ошибка
;  b  - страница
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

pageNext:	 ; У ROM-диска (код 0x80) может быть только одна страница, выходим с флагом C
		ld a, b
		rla
		ret c
		rra

		; Отфильтровываем флаги
    IF ARAM_MAX_PAGE <= 7
		and 7
    ELSE
		and 0Fh
    ENDIF
		; Максимум страниц
		ld c, a
		inc c
		ld a, (v_aramMaxPage)
		cp c
		ret c

		; Увеличиваем страницу
		inc b
		ret
