;+---------------------------------------------------------------------------
; RAMFOS
; Сравнить ОЗУ в обратном направлении
;
; На входе
;  hl - адрес 1 (сравнение начинается с hl-1)
;  de - адрес 2 (сравнение начинается с de)
;  с  - размер
; 
; На выходе
;  z  - если блоки равны
; 
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

memcmp_hl1_de_c:  ; if(*de-- != *--hl) return;
		 ld a, (de)
		 dec de
		 dec hl
		 cp (hl)
		 ret nz
		 ; c--
		 dec c
		 ret z
		jp memcmp_hl1_de_c
