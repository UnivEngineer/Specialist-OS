;+---------------------------------------------------------------------------
; RAMFOS
; Получить адрес предыдущего файла
;
; На входе
;  hl - адрес файла
;
; На выходе
;  bc - адрес предыдущего файла
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

		; Последние два байта файла это указатель на начало.
		dec hl
		call	pageRead
		ld b, c
		dec hl
		call	pageRead
