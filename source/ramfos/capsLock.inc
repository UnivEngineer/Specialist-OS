;+---------------------------------------------------------------------------
; RAMFOS
; Нажатие на клавишу CAPS LOCK
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

capsLock:	dec b
		jp p, capsLock1
		 ld a, h
		 cpl
		 ld h, a
		jp capsLockRet

; ---------------------------------------------------------------------------

capsLock1:	ld a, (v_capsLock)
		xor 2
		ld (v_capsLock), a
		jp specialKeysRet
