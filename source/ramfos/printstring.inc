;+---------------------------------------------------------------------------
; RAMFOS
; Стандартная точка входа C818
; Вывод строки на экран
;
; На входе
;  hl - Строка
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

printString:	ld a, (hl)
		and a
		ret z
		call	printCharA
		inc hl
		jp printString
