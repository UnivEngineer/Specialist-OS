;+---------------------------------------------------------------------------
; RAMFOS
; Задержка
;
; На входе
;  L - длительность
;
; На выходе
;  B - 0
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

delay_l:	ld b, l
delay_l_0:	dec b
		jp nz, delay_l_0
		ret
