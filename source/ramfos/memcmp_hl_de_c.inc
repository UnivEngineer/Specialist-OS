;+---------------------------------------------------------------------------
; RAMFOS
; Сравнить с расширение текущего файла
;
; вход:
;  hl - адрес
; 
; выход:
;  z  - если блоки равны
; 
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

memcmp_ext:	ld de, v_header_ext

;----------------------------------------------------------------------------
; RAMFOS
; Сравнить 3 байта ОЗУ
;
; вход:
;  hl - адрес 1
;  de - адрес 2
; 
; выход:
;  z  - если блоки равны
; 
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

memcmp_hl_de_3:	ld c, 3

;----------------------------------------------------------------------------
; RAMFOS
; Сравнить ОЗУ
;
; вход:
;  hl - адрес 1
;  de - адрес 2
;  с  - размер
; 
; выход:
;  z  - если блоки равны
; 
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

memcmp_hl_de_c:	  ; if(*de-- != *hl--) return;
		 ld a, (de)
		 cp (hl)
		 inc hl
		 ret nz
		 inc de
		 dec c
		jp nz, memcmp_hl_de_c
		ret
