;+---------------------------------------------------------------------------
; RAMFOS
; Ожидание изменения порта магнитофона и замер времени в bс
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

tapeWaitC3:	ld c, 3
tapeWait:	ld a, e
		xor 1
		ld e, a
tapeWait_0:	inc bc
		 ld a, (hl)
		 xor e
		jp po, tapeWait_0
		rrca
		rrca
		ret c
		pop hl
		jp tapeError
