;+---------------------------------------------------------------------------
; RAMFOS
; Инверсия кода цвета
; Вызывается при выводе кода 89
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

inverseColor:	ld a, (v_color)
		cpl

;----------------------------------------------------------------------------
; RAMFOS
;
; Выбрать цвет фона и символов и сохранить его копию для RAMFOS.
;
; вход:
;   a = байт цвета: старшие биты задают символы, младшие — фон.
;
; выход:
;   v_color и IO_COLOR получают a. Регистры и флаги сохранены.
;
; Стандартная точка входа C84B
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

setColor:	ld (v_color), a
		ld (IO_COLOR), a
		ret
