;+---------------------------------------------------------------------------
; RAMFOS
; Инверсия кода цвета
; Вызывается при выводе кода 89
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

inverseColor:	ld a, (v_color)
		cpl

;+---------------------------------------------------------------------------
; RAMFOS
; Стандартная точка входа C84B
; Установка цвета фона и букв
;
; На входе
;  Младшие биты A - цвета фона
;  Старшие биты A - цвет букв
;
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

setColor:	ld (v_color), a
		ld (IO_COLOR), a
		ret
