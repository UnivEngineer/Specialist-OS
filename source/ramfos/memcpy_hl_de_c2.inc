;+---------------------------------------------------------------------------
; RAMFOS
; Копирование ОЗУ
;
; На входе
;  de - откуда
;  hl - куда
;  с  - размер / 2
; 
; 2013-11-01 Дизассемблировано vinxru
;----------------------------------------------------------------------------

memcpy_hl_de_c2:	ld a, (de)
		ld (hl), a
		inc l
		inc e
		ld a, (de)
		ld (hl), a
		inc l
		inc e
		dec c
		jp nz, memcpy_hl_de_c2
		ret
