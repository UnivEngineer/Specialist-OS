;+---------------------------------------------------------------------------
; RAMFOS
; Преобразовать введенную строку с датой в числа
;
; На входе:
;  de - строка
;
; 2013-11-01 Доработано vinxru (короче и сохраняет в ОЗУ)
;----------------------------------------------------------------------------

    IF DATE_IN_RAM

parseDate:	ld bc, v_header2_date ; 3

parseDate_1:	 ; Преобразование строки в число. Ошибка не контроллируется.
		call	strToHex  ; 6

		; Сохранение
		ld a, l ; 7
		ld (bc), a ; 8
		inc bc ; 9
	
		; Если конец строки, выходим
		ret c ; 10

		; Цикл
		ld a, (v_header2_date + 3) & 0FFh ; 12
		cp c ; 13
		jp nz, parseDate_1 ; 16

		; Выходим с флагами Z, NC, что приведет к повтормому вводу даты
		ret  ; 17

    ELSE  ;---------------------------------------------------------------------

parseDate:	 ; День
		call	strToHex  ; 3
		ld a, l ; 4
		ld (parseDate_r1+1), a ; 7
		ret c ; 8
		; Месяц
		call	strToHex  ; 11
		ld a, l ; 12
		ld (parseDate_r2+1), a ; 15
		ret c ; 16
		; Год
		call	strToHex  ; 19
		ld a, l ; 20
		ld (parseDate_r3+1), a ; 23
		ret c ; 24
		; Слишком много параметров
		jp xra_a_stc_ret ; 27

    ENDIF
