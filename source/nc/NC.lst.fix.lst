134   F4DD                  INCLUDE "compactName.inc"
# file opened: D:\Projects\Specialist-OS\source\nc\compactName.inc
  1+  F4DD              ;----------------------------------------------------------------------------
  2+  F4DD              ; MXOS NC.COM
  3+  F4DD              ; Убрать из имени пробелы
  4+  F4DD              ;
  5+  F4DD              ; вход:
  6+  F4DD              ;   hl - откуда
  7+  F4DD              ;   de - куда
  8+  F4DD              ;
  9+  F4DD              ; сохраняемые регистры:
 10+  F4DD              ;   hl, bc
 11+  F4DD              ;
 12+  F4DD              ; 2013-12-18 Дизассемблировано vinxru
 13+  F4DD              ;----------------------------------------------------------------------------
 14+  F4DD
 15+  F4DD              compactName:
 16+  F4DD                          ; Сохраняем регистры
 17+  F4DD E5                       push    hl
 18+  F4DE C5                       push    bc
 19+  F4DF
 20+  F4DF                          ; Копируем до пробела, но не более FILE_NAME_LENGTH букв
 21+  F4DF 01 08 00                 ld      bc, FILE_NAME_LENGTH
 22+  F4E2 7E           compactName_1:      ld  a, (hl)
 23+  F4E3 FE 20                    cp      ' '
 24+  F4E5 CA EF F4                 jp z,   compactName_2
 25+  F4E8 12                       ld      (de),a
 26+  F4E9 23                       inc     hl
 27+  F4EA 13                       inc     de
 28+  F4EB 0D                       dec     c
 29+  F4EC C2 E2 F4                 jp nz,  compactName_1
 30+  F4EF
 31+  F4EF              compactName_2:
 32+  F4EF                          ; Пропущенные символы исходной строки
 33+  F4EF 09                       add     hl, bc
 34+  F4F0
 35+  F4F0                          ; Точка
 36+  F4F0 3E 2E                    ld      a, '.'
 37+  F4F2 12                       ld      (de),a
 38+  F4F3 13                       inc     de
 39+  F4F4
 40+  F4F4                          ; Копируем до пробела, но не более 3 букв
 41+  F4F4 0E 03                    ld      c, 3
 42+  F4F6              compactName_3:
 43+  F4F6 7E                       ld      a, (hl)
 44+  F4F7 FE 20                    cp      ' '
 45+  F4F9 CA 03 F5                 jp z,   compactName_4
 46+  F4FC 12                       ld      (de),a
 47+  F4FD 23                       inc     hl
 48+  F4FE 13                       inc     de
 49+  F4FF 0D                       dec     c
 50+  F500 C2 F6 F4                 jp nz,  compactName_3
 51+  F503
 52+  F503              compactName_4:
 53+  F503 EB                       ex      de, hl
 54+  F504 F5                       push    af
 55+  F505
 56+  F505                          ; Если последний символ '.', то удаляем его
 57+  F505 2B                       dec     hl
 58+  F506 7E                       ld      a, (hl)
 59+  F507 FE 2E                    cp      '.'
 60+  F509 CA 0D F5                 jp z,   compactName_5
 61+  F50C 23                       inc     hl
 62+  F50D
 63+  F50D              compactName_5:
 64+  F50D                          ; Добавляем пробел и конец строки
 65+  F50D 36 20                    ld      (hl), ' '
 66+  F50F 23                       inc     hl
 67+  F510 36 0D                    ld      (hl), 0Dh
 68+  F512 23                       inc     hl
 69+  F513 36 00                    ld      (hl), 0
 70+  F515
 71+  F515                          ; Результат в de
 72+  F515 EB                       ex    de, hl
 73+  F516
 74+  F516                          ; Восстаналиваем регистры и выходим
 75+  F516 F1                       pop   af
 76+  F517 C1                       pop   bc
 77+  F518 E1                       pop   hl
 78+  F519 C9                       ret
 79+  F51A
