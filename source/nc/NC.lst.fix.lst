 35+  F461
 36+  F461                          ; Если a&0xF==1, то нарисовать веритикальную линию
 37+  F461                          ; b-первый байт, c-средняя длина, *de++ - последний байт
 38+  F461 FE 01                    cp    1
 39+  F463 CA 74 F4                 jp z, draw1
 40+  F466
 41+  F466                          ; Нарисовать окно
 42+  F466 CD 94 F4                 call  draw_window
 43+  F469
 44+  F469              draw_next:  ; hl=de и следующий цикл
 45+  F469 EB                       ex    de, hl
