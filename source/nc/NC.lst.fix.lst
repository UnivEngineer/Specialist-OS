 26+  F0A2 CD FC F3                 call  readBytePanel
 27+  F0A5 91                       sub   c
 28+  F0A6
 29+  F0A6                          ; Рассчиытваем координату X (точнее, адрес)
 30+  F0A6 26 91                    ld    h, 90h + (P_FILE_LIST_X1 * 2 / 8)
 31+  F0A8 FE 12                    cp    FILE_LIST_SIZE/2
 32+  F0AA DA B1 F0                 jp c, drawCursor_1
 33+  F0AD D6 12                    sub   FILE_LIST_SIZE/2
 34+  F0AF 26 9D                    ld    h, 90h + (P_FILE_LIST_X2 * 2 / 8)
 35+  F0B1
 36+  F0B1              drawCursor_1:
 37+  F0B1                          ; Рассчиытваем координату Y (точнее, адрес)
 38+  F0B1                          ; a = a * 10 + P_FILE_LIST_Y - 8
 39+  F0B1 87                       add   a, a
 40+  F0B2 4F                       ld    c, a
 41+  F0B3 87                       add   a, a
 42+  F0B4 87                       add   a, a
 43+  F0B5 81                       add   a, c
 44+  F0B6 C6 18                    add   P_FILE_LIST_Y - 8
 45+  F0B8 6F                       ld    l, a
 46+  F0B9
 47+  F0B9                          ; Ширина курсора в байтах, высота в пикселях
