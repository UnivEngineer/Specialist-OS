133   F4C9                  INCLUDE "tools.inc"
# file opened: D:\Projects\Specialist-OS\source\nc\tools.inc
  1+  F4C9              ;----------------------------------------------------------------------------
  2+  F4C9              ; MXOS NC.COM
  3+  F4C9              ; Копирвоание 3-х байт из адреса de в адрес hl
  4+  F4C9              ;
  5+  F4C9              ; 2013-12-18 Дизассемблировано vinxru
  6+  F4C9              ;----------------------------------------------------------------------------
  7+  F4C9
  8+  F4C9              memcpy_hl_de_3:
  9+  F4C9 1A                   ld    a, (de)
 10+  F4CA 77                   ld    (hl), a
 11+  F4CB 23                   inc   hl
 12+  F4CC 13                   inc   de
 13+  F4CD
 14+  F4CD 1A                   ld    a, (de)
 15+  F4CE 77                   ld    (hl), a
 16+  F4CF 23                   inc   hl
 17+  F4D0 13                   inc   de
 18+  F4D1
 19+  F4D1 1A                   ld    a, (de)
 20+  F4D2 77                   ld    (hl), a
 21+  F4D3 23                   inc   hl
 22+  F4D4 13                   inc   de
 23+  F4D5
 24+  F4D5 C9                   ret
 25+  F4D6
 26+  F4D6              ;----------------------------------------------------------------------------
 27+  F4D6              ; MXOS NC.COM
 28+  F4D6              ; Заполнение памяти по адресу hl байтом a длинной c
 29+  F4D6              ;
 30+  F4D6              ; 2013-12-18 Дизассемблировано vinxru
 31+  F4D6              ;----------------------------------------------------------------------------
 32+  F4D6
 33+  F4D6              memset_hl_a_c:
 34+  F4D6 77                   ld      (hl), a
 35+  F4D7 23                   inc     hl
 36+  F4D8 0D                   dec     c
 37+  F4D9 C2 D6 F4             jp nz,  memset_hl_a_c
