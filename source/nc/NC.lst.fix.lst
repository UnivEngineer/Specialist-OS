234   F745 14          >
235   F746                          G_LINE   80h, 108, 132, 168       ; 81h, 84h, 9Dh, 14h, 0Fh, 0F0h
235   F746 81 84 9D 14 >                DB 80h|1, 132, 90h+(108>>3), (((108&7)+168+7)>>3)-2, 0FFh>>(108&7), (0FF00h>>((168+108)&7)) & 0FFh
235   F74A 0F F0       >
236   F74C 00                       DB 0
237   F74D
238   F74D              ;-----------------------------------------------------------------------
239   F74D              ; Размер буфера для листинга директории (штук дескрипторов файлов)
240   F74D
241   F74D                  IF FULL_PANELS
242   F74D ~            FILE_LIST_SIZE    = 40
243   F74D                  ELSE
244   F74D              FILE_LIST_SIZE    = 36
245   F74D                  ENDIF
246   F74D
247   F74D              ;-----------------------------------------------------------------------
248   F74D              ; Коодинаты элементов панелей от левого верхнего угла экрана
249   F74D              ; x - удвоенные пиксели, y - пиксели
250   F74D
251   F74D              P_NAME_X1         = 17  ; Заголовок панели "NAME" (2 колонки)
252   F74D              P_NAME_X2         = 65
253   F74D              P_NAME_Y          = 16
254   F74D
255   F74D              P_FILE_LIST_X1    = 6   ; Файловая таблица (2 колонки)
256   F74D              P_FILE_LIST_X2    = 54
257   F74D
258   F74D                  IF FULL_PANELS
259   F74D ~            P_FILE_LIST_Y     = 12
260   F74D                  ELSE
261   F74D              P_FILE_LIST_Y     = 32
262   F74D                  ENDIF
263   F74D
264   F74D              P_FILE_LIST_H     = FILE_LIST_SIZE / 2  ; Высота файловой таблицы в строках
265   F74D              P_FILE_LIST_Y_MAX = P_FILE_LIST_H * 10 + P_FILE_LIST_Y
266   F74D
267   F74D              P_DRIVE_LETTER_X  = 9   ; Буква имени диска внизу панели
268   F74D              P_DRIVE_LETTER_Y  = 222
269   F74D              P_FILE_NAME_X     = 15  ; Имя файла внизу панели
270   F74D              P_FILE_NAME_Y     = 222
271   F74D              P_FILE_DATA_X     = 57  ; Данные о файле (адрес загрузки, размер)
272   F74D              P_FILE_DATA_Y     = 222
273   F74D
274   F74D              P_INPUT_WIDTH     = 23  ; Длина поля ввода имени файла в символах
275   F74D
276   F74D              ;-----------------------------------------------------------------------
277   F74D              ; Переменные
278   F74D              ;-----------------------------------------------------------------------
279   F74D
280   F74D              ; Блок переменных состояния
281   F74D              ; Сохраняется в неиспользуемом секторе нулевой страницs RAM-диска
282   F74D
283   F74D                  STRUCT NC_STATE
284   F74D ~            initState           DB    5Ah   ; признак, что NC.COM уже запускался
285   F74D ~            activePanel         DB    0     ; номер активной панели
286   F74D ~            panelA_info         DB    0     ; 1 = панель A в режиме информации
287   F74D ~            panelB_info         DB    0     ; 1 = панель B в режиме информации
288   F74D ~            panelA_drive        DB    0     ; номер диска панели A
289   F74D ~            panelB_drive        DB    7     ; номер диска панели B
290   F74D ~            panelA_filesCnt     DB    0     ; количество файлов на панели A
291   F74D ~            panelB_filesCnt     DB    0     ; количество файлов на панели B
292   F74D ~            panelA_firstFile    DB    0     ; c какого файла начинается панель A
293   F74D ~            panelB_firstFile    DB    0     ; c какого файла начинается панель B
294   F74D ~            panelA_curFile      DB    0     ; на каком файле курсор на панели A
295   F74D ~            panelB_curFile      DB    0     ; на каком файле курсор на панели B
296   F74D                  ENDS
297   F74D
298   F74D 5A 00 00 00  state   NC_STATE
298   F751 00 07 00 00
298   F755 00 00 00 00
299   F759              stateEnd:           ; адрес конца блока переменных состояния
300   F759
301   F759              ; Другие переменные - не включены в бинарник (машинный код не
302   F759              ; генерируется, при первом запуске переменные могут содержать мусор)
303   F759
304   F759                  STRUCT NC_VARIABLES
305   F759 ~            cmdLinePos      DW    0
306   F759 ~            cmdLineEnd      DW    0
307   F759 ~            chooseDrive     DB    0
308   F759 ~            copySourceName    DW    0
309   F759 ~            copyBlocksLeft    DW    0
310   F759 ~            copySourceCluster DW    0
311   F759 ~            copyDestCluster   DW    0
312   F759 ~            copySourceDrive   DB    0
313   F759 ~            copyDestDrive     DB    0
314   F759 ~            diskInfoPtr     DW    0         ; адрес структуны DISK_INFO
315   F759 ~            cmdLine         BLOCK 59, 0FFh  ; командная строка
316   F759 ~            cmdLineCtrl     DB    0FFh      ; контроль переполнения командной строки
317   F759 ~            driveCount     DB    0         ; число установленных дисковых драйверов
318   F759 ~            driveList      BLOCK 8, 0     ; номера дисков с установленным драйвером
319   F759 ~                            BLOCK 4, 0FFh ; резерв внутри прежнего блока переменных
320   F759 ~
321   F759 ~            input           BLOCK 21, 0FFh
322   F759 ~                            BLOCK 11
323   F759 ~            tempFileDescr   FILE_DESCRIPTOR
324   F759                  ENDS
325   F759
326   F759              vars    NC_VARIABLES = $        ; адрес начала блока переменнных
327   F759              varsEnd = vars + NC_VARIABLES   ; адрес конца  блока переменнных
328   F759
329   F759              ; Адрес буфера для листинга директории (FILE_LIST_SIZE структур FILE_INFO + 1 = 577 байт)
330   F759              ;FILE_LIST_BUFFER = 8800h
331   F759              FILE_LIST_BUFFER      = varsEnd
332   F759              FILE_LIST_BUFFER_SIZE = FILE_LIST_SIZE * FILE_INFO_SIZE + 1
333   F759
334   F759              ;-----------------------------------------------------------------------
335   F759              ; Проверяем, что программа помещается в память вместе со своими буферами
336   F759              ;-----------------------------------------------------------------------
337   F759
338   F759              ; Конец NC.COM после разворачивания в памяти
339   F759              NC_END = FILE_LIST_BUFFER + FILE_LIST_BUFFER_SIZE
340   F759
341   F759              ; Максимальный допустимый размер NC.COM. Последняя страница перед FAT-кэшем
342   F759              ; зарезервирована как секторный буфер потокового копирования.
343   F759
344   F759                  IF NEW_MEMORY_MAP
345   F759              NC_END_MAX = FAT_CACHE_ADDR  ; до дискового кэша
346   F759                  ELSE
347   F759 ~            NC_END_MAX = 0E200h          ; до адреса 0E200h
348   F759                  ENDIF
349   F759
350   F759              ; Проверка
351   F759                  IF NC_END >= NC_END_MAX
352   F759 ~                    ASSERT 0
353   F759 ~                    DISPLAY /l, "Error! NC.COM did not fit (", NC_END, " > ", NC_END_MAX, ")"
354   F759                  ENDIF
355   F759
356   F759                  END
