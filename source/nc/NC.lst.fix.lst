135   F51A                  INCLUDE "input.inc"
# file opened: D:\Projects\Specialist-OS\source\nc\input.inc
  1+  F51A              ;----------------------------------------------------------------------------
  2+  F51A              ; MXOS NC.COM
  3+  F51A              ; Ввод строки
  4+  F51A              ;
  5+  F51A              ; 2013-12-18 Дизассемблировано vinxru
