  8+  F090              drawCursor: ; Цвет устаналвиается перед выводом
  9+  F090
 10+  F090                          ; Если файлов нет, выходим
 11+  F090 21 53 F7                 ld    hl, state.panelA_filesCnt
 12+  F093 CD FC F3                 call  readBytePanel
