225   F72E 01 67 95 0C >                DB 0|1, 103, 90h+(44>>3), (((44&7)+104+7)>>3)-2, 0FFh>>(44&7), (0FF00h>>((104+44)&7)) & 0FFh
225   F732 0F F0       >
226   F734 00                       DB 0
227   F735
228   F735              g_window1:
229   F735                          G_WINDOW 80h, 112, 80, 160, 37    ; 82h, 50h, 9Eh, 1Fh, 12h
229   F735 82 50 9E 1F >                DB 80h|2, 80, 90h+(112>>3), 37-6, (160>>3)-2
229   F739 12          >
230   F73A                          G_LINE   80h, 116, 98, 152        ; 81h, 62h, 9Eh, 12h, 0Fh, 0F0h
230   F73A 81 62 9E 12 >                DB 80h|1, 98, 90h+(116>>3), (((116&7)+152+7)>>3)-2, 0FFh>>(116&7), (0FF00h>>((152+116)&7)) & 0FFh
230   F73E 0F F0       >
