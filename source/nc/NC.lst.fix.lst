 28+  F125 0D                       dec     c
 29+  F126 C2 21 F1                 jp nz,  ir_loop_y
 30+  F129
 31+  F129                          ; Повтор цикла по горизонтали
 32+  F129 E1                       pop     hl
 33+  F12A 24                       inc     h
 34+  F12B 05                       dec     b
 35+  F12C C2 1F F1                 jp nz,  ir_loop_x
 36+  F12F
 37+  F12F D1                       pop     de
 38+  F130 C9                       ret
