 14+  F097                  IF ENABLE_COLOR
 15+  F097 C8                       ret Z
 16+  F098                  ELSE
 17+  F098 ~                        jp z, drawCursor_0
 18+  F098                  ENDIF
 19+  F098                          ; C какого файла начинается список файлов на панели
 20+  F098 21 55 F7                 ld    hl, state.panelA_firstFile
 21+  F09B CD FC F3                 call  readBytePanel
