  7+  F51A
  8+  F51A              input:      ; Вывод строки
  9+  F51A E5                       push    hl
 10+  F51B 21 B3 F7                 ld      hl, vars.input
 11+  F51E CD F3 EA                 call    printStringInv
 12+  F521 E1                       pop     hl
 13+  F522
 14+  F522                          ; Включаем инверсию
 15+  F522 3E 01                    ld      a, 1
 16+  F524 32 FA 8F                 ld      (bios_vars.inverse),a
 17+  F527
 18+  F527              input_loop: ; Ввод символа
 19+  F527 CD 03 C8                 call  bios_getch
 20+  F52A
 21+  F52A                          ; Enter или ESC
 22+  F52A FE 0D                    cp      0Dh
 23+  F52C CA 5F F5                 jp z,   input_exit
 24+  F52F FE 1B                    cp      1Bh
 25+  F531 CA 5F F5                 jp z,   input_exit
 26+  F534
 27+  F534                          ; Если служебная клавиша или пробел, то пропускаем
 28+  F534 FE 21                    cp      21h
 29+  F536 DA 27 F5                 jp c,   input_loop
 30+  F539
 31+  F539                          ; Сохраняем для вывода
 32+  F539 4F                       ld      c, a
 33+  F53A
 34+  F53A                          ; Помещаем символ в буфер
 35+  F53A 12                       ld      (de),a
 36+  F53B
 37+  F53B                          ; Удаление
 38+  F53B FE 7F                    cp      7Fh
 39+  F53D CA 4D F5                 jp z,   input_bkspc
 40+  F540
 41+  F540                          ; Если переполнение
 42+  F540 3E CA                    ld      a, (vars.input + P_INPUT_WIDTH) & 0FFh  ; a = младший байт адреса пследнего байта буфера
 43+  F542 BB                       cp      e
 44+  F543 CA 27 F5                 jp z,   input_loop
 45+  F546
 46+  F546                          ; Вывод символа на экран
 47+  F546 CD 09 C8                 call    bios_printChar
 48+  F549
 49+  F549                          ; Увеличение длины строки
 50+  F549 13                       inc     de
 51+  F54A
 52+  F54A C3 27 F5                 jp      input_loop
 53+  F54D
 54+  F54D              ; ---------------------------------------------------------------------------
 55+  F54D
 56+  F54D              input_bkspc:
 57+  F54D                          ; Если это начало строки, выходим
 58+  F54D 3E B3                    ld      a, vars.input & 0FFh
 59+  F54F BB                       cp      e
 60+  F550 CA 27 F5                 jp z,   input_loop
 61+  F553
 62+  F553                          ; Уменьшаем длину строки
 63+  F553 1D                       dec     e
 64+  F554
 65+  F554                          ; Стираем символ с экрана
 66+  F554 E5                       push    hl
 67+  F555 21 06 F6                 ld      hl, asc_DC17
 68+  F558 CD 18 C8                 call    bios_printString
 69+  F55B E1                       pop     hl
 70+  F55C
 71+  F55C C3 27 F5                 jp      input_loop
 72+  F55F
 73+  F55F              ; ---------------------------------------------------------------------------
 74+  F55F
 75+  F55F              input_exit:
 76+  F55F                          ; Сохраняем ESC или Enter для выхода
 77+  F55F 4F                       ld      c, a
 78+  F560
 79+  F560                          ; Записываем в конец строки 0Dh, 0
 80+  F560 EB                       ex      de, hl
 81+  F561 36 0D                    ld      (hl), 0Dh
 82+  F563 23                       inc     hl
 83+  F564 AF                       xor     a
 84+  F565 77                       ld      (hl), a
 85+  F566
 86+  F566                          ; Восстанавливаем инверсию
 87+  F566 32 FA 8F                 ld      (bios_vars.inverse),a
 88+  F569
 89+  F569                          ; Выход
 90+  F569 79                       ld      a, c
 91+  F56A C9                       ret
 92+  F56B
