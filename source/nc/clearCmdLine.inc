; Очистка общей командной строки и перерисовка приглашения с путём.
clearCmdLine:
            call resetCmdLine
            jp redrawCommandLine

;----------------------------------------------------------------------------
; MXOS
;
; Очистить командную строку активного NC.
;
; вход:
;   Регистровых параметров нет.
;
; выход:
;   Первый байт vars.cmdLine = 0; hl и vars.cmdLineEnd указывают на него. af, bc и de
;   сохранены.
;----------------------------------------------------------------------------

resetCmdLine:
            ld hl,vars.cmdLine
            ld (vars.cmdLineEnd),hl
            ld (hl),0
            ret
