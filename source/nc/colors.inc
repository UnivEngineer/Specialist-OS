; Частые цвета: экономия двух байтов на вызов COLOR.
; Изменяет только A, сохраняет остальные регистры и флаги, как MVI/STA.
; Software mirror avoids reading the write-only color register for masked UI.
    IF ENABLE_COLOR

;----------------------------------------------------------------------------
; MXOS
;
; Выбрать цвет COLOR_INFOTEXT для вывода NC.
;
; вход:
;   Сборка с ENABLE_COLOR. Регистровых параметров нет.
;
; выход:
;   a, IO_COLOR и ncCurrentColor содержат COLOR_INFOTEXT. bc, de, hl и флаги сохранены.
;----------------------------------------------------------------------------

ncColorText:
            ld      a, COLOR_INFOTEXT
            jp      ncSetColor

;----------------------------------------------------------------------------
; MXOS
;
; Выбрать цвет COLOR_INFONUMBER для вывода NC.
;
; вход:
;   Сборка с ENABLE_COLOR. Регистровых параметров нет.
;
; выход:
;   a, IO_COLOR и ncCurrentColor содержат COLOR_INFONUMBER. bc, de, hl и флаги
;   сохранены.
;----------------------------------------------------------------------------

ncColorNumber:
            ld      a, COLOR_INFONUMBER
            jp      ncSetColor

;----------------------------------------------------------------------------
; MXOS
;
; Выбрать цвет COLOR_CMDLINE для вывода NC.
;
; вход:
;   Сборка с ENABLE_COLOR. Регистровых параметров нет.
;
; выход:
;   a, IO_COLOR и ncCurrentColor содержат COLOR_CMDLINE. bc, de, hl и флаги сохранены.
;----------------------------------------------------------------------------

ncColorCommand:
            ld      a, COLOR_CMDLINE
            jp      ncSetColor

;----------------------------------------------------------------------------
; MXOS
;
; Выбрать цвет COLOR_DIALOG для вывода NC.
;
; вход:
;   Сборка с ENABLE_COLOR. Регистровых параметров нет.
;
; выход:
;   a, IO_COLOR и ncCurrentColor содержат COLOR_DIALOG. bc, de, hl и флаги сохранены.
;----------------------------------------------------------------------------

ncColorDialog:
            ld      a, COLOR_DIALOG
            jp      ncSetColor

;----------------------------------------------------------------------------
; MXOS
;
; Выбрать цвет COLOR_FILE для вывода NC.
;
; вход:
;   Сборка с ENABLE_COLOR. Регистровых параметров нет.
;
; выход:
;   a, IO_COLOR и ncCurrentColor содержат COLOR_FILE. bc, de, hl и флаги сохранены.
;----------------------------------------------------------------------------

ncColorFile:
            ld      a, COLOR_FILE

;----------------------------------------------------------------------------
; MXOS
;
; Установить аппаратный цвет и сохранить его копию для NC.
;
; вход:
;   a = выбранный цвет.
;
; выход:
;   IO_COLOR и ncCurrentColor получают a. Регистры и флаги сохранены.
;----------------------------------------------------------------------------

ncSetColor:
            ld      (IO_COLOR), a
            ld      (ncCurrentColor), a
            ret
    ENDIF
ncCurrentColor: DB COLOR_FILE
