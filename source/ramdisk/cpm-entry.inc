;----------------------------------------------------------------------------
; MXOS
;
; Скопировать один сектор RAM-диска из указанной физической страницы в MAIN.
;
; вход:
;   c = физическая страница, de = адрес сектора (номер в странице × 256), hl = адрес
;   256-байтного буфера в MAIN. Диапазон уже проверен драйвером.
;
; выход:
;   Переданы 256 байт. Восстановлены отображение MAIN и исходный SP; af, bc, de и hl
;   изменяются.
;----------------------------------------------------------------------------

cpmInitRead:
    ld (0FFD2h),hl
    ex de,hl
    ld (0FFD0h),hl
    ld a,c
    ld (0FFD6h),a
    ld a,0FFh
    ld (0FFD7h),a
    jp cpmInitCommon

;----------------------------------------------------------------------------
; MXOS
;
; Скопировать один сектор RAM-диска из MAIN в указанную физическую страницу.
;
; вход:
;   c = физическая страница, de = адрес сектора (номер в странице × 256), hl = адрес
;   256-байтного буфера в MAIN. Диапазон уже проверен драйвером.
;
; выход:
;   Переданы 256 байт. Восстановлены отображение MAIN и исходный SP; af, bc, de и hl
;   изменяются.
;----------------------------------------------------------------------------

cpmInitWrite:
    ld (0FFD0h),hl
    ex de,hl
    ld (0FFD2h),hl
    ld a,0FFh
    ld (0FFD6h),a
    ld a,c
    ld (0FFD7h),a
cpmInitCommon:
    ld hl,0
    add hl,sp
    ld (0FFD9h),hl
    ld a,16
    ld (0FFD4h),a
    jp cpmCopySector
