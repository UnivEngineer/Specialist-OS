; Единый статус DOS: CF остаётся быстрым признаком отказа.
; Внутренний setter: A=код, BC/DE/HL сохраняются, CF=1.

;----------------------------------------------------------------------------
; MXOS
;
; Сохранить причину отказа в DOS и вернуть её вызывающему.
;
; вход:
;   a = код ошибки.
;
; выход:
;   v_dosError = a, cf = 1. Регистры и остальные флаги сохранены.
;----------------------------------------------------------------------------

dosSetError:
            ld (v_dosError),a
            scf
            ret
;----------------------------------------------------------------------------
; MXOS
;
; Прочитать последнюю причину ошибки DOS.
;
; вход:
;   Параметров нет, состояние хранится в v_dosError.
;
; выход:
;   a = код, cf = 1 при ненулевом коде, z = 1 при нуле. bc, de, hl и само v_dosError
;   сохранены.
;----------------------------------------------------------------------------

dosGetError:
            ld a,(v_dosError)
            or a
            ret z
            scf
            ret

;----------------------------------------------------------------------------
; MXOS
;
; Вернуть причину отказа ввода-вывода, сохранив ранее установленную ошибку.
;
; вход:
;   v_dosError содержит причину либо 0, если драйвер её не установил.
;
; выход:
;   cf = 1. При ненулевом v_dosError его значение возвращено в a; иначе a и v_dosError
;   = DOS_ERR_IO. bc, de и hl сохранены.
;----------------------------------------------------------------------------

dosIoError:
            ld a,(v_dosError)
            or a
            scf
            ret nz
            ld a,DOS_ERR_IO
            jp dosSetError

;----------------------------------------------------------------------------
; MXOS
;
; Сообщить о повреждении файловой структуры тома.
;
; вход:
;   Параметров нет.
;
; выход:
;   a и v_dosError = DOS_ERR_CORRUPT, cf = 1. bc, de и hl сохранены.
;----------------------------------------------------------------------------

dosCorrupt:
            ld a,DOS_ERR_CORRUPT
            jp dosSetError

;----------------------------------------------------------------------------
; MXOS
;
; Зафиксировать отсутствие носителя выбранного диска или вернуть только код.
; вход: параметров нет. dosMediaMissing обновляет состояние выбранного тома,
;   прямой вход dosNoMedia оставляет геометрию и состояние тома без изменений.
; выход: a и v_dosError = DOS_ERR_NO_MEDIA, cf = 1. BC/DE/HL сохранены.
;----------------------------------------------------------------------------
dosMediaMissing:
            ld a,DISK_NO_MEDIA
            ld (v_diskInfo.isValid),a
dosNoMedia:
            ld a,DOS_ERR_NO_MEDIA
            jp dosSetError

    IFDEF DOS_SPLIT_BUILD
;----------------------------------------------------------------------------
; MXOS
;
; Сбросить сохранённую причину ошибки после успешной операции.
;
; вход:
;   Параметров нет.
;
; выход:
;   a и v_dosError = 0, cf = 0, z = 1. bc, de и hl сохранены.
;----------------------------------------------------------------------------

dosClearError:
            xor a
            ld (v_dosError),a
            ret
    ENDIF

;----------------------------------------------------------------------------
; MXOS
;
; Вернуть отказ для неподдерживаемого запроса DOS.
;
; вход:
;   Параметров нет.
;
; выход:
;   a и v_dosError = DOS_ERR_UNSUPPORTED, cf = 1. bc, de и hl сохранены.
;----------------------------------------------------------------------------

dosUnsupported:
            ld a,DOS_ERR_UNSUPPORTED
            jp dosSetError
