;+---------------------------------------------------------------------------
; MXOS
; Получение/установка текущего накопителя.
; В режиме 1 функция переключает драйвер накопителя.
;
; вход:
;   e  - 0=чтение, 1=установка
;   a  - накопитель от 0 до 7
;
; выход:
;   e уменьшен на единицу в обоих режимах. При чтении a = номер диска, cf сохранён.
;   При установке cf = результат fileSelectDrive. bc, d и hl сохраняются.
;
; 2013-12-12 Дизассемблировано vinxru
; 2022-02-02 Доработано SpaceEngineer
;----------------------------------------------------------------------------

fileGetSetDrive:
            dec     e
            jp z,   fileSelectDrive
            ld      a, (v_drive)
            ret

; ---------------------------------------------------------------------------

;----------------------------------------------------------------------------
; MXOS
;
; Подключить драйвер выбранного диска и его текущий каталог.
;
; вход:
;   a = индекс диска, используются биты 0..2.
;
; выход:
;   При смене диска сначала сбрасываются отложенные записи. При cf = 0 восстановлен
;   каталог выбранного диска. При ошибке сброса остаётся предыдущий диск. bc, de и hl
;   сохранены.
;----------------------------------------------------------------------------

fileSelectDrive:
            ; Максимум устройств - 1
            and     7

            ; Если устройство не менялось, выходим
            push    hl
            ld      hl, v_drive
            cp      a, (hl)
            pop     hl
            jp z,   selectDirectory

            push    af
            call    flushVolume
            jp c,   fileDriveFlushError
            pop     af

            ; Сохраняем выбранное устройство
            ld      (v_drive), a

            ; Пригодится ниже (a = a * 2)
            add     a, a

            ; Сохраняем регистры
            push    hl
            push    de

            ; Получаем точку входа драйвера
            ld      l, a
            ld      h, 0
            ld      de, v_drives
            add     hl, de
            ld      e, (hl)
            inc     hl
            ld      d, (hl)
            ex      de, hl

            ; Сохраняем её
            ld      (j_diskDriver+1), hl

            ; Восстаналвиаем a
            rrca

    IFDEF BANKED_DOS_BUILD
            ; После ухода с D: отложенная запись уже завершена. Дискету
            ; могли заменить до повторного выбора, сбрасываем старый кэш.
            push hl
            ld hl,kernelFloppyDrive
            cp (hl)
            pop hl
            call z, invalidateDriveCache
    ENDIF

            ; Файловая система выбирается отдельно от физического драйвера.
            call    selectVolume

            ; Восстанавливаем регистры и выходим
            pop     de
            pop     hl
            ret c
            jp selectDirectory


fileDriveFlushError:
            pop af
            scf
            ret
