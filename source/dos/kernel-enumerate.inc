; A=OPEN/NEXT/CLOSE, HL=ENUM_REQUEST in the caller's bank. One owned cursor.
enumService:
    ld a,(kdRegs+7)
    cp ENUM_CLOSE+1
    jp nc,kdBad
    ld (eqOperation),a
    ld hl,(kdRegs)
    ld (kdClientObject),hl
    ld de,KD_OBJECT
    ld bc,ENUM_REQUEST
    call kdFetch
    jp c,kdBad
    ld hl,0
    ld (KD_OBJECT+ENUM_REQUEST.count),hl
    ld a,(eqOperation)
    or a
    jp z,eqOpen
    ld a,(enumActive)
    or a
    jp z,kdBad
    call memoryOwnerCurrent
    ld hl,eqOwner
    cp (hl)
    jp nz,kdBad
    ld hl,(KD_OBJECT)
    ex de,hl
    ld hl,(eqHandle)
    call cmp_hl_de
    jp nz,kdBad
    ld a,(eqOperation)
    cp ENUM_CLOSE
    jp z,eqClose
    ld hl,(KD_OBJECT+ENUM_REQUEST.capacity)
    ld a,h
    or a
    jp nz,kdBad
    ld a,l
    or a
    jp z,kdBad
    ld (eqLeft),a
    ; Validate the complete writable batch before advancing the cursor.
    ld b,h
    ld c,l
    add hl,hl
    add hl,hl
    add hl,bc
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld b,h
    ld c,l
    ld hl,(KD_OBJECT+ENUM_REQUEST.buffer)
    ld (eqBuffer),hl
    call kdRange
    jp c,kdBad
    ; Reject output overlapping the request packet before touching the cursor.
    add hl,bc
    push hl
    ld hl,(kdClientObject)
    ex de,hl
    pop hl
    call cmp_hl_de
    jp c,eqNext
    jp z,eqNext
    ld hl,(kdClientObject)
    ld de,ENUM_REQUEST
    add hl,de
    push hl
    ld hl,(eqBuffer)
    ex de,hl
    pop hl
    call cmp_hl_de
    jp c,eqNext
    jp nz,kdBad
eqNext:
    ld a,ENUM_NEXT
    call enumRun
    jp c,eqEnd
    ld a,h
    or l
    jp z,eqPublish
    push hl
    ld hl,(eqBuffer)
    ex de,hl
    pop hl
    ld bc,ENUM_ENTRY
    call kdStore
    jp c,kdBad
    ld hl,(eqBuffer)
    ld de,ENUM_ENTRY
    add hl,de
    ld (eqBuffer),hl
    ld hl,(KD_OBJECT+ENUM_REQUEST.count)
    inc hl
    ld (KD_OBJECT+ENUM_REQUEST.count),hl
    ld a,(eqLeft)
    dec a
    ld (eqLeft),a
    jp nz,eqNext
    jp eqPublish
eqEnd:
    or a
    jp nz,eqError
    ld a,1
    ld (KD_OBJECT+ENUM_REQUEST.state),a
    jp eqPublish
eqOpen:
    ld hl,(eqNextHandle)
    ld a,h
    or l
    jp z,kdBad
    ld hl,(KD_OBJECT+ENUM_REQUEST.path)
    call kdFetchPath
    jp c,kdBad
    ld a,(KD_OBJECT+ENUM_REQUEST.flags)
    ld c,a
    ld hl,KD_PATH
    ld a,ENUM_OPEN
    call enumRun
    jp c,eqError
    call memoryOwnerCurrent
    ld (eqOwner),a
    ld hl,(eqNextHandle)
    ld (eqHandle),hl
    ld (KD_OBJECT),hl
    inc hl
    ld (eqNextHandle),hl
    xor a
    ld (KD_OBJECT+ENUM_REQUEST.state),a
    jp eqPublish
eqClose:
    ld a,ENUM_CLOSE
    call enumRun
    ld hl,0
    ld (KD_OBJECT),hl
eqPublish:
    xor a
eqError:
    push af
    ld hl,(kdClientObject)
    ex de,hl
    ld hl,KD_OBJECT
    ld bc,ENUM_REQUEST
    call kdStore
    pop bc
    jp c,kdBad
    push bc
    pop af
    call kdCapture
    jp kdRestorePointer
enumReleaseOwner:
    ld a,(enumActive)
    or a
    ret z
    ld a,(eqOwner)
    cp c
    ret nz
    xor a
    ld (enumActive),a
    ret
