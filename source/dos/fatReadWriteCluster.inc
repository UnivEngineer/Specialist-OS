;----------------------------------------------------------------------------
; MXOS
;
; Чтение номера кластера из таблицы fat
;
; вход:
;   de = номер ячейки, чтобы прочитать
;
; выход:
;   de = номер кластера, прочитанный из ячейки
;   hl, bc, a - сохраняются
;
; СИ аналог:
;   de = fat[de];
;
; 2022-02-04 SpaceEngineer
;----------------------------------------------------------------------------

fatReadCluster:
            push    hl

            ; вычисляем адрес ячейки, куда указывает de
            xor     a ; флаг - сектор fat не будет модифицироваться
            call    getFatCellAddress

            ; читаем в de номер кластера из fat по адресу hl
            ld      e, (hl)
            inc     hl
            ld      d, (hl)

            ; восстанавливаем регистры и выходим
            pop     hl
            ret

;----------------------------------------------------------------------------
; MXOS
;
; Запись номера кластера в таблицу fat и переход на следующий адрес ячейки
;
; вход:
;   hl = номер ячейки fat, куда писать
;   de = номер кластера, чтобы записать
;
; выход:
;   hl = de
;   bc, a - сохраняются
;
; СИ аналог:
;   fat[de] = hl;
;   hl = de;
;
; 2022-02-04 SpaceEngineer
;----------------------------------------------------------------------------

fatWriteCluster:
            ; вычисляем адрес ячейки, куда указывает hl
            push    de
            ex      hl, de
            ld      a, 1 ; флаг - сектр fat будет модифицироваться
            call    getFatCellAddress
            pop     de

            ; записываем номер кластера из de в fat по адресу hl
            ld      (hl), e
            inc     hl
            ld      (hl), d

            ; hl = de
            ld      h, d
            ld      l, e
            ret

;----------------------------------------------------------------------------
; MXOS
;
; Освобождение кластера в таблице fat
;
; вход:
;   de = номер кластера
;
; выход:
;   de = номер следующего кластера
;   hl, bc, a - сохраняются
;
; СИ аналог:
;   fat[de] = 0x0000;
;
; 2022-02-04 SpaceEngineer
;----------------------------------------------------------------------------

fatFreeCluster:
            push    hl

            ; вычисляем адрес ячейки, куда указывает hl
            push    de
            ex      hl, de
            ld      a, 1 ; флаг - сектор fat будет модифицироваться
            call    getFatCellAddress
            pop     de

            ; читаем номер кластера из fat, и сразу записываем туда нули
            ld      e, (hl)
            ld      (hl), 0
            inc     hl
            ld      d, (hl)
            ld      (hl), 0

            ; восстанавливаем регистры и выходим
            pop     hl
            ret


