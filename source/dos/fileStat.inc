; Получить метаданные найденного файла, сохранив входное имя.

;----------------------------------------------------------------------------
; MXOS
;
; Дополнить поле имени метаданными найденного файла.
;
; вход:
;   hl указывает на доступный для записи FILE_DESCRIPTOR с заполненным именем. Текущий
;   том и каталог уже выбраны.
;
; выход:
;   При cf = 0 поля от attrib до конца структуры скопированы из каталога, имя и
;   расширение сохранены. При cf = 1 поиск завершился ошибкой.
;----------------------------------------------------------------------------

fatFileLoadInfo:
            ; Ищем файл с именем в hl
            call    fileFind
            ret c

; ---------------------------------------------------------------------------

;----------------------------------------------------------------------------
; MXOS
;
; Скопировать метаданные уже найденной записи каталога в дескриптор.
;
; вход:
;   hl = адрес дескриптора назначения, v_foundDescrPtr = действительный адрес найденной
;   записи.
;
; выход:
;   Байты от FILE_DESCRIPTOR.attrib до конца дескриптора обновлены. cf = 0. bc, de и hl
;   сохранены.
;----------------------------------------------------------------------------

fileLoadExit:
            ; Сохраняем регистры
            push    hl
            push    bc
            push    de

            ; de = указатель на первое поле после расширения
            ld      bc, FILE_DESCRIPTOR.attrib
            add     hl, bc
            ex      de, hl

            ; Информация о файле, исключая имя
            ld      hl, (v_foundDescrPtr)
            add     hl, bc

            ; Копируем дескриптор из hl в de, исключая имя и расширение
            ld      b, FILE_DESCR_SIZE - FILE_NAME_LENGTH - 3
fileLoadCDLoop:
            ld      a, (hl)
            ld      (de), a
            inc     hl
            inc     de
            dec     b
            jp nz,  fileLoadCDLoop

            ; Выход CF=0
            or      a
            jp      popDBH_ret
