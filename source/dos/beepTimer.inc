;----------------------------------------------------------------------------
; MXOS2
; Звуковой сигнал через ВИ53 с интерфейсом RAMFOS beep.
;
; Вход:
;   DE — делитель частоты канала 0;
;   BC — длительность в формате RAMFOS;
;   CF — ждать завершения предыдущего сигнала;
;   ZF — ждать завершения текущего сигнала.
; Выход:
;   регистры и флаги сохранены.
;
; Канал 0 формирует несущую, канал 1 тактирует длительность с частотой
; 100 Гц, OUT2 канала 2 аппаратно закрывает GATE0. Как и RAMFOS, канал 2
; работает в режиме младшего байта: сначала записывается C, затем B.
; Процедура перенастраивает все три канала ВИ53 и выключает старый звук PC5.
; Размер — 46 байт. Неблокирующий путь CF=0/ZF=0 занимает 197 тактов
; (около 98,5 мкс при 2 МГц), делает девять записей в ВИ53 и одну в ВВ55.
; Ожидающий путь не ограничен по времени сигнала; цикл опроса — 30 тактов
; и одно чтение ВВ55 на итерацию.
;----------------------------------------------------------------------------

beepTimer:
            ; RAMFOS сначала дожидается предыдущего сигнала, если установлен CF.
            call c, beepTimerWait

            push af
            push hl

            ld      a, 00Ah
            ld      (IO_KEYB_MODE), a

            ld      hl, IO_TIMER_MODE
            ld      (hl), 036h          ; Канал 0: слово, режим 3.
            ld      (hl), 076h          ; Канал 1: слово, режим 3.
            ld      (hl), 090h          ; Канал 2: младший байт, режим 0.

            dec     hl                  ; IO_TIMER_CH2
            dec     hl                  ; IO_TIMER_CH1
            ld      (hl), 020h
            ld      (hl), 04Eh          ; 20000 от 2 МГц = 100 Гц.
            dec     hl                  ; IO_TIMER_CH0
            ld      (hl), e
            ld      (hl), d
            inc     hl
            inc     hl                  ; IO_TIMER_CH2
            ld      (hl), c
            ld      (hl), b

            pop     hl
            pop     af

            ; RAMFOS ожидает текущий сигнал только при установленном ZF.
            ret nz

beepTimerWait:
            push af
beepTimerWaitLoop:
            ld      a, (IO_PROG_A)      ; Бит 0 аппаратно связан с OUT2 ВИ53.
            and     1
            jp z,   beepTimerWaitLoop
            pop     af
            ret
