; C42Dh: HL=начало, DE=конец исключительно, BC=назначение.
; Копирование с перекрытием; DE сохраняется, HL=конец, BC=конец назначения.
; AF/флаги разрушаются. Код основного движка вынесен из фиксированного окна.
memcpy_bc_hl:
            push    de
            call    moveCore
            pop     de
            ret
