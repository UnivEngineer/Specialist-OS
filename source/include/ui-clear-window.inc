uiClearWindow:
    ld c,a
    ld a,(hl)
    ld b,a
    and 80h
    jp z,uiClearWindowRelative
    ld c,0
uiClearWindowRelative:
    ld a,b
    and 10h
    ld e,3
    jp z,uiClearWindowInset
    ld e,5
uiClearWindowInset:
    inc hl
    ld a,(hl)
    add a,e
    ld d,a
    inc hl
    ld a,(hl)
    sub 90h
    add a,c
    ld c,a
    inc hl
    ld a,e
    add a,a
    sub 6
    ld b,a
    ld a,(hl)
    sub b
    ld e,a
    inc hl
    ld b,(hl)
    inc b
    push de
    ld l,c
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,4
    add hl,de
    push hl
    ld l,b
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld b,h
    ld c,l
    pop hl
    pop de
    xor a
    jp uiFillRectPixels
