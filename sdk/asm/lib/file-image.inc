; Optional native-container loader for tools. Uses the local file-io library.
; HL=short-name descriptor. Returns HL=entry, DE=load, BC=body length.
fileReadImage:
    push hl
    call flClear
    pop hl
    ld de,flHandle
    ld b,FILE_DESCRIPTOR
fiCopyName:
    ld a,(hl)
    ld (de),a
    inc hl
    inc de
    dec b
    jp nz,fiCopyName
    ld a,DIR_OP_RESOLVED
    MXOS_CALL_REGS MXOS_DOS_DIRECTORY
    ex de,hl
    ld (flHandle+FH_SEEK),hl
    ld de,0
    MXOS_CALL_REGS MXOS_DOS_FILE_GET_SET_DRIVE
    ld (flHandle+FH_DRIVE),a
    ld a,FILE_MODE_READ
    ld (flHandle+FH_MODE),a
    ld a,FILE_OP_OPEN_AT
    call flCall
    ret c
    ld hl,fiHeader
    ld (flHandle+FH_BUFFER),hl
    ld hl,IMAGE_HEADER_SIZE
    ld (flHandle+FH_COUNT),hl
    ld a,FILE_OP_READ
    call flCall
    jp c,flClose
    ld hl,(flHandle+FH_COUNT)
    ld a,l
    cp IMAGE_HEADER_SIZE
    jp nz,fiBad
    ld hl,fiHeader
    ld de,fiMagic
    ld b,5
fiMagicLoop:
    ld a,(de)
    cp (hl)
    jp nz,fiBad
    inc hl
    inc de
    dec b
    jp nz,fiMagicLoop
    ld a,(fiHeader+5)
    cp IMAGE_FLAG_MAIN
    jp z,fiFlagsReady
    cp IMAGE_FLAG_BANK+1
    jp nc,fiBad
fiFlagsReady:
    ld hl,fiHeader
    ld de,fiHeader+IMAGE_HEADER_CHECKSUM-1
    call bios_calcCS
    ld hl,(fiHeader+IMAGE_HEADER_CHECKSUM)
    ld a,h
    cp b
    jp nz,fiBad
    ld a,l
    cp c
    jp nz,fiBad
    ld hl,(flHandle+FILE_DESCRIPTOR.size+2)
    ld a,h
    or l
    jp nz,fiBad
    ld hl,(fiHeader+10)
    ld a,h
    or l
    jp z,fiBad
    ld de,IMAGE_HEADER_SIZE
    add hl,de
    jp c,fiBad
    push hl
    ld hl,(flHandle+FILE_DESCRIPTOR.size)
    ex de,hl
    pop hl
    ld a,h
    cp d
    jp nz,fiBad
    ld a,l
    cp e
    jp nz,fiBad
    ld hl,(fiHeader+6)
    ld (flHandle+FH_BUFFER),hl
    ld hl,(fiHeader+10)
    ld (flHandle+FH_COUNT),hl
    ld a,FILE_OP_READ
    call flCall
    jp c,flClose
    ld hl,(flHandle+FH_COUNT)
    push hl
    ld hl,(fiHeader+10)
    ex de,hl
    pop hl
    ld a,h
    cp d
    jp nz,fiBad
    ld a,l
    cp e
    jp nz,fiBad
    ld hl,(fiHeader+6)
    add hl,de
    jp c,fiBad
    dec hl
    ex de,hl
    ld hl,(fiHeader+6)
    call bios_calcCS
    ld hl,(fiHeader+12)
    ld a,h
    cp b
    jp nz,fiBad
    ld a,l
    cp c
    jp nz,fiBad
    xor a
    call flClose
    ret c
    ld hl,(fiHeader+6)
    ex de,hl
    ld hl,(fiHeader+10)
    ld b,h
    ld c,l
    ld hl,(fiHeader+8)
    or a
    ret
fiBad:
    ld a,DOS_ERR_BAD_IMAGE
    scf
    jp flClose
fiMagic:
    MXOS_IMAGE_SIGNATURE
fiHeader: DS IMAGE_HEADER_SIZE,0
