--- a/source/bios/bankText.inc
+++ b/source/bios/bankText.inc
@@ -7,53 +7,44 @@ window:
 ;----------------------------------------------------------------------------
 ; MXOS
 ; Печать порции без копирования. До возврата движок не занимает окно.
-; вход: HL = BANK_WINDOW, BC = длина 1..32, A = D = режим 0, 1, 2 или 8.
-; Для Z и RAW_Z инициатор уже исключил завершающий NUL из длины.
-; выход: HL сразу за выведенными байтами. Остальные регистры рабочие.
+; вход: HL = BANK_WINDOW, BC = длина до 32, A = D = режим 0, 1, 2 или 8.
+; Для всех режимов BC — точное число байтов. Отправитель Z и RAW_Z
+; уже остановился на NUL и исключил его из длины.
+; выход: C сохраняется.
 ;----------------------------------------------------------------------------
 printWindow:
     cp 2
     jp z,bios_printStringRawLim
-    jp nc,bios_printStringRawPseudo
-    ; Оставляем старым перехватчикам Z их собственный способ рисования.
+    jp c,printKnown
+    cp TEXT_PRINT_LIM
+    jp z,bios_printStringLim
+    jp bios_printStringRawPseudo
+printKnown:
     or a
-    ld hl,(bios_printStringZ+1)
+    ld hl,bios_printStringZ
     ld de,FONT_ENGINE_Z+1
     jp z,windowVector
-    ld hl,(bios_printStringRawZ+1)
+    ld hl,bios_printStringRawZ
     ld de,FONT_ENGINE_RAWZ+1
 windowVector:
     ld b,a
-    ld a,(de)
-    cp l
-    jp nz,windowLegacy
-    inc de
-    ld a,(de)
-    cp h
+    call fontVectorMatches
     jp nz,windowLegacy
     ld a,b
     or a
     ld b,0
     ld hl,BANK_WINDOW
     jp nz,FONT_ENGINE_LIM
-    ld hl,(FONT_ENGINE_TEXT_EXT)
-    ld a,h
-    cp FONT_ENGINE_TEXT_LIM >> 8
-    jp nz,windowLegacy
-    ld a,l
-    cp FONT_ENGINE_TEXT_LIM & 0FFh
+    call textLimCapability
     ld hl,BANK_WINDOW
     jp z,FONT_ENGINE_TEXT_LIM
 windowLegacy:
     ld d,b
-    ld b,0
     ld hl,BANK_WINDOW
     ld a,c
     cp BANK_TEXT_BYTES
     ld a,d
     jp nz,window
-    ; Прежний вектор принимает только ASCIIZ. Печатаем 31+1 через этот же
-    ; вектор. Последний код сохранён в E, после первого вызова HL = FFDFh.
     ld a,(BANK_WINDOW+BANK_TEXT_BYTES-1)
     ld e,a
     xor a
@@ -61,11 +52,61 @@ windowLegacy:
     ld a,d
     call window
     dec hl
+    ld b,(hl)
     ld (hl),e
     ld a,d
     call window
+    ld (hl),e
+    dec hl
+    ld (hl),b
+    ret
+
+; HL — публичный вектор, DE — адрес операнда штатного JMP движка.
+; Z=1 только при совпадении самого JMP и обоих байтов операнда.
+fontVectorMatches:
+    ld a,(hl)
+    cp 0C3h
+    ret nz
     inc hl
+    ld a,(de)
+    cp (hl)
+    ret nz
+    inc de
+    inc hl
+    ld a,(de)
+    cp (hl)
+    ret
+textLimCapability:
+    ld hl,(FONT_ENGINE_TEXT_EXT)
+    ld de,-FONT_ENGINE_TEXT_LIM
+    add hl,de
+    ld a,h
+    or l
     ret
+
+;----------------------------------------------------------------------------
+; MXOS
+; Печать ровно BC байт с управляющими кодами через активный шрифт.
+; вход: HL — буфер MAIN, BC — точная длина (00h тоже управляющий код).
+; выход: HL — исключающий конец, AF/BC/DE сохранены.
+;----------------------------------------------------------------------------
+printStringLim:
+    push af
+    push de
+    push hl
+    ld hl,bios_printChar
+    ld de,FONT_ENGINE_CHAR+1
+    call fontVectorMatches
+    call z,textLimCapability
+    pop hl
+    pop de
+    jp nz,printStringLimLegacy
+    pop af
+    jp FONT_ENGINE_TEXT_LIM
+printStringLimLegacy:
+    pop af
+    jp BIOS_BANK_GATE_ADDR+14h
+
 ; Принимающий адаптер уже сохранил пакет и установил main-стек.
 fromBank:
     ld a,(io_vars.bbPage)
@@ -180,17 +221,12 @@ print:
     ld c,l
     ld hl,(destination)
     ld a,(kind)
-    or a
-    jp z,printZ
-    dec a
-    jp z,printRawZ
-    call bios_printStringRawLim
-    jp printed
-printZ:
-    call bios_printStringZ
+    cp TEXT_PRINT_RAW_LIM
+    jp z,printRawLim
+    call window
     jp printed
-printRawZ:
-    call bios_printStringRawZ
+printRawLim:
+    call bios_printStringRawLim
 printed:
     push hl
     ld hl,(destination)
