@@ -5,6 +5,11 @@
 ; memcpy_far временно использует всё окно как данные COPY.
 ; FAR: FAR-код, младший и старший байты смещения;
 ; номер банка: 0=main, 1..16=банки ДОЗУ.
+    MACRO COPY_TINY_WORD lo_byte, hi_byte
+    ld hl,0 + ((lo_byte) | ((hi_byte) << 8))
