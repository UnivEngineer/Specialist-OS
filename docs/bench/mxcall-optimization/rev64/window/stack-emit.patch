+; Верхние слова остаточного трамплина. SP=FFE0h, A=число байт.
+; Каждый PUSH создаёт два байта потока команд, исполнение начнётся после
+; восстановления исходного SP в bankCopyTinyResume. FFDCh–FFDFh содержат
+; старший байт JP, счётчик, резерв и профиль COPY.
+copyTinyBuild:
+    COPY_TINY_WORD 0,BANK_PROFILE_COPY
+    ld h,a
+    ld l,bankCopyOK >> 8                      ; JP bankCopyOK: старший байт / счётчик
+    push hl
+    COPY_TINY_WORD 0C3h,bankCopyOK & 255       ; JP bankCopyOK: код и младший байт
+    ld hl,(bankCopyPairs+4)
+    ld a,l
+    ld l,036h                                ; MVI M,селектор исходного банка
+    push hl
+    ld l,a
+    ld h,0FFh                                ; Адрес регистра исходного банка
+    push hl
+    COPY_TINY_WORD BANK_WINDOW >> 8,021h      ; JP NZ: старший байт / LXI H
+    jp bankCopyTinyResume
     ASSERT $ <= MEM_COPY_QUADS_ENTRY
     DS MEM_COPY_QUADS_ENTRY-$,0
