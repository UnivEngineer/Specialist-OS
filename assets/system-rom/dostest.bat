@ECHO OFF
ECHO DOS TEST - FILE OPERATIONS ON RAM DISK B:
MD B:/DOSTEST/TEMP
COPY C:/TESTS/DOSTEST.TXT B:/DOSTEST/TEST.TXT
REN B:/DOSTEST/TEST.TXT B:/DOSTEST/SAMPLE.TXT
ATTRIB +R B:/DOSTEST/SAMPLE.TXT
ATTRIB B:/DOSTEST/SAMPLE.TXT
DIR B:/DOSTEST
ATTRIB -R B:/DOSTEST/SAMPLE.TXT
MOVE B:/DOSTEST/SAMPLE.TXT B:/DOSTEST/TEMP/SAMPLE.TXT
ECHO KOI-7R
C:/DOS/FONT.COM 6x8/K7Rotate
TYPE B:/DOSTEST/TEMP/SAMPLE.TXT
C:/DOS/FONT.COM 6x8/Rotate
ECHO KOI-8
TYPE B:/DOSTEST/TEMP/SAMPLE.TXT
ECHO FILE TEST COMPLETE. PRESS A KEY TO CLEAN UP.
PAUSE
DEL B:/DOSTEST/TEMP/SAMPLE.TXT
RD B:/DOSTEST/TEMP
RD B:/DOSTEST
ECHO DOS TEST OK
PAUSE
