          "${workspaceFolder}\\scripts\\build\\build-if-needed.ps1",
          "DOSChecked",
          "sys",
          "0xC000",
          "DOS"
        ],
        "options": {
          "cwd": "${workspaceFolder}\\source\\dos"
        },
        "problemMatcher": "$errmatcher-sjasmplus",
        "group": "build",
        "presentation": {
          "reveal": "always",
          "focus": false,
          "panel": "shared",
          "clear": false
        }
