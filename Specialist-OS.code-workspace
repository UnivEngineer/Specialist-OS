{
  "folders": [
    {
      "name": "Specialist-OS",
      "path": "."
    }
  ],
  "extensions": {
    "recommendations": [
      "mborik.z80-macroasm"
    ]
  },
  "settings": {
    "files.encoding": "utf8",
    "files.autoGuessEncoding": true,
    "files.eol": "\r\n",
    "files.insertFinalNewline": false,
    "files.trimFinalNewlines": false,
    "files.trimTrailingWhitespace": false,
    "files.associations": {
      "*.lst": "plaintext",
      "*.fix.lst": "plaintext"
    },
    "explorer.compactFolders": false,
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.detectIndentation": true,
    "z80-macroasm.files.include": "**/*.{asm,inc}",
    "z80-macroasm.files.exclude": "**/*.{lst,fix.lst}",
    "z80-macroasm.seekSymbolsThroughWorkspace": true,
    "z80-macroasm.suggestOnInstructions": true,
    "z80-macroasm.format.enabled": false,
    "task.autoDetect": "off",
    "python.analysis.languageServerMode": "light",
    "python.analysis.exclude": [
      "**"
    ],
    "python.analysis.indexing": false,
    "search.exclude": {
      "**/.vs/**": true,
      "**/*.lst": true,
      "**/*.fix.lst": true
    },
    "files.watcherExclude": {
      "**/.vs/**": true,
      "**/*.lst": true,
      "**/*.fix.lst": true
    },
    "cSpell.words": [
      "AUTOEXEC",
      "MXOS"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "build: all",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\build\\build-all.ps1"
        ],
        "problemMatcher": "$errmatcher-sjasmplus",
        "group": "build"
      },
      {
        "label": "run: Emu80 H-Flash2M",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\emu80\\run-built-profile.ps1",
          "Flash2M"
        ],
        "problemMatcher": "$errmatcher-sjasmplus",
        "group": "build"
      },
      {
        "label": "run: Emu80 fresh A:",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder}\\scripts\\emu80\\run-built-profile.ps1",
          "Floppy720"
        ],
        "problemMatcher": [],
        "group": "build"
      },
      {
        "label": "mount: ImDisk A: (read/write)",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\emu80\\imdisk-floppy.ps1",
          "Mount"
        ],
        "problemMatcher": []
      },
      {
        "label": "unmount: ImDisk A:",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\emu80\\imdisk-floppy.ps1",
          "Unmount"
        ],
        "problemMatcher": []
      },
      {
        "label": "run: Emu80 H-Flash2M (no build)",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder}\\scripts\\emu80\\run.ps1",
          "-Flash",
          "-UpdateSystemFlash"
        ],
        "problemMatcher": [],
        "group": "build"
      },
      {
        "label": "run: Emu80 H-Flash2M (MCP slot, no build)",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\emu80\\run-mcp-slot.ps1",
          "-Port",
          "${input:emu80McpPort}"
        ],
        "problemMatcher": [],
        "group": "build"
      },
      {
        "label": "run: Emu80 H-ROM64k (no build)",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\emu80\\run.ps1"
        ],
        "problemMatcher": [],
        "group": "build"
      },
      {
        "label": "run: Emu80 CP/M",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\emu80\\run-built-profile.ps1",
          "CPM"
        ],
        "problemMatcher": [],
        "group": "build"
      },
      {
        "label": "run: Emu80 RAMFOS",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\emu80\\run-built-profile.ps1",
          "RAMFOS"
        ],
        "problemMatcher": [],
        "group": "build"
      }
    ],
    "inputs": [
      {
        "id": "emu80McpPort",
        "type": "pickString",
        "description": "Свободный порт локального Emu80 MCP",
        "options": [
          "19781",
          "19782",
          "19783",
          "19784"
        ]
      }
    ]
  }
}
