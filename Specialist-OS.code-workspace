{
  "folders": [
    {
      "name": "Specialist-OS",
      "path": "."
    }
  ],
  "extensions": {
    "recommendations": [
      "mborik.z80-macroasm"
    ]
  },
  "settings": {
    "files.autoGuessEncoding": true,
    "files.eol": "\r\n",
    "files.insertFinalNewline": false,
    "files.trimFinalNewlines": false,
    "files.trimTrailingWhitespace": false,
    "files.associations": {
      "*.lst": "plaintext",
      "*.fix.lst": "plaintext"
    },
    "explorer.compactFolders": false,
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.detectIndentation": true,
    "z80-macroasm.files.include": "**/*.{asm,inc}",
    "z80-macroasm.files.exclude": "**/*.{lst,fix.lst}",
    "z80-macroasm.seekSymbolsThroughWorkspace": true,
    "z80-macroasm.suggestOnInstructions": true,
    "z80-macroasm.format.enabled": false,
    "search.exclude": {
      "**/.vs/**": true,
      "**/*.lst": true,
      "**/*.fix.lst": true,
      "**/Release/**/*.tlog/**": true,
      "**/Release/**/*.lastbuildstate": true,
      "**/Release/**/*.recipe": true,
      "**/Release/**/*.log": true
    },
    "files.watcherExclude": {
      "**/.vs/**": true,
      "**/*.lst": true,
      "**/*.fix.lst": true,
      "**/Release/**/*.tlog/**": true
    }
  },
