{
  "folders": [
    {
      "name": "Specialist-OS",
      "path": "."
    }
  ],
  "extensions": {
    "recommendations": [
      "mborik.z80-macroasm"
    ]
  },
  "settings": {
    "files.encoding": "utf8",
    "files.autoGuessEncoding": true,
    "files.eol": "\r\n",
    "files.insertFinalNewline": false,
    "files.trimFinalNewlines": false,
    "files.trimTrailingWhitespace": false,
    "files.associations": {
      "*.lst": "plaintext",
      "*.fix.lst": "plaintext"
    },
    "explorer.compactFolders": false,
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.detectIndentation": true,
    "z80-macroasm.files.include": "**/*.{asm,inc}",
    "z80-macroasm.files.exclude": "**/*.{lst,fix.lst}",
    "z80-macroasm.seekSymbolsThroughWorkspace": true,
    "z80-macroasm.suggestOnInstructions": true,
    "z80-macroasm.format.enabled": false,
    "task.autoDetect": "off",
    "python.analysis.languageServerMode": "light",
    "python.analysis.exclude": [
      "**"
    ],
    "python.analysis.indexing": false,
    "search.exclude": {
      "**/.vs/**": true,
      "**/*.lst": true,
      "**/*.fix.lst": true
    },
    "files.watcherExclude": {
      "**/.vs/**": true,
      "**/*.lst": true,
      "**/*.fix.lst": true
    },
    "cSpell.words": [
      "AUTOEXEC",
      "MXOS"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build all",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\build\\build-all.ps1"
        ],
        "problemMatcher": "$errmatcher-sjasmplus",
        "group": "build"
      },
      {
        "label": "Build and run Emu80 MMX Flash + floppy",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\emu80\\run-profile.ps1",
          "MMX Flash + floppy",
          "-Build"
        ],
        "problemMatcher": "$errmatcher-sjasmplus",
        "group": "build"
      },
      {
        "label": "Run Emu80 MMX Flash + floppy",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\emu80\\run-profile.ps1",
          "MMX Flash + floppy"
        ],
        "problemMatcher": [],
        "group": "build"
      },
      {
        "label": "Build and run Emu80 MX ROM + floppy",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\emu80\\run-profile.ps1",
          "MX ROM + floppy",
          "-Build"
        ],
        "problemMatcher": "$errmatcher-sjasmplus",
        "group": "build"
      },
      {
        "label": "Run Emu80 MX ROM + floppy",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\emu80\\run-profile.ps1",
          "MX ROM + floppy"
        ],
        "problemMatcher": [],
        "group": "build"
      },
      {
        "label": "Build and run Emu80 RAMFOS",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\emu80\\run-profile.ps1",
          "RAMFOS",
          "-Build"
        ],
        "problemMatcher": "$errmatcher-sjasmplus",
        "group": "build"
      },
      {
        "label": "Run Emu80 RAMFOS",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\emu80\\run-profile.ps1",
          "RAMFOS"
        ],
        "problemMatcher": [],
        "group": "build"
      }
    ]
  }
}
