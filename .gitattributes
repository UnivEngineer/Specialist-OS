# Бинарные проекты и документы сохраняем побайтно.
hardware/**/*.dch binary
hardware/**/*.dip binary
hardware/**/*.pdf binary
# Сохраняем оригинальные байты экспорта для проверки манифеста импорта.
hardware/**/*.dchxml -text diff
hardware/import-notes.md -text
# Текстовые ресурсы образов: сохраняем кодировку и окончания строк побайтно.
# Регистр расширения не влияет на защиту; манифесты в scripts/ не затрагиваются.
assets/**/*.[tT][xX][tT] -text
assets/**/*.[bB][aA][tT] -text
assets/**/*.[hH][lL][pP] -text
# Архивные пары CPU/I80 для «Специалиста-MX» сохраняем побайтно.
assets/games/mx/*.[cC][pP][uU] -text
assets/games/mx/*.[iI]80 binary
assets/games/families/starwars/originals/StarWars2-mx.cpu -text
assets/games/families/starwars/originals/StarWars2-mx.i80 binary
source-emulators/emu80/*.patch text eol=lf
