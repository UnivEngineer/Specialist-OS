+    json Tool_MxAudio(const json& args)
+    {
+        const std::string action = args.at("action").get<std::string>();
+        json result;
+        std::string error;
+        const bool ok = mcp::Run([&] {
+            if (action == "start") {
+                if (mxAudioActive || g_emulation->getSpeedUpFactor() != 1.0 ||
+                    g_emulation->getFullThrottleState()) {
+                    error = "start requires normal speed and an idle recorder";
+                    return;
+                }
+                mxAudioPcm.clear();
+                mxAudioRate = g_emulation->getSampleRate();
+                mxAudioActive = true;
+                mxAudioTruncated = false;
+                result = { {"rate", mxAudioRate} };
+            } else if (action == "stop" && mxAudioActive) {
+                mxAudioActive = false;
+                result = { {"rate", mxAudioRate}, {"samples", mxAudioPcm.size() / 2},
+                           {"truncated", mxAudioTruncated}, {"pcm_base64", Base64(mxAudioPcm.data(), mxAudioPcm.size())} };
+            } else {
+                error = "invalid audio action or no active recorder";
+            }
+        });
+        if (!ok) throw std::runtime_error("emulator main thread is not ready");
+        if (!error.empty()) throw std::runtime_error(error);
+        return result;
+    }
+
+    json Tool_EmuSpeed(const json& args)
+    {
+        const int factor = args.at("factor").get<int>();
+        if (factor < 1 || factor > 32)
+            throw std::runtime_error("factor must be in 1..32");
+        bool busy = false;
+        const bool ok = mcp::Run([&] {
+            busy = mxAudioActive || g_emulation->getFullThrottleState();
+            if (!busy) g_emulation->setTemporarySpeedUpFactor(factor);
+        });
+        if (!ok) throw std::runtime_error("emulator main thread is not ready");
+        if (busy) throw std::runtime_error("speed unavailable during audio capture or full throttle");
+        return json{ {"factor", factor} };
+    }
