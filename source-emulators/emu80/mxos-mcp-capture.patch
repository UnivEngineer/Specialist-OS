+
+void mcpCaptureMxSample(int value)
+{
+    if (!mxAudioActive) return;
+    if (mxAudioPcm.size() >= static_cast<size_t>(mxAudioRate) * 4) {
+        mxAudioTruncated = true;
+        return;
+    }
+    mxAudioPcm.push_back(static_cast<uint8_t>(value));
+    mxAudioPcm.push_back(static_cast<uint8_t>(value >> 8));
+}
 
