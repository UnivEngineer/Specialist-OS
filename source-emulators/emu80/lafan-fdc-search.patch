+uint64_t Fdc1793::diskIndex() const
+{
+    // Период индексного импульса в существующей модели — 200 мс.
+    return g_emulation->getCurClock() * 5 / g_emulation->getFrequency();
+}
+
+
+void Fdc1793::startReadSearch()
+{
+    m_accessMode = FAM_SECTOR_SEARCH;
+    m_searchIndex = diskIndex();
+    m_status = 0x01; // Поиск следующего ID поля: BUSY без запроса данных.
+}
+
+
+void Fdc1793::finishReadSearch()
+{
+    if (m_accessMode != FAM_SECTOR_SEARCH || diskIndex() - m_searchIndex < 5)
+        return;
+    m_accessMode = FAM_WAITING;
+    m_status = 0x10; // Не найдено за пять индексных импульсов.
+    generateInt();
+}
