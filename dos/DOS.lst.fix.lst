 72+  CA71              execExeCom:
 73+  CA71                          ; Вытаскиваем из стека текущий адрес командной строки (начало списка аргументов)
 74+  CA71 D1                       pop     de
 75+  CA72
 76+  CA72                          ; Загрузить файл
 77+  CA72 21 DF D3                 ld      hl, v_curFileDescr
 78+  CA75 CD 09 D0                 call    fileLoad
 79+  CA78 DA 8C CA                 jp c,   badCommand
 80+  CA7B
 81+  CA7B                          ; Адрес командной строки
 82+  CA7B D5                       push    de
 83+  CA7C
 84+  CA7C                          ; Выводим на экран 0Ah
 85+  CA7C                          ;call printCharA
