106   CBA6                  INCLUDE "installDriver.inc"
  1+  CBA6              ;+---------------------------------------------------------------------------
  2+  CBA6              ; MXOS
  3+  CBA6              ; Установить драйвер устройства
  4+  CBA6              ;
  5+  CBA6              ; На входе
  6+  CBA6              ;  a - диск
  7+  CBA6              ;  hl - адрес драйвера
  8+  CBA6              ;
  9+  CBA6              ; На выходе
 10+  CBA6              ;  hl - адрес структуры DISK_INFO
 11+  CBA6              ;
 12+  CBA6              ; 2013-12-12 Дизассемблировано vinxru
 13+  CBA6              ;----------------------------------------------------------------------------
 14+  CBA6
 15+  CBA6              installDriver:    ; Сохранение регистров
 16+  CBA6 D5                       push de
 17+  CBA7 E5                       push hl
 18+  CBA8
 19+  CBA8                          ; Максимум дисков
 20+  CBA8 E6 07                    and 7
 21+  CBAA
 22+  CBAA                          ; Вычисление адреса в таблице дисков
 23+  CBAA 87                       add   a, a
 24+  CBAB 6F                       ld    l, a
 25+  CBAC 26 00                    ld    h, 0
 26+  CBAE 11 DB D2                 ld    de, v_drives
 27+  CBB1 19                       add   hl, de
 28+  CBB2
 29+  CBB2                          ; Установка драйвера
 30+  CBB2 D1                       pop   de
 31+  CBB3 73                       ld  (hl), e
 32+  CBB4 23                       inc   hl
 33+  CBB5 72                       ld  (hl), d
 34+  CBB6
 35+  CBB6                          ; Восстановление регистров
 36+  CBB6 EB                       ex  de, hl
 37+  CBB7 D1                       pop de
 38+  CBB8 0F                       rrca
 39+  CBB9
 40+  CBB9                          ; Передача адреса структуры v_diskInfo
 41+  CBB9 21 EB D2                 ld  hl, v_diskInfo
 42+  CBBC
 43+  CBBC                          ; Выход
 44+  CBBC C9                       ret
 45+  CBBD
107   CBBD                  INCLUDE "fileGetSetDrive.inc"
  1+  CBBD              ;+---------------------------------------------------------------------------
  2+  CBBD              ; MXOS
  3+  CBBD              ; Получение/установка текущего накопителя.
  4+  CBBD              ; В режиме 1 функция переключает драйвер накопителя.
  5+  CBBD              ;
  6+  CBBD              ; На входе
  7+  CBBD              ;   e  - 0=чтение, 1=установка
  8+  CBBD              ;   a  - накопитель от 0 до 7
  9+  CBBD              ;
 10+  CBBD              ; На выходе
 11+  CBBD              ;   a  - накопитель
 12+  CBBD              ;   bc, de, hl - сохраняются
 13+  CBBD              ;
 14+  CBBD              ; 2013-12-12 Дизассемблировано vinxru
 15+  CBBD              ; 2022-02-02 Доработано SpaceEngineer
 16+  CBBD              ;----------------------------------------------------------------------------
 17+  CBBD
 18+  CBBD              fileGetSetDrive:
 19+  CBBD 1D                       dec     e
 20+  CBBE CA C5 CB                 jp z,   fileSelectDrive
 21+  CBC1 3A BC D2                 ld      a, (v_drive)
 22+  CBC4 C9                       ret
 23+  CBC5
 24+  CBC5              ; ---------------------------------------------------------------------------
 25+  CBC5
 26+  CBC5              fileSelectDrive:
 27+  CBC5                          ; Максимум устройств - 1
 28+  CBC5 E6 07                    and     7
 29+  CBC7
 30+  CBC7                          ; Если устройство не менялось, выходим
 31+  CBC7 E5                       push    hl
 32+  CBC8 21 BC D2                 ld      hl, v_drive
 33+  CBCB BF BE                    cp      a, (hl)
 34+  CBCD E1                       pop     hl
 35+  CBCE C8                       ret z
 36+  CBCF
 37+  CBCF                          ; Сохраняем выбранное устройство
 38+  CBCF 32 BC D2                 ld      (v_drive), a
 39+  CBD2
 40+  CBD2                          ; Пригодится ниже (a = a * 2)
 41+  CBD2 87                       add     a, a
 42+  CBD3
 43+  CBD3                          ; Сохраняем регистры
 44+  CBD3 E5                       push    hl
 45+  CBD4 D5                       push    de
 46+  CBD5
 47+  CBD5                          ; Получаем точку входа драйвера
 48+  CBD5 6F                       ld      l, a
 49+  CBD6 26 00                    ld      h, 0
 50+  CBD8 11 DB D2                 ld      de, v_drives
 51+  CBDB 19                       add     hl, de
 52+  CBDC 5E                       ld      e, (hl)
 53+  CBDD 23                       inc     hl
 54+  CBDE 56                       ld      d, (hl)
 55+  CBDF EB                       ex      de, hl
 56+  CBE0
 57+  CBE0                          ; Сохраняем её
 58+  CBE0 22 64 C8                 ld      (j_diskDriver+1), hl
 59+  CBE3
 60+  CBE3                          ; Восстаналвиаем a
 61+  CBE3 0F                       rrca
 62+  CBE4
 63+  CBE4                          ; Очищаем кэш fat
 64+  CBE4 C5                       push    bc
 65+  CBE5 CD 5B CC                 call    resetSectorCache
 66+  CBE8 C1                       pop     bc
 67+  CBE9
 68+  CBE9                          ; Считываем загрузочный сектор и инициализируем структуру v_diskInfo
 69+  CBE9 CD 14 CE                 call    fatReadBootSector
 70+  CBEC
 71+  CBEC                          ; Восстанавливаем регистры и выходим
 72+  CBEC D1                       pop     de
 73+  CBED E1                       pop     hl
 74+  CBEE C9                       ret
 75+  CBEF
108   CBEF                  INCLUDE "strcmp.inc"
  1+  CBEF              ;----------------------------------------------------------------------------
  2+  CBEF              ; MXOS
  3+  CBEF              ; Сравнение строк, чувстсвительное к регистру
  4+  CBEF              ;
  5+  CBEF              ; вход:
  6+  CBEF              ;  de = адрес строки 1
  7+  CBEF              ;  hl = адрес строки 2
  8+  CBEF              ;  c  = длина строки
  9+  CBEF              ;
 10+  CBEF              ; выход:
 11+  CBEF              ;  zf - строки равны
 12+  CBEF              ;
 13+  CBEF              ; регистры не сохраняются!
 14+  CBEF              ;
 15+  CBEF              ; 2022-02-11 SpaceEngineer
 16+  CBEF              ;----------------------------------------------------------------------------
 17+  CBEF
 18+  CBEF              strcmp:     ; Сравнение символов
 19+  CBEF 1A                       ld      a, (de)
 20+  CBF0 BE                       cp      (hl)
 21+  CBF1 C0                       ret nz          ; если символы не равны, выходим с флагом nz
 22+  CBF2 23                       inc     hl
 23+  CBF3 13                       inc     de
 24+  CBF4
 25+  CBF4                          ; Повтор цикла
 26+  CBF4 0D                       dec     c
 27+  CBF5 C2 EF CB                 jp nz,  strcmp
 28+  CBF8
 29+  CBF8                          ; Сравнили до конца и не вышли раньше - значит, строки равны
 30+  CBF8 C9                       ret             ; выходим с флагом z
 31+  CBF9
 32+  CBF9              ;----------------------------------------------------------------------------
 33+  CBF9              ; MXOS
 34+  CBF9              ; Сравнение строк, нечувстсвительное к регистру
 35+  CBF9              ;
 36+  CBF9              ; вход:
 37+  CBF9              ;  hl = адрес строки 1
 38+  CBF9              ;  de = адрес строки 2
 39+  CBF9              ;  c  = длина строки
 40+  CBF9              ;
 41+  CBF9              ; выход:
 42+  CBF9              ;  zf = 1 - строки равны
 43+  CBF9              ;
 44+  CBF9              ; регистр bc сохраняется
 45+  CBF9              ;
 46+  CBF9              ; 2022-02-11 SpaceEngineer
 47+  CBF9              ;----------------------------------------------------------------------------
 48+  CBF9
 49+  CBF9 C5           stricmp:    push    bc
 50+  CBFA              stricmp_loop:
 51+  CBFA                          ; Читаем символ из первой строки и переводим в верхний регистр
 52+  CBFA 1A                       ld      a, (de)
 53+  CBFB CD 0F CC                 call    upperCase
 54+  CBFE 47                       ld      b, a    ; сохраняем его в b
 55+  CBFF
 56+  CBFF                          ; Читаем символ из второй строки и переводим в верхний регистр
 57+  CBFF 7E                       ld      a, (hl)
 58+  CC00 CD 0F CC                 call    upperCase
 59+  CC03
 60+  CC03                          ; Сравнение символов
 61+  CC03 B8                       cp      b
 62+  CC04 C2 0D CC                 jp nz,  stcicmp_exit    ; если символы не равны, выходим с флагом zf = 0
 63+  CC07
 64+  CC07                          ; Повтор цикла
 65+  CC07 23                       inc     hl
 66+  CC08 13                       inc     de
 67+  CC09 0D                       dec     c
 68+  CC0A C2 FA CB                 jp nz,  stricmp_loop
 69+  CC0D
 70+  CC0D                          ; Сравнили до конца и не вышли раньше - значит, строки равны
 71+  CC0D              stcicmp_exit:
 72+  CC0D C1                       pop     bc
 73+  CC0E C9                       ret             ; выходим с флагом zf = 1
 74+  CC0F
 75+  CC0F              ;----------------------------------------------------------------------------
 76+  CC0F              ; MXOS
 77+  CC0F              ; Преобразование кода символа КОИ-8 в верхний регистр.
 78+  CC0F              ;
 79+  CC0F              ; вход:
 80+  CC0F              ;  a = символ
 81+  CC0F              ;
 82+  CC0F              ; выход:
 83+  CC0F              ;  a = символ в верхнем регистре
 84+  CC0F              ;
 85+  CC0F              ; все регистры сохраняются
 86+  CC0F              ;
 87+  CC0F              ; 2022-02-11 SpaceEngineer
 88+  CC0F              ;----------------------------------------------------------------------------
 89+  CC0F
 90+  CC0F              upperCase:  ; Цифры, знаки и прописные английские буквы - не меняем
 91+  CC0F FE 61                    cp      61h
 92+  CC11 D8                       ret c
 93+  CC12
 94+  CC12                          ; Строчные английские буквы - вычитаем 20h
 95+  CC12 FE 7B                    cp      7Bh
 96+  CC14 D2 1A CC                 jp nc,  upperCase1
 97+  CC17 D6 20                    sub     20h
 98+  CC19 C9                       ret
 99+  CC1A
100+  CC1A              upperCase1: ; Буква ё - прибавляем 10h
101+  CC1A FE A3                    cp      0A3h
102+  CC1C D2 22 CC                 jp nc,  upperCase2
103+  CC1F C6 10                    add     10h
104+  CC21 C9                       ret
105+  CC22
106+  CC22              upperCase2: ; Символы псевдографики - не меняем
107+  CC22 FE C0                    cp      0C0h
108+  CC24 D8                       ret c
109+  CC25
110+  CC25                          ; Заглавные русские буквы - не маняем
111+  CC25 FE E0                    cp      0E0h
112+  CC27 D0                       ret nc
113+  CC28
114+  CC28                          ; Строчные русские буквы - прибавляем 20h
115+  CC28 C6 20                    add     20h
116+  CC2A C9                       ret
117+  CC2B
118+  CC2B              ;+---------------------------------------------------------------------------
119+  CC2B              ; MXOS
120+  CC2B              ; Сравнение расширений файлов
121+  CC2B              ;
122+  CC2B              ; На входе
123+  CC2B              ;  de - адрес расширения 1
124+  CC2B              ;  v_curFileDescr - имя с расширением 2
125+  CC2B              ;
126+  CC2B              ; На выходе
127+  CC2B              ;  zf = 0 - расширения равны
128+  CC2B              ;  de = de+3
129+  CC2B              ;
130+  CC2B              ; 2013-12-12 Дизассемблировано vinxru
131+  CC2B              ; 2022-02-11 Доработано SpaceEngineer
132+  CC2B              ;----------------------------------------------------------------------------
133+  CC2B
134+  CC2B              cmpFileExt:
135+  CC2B                          ; Адрес расширения
136+  CC2B 21 A4 D3                 ld      hl, v_curFileDescr + FILE_NAME_LENGTH
137+  CC2E 0E 03                    ld      c, 3   ; cравниваем 3 символа
138+  CC30 CD F9 CB                 call    stricmp ; zf = 1 если равны
139+  CC33
140+  CC33                          ; Делаем так, чтобы на выходе функции de было
141+  CC33                          ; на 3 больше, чем на входе в функцию
142+  CC33 06 00                    ld      b, 0
143+  CC35 F5                       push    af
144+  CC36 EB                       ex      de, hl
145+  CC37 09                       add     hl, bc
146+  CC38 EB                       ex      de, hl
147+  CC39 F1                       pop     af
148+  CC3A
149+  CC3A                          ; Выход
150+  CC3A C9                       ret
151+  CC3B
109   CC3B                  INCLUDE "fatCache.inc"
  1+  CC3B              ;----------------------------------------------------------------------------
  2+  CC3B              ; MXOS
  3+  CC3B              ; Кэш секторов fat
  4+  CC3B              ;
  5+  CC3B              ; 2022-02-08 Разработано SpaceEngineer
  6+  CC3B              ;----------------------------------------------------------------------------
  7+  CC3B
  8+  CC3B                  STRUCT  FAT_CACHE_DATA          ; размер структуры 8 байт
  9+  CC3B ~            number:         DW  0FFFFh          ; номер сектора
 10+  CC3B ~            address:        DW  FAT_CACHE_ADDR  ; адрес закешированного сектора в ОЗУ
 11+  CC3B ~            accessTime:     DW  0               ; последнее время обращения к сектору
 12+  CC3B ~            isModified:     DB  0               ; модифицирован ли сектор
 13+  CC3B ~            _align:         DB  0               ; для выравнивания
 14+  CC3B                  ENDS
 15+  CC3B
 16+  CC3B              ; Массив из FAT_CACHE_CAPACITY структур длиной FAT_CACHE_DATA, инициализирован нулями
 17+  CC3B 00 00 00...  cacheData:      BLOCK   FAT_CACHE_CAPACITY * FAT_CACHE_DATA, 0
 18+  CC5B
 19+  CC5B              ;----------------------------------------------------------------------------
 20+  CC5B              ; MXOS
 21+  CC5B              ; Инициализация кэша fat
 22+  CC5B              ;
 23+  CC5B              ; регисты НЕ сохраняются!
 24+  CC5B              ;
 25+  CC5B              ; 2022-02-08 Разработано SpaceEngineer
 26+  CC5B              ;----------------------------------------------------------------------------
 27+  CC5B
 28+  CC5B              resetSectorCache:
 29+  CC5B                      ; bc = системное время
 30+  CC5B CD 71 CD             call    getSystemTime
 31+  CC5E
 32+  CC5E                      ; В цикле записываем начальные значения во поля address
 33+  CC5E 11 00 FB             ld      de, FAT_CACHE_ADDR      ; адрес буфера секторов
 34+  CC61 21 3B CC             ld      hl, cacheData           ; адрес первого элемента в массиве
 35+  CC64 3E 04                ld      a,  FAT_CACHE_CAPACITY  ; счетчик цикла
 36+  CC66
 37+  CC66              resetCacheLoop:
 38+  CC66                      ; Поле number = 0FFFFh
 39+  CC66 36 FF                ld      (hl), 0FFh
 40+  CC68 23                   inc     hl
 41+  CC69 36 FF                ld      (hl), 0FFh
 42+  CC6B 23                   inc     hl
 43+  CC6C                      ; Поле address = de
 44+  CC6C 73                   ld      (hl), e
 45+  CC6D 23                   inc     hl
 46+  CC6E 72                   ld      (hl), d
 47+  CC6F 23                   inc     hl
 48+  CC70                      ; Поле accessTime = bc
 49+  CC70 71                   ld      (hl), c
 50+  CC71 23                   inc     hl
 51+  CC72 70                   ld      (hl), b
 52+  CC73 23                   inc     hl
 53+  CC74                      ; Поле isModified = 0
 54+  CC74 36 00                ld      (hl), 0
 55+  CC76 23                   inc     hl
 56+  CC77                      ; Поле isLoaded = 0
 57+  CC77 36 00                ld      (hl), 0
 58+  CC79 23                   inc     hl
 59+  CC7A
 60+  CC7A                      ; de += SECTOR_SIZE
 61+  CC7A 14                   inc     d   ; это работает только с секторами по 256 байт
 62+  CC7B
 63+  CC7B                      ; Повтор чикла
 64+  CC7B 3D                   dec     a
 65+  CC7C C2 66 CC             jp nz,  resetCacheLoop
 66+  CC7F
 67+  CC7F C9                   ret
 68+  CC80
 69+  CC80              ;----------------------------------------------------------------------------
 70+  CC80              ; MXOS
 71+  CC80              ; Получение адреса закешированного сектора в памяти.
 72+  CC80              ; Если сектор не найден в кэше, он загружается с текущего накопителя.
 73+  CC80              ;
 74+  CC80              ; вход:
 75+  CC80              ;   de = номер сектора
 76+  CC80              ;   a  = 1 - установить флаг isModified сектора
 77+  CC80              ;
 78+  CC80              ; выход:
 79+  CC80              ;   hl = адрес сектора в буфере
 80+  CC80              ;
 81+  CC80              ;   регистры de, bc сохраняются
 82+  CC80              ;
 83+  CC80              ; 2022-02-08 Разработано SpaceEngineer
 84+  CC80              ;----------------------------------------------------------------------------
 85+  CC80
 86+  CC80              getSectorAddressInCache:
 87+  CC80 C5                   push    bc
 88+  CC81 D5                   push    de
 89+  CC82 47                   ld      b, a    ; b = isModified
 90+  CC83 EB                   ex      hl, de
 91+  CC84
 92+  CC84                      ; Находим сектор в кэше; если нету - кешируем
 93+  CC84                      ; вход:  hl = номер сектора на диске
 94+  CC84                      ; выход: hl = адрес сектора в ОЗУ
 95+  CC84 CD A1 CC             call    cacheSector
 96+  CC87
 97+  CC87 D1                   pop     de
 98+  CC88 C1                   pop     bc
 99+  CC89 C9                   ret
100+  CC8A
101+  CC8A              ;----------------------------------------------------------------------------
102+  CC8A              ; MXOS
103+  CC8A              ; Получение адреса ячейки fat.
104+  CC8A              ; Если сектор fat не найден в кэше, он загружается с текущего накопителя.
105+  CC8A              ;
106+  CC8A              ; вход:
107+  CC8A              ;   de = номер ячейки fat
108+  CC8A              ;   a  = 1 - установить флаг isModified сектора
109+  CC8A              ;
110+  CC8A              ; выход:
111+  CC8A              ;   hl = адрес ячейки в буфере
112+  CC8A              ;
113+  CC8A              ; 2022-02-08 Разработано SpaceEngineer
114+  CC8A              ;----------------------------------------------------------------------------
115+  CC8A
116+  CC8A              getFatCellAddress:
117+  CC8A C5                   push    bc
118+  CC8B 47                   ld      b, a ; b = isModified
119+  CC8C
120+  CC8C                      ; Вычисляем номер сектора, где находится искомая ячейка fat
121+  CC8C                      ; fatSectorNum  = (N * 2) / v_diskInfo.sectorSize + v_diskInfo.resSectors;
122+  CC8C                      ; fatCellOffset = (N * 2) % v_diskInfo.sectorSize;
123+  CC8C 2A EB D2             ld      hl, (v_diskInfo.sectorSize)
124+  CC8F EB                   ex      hl, de
125+  CC90 29                   add     hl, hl      ; hl = N * 2
126+  CC91 CD 87 D2             call    div_hl_de   ; выход: hl = номер сектора от начала fat; de = смещение ячейки в секторе
127+  CC94 D5                   push    de          ; de = смещение ячейки в секторе
128+  CC95 EB                   ex      hl, de
129+  CC96 2A EF D2             ld      hl, (v_diskInfo.resSectors)
130+  CC99 19                   add     hl, de      ; hl += v_diskInfo.resSectors
131+  CC9A
132+  CC9A                      ; Находим сектор в кэше; если нету - кешируем
133+  CC9A                      ; вход:  hl = номер сектора на диске
134+  CC9A                      ; выход: hl = адрес сектора в ОЗУ
135+  CC9A CD A1 CC             call    cacheSector
136+  CC9D
137+  CC9D                      ; Находим смещение ячейки fat в этом секторе
138+  CC9D D1                   pop     de      ; de = смещение ячейки в секторе
139+  CC9E 19                   add     hl, de  ; hl = адрес ячейки в секторе
140+  CC9F
141+  CC9F C1                   pop     bc
142+  CCA0 C9                   ret
143+  CCA1
144+  CCA1              ;----------------------------------------------------------------------------
145+  CCA1              ; MXOS
146+  CCA1              ; Поиск сектора в кэше. Если сектор не найден, то он загружается с накопителя.
147+  CCA1              ;
148+  CCA1              ; вход:
149+  CCA1              ;   hl = номер сектора
150+  CCA1              ;   b  = флаг модификации
151+  CCA1              ;
152+  CCA1              ; выход:
153+  CCA1              ;   hl = адрес начала сектора в памяти
154+  CCA1              ;
155+  CCA1              ; регистры de, bc сохраняются
156+  CCA1              ;
157+  CCA1              ; 2022-02-08 Разработано SpaceEngineer
158+  CCA1              ;----------------------------------------------------------------------------
159+  CCA1
160+  CCA1              cacheSector:
161+  CCA1                      ; Сохраняем регистры
162+  CCA1 D5                   push    de
163+  CCA2 C5                   push    bc
164+  CCA3
165+  CCA3                      ; Просматриваем массив структур cacheData в поисках сектора с номером hl
166+  CCA3 EB                   ex      hl, de                                      ; de = номер для поиска
167+  CCA4 21 3B CC             ld      hl, cacheData + FAT_CACHE_DATA.number       ; hl = адрес поля number в первом элементе массива
168+  CCA7 0E 04                ld      c,  FAT_CACHE_CAPACITY                      ; счетчик цикла
169+  CCA9              cff_FindSector:
170+  CCA9 CD 7D CD             call    cmp_m_de            ; сравниваем [hl] и de
171+  CCAC CA EC CC             jp z,   cff_SectorFound     ; если равно, значит есть такой сектор в кэше
172+  CCAF C5                   push    bc                  ; иначе переходим на следущий элемент массива
173+  CCB0 01 08 00             ld      bc, FAT_CACHE_DATA  ; bc = размер структуры FAT_CACHE_DATA
174+  CCB3 09                   add     hl, bc
175+  CCB4 C1                   pop     bc
176+  CCB5 0D                   dec     c                   ; повтор цикла
177+  CCB6 C2 A9 CC             jp      nz, cff_FindSector
178+  CCB9
179+  CCB9                      ; Не не нашли сектор в массиве, загружаем его с накопителя на место наиболее давно использовавашегося
180+  CCB9 D5                   push    de  ; de = номер сектора, который надо загрузить
181+  CCBA
182+  CCBA                      ; Ищем наиболее давно использовавашийся сектор (т.е. у которого самый маленький accessTime)
183+  CCBA 11 FF FF             ld      de, 0FFFFh                                  ; de = максимальный найденый accessTime сектора
184+  CCBD 21 3F CC             ld      hl, cacheData + FAT_CACHE_DATA.accessTime   ; hl = адрес поля accessTime в первом элементе массива
185+  CCC0 01 04 00             ld      bc, FAT_CACHE_CAPACITY                      ; b  = 0, c = счетчик цикла
186+  CCC3              cff_FindOldestSector:
187+  CCC3 CD 7D CD             call    cmp_m_de            ; сравниваем [hl] и de
188+  CCC6 D2 CE CC             jp nc,  cff_next            ; переход, если [hl] >= de
189+  CCC9 5E                   ld      e, (hl)             ; тут [hl] < de, запоминаем accessTime сектора в de
190+  CCCA 23                   inc     hl
191+  CCCB 56                   ld      d, (hl)
192+  CCCC 2B                   dec     hl
193+  CCCD 41                   ld      b, c                ; запоминаем итерацию цикла сектора в b
194+  CCCE              cff_next:
195+  CCCE C5                   push    bc                  ; переходим на следущий элемент массива
196+  CCCF 01 08 00             ld      bc, FAT_CACHE_DATA  ; bc = размер структуры FAT_CACHE_DATA
197+  CCD2 09                   add     hl, bc
198+  CCD3 C1                   pop     bc
199+  CCD4 0D                   dec     c                   ; повтор цикла
200+  CCD5 C2 C3 CC             jp      nz, cff_FindOldestSector
201+  CCD8
202+  CCD8                      ; Нашли наиболее давно использовавашийся сектор
203+  CCD8 3E 04                ld      a, FAT_CACHE_CAPACITY
204+  CCDA 90                   sub     b       ; a = индекс найденного сектора
205+  CCDB 17                   rla
206+  CCDC 17                   rla
207+  CCDD 17                   rla             ; a = a * 8 (размер структуры FAT_CACHE_DATA)
208+  CCDE 4F                   ld      c, a
209+  CCDF 06 00                ld      b, 0    ; bc = смещение сектора в массиве cacheData
210+  CCE1 21 3B CC             ld      hl, cacheData
211+  CCE4 09                   add     hl, bc  ; hl = адрес элемента массива
212+  CCE5
213+  CCE5                      ; Прежде чем загрузить новый сектор, старый надо сохранить, если его isModified не ноль
214+  CCE5 CD 13 CD             call    saveSectorFromCache    ; записываем сектор на накопитель
215+  CCE8
216+  CCE8                      ; Загружаем новый сектор на место старого
217+  CCE8 D1                   pop     de              ; de = номер сектора, который надо загрузить
218+  CCE9 CD 00 CD             call    loadSectorToCache    ; загружаем сектор с накопителя
219+  CCEC
220+  CCEC                      ; Сектор найден или загружен, возвращаем его адрес
221+  CCEC                      ; Здесь hl = адрес элемента массива cacheData этого сектора
222+  CCEC              cff_SectorFound:
223+  CCEC
224+  CCEC 23                   inc     hl
225+  CCED 23                   inc     hl      ; теперь hl = адрес поля address
226+  CCEE
227+  CCEE                      ; Читаем адрес сектора в de
228+  CCEE 5E                   ld      e, (hl)
229+  CCEF 23                   inc     hl
230+  CCF0 56                   ld      d, (hl) ; de = адрес сектора
231+  CCF1 23                   inc     hl      ; теперь hl = адрес поля accessTime
232+  CCF2
233+  CCF2                      ; Уcтанавливаем accessTime сектора
234+  CCF2 CD 71 CD             call    getSystemTime;  bc = системное время
235+  CCF5
236+  CCF5 71                   ld      (hl), c
237+  CCF6 23                   inc     hl
238+  CCF7 70                   ld      (hl), b ; de = адрес сектора
239+  CCF8 23                   inc     hl      ; теперь hl = адрес поля isModified
240+  CCF9
241+  CCF9                      ; Устанавливаем isModified, если в регистре b на входе в функцию был не ноль
242+  CCF9 C1                   pop     bc      ; b = флаг модификации
243+  CCFA 7E                   ld      a, (hl)
244+  CCFB B0                   or      b
245+  CCFC 77                   ld      (hl), a
246+  CCFD
247+  CCFD                      ; hl = адрес сектора
248+  CCFD EB                   ex      hl, de
249+  CCFE
250+  CCFE                      ; Восстанавливаем регистры и выходим
251+  CCFE D1                   pop     de
252+  CCFF C9                   ret
253+  CD00
254+  CD00              ;----------------------------------------------------------------------------
255+  CD00              ; MXOS
256+  CD00              ; Загрузка сектора с накопителя в кэш
257+  CD00              ;
258+  CD00              ; вход:
259+  CD00              ;   hl = адрес структуры FAT_CACHE_DATA с описанием сектора
260+  CD00              ;   de = номер сектора
261+  CD00              ;
262+  CD00              ; регистры hl, de, bc сохраняются
263+  CD00              ;
264+  CD00              ; 2022-02-08 Разработано SpaceEngineer
265+  CD00              ;----------------------------------------------------------------------------
266+  CD00
267+  CD00              loadSectorToCache:
268+  CD00 E5                   push    hl
269+  CD01
270+  CD01                      ; Записываем номер сектора в структуру
271+  CD01 73                   ld      (hl), e
272+  CD02 23                   inc     hl
273+  CD03 72                   ld      (hl), d
274+  CD04 23                   inc     hl      ; теперь hl = адрес поля address
275+  CD05 D5                   push    de
276+  CD06
277+  CD06                      ; Читаем в de адрес загрузки сектора
278+  CD06 5E                   ld      e, (hl)
279+  CD07 23                   inc     hl
280+  CD08 56                   ld      d, (hl)
281+  CD09 23                   inc     hl
282+  CD0A
283+  CD0A                      ; Загружаем сектор
284+  CD0A                      ; Номер сектора = номер сектора, т.к. fat начинается с начала диска
285+  CD0A EB                   ex      hl, de  ; hl = адрес буфера
286+  CD0B D1                   pop     de      ; de = номер сектора
287+  CD0C 06 02                ld      b, 2    ; режим - чтение
288+  CD0E CD 63 C8             call    j_diskDriver
289+  CD11
290+  CD11                      ; Восстанавливаем регситры и выходим
291+  CD11 E1                   pop     hl
292+  CD12 C9                   ret
293+  CD13
294+  CD13              ;----------------------------------------------------------------------------
295+  CD13              ; MXOS
296+  CD13              ; Запись сектора из кэша на накопитель, если его isModified не ноль
297+  CD13              ;
298+  CD13              ; вход:
299+  CD13              ;   hl = адрес структуры FAT_CACHE_DATA с описанием сектора
300+  CD13              ;
301+  CD13              ;   регистры hl, de, bc сохраняются
302+  CD13              ;
303+  CD13              ; 2022-02-08 Разработано SpaceEngineer
304+  CD13              ;----------------------------------------------------------------------------
305+  CD13
306+  CD13              saveSectorFromCache:
307+  CD13 E5                   push    hl
308+  CD14 D5                   push    de
309+  CD15
310+  CD15                      ; Проверяем, был ли изменен сектор
311+  CD15 C5                   push    bc
312+  CD16 01 06 00             ld      bc, FAT_CACHE_DATA.isModified   ; bc = смещение поля isModified
313+  CD19 09                   add     hl, bc      ; hl = адрес поля isModified
314+  CD1A C1                   pop     bc
315+  CD1B 7E                   ld      a, (hl)     ; a = isModified
316+  CD1C B7                   or      a           ; a == 0?
317+  CD1D CA 33 CD             jp z,   ssfc_Exit   ; если isModified == 0, сектор не был изменен, и его не надо сохранять
318+  CD20
319+  CD20                      ; Обнуляем isModified
320+  CD20 36 00                ld      (hl), 0
321+  CD22
322+  CD22 2B                   dec     hl  ; теперь hl = адрес поля accessTime (ст. байт)
323+  CD23
324+  CD23 2B                   dec     hl
325+  CD24 2B                   dec     hl  ; теперь hl = адрес поля address (ст. байт)
326+  CD25
327+  CD25                      ; Читаем в de адрес загрузки сектора
328+  CD25 56                   ld      d, (hl)
329+  CD26 2B                   dec     hl
330+  CD27 5E                   ld      e, (hl)
331+  CD28 D5                   push    de  ; сохраняем его в стек
332+  CD29
333+  CD29 2B                   dec     hl  ; теперь hl = адрес поля number (ст. байт)
334+  CD2A
335+  CD2A                      ; Читаем в de номер сектора
336+  CD2A 56                   ld      d, (hl)
337+  CD2B 2B                   dec     hl
338+  CD2C 5E                   ld      e, (hl)
339+  CD2D
340+  CD2D                      ; Записываем сектор
341+  CD2D                      ; de = номер сектора
342+  CD2D E1                   pop     hl      ; hl = адрес загрузки сектора
343+  CD2E 06 01                ld      b, 1    ; режим - запись
344+  CD30 CD 63 C8             call    j_diskDriver
345+  CD33
346+  CD33              ssfc_Exit:
347+  CD33                      ; Восстанавливаем регситры и выходим
348+  CD33 D1                   pop     de
349+  CD34 E1                   pop     hl
350+  CD35 C9                   ret
351+  CD36
352+  CD36              ;----------------------------------------------------------------------------
353+  CD36              ; MXOS
354+  CD36              ; Запись всех закешированных секторов на накопитель, если их isModified не ноль
355+  CD36              ;
356+  CD36              ; регистры hl, de, bc сохраняются
357+  CD36              ;
358+  CD36              ; 2022-02-08 Разработано SpaceEngineer
359+  CD36              ;----------------------------------------------------------------------------
360+  CD36
361+  CD36              saveSectorCache:
362+  CD36                      ; Сохраняем регситры
363+  CD36 E5                   push    hl
364+  CD37 D5                   push    de
365+  CD38 C5                   push    bc
366+  CD39
367+  CD39 21 3B CC             ld      hl, cacheData           ; hl = первый элемент в массиве cacheData
368+  CD3C 11 08 00             ld      de, FAT_CACHE_DATA      ; de = размер элемента массива cacheData
369+  CD3F 0E 04                ld      c,  FAT_CACHE_CAPACITY  ; счетчик цикла
370+  CD41              saveSectorCacheLoop:
371+  CD41 CD 13 CD             call    saveSectorFromCache     ; записываем сектор на накопитель
372+  CD44 19                   add     hl, de
373+  CD45 0D                   dec     c
374+  CD46 C2 41 CD             jp nz,  saveSectorCacheLoop
375+  CD49
376+  CD49                      ; Восстанавливаем регситры и выходим
377+  CD49 C1                   pop     bc
378+  CD4A D1                   pop     de
379+  CD4B E1                   pop     hl
380+  CD4C C9                   ret
381+  CD4D
382+  CD4D              ;----------------------------------------------------------------------------
383+  CD4D              ; MXOS
384+  CD4D              ; Вычисление номера сектора по номеру кластера
385+  CD4D              ;
386+  CD4D              ; вход:
387+  CD4D              ;   de = номер кластера
388+  CD4D              ;
389+  CD4D              ; формула:
390+  CD4D              ;   de = (de - 2) * v_diskInfo.sectorsPerCluster + v_diskInfo.dataStartSector
391+  CD4D              ;
392+  CD4D              ; выход:
393+  CD4D              ;   de = номер сектора
394+  CD4D              ;
395+  CD4D              ;   регистры bc, hl сохраняются
396+  CD4D              ;
397+  CD4D              ; 2022-02-14 Разработано SpaceEngineer
398+  CD4D              ;----------------------------------------------------------------------------
399+  CD4D
400+  CD4D              fatClusterToSector:
401+  CD4D E5                   push    hl
402+  CD4E
403+  CD4E 1B                   dec     de
404+  CD4F 1B                   dec     de          ; de -= 2 (нумерация кластеров начинается с 2)
405+  CD50
406+  CD50 2A ED D2             ld      hl, (v_diskInfo.sectorsPerCluster)
407+  CD53 CD 62 D2             call    mul_hl_de   ; hl = de * BPB_SecPerClus
408+  CD56 EB                   ex      hl, de
409+  CD57
410+  CD57 2A FF D2             ld      hl, (v_diskInfo.dataStartSector)
411+  CD5A 19                   add     hl, de
412+  CD5B EB                   ex      hl, de
413+  CD5C
414+  CD5C E1                   pop     hl
415+  CD5D C9                   ret
416+  CD5E
417+  CD5E              ;----------------------------------------------------------------------------
418+  CD5E              ; MXOS
419+  CD5E              ; Начало цикла по файлам в каталоге
420+  CD5E              ;
421+  CD5E              ; выход:
422+  CD5E              ;   de = номер первого сектора каталога
423+  CD5E              ;   с  = количество секторов каталога (мл. байт)
424+  CD5E              ;
425+  CD5E              ;   остальные регистры сохраняются
426+  CD5E              ;
427+  CD5E              ; 2022-02-14 Разработано SpaceEngineer
428+  CD5E              ;----------------------------------------------------------------------------
429+  CD5E
430+  CD5E              fatBeginDirLoop:
431+  CD5E EB                   ex      hl, de
432+  CD5F 2A FD D2             ld      hl, (v_diskInfo.dirStartSector)
433+  CD62 EB                   ex      hl, de                      ; de = номер первого сектора каталога
434+  CD63 3A F3 D2             ld      a, (v_diskInfo.dirSectors)  ; a = количество секторов каталога (мл. байт)
435+  CD66 4F                   ld      c,  a                       ; с  = счетчик цикла
436+  CD67 C9                   ret
437+  CD68
438+  CD68              ;----------------------------------------------------------------------------
439+  CD68              ; MXOS
440+  CD68              ; Установка сектору каталога флага isModified
441+  CD68              ;
442+  CD68              ; вход:
443+  CD68              ;  v_cachedSector - номер сектора
444+  CD68              ;
445+  CD68              ; выход:
446+  CD68              ;   bc = системное время
447+  CD68              ;
448+  CD68              ;   регистр bc сохраняется
449+  CD68              ;
450+  CD68              ; 2022-02-08 Разработано SpaceEngineer
451+  CD68              ;----------------------------------------------------------------------------
452+  CD68
453+  CD68              markDirSectorAsModified:
454+  CD68 2A C7 D2             ld      hl, (v_cachedSector)
455+  CD6B EB                   ex      hl, de  ; de = номер сектора
456+  CD6C 3E 01                ld      a, 1    ; флаг - сектор будет изменен
457+  CD6E
458+  CD6E                      ; Загрузка сектора в кэш; если сектор уже в кэше,
459+  CD6E                      ; функция просто найдет его и изменит флаг
460+  CD6E C3 80 CC             jp      getSectorAddressInCache
461+  CD71
462+  CD71              ;----------------------------------------------------------------------------
463+  CD71              ; MXOS
464+  CD71              ; Получение текущего системного времени
465+  CD71              ;
466+  CD71              ; В "Специалисте" нет часов реального времени (RTC), поэтому системное время
467+  CD71              ; - это просто счетчик, увеличивающийся каждый раз при обращении. В будущем
468+  CD71              ; можно будет сделать вермя через таймер ВИ53, или через драйвер RTC, при его
469+  CD71              ; наличии в системе.
470+  CD71              ;
471+  CD71              ; выход:
472+  CD71              ;   bc = системное время
473+  CD71              ;
474+  CD71              ; все остальные регистры сохраняеюся
475+  CD71              ;
476+  CD71              ; 2022-02-08 Разработано SpaceEngineer
477+  CD71              ;----------------------------------------------------------------------------
478+  CD71
479+  CD71              getSystemTime:
480+  CD71 E5                   push    hl
481+  CD72 2A D9 D2             ld      hl, (v_fakeSystemTime)
482+  CD75 23                   inc     hl
483+  CD76 22 D9 D2             ld      (v_fakeSystemTime), hl
484+  CD79 44                   ld      b, h
485+  CD7A 4D                   ld      c, l
486+  CD7B E1                   pop     hl
487+  CD7C C9                   ret
488+  CD7D
489+  CD7D              ;----------------------------------------------------------------------------
490+  CD7D              ; MXOS
491+  CD7D              ; Сравнение слова по адресу hl и de
492+  CD7D              ; Псевдокод: cp [hl], de
493+  CD7D              ;
494+  CD7D              ; выход:
495+  CD7D              ;   флаги c, z
496+  CD7D              ;
497+  CD7D              ; 2022-02-08 Разработано SpaceEngineer
498+  CD7D              ;----------------------------------------------------------------------------
499+  CD7D
500+  CD7D              cmp_m_de:
501+  CD7D 23                   inc   hl
502+  CD7E 7E                   ld    a, (hl)
503+  CD7F 2B                   dec   hl
504+  CD80 BA                   cp    d
505+  CD81 D8                   ret   c
506+  CD82 C0                   ret   nz
507+  CD83 7E                   ld    a, (hl)
508+  CD84 BB                   cp    e
509+  CD85 C9                   ret
510+  CD86
110   CD86                  INCLUDE "fatFindCluster.inc"
  1+  CD86              ;+---------------------------------------------------------------------------
  2+  CD86              ; MXOS
  3+  CD86              ; Поиск свободного кластера
  4+  CD86              ;
  5+  CD86              ; На выходе
  6+  CD86              ;  cf - ошибка
  7+  CD86              ;  de - номер кластера
  8+  CD86              ;  регистры bc, hl сохраняются
  9+  CD86              ;
 10+  CD86              ; 2013-12-12 Дизассемблировано vinxru
 11+  CD86              ; 2022-02-04 Переработано SpaceEngineer
 12+  CD86              ;----------------------------------------------------------------------------
 13+  CD86
 14+  CD86              fatFindClusterFirst:
 15+  CD86                          ; Сохраняем регистры
 16+  CD86 E5                       push  hl
 17+  CD87
 18+  CD87                          ; de = номер первого кластера для поиска
 19+  CD87                          ; Первые 2 ячейки fat зарезервированы
 20+  CD87 11 02 00                 ld    de, 2
 21+  CD8A
 22+  CD8A C3 93 CD                 jp    fatFindClusterCommon
 23+  CD8D
 24+  CD8D              ;----------------------------------------------------------------------------
 25+  CD8D              ; Поиск следующего свободного кластера
 26+  CD8D              ;
 27+  CD8D              ; На выходе
 28+  CD8D              ;  cf - ошибка
 29+  CD8D              ;  de - номер кластера
 30+  CD8D              ;  регистры bc, hl сохраняются
 31+  CD8D              ;----------------------------------------------------------------------------
 32+  CD8D
 33+  CD8D              fatFindClusterNext:
 34+  CD8D                          ; Сохраняем регистры
 35+  CD8D E5                       push    hl
 36+  CD8E
 37+  CD8E                          ; Предыдущий найденный кластер
 38+  CD8E 2A BD D2                 ld      hl, (v_findCluster)
 39+  CD91
 40+  CD91                          ; Начинаем поиск со следующего кластера
 41+  CD91 23                       inc     hl
 42+  CD92 EB                       ex      hl, de
 43+  CD93
 44+  CD93                          ; Ищем свободный кластер: перебераем все ячейки fat, пока не найдём 0
 45+  CD93              fatFindClusterCommon:
 46+  CD93 C5                       push    bc
 47+  CD94 2A FB D2                 ld      hl, (v_diskInfo.fatNumCells)
 48+  CD97 44                       ld      b, h
 49+  CD98 4D                       ld      c, l    ; bc = кол-во ячеек fat
 50+  CD99
 51+  CD99              fatFindClusterLoop:
 52+  CD99                          ; Запоминаем номер последнего кластера в hl
 53+  CD99 62                       ld      h, d
 54+  CD9A 6B                       ld      l, e
 55+  CD9B
 56+  CD9B                          ; de = fat[de]
 57+  CD9B CD BA CD                 call    fatReadCluster
 58+  CD9E
 59+  CD9E                          ; Сравниваем de с нулем
 60+  CD9E 7A                       ld      a, d
 61+  CD9F B3                       or      e
 62+  CDA0 CA B2 CD                 jp z,   fatFindClusterOk  ; найден
 63+  CDA3
 64+  CDA3                          ; Следующий кластер
 65+  CDA3 54                       ld      d, h
 66+  CDA4 5D                       ld      e, l
 67+  CDA5 13                       inc     de
 68+  CDA6
 69+  CDA6                          ; Счётчик просмотренных ячеек fat
 70+  CDA6 0B                       dec     bc
 71+  CDA7 78                       ld      a, b
 72+  CDA8 B1                       or      c
 73+  CDA9 C2 99 CD                 jp nz,  fatFindClusterLoop  ; повтор цикла
 74+  CDAC
 75+  CDAC              ;---------------------------------------------------------------------------
 76+  CDAC
 77+  CDAC                          ; Свободный кластер не найден
 78+  CDAC                          ; Восстанавливаем регистры и выходим с a=1, CF=1, ZF=0
 79+  CDAC C1                       pop     bc
 80+  CDAD E1                       pop     hl
 81+  CDAE 3E 01                    ld      a, 1
 82+  CDB0 37                       scf
 83+  CDB1 C9                       ret
 84+  CDB2
 85+  CDB2              ;---------------------------------------------------------------------------
 86+  CDB2
 87+  CDB2                          ; Свободный кластер найден
 88+  CDB2              fatFindClusterOk:
 89+  CDB2                          ; Устаналиваем ZF=0. Номер кластера не может быть нулевым.
 90+  CDB2                          ; В случае ошибки мы тоже выходим с ZF=1
 91+  CDB2 B7                       or      a
 92+  CDB3
 93+  CDB3                          ; Для ускорения поиска сохраняем номер найденного кластера в v_findCluster
 94+  CDB3 22 BD D2                 ld      (v_findCluster), hl
 95+  CDB6 EB                       ex      hl, de
 96+  CDB7
 97+  CDB7                          ; Восстанавливаем регистры и выходим с CF=0, ZF=0
 98+  CDB7 C1                       pop     bc
 99+  CDB8 E1                       pop     hl
100+  CDB9 C9                       ret
101+  CDBA
111   CDBA                  INCLUDE "fatReadWriteCluster.inc"
  1+  CDBA              ;----------------------------------------------------------------------------
  2+  CDBA              ; MXOS
  3+  CDBA              ;
  4+  CDBA              ; Чтение номера кластера из таблицы fat
  5+  CDBA              ;
  6+  CDBA              ; вход:
  7+  CDBA              ;   de = номер ячейки, чтобы прочитать
  8+  CDBA              ;
  9+  CDBA              ; выход:
 10+  CDBA              ;   de = номер кластера, прочитанный из ячейки
 11+  CDBA              ;   hl, bc, a - сохраняются
 12+  CDBA              ;
 13+  CDBA              ; СИ аналог:
 14+  CDBA              ;   de = fat[de];
 15+  CDBA              ;
 16+  CDBA              ; 2022-02-04 SpaceEngineer
 17+  CDBA              ;----------------------------------------------------------------------------
 18+  CDBA
 19+  CDBA              fatReadCluster:
 20+  CDBA E5                       push    hl
 21+  CDBB
 22+  CDBB                          ; вычисляем адрес ячейки, куда указывает de
 23+  CDBB AF                       xor     a ; флаг - сектор fat не будет модифицироваться
 24+  CDBC CD 8A CC                 call    getFatCellAddress
 25+  CDBF
 26+  CDBF                          ; читаем в de номер кластера из fat по адресу hl
 27+  CDBF 5E                       ld      e, (hl)
 28+  CDC0 23                       inc     hl
 29+  CDC1 56                       ld      d, (hl)
 30+  CDC2
 31+  CDC2                          ; восстанавливаем регистры и выходим
 32+  CDC2 E1                       pop     hl
 33+  CDC3 C9                       ret
 34+  CDC4
 35+  CDC4              ;----------------------------------------------------------------------------
 36+  CDC4              ; MXOS
 37+  CDC4              ;
 38+  CDC4              ; Запись номера кластера в таблицу fat и переход на следующий адрес ячейки
 39+  CDC4              ;
 40+  CDC4              ; вход:
 41+  CDC4              ;   hl = номер ячейки fat, куда писать
 42+  CDC4              ;   de = номер кластера, чтобы записать
 43+  CDC4              ;
 44+  CDC4              ; выход:
 45+  CDC4              ;   hl = de
 46+  CDC4              ;   bc, a - сохраняются
 47+  CDC4              ;
 48+  CDC4              ; СИ аналог:
 49+  CDC4              ;   fat[de] = hl;
 50+  CDC4              ;   hl = de;
 51+  CDC4              ;
 52+  CDC4              ; 2022-02-04 SpaceEngineer
 53+  CDC4              ;----------------------------------------------------------------------------
 54+  CDC4
 55+  CDC4              fatWriteCluster:
 56+  CDC4                          ; вычисляем адрес ячейки, куда указывает hl
 57+  CDC4 D5                       push    de
 58+  CDC5 EB                       ex      hl, de
 59+  CDC6 3E 01                    ld      a, 1 ; флаг - сектр fat будет модифицироваться
 60+  CDC8 CD 8A CC                 call    getFatCellAddress
 61+  CDCB D1                       pop     de
 62+  CDCC
 63+  CDCC                          ; записываем номер кластера из de в fat по адресу hl
 64+  CDCC 73                       ld      (hl), e
 65+  CDCD 23                       inc     hl
 66+  CDCE 72                       ld      (hl), d
 67+  CDCF
 68+  CDCF                          ; hl = de
 69+  CDCF 62                       ld      h, d
 70+  CDD0 6B                       ld      l, e
 71+  CDD1 C9                       ret
 72+  CDD2
 73+  CDD2              ;----------------------------------------------------------------------------
 74+  CDD2              ; MXOS
 75+  CDD2              ;
 76+  CDD2              ; Освобождение кластера в таблице fat
 77+  CDD2              ;
 78+  CDD2              ; вход:
 79+  CDD2              ;   de = номер кластера
 80+  CDD2              ;
 81+  CDD2              ; выход:
 82+  CDD2              ;   de = номер следующего кластера
 83+  CDD2              ;   hl, bc, a - сохраняются
 84+  CDD2              ;
 85+  CDD2              ; СИ аналог:
 86+  CDD2              ;   fat[de] = 0x0000;
 87+  CDD2              ;
 88+  CDD2              ; 2022-02-04 SpaceEngineer
 89+  CDD2              ;----------------------------------------------------------------------------
 90+  CDD2
 91+  CDD2              fatFreeCluster:
 92+  CDD2 E5                       push    hl
 93+  CDD3
 94+  CDD3                          ; вычисляем адрес ячейки, куда указывает hl
 95+  CDD3 D5                       push    de
 96+  CDD4 EB                       ex      hl, de
 97+  CDD5 3E 01                    ld      a, 1 ; флаг - сектор fat будет модифицироваться
 98+  CDD7 CD 8A CC                 call    getFatCellAddress
 99+  CDDA D1                       pop     de
100+  CDDB
101+  CDDB                          ; читаем номер кластера из fat, и сразу записываем туда нули
102+  CDDB 5E                       ld      e, (hl)
103+  CDDC 36 00                    ld      (hl), 0
104+  CDDE 23                       inc     hl
105+  CDDF 56                       ld      d, (hl)
106+  CDE0 36 00                    ld      (hl), 0
107+  CDE2
108+  CDE2                          ; восстанавливаем регистры и выходим
109+  CDE2 E1                       pop     hl
110+  CDE3 C9                       ret
111+  CDE4
112+  CDE4
112   CDE4                  INCLUDE "fatGetFreeSpace.inc"
  1+  CDE4              ;----------------------------------------------------------------------------
  2+  CDE4              ; MXOS
  3+  CDE4              ; Определение свободного объема накопителя
  4+  CDE4              ;
  5+  CDE4              ; выход:
  6+  CDE4              ;   de = количество свободных кластеров
  7+  CDE4              ;
  8+  CDE4              ; 2022-02-09 Разработано SpaceEngineer
  9+  CDE4              ;----------------------------------------------------------------------------
 10+  CDE4
 11+  CDE4              getDriveFreeSpace:
 12+  CDE4                          ; Сохраняем регистры
 13+  CDE4 E5                       push    hl
 14+  CDE5 C5                       push    bc
 15+  CDE6
 16+  CDE6                          ; Счетчик свободных кластеров
 17+  CDE6 11 00 00                 ld      de, 0
 18+  CDE9
 19+  CDE9                          ; Кэшируем по очереди все секторы таблицы fat,
 20+  CDE9                          ; и подсчитываем общее коичество свободных кластеров в них
 21+  CDE9 2A F1 D2                 ld      hl, (v_diskInfo.fatSectors) ; hl = количество секторов fat на устройстве
 22+  CDEC 7D                       ld      a, l                        ; a  = количество секторов fat на устройстве (считаем, что их меньше 256)
 23+  CDED F5                       push    af
 24+  CDEE 2A EF D2                 ld      hl, (v_diskInfo.resSectors) ; hl = номер сектора: начинаем с resSectors
 25+  CDF1              fatSectorsLoop:
 26+  CDF1 E5                       push    hl              ; hl = номер сектора
 27+  CDF2 06 00                    ld      b, 0            ; флаг - сектор не будет модифицироваться
 28+  CDF4 CD A1 CC                 call    cacheSector     ; теперь hl = адрес буфера с загруженным сектором fat
 29+  CDF7
 30+  CDF7                          ; Цикл по кластерам сектора fat
 31+  CDF7 01 80 00                 ld      bc, SECTOR_SIZE/2   ; счетчик цикла
 32+  CDFA              sectorClustersLoop:
 33+  CDFA                          ; Читаем в a номер кластера из ячейки по адресу hl и сразу сравниваем с нулем
 34+  CDFA 7E                       ld      a, (hl)
 35+  CDFB 23                       inc     hl
 36+  CDFC B6                       or      (hl)
 37+  CDFD 23                       inc     hl
 38+  CDFE
 39+  CDFE                          ; Если кластер пустой, увеличиваем счетчик свободных кластеров
 40+  CDFE C2 02 CE                 jp nz,  gdfs_nonEmpty
 41+  CE01 13                       inc     de
 42+  CE02              gdfs_nonEmpty:
 43+  CE02
 44+  CE02                          ; Повтор цикла по кластерам сектора fat
 45+  CE02 0B                       dec     bc  ; счетчик просмотренных кластеров сектора
 46+  CE03 78                       ld      a, b
 47+  CE04 B1                       or      c
 48+  CE05 C2 FA CD                 jp nz,  sectorClustersLoop
 49+  CE08
 50+  CE08                          ; Повтор цикла по секторам fat
 51+  CE08 E1                       pop     hl              ; hl = номер сектора
 52+  CE09 23                       inc     hl              ; инкремент номера сектора
 53+  CE0A
 54+  CE0A F1                       pop     af
 55+  CE0B 3D                       dec     a               ; счетчик цикла
 56+  CE0C F5                       push    af
 57+  CE0D
 58+  CE0D C2 F1 CD                 jp nz,  fatSectorsLoop  ; повтор цилкла по секторам
 59+  CE10
 60+  CE10                          ; Восстанавливаем регистры и выходим
 61+  CE10 F1                       pop     af
 62+  CE11 C1                       pop     bc
 63+  CE12 E1                       pop     hl
 64+  CE13
 65+  CE13 C9                       ret
 66+  CE14
113   CE14                  INCLUDE "fatReadBootSector.inc"
  1+  CE14              ;----------------------------------------------------------------------------
  2+  CE14              ; MXOS
  3+  CE14              ; Считывание загрузочного сектора и инициализация структуры v_diskInfo.
  4+  CE14              ; Подпрограмма затирает дисковый кэш!
  5+  CE14              ;
  6+  CE14              ; На выходе
  7+  CE14              ;  cf - ошибка
  8+  CE14              ;  регистры bc, de, hl сохраняются
  9+  CE14              ;
 10+  CE14              ; 2022-02-13 Разработано SpaceEngineer
 11+  CE14              ;----------------------------------------------------------------------------
 12+  CE14
 13+  CE14              ; Структура загрузочного сектора FAT12/16
 14+  CE14
 15+  CE14                  STRUCT  FAT_BOOT_SECTOR
 16+  CE14 ~            BS_JmpBoot      BLOCK   3   ; смещение  00h,   3 байт - Jump instruction to the bootstrap code (x86 instruction): EBh, ??h, 90h (Short jump + NOP) or E9h, ??h, ??h (Near jump).
 17+  CE14 ~            BS_OEMName      BLOCK   8   ; смещение  03h,   8 байт - "MSWIN 4.1" is recommended but also "MSDOS 5.0" is often used.
 18+  CE14 ~            BPB_BytsPerSec  BLOCK   2   ; смещение  0Bh,   2 байт - Sector size in unit of byte. Valid values are 512, 1024, 2048, 4096. But most drivers use 512.
 19+  CE14 ~            BPB_SecPerClus  BLOCK   1   ; смещение  0Dh,   1 байт - Number of sectors per cluster. Valid values are 1, 2, 4, 8, ... 128.
 20+  CE14 ~            BPB_RsvdSecCnt  BLOCK   2   ; смещение  0Eh,   2 байт - Number of sectors in reserved area. This field hould be 1 on FAT12/16 volume.
 21+  CE14 ~            BPB_NumFATs     BLOCK   1   ; смещение  10h,   1 байт - Number of FATs. The value of this field should always be 2. On memory cards, it may be 1, but some FAT driver may not recognize such a volume properly.
 22+  CE14 ~            BPB_RootEntCnt  BLOCK   2   ; смещение  11h,   2 байт - Number of 32-byte directory entries in the root directory. For max compatibility, must be 512 on FAT16 volume.
 23+  CE14 ~            BPB_TotSec16    BLOCK   2   ; смещение  13h,   2 байт - Total number of sectors of the volume in old 16-bit field. If >= 0x10000, this field = 0, and the true value is set to BPB_TotSec32.
 24+  CE14 ~            BPB_Media       BLOCK   1   ; смещение  15h,   1 байт - Valid values are F0h, F8h ... FFh. The same value must be put in the lower 8-bits of FAT[0].
 25+  CE14 ~            BPB_FATSz16     BLOCK   2   ; смещение  16h,   2 байт - Number of sectors occupied by a FAT. The size of the FAT area becomes BPB_FATSz16 * BPB_NumFATs sectors.
 26+  CE14 ~            BPB_SecPerTrk   BLOCK   2   ; смещение  18h,   2 байт - Number of sectors per track. This field is relevant only for media that have geometry and used for only disk BIOS of IBM PC.
 27+  CE14 ~            BPB_NumHeads    BLOCK   2   ; смещение  1Ah,   2 байт - Number of heads. This field is relevant only for media that have geometry and used for only disk BIOS of IBM PC.
 28+  CE14 ~            BPB_HiddSec     BLOCK   4   ; смещение  1Ch,   4 байт - Number of hidden physical sectors preceding the FAT volume. Should always be 0 if the volume starts at the beginning of the storage.
 29+  CE14 ~            BPB_TotSec32    BLOCK   4   ; смещение  20h,   4 байт - Total number of sectors of the FAT volume in new 32-bit field.
 30+  CE14 ~            BS_DrvNum       BLOCK   1   ; смещение  24h,   1 байт - Drive number used by disk BIOS of IBM PC. This field is used in MS-DOS bootstrap, 0x00 for floppy disk and 0x80 for fixed disk.
 31+  CE14 ~            BS_Reserved     BLOCK   1   ; смещение  25h,   1 байт - Reserved (used by Windows NT). It should be set 0 when create the volume.
 32+  CE14 ~            BS_BootSig      BLOCK   1   ; смещение  26h,   1 байт - Extended boot signature (0x29). This is a signature byte indicates that the following three fields are present.
 33+  CE14 ~            BS_VolID        BLOCK   4   ; смещение  27h,   4 байт - Volume serial number used with BS_VolLab to track a volume on the removable storage. It enables to detect a wrong media change by FAT driver.
 34+  CE14 ~            BS_VolLab       BLOCK  11   ; смещение  2Bh,  11 байт - Volume label, matches volume label recorded in the root directory. When volume label is not present, "NO NAME " should be set.
 35+  CE14 ~            BS_FilSysType   BLOCK   8   ; смещение  36h,   8 байт - "FAT12   ", "FAT16   " or "FAT     ". Microsoft's FAT driver does not use this field to determine the FAT type.
 36+  CE14 ~            BS_BootCode     BLOCK 448   ; смещение  3Eh, 448 байт - Bootstrap program. It is platform dependent and filled with zero when not used.
 37+  CE14 ~            BS_BootSign     BLOCK   2   ; смещение 1FEh,   2 байт - 0xAA55. A boot signature indicating that this is a valid boot sector.
 38+  CE14                  ENDS
 39+  CE14
 40+  CE14              ;----------------------------------------------------------------------------
 41+  CE14
 42+  CE14              fatReadBootSector:
 43+  CE14                          ; Сохраняем регистры
 44+  CE14 E5                       push    hl
 45+  CE15 D5                       push    de
 46+  CE16 C5                       push    bc
 47+  CE17
 48+  CE17                          ; Помещаем значение DISK_NO_DRIVER в v_diskInfo.isValid
 49+  CE17 3E 00                    ld      a, DISK_NO_DRIVER
 50+  CE19 32 0D D3                 ld      (v_diskInfo.isValid), a
 51+  CE1C
 52+  CE1C                          ; Проверяем, установлен ли драйвер: сравниваем
 53+  CE1C                          ; с адресом пустого драйвера diskDriverDummy
 54+  CE1C 2A 64 C8                 ld      hl, (j_diskDriver + 1)  ; hl = адрес драйвера
 55+  CE1F 3E CB                    ld      a, diskDriverDummy >> 8
 56+  CE21 BC                       cp      h
 57+  CE22 C2 2B CE                 jp nz,  frbs_DriverOk
 58+  CE25 3E 97                    ld      a, diskDriverDummy & 0FFh
 59+  CE27 BD                       cp      l
 60+  CE28 CA B5 CE                 jp z,   frbs_Exit
 61+  CE2B
 62+  CE2B              frbs_DriverOk:
 63+  CE2B                          ; Драйвер установлен; загружаем boot сектор в дисковый кэш, затирая его
 64+  CE2B 21 00 FB                 ld      hl, FAT_CACHE_ADDR  ; адрес буфера
 65+  CE2E 11 00 00                 ld      de, 0               ; номер сектора - 0
 66+  CE31 06 02                    ld      b, 2                ; режим драйвера - чтение
 67+  CE33 CD 63 C8                 call    j_diskDriver        ; читаем сектор в память
 68+  CE36
 69+  CE36                          ; Помещаем значение DISK_INVALID в v_diskInfo.isValid
 70+  CE36 3E 01                    ld      a, DISK_INVALID
 71+  CE38 32 0D D3                 ld      (v_diskInfo.isValid), a
 72+  CE3B
 73+  CE3B                          ; Проверяем, корректный ли это FAT12/16 диск:
 74+  CE3B                          ; поле BS_FilSysType должно содержить текст "FAT"
 75+  CE3B 21 36 FB                 ld      hl, FAT_CACHE_ADDR + FAT_BOOT_SECTOR.BS_FilSysType
 76+  CE3E 11 47 D3                 ld      de, aFat
 77+  CE41 0E 03                    ld      c, 3
 78+  CE43 CD EF CB                 call    strcmp
 79+  CE46 C2 B5 CE                 jp nz,  frbs_Exit   ; это не FAT диск, или не отформатирован - выходим
 80+  CE49
 81+  CE49                          ; Помещаем значение DISK_VALID в v_diskInfo.isValid
 82+  CE49 3E 02                    ld      a, DISK_VALID
 83+  CE4B 32 0D D3                 ld      (v_diskInfo.isValid), a
 84+  CE4E
 85+  CE4E                          ; Копируем и рассчитываем необходимые значения
 86+  CE4E 2A 0B FB                 ld      hl, (FAT_CACHE_ADDR + FAT_BOOT_SECTOR.BPB_BytsPerSec)
 87+  CE51 22 EB D2                 ld      (v_diskInfo.sectorSize), hl         ; размер сектора
 88+  CE54
 89+  CE54 3A 0D FB                 ld      a, (FAT_CACHE_ADDR + FAT_BOOT_SECTOR.BPB_SecPerClus)
 90+  CE57 32 ED D2                 ld      (v_diskInfo.sectorsPerCluster), a
 91+  CE5A AF                       xor     a
 92+  CE5B 32 EE D2                 ld      (v_diskInfo.sectorsPerCluster+1), a ; секторов на кластер (16-битным словом)
 93+  CE5E
 94+  CE5E 2A 13 FB                 ld      hl, (FAT_CACHE_ADDR + FAT_BOOT_SECTOR.BPB_TotSec16)
 95+  CE61 22 F5 D2                 ld      (v_diskInfo.totalSectors), hl       ; сколько всего секторов на диске
 96+  CE64
 97+  CE64 2A 0E FB                 ld      hl, (FAT_CACHE_ADDR + FAT_BOOT_SECTOR.BPB_RsvdSecCnt)
 98+  CE67 22 EF D2                 ld      (v_diskInfo.resSectors), hl         ; сколько секторов занимает зарезервированная область
 99+  CE6A
100+  CE6A EB                       ex      hl, de
101+  CE6B
102+  CE6B 2A 16 FB                 ld      hl, (FAT_CACHE_ADDR + FAT_BOOT_SECTOR.BPB_FATSz16)
103+  CE6E 22 F1 D2                 ld      (v_diskInfo.fatSectors), hl         ; сколько секторов занимает таблица fat
104+  CE71
105+  CE71 19                       add     hl, de
106+  CE72 22 FD D2                 ld      (v_diskInfo.dirStartSector), hl     ; первый сектор корневого каталога
107+  CE75 E5                       push    hl
108+  CE76
109+  CE76 2A 11 FB                 ld      hl, (FAT_CACHE_ADDR + FAT_BOOT_SECTOR.BPB_RootEntCnt)
110+  CE79 22 F7 D2                 ld      (v_diskInfo.rootDirMaxFiles), hl    ; максимум файлов в корневом каталоге
111+  CE7C
112+  CE7C 2A EB D2                 ld      hl, (v_diskInfo.sectorSize)
113+  CE7F 11 20 00                 ld      de, FILE_DESCR_SIZE ; de = 32
114+  CE82 CD 87 D2                 call    div_hl_de;
115+  CE85 22 F9 D2                 ld      (v_diskInfo.descrPerSector), hl     ; сколько дескрипторов файлов вмещается в один сектор
116+  CE88
117+  CE88 EB                       ex      hl, de
118+  CE89 2A F7 D2                 ld      hl, (v_diskInfo.rootDirMaxFiles)
119+  CE8C CD 87 D2                 call    div_hl_de;
120+  CE8F 22 F3 D2                 ld      (v_diskInfo.dirSectors), hl         ; сколько секторов занимает корневой каталог
121+  CE92
122+  CE92 D1                       pop     de
123+  CE93 19                       add     hl, de
124+  CE94 22 FF D2                 ld      (v_diskInfo.dataStartSector), hl    ; первый сектор области данных
125+  CE97
126+  CE97 2A EB D2                 ld      hl, (v_diskInfo.sectorSize)
127+  CE9A CD 5A D2                 call    div_hl_2
128+  CE9D EB                       ex      hl, de
129+  CE9E 2A F1 D2                 ld      hl, (v_diskInfo.fatSectors)
130+  CEA1 CD 62 D2                 call    mul_hl_de;
131+  CEA4 22 FB D2                 ld      (v_diskInfo.fatNumCells), hl        ; количество ячеек в таблице fat (= fatSectors * sectorSize / 2)
132+  CEA7
133+  CEA7                          ; Копируем метку тома
134+  CEA7 21 2B FB                 ld      hl, FAT_CACHE_ADDR + FAT_BOOT_SECTOR.BS_VolLab          ; откуда - начало
135+  CEAA 11 36 FB                 ld      de, FAT_CACHE_ADDR + FAT_BOOT_SECTOR.BS_FilSysType      ; откуда - конец
136+  CEAD 01 01 D3                 ld      bc, v_diskInfo.volumeLabel                              ; куда
137+  CEB0 CD 2D C4                 call    memcpy_bc_hl
138+  CEB3 36 00                    ld      (hl), 0                                                 ; в конце байт-терминатор строки
139+  CEB5
140+  CEB5              frbs_Exit:  ; Восстанавливаем регистры и выходим
141+  CEB5 C1                       pop     bc
142+  CEB6 D1                       pop     de
143+  CEB7 E1                       pop     hl
144+  CEB8 C9                       ret
145+  CEB9
114   CEB9                  INCLUDE "fileCreate.inc"
  1+  CEB9              ;----------------------------------------------------------------------------
  2+  CEB9              ; MXOS
  3+  CEB9              ; Создать файл
  4+  CEB9              ;
  5+  CEB9              ; На входе
  6+  CEB9              ;  hl - адрес дескриптора файла в формате FAT (имя, фтрибуты, размер и т.д.)
  7+  CEB9              ;
  8+  CEB9              ; На выходе
  9+  CEB9              ;  сf - ошибка
 10+  CEB9              ;
 11+  CEB9              ; TODO: В случае нехватки места на диске, на нем остается неполный файл.
 12+  CEB9              ; Надо удалить то, что записали.
 13+  CEB9              ;
 14+  CEB9              ; 2013-12-12 Дизассемблировано vinxru
 15+  CEB9              ; 2022-02-11 Переработано SpaceEngineer
 16+  CEB9              ;----------------------------------------------------------------------------
 17+  CEB9
 18+  CEB9              fileCreate: ; Сохраняем регистры
 19+  CEB9 E5                       push    hl  ; [1]
 20+  CEBA C5                       push    bc  ; [2]
 21+  CEBB D5                       push    de  ; [3]
 22+  CEBC
 23+  CEBC                          ; Сохраняем адрес подготовленного дескриптора создаваемого файла
 24+  CEBC 22 C9 D2                 ld      (v_newDescrPtr), hl
 25+  CEBF
 26+  CEBF                          ; Если файл существует, то удаляем его
 27+  CEBF CD 73 CF                 call    fileFind
 28+  CEC2 D4 43 D0                 call nc,deleteFileInt
 29+  CEC5
 30+  CEC5                          ; de = номер первого сектора каталога
 31+  CEC5                          ; с  = количество секторов каталога (мл. байт)
 32+  CEC5 CD 5E CD                 call    fatBeginDirLoop
 33+  CEC8
 34+  CEC8                          ; Цикл по секторам каталога
 35+  CEC8              fileCreate_dirLoop:
 36+  CEC8                          ; Сохраняем номер сектора каталога
 37+  CEC8 D5                       push    de  ; [4]               ; de = номер сектора каталога
 38+  CEC9
 39+  CEC9                          ; Кэшируем сектор каталога
 40+  CEC9 AF                       xor     a                       ; флаг - сектор не будет меняться
 41+  CECA CD 80 CC                 call    getSectorAddressInCache ; выход: hl = адрес сектора в буфере
 42+  CECD
 43+  CECD                          ; Кол-во дескрипторов файлов в одном секторе каталога (мл. байт)
 44+  CECD 3A F9 D2                 ld      a, (v_diskInfo.descrPerSector)
 45+  CED0 47                       ld      b, a
 46+  CED1
 47+  CED1                          ; Размер дескриптора
 48+  CED1 11 20 00                 ld      de, FILE_DESCR_SIZE
 49+  CED4
 50+  CED4                          ; Цикл по дескрипторам в закешированном секторе каталога
 51+  CED4              fileCreate_sectorLoop:
 52+  CED4 7E                       ld      a, (hl)                 ; читаем байт из каталога
 53+  CED5 3C                       inc     a                       ; если байт = 0FFh, значит запись свободна
 54+  CED6 CA EA CE                 jp z,   fileCreate_placeFound   ; переход, если свободная запись найдена
 55+  CED9
 56+  CED9                          ; Вычисляем адрес следующего дескриптора
 57+  CED9 19                       add     hl, de
 58+  CEDA
 59+  CEDA                          ; Еще остались файлы в секторе каталога?
 60+  CEDA 05                       dec     b
 61+  CEDB C2 D4 CE                 jp nz,  fileCreate_sectorLoop
 62+  CEDE
 63+  CEDE                          ; Еще остались секторы каталога?
 64+  CEDE                          ; Восстанавливаем номер сектора каталога
 65+  CEDE D1                       pop     de  ; [4]   de = номер сектора каталога
 66+  CEDF 13                       inc     de  ;       следующий сектор каталога
 67+  CEE0
 68+  CEE0 0D                       dec     c
 69+  CEE1 C2 C8 CE                 jp nz,  fileCreate_dirLoop
 70+  CEE4
 71+  CEE4                          ;-----------------------------------------------------------
 72+  CEE4                          ; Свободных записей нет
 73+  CEE4
 74+  CEE4                          ; Установка a=0, ZF=1
 75+  CEE4 AF                       xor     a
 76+  CEE5
 77+  CEE5              stc_popDBH_ret:
 78+  CEE5                          ; Установка флага CF=1
 79+  CEE5 37                       scf
 80+  CEE6
 81+  CEE6              popDBH_ret: ; Восстановление регистров и выход
 82+  CEE6 D1                       pop     de  ; [3]
 83+  CEE7 C1                       pop     bc  ; [2]
 84+  CEE8 E1                       pop     hl  ; [1]
 85+  CEE9 C9                       ret
 86+  CEEA
 87+  CEEA                          ;-----------------------------------------------------------
 88+  CEEA                          ; Свободная запись найдена
 89+  CEEA
 90+  CEEA              fileCreate_placeFound:
 91+  CEEA
 92+  CEEA                          ; Сохраняем найденный в кэше адрес свободного дескриптора
 93+  CEEA 22 C5 D2                 ld      (v_cachedDescrPtr), hl
 94+  CEED
 95+  CEED                          ; Сохраняем номер сектора каталога
 96+  CEED D1                       pop     de  ; [4]   de = номер сектора каталога
 97+  CEEE EB                       ex      hl, de
 98+  CEEF 22 C7 D2                 ld      (v_cachedSector), hl
 99+  CEF2
100+  CEF2                          ; Находим первый свободный кластер
101+  CEF2 CD 86 CD                 call    fatFindClusterFirst ; de = первый свободный кластер
102+  CEF5 DA E5 CE                 jp c,   stc_popDBH_ret      ; если нет свободных кластеров - выходим с ошибкой
103+  CEF8
104+  CEF8                          ; Сохраняем его в переменную v_fileFirstCluster
105+  CEF8 EB                       ex      hl, de
106+  CEF9 22 BF D2                 ld      (v_fileFirstCluster), hl
107+  CEFC EB                       ex      hl, de
108+  CEFD
109+  CEFD                          ; Сохраняем номер первого кластера в дескриптор файла
110+  CEFD                          ; de = номер первого кластера
111+  CEFD                          ; hl = адрес дескриптора файла
112+  CEFD 2A C9 D2                 ld      hl, (v_newDescrPtr)
113+  CF00 01 1A 00                 ld      bc, FILE_DESCRIPTOR.firstCluster
114+  CF03 09                       add     hl, bc  ; hl = адрес поля firstCluster (мл. байт) в дескрипторе файла
115+  CF04 73                       ld      (hl), e
116+  CF05 23                       inc     hl      ; hl = адрес поля firstCluster (ст. байт) в дескрипторе файла
117+  CF06 72                       ld      (hl), d
118+  CF07
119+  CF07
120+  CF07                          ;---------------------------------------------------------------------
121+  CF07                          ; Записываем дескриптор в каталог, пока сектор каталога все еще в кэше
122+  CF07
