 94   C7F2                  ORG_PAD 0C800h
 94   C7F2             >         IF $ > 0C800h
 94   C7F2 ~           >           ; вывод сообщения об ошибке
 94   C7F2 ~           >           ASSERT 0
 94   C7F2 ~           >           DISPLAY /l, "Error! ORG_PAD failed! ", $, " is more than ", adr
 94   C7F2             >         ELSE
 94   C7F2             >           ; заполнение памяти
 94   C7F2 FF FF FF... >           BLOCK 0C800h-$, 0FFh
 94   C7F6             >         ENDIF
 94   C800             >         ORG 0C800h
