104   CA96                  INCLUDE "driverFFC0.inc"
  1+  CA96              ;+---------------------------------------------------------------------------
  2+  CA96              ; MXOS
  3+  CA96              ; Драйверы диска в ДОЗУ (часть, которая копируется на адрес 0FFC0h)
  4+  CA96              ;
  5+  CA96              ; 2013-12-12 Дизассемблировано и доработано vinxru
  6+  CA96              ; 2022-02-02 Доработано SpaceEngineer
  7+  CA96              ;----------------------------------------------------------------------------
  8+  CA96
  9+  CA96              ;----------------------------------------------------------------------------
 10+  CA96              ; Установить драйвер доступа к ДОЗУ в окно разделяемой памяти
 11+  CA96              ; Специалиста-MX (FFC0h-FFDEh)
 12+  CA96              ;
 13+  CA96              ; вход:
 14+  CA96              ;  b = 0 - установить блочный драйвер, b = 1 - установить побайтовый драйвер
 15+  CA96              ;
 16+  CA96              ; 2022-02-02 SpaceEngineer
 17+  CA96              ;----------------------------------------------------------------------------
 18+  CA96
 19+  CA96              setRAMDDriver:
 20+  CA96 E5                       push  hl
 21+  CA97 D5                       push  de
 22+  CA98 C5                       push  bc
 23+  CA99 F5                       push  af
 24+  CA9A 05                       dec   b
 25+  CA9B CA A7 CA                 jp z, setRAMDDriver_1
 26+  CA9E
 27+  CA9E                          ; Адреса блочного драйвера
 28+  CA9E 21 B8 CA                 ld    hl, driverBlockStart
 29+  CAA1 11 D8 CA                 ld    de, driverBlockEnd
 30+  CAA4 C3 AD CA                 jp    setRAMDDriver_2
 31+  CAA7
 32+  CAA7              setRAMDDriver_1:
 33+  CAA7                          ; Адреса побайтового драйвера
 34+  CAA7 21 D8 CA                 ld    hl, driverByteStart
 35+  CAAA 11 F8 CA                 ld    de, driverByteEnd
 36+  CAAD
 37+  CAAD                          ; Копируем драйвер на адрес bc = bios_RAMDRead = 0FFC0h
 38+  CAAD              setRAMDDriver_2:
 39+  CAAD 01 C0 FF                 ld    bc, bios_RAMDRead
 40+  CAB0 CD 2D C4                 call  memcpy_bc_hl
 41+  CAB3
 42+  CAB3                          ; Восстанавливаем регистры и выходим
 43+  CAB3 F1                       pop   af
 44+  CAB4 C1                       pop   bc
 45+  CAB5 D1                       pop   de
 46+  CAB6 E1                       pop   hl
 47+  CAB7 C9                       ret
 48+  CAB8
 49+  CAB8              ;----------------------------------------------------------------------------
 50+  CAB8              ; Блочный драйвер, обрабатывает сразу блок 256 байт
 51+  CAB8              ;
 52+  CAB8              ; FFC0h - чтение 256-байтного блока
 53+  CAB8              ;   вход:
 54+  CAB8              ;     c = номер страницы
 55+  CAB8              ;     d = номер блока
 56+  CAB8              ;     e = 0
 57+  CAB8              ;     hl = адрес буфера в памяти
 58+  CAB8              ;
 59+  CAB8              ; FFD0h - запись 256-байтного блока
 60+  CAB8              ;   вход:
 61+  CAB8              ;     c = номер страницы
 62+  CAB8              ;     d = номер блока
 63+  CAB8              ;     e = 0
 64+  CAB8              ;     hl = адрес буфера в памяти
 65+  CAB8              ;
 66+  CAB8              ;----------------------------------------------------------------------------
 67+  CAB8
 68+  CAB8              ; Чтение 256-байтного блока с диска
 69+  CAB8
 70+  CAB8              driverBlockStart: ; эта п/п копируется на FFC0h
 71+  CAB8 79                       ld      a, c
 72+  CAB9 32 FD FF                 ld      (IO_PAGE_RAMD), a
 73+  CABC 1A                       ld      a, (de)
 74+  CABD 32 FC FF                 ld      (IO_PAGE_RAM), a
 75+  CAC0 77                       ld      (hl), a
 76+  CAC1 23                       inc     hl
 77+  CAC2 1C                       inc     e
 78+  CAC3 C2 C0 FF                 jp nz,  0FFC0h
 79+  CAC6 C9                       ret
 80+  CAC7
 81+  CAC7                          ; осталось места: 1 байт
 82+  CAC7 00                       nop
 83+  CAC8
 84+  CAC8              ; Запись 256-байтного блока на диск
 85+  CAC8
 86+  CAC8              driverBlockWrite: ; эта п/п копируется на FFD0h
 87+  CAC8 46                       ld      b, (hl)
 88+  CAC9 79                       ld      a, c
 89+  CACA 32 FD FF                 ld      (IO_PAGE_RAMD), a
 90+  CACD 78                       ld      a, b
 91+  CACE 12                       ld      (de), a
 92+  CACF 32 FC FF                 ld      (IO_PAGE_RAM), a
 93+  CAD2 23                       inc     hl
 94+  CAD3 1C                       inc     e
 95+  CAD4 C2 D0 FF                 jp nz,  0FFD0h
 96+  CAD7 C9                       ret
 97+  CAD8
 98+  CAD8                          ; осталось места: 0 байт
 99+  CAD8
100+  CAD8              driverBlockEnd:
101+  CAD8
102+  CAD8              ;----------------------------------------------------------------------------
103+  CAD8              ; Побайтовый драйвер, обрабатывает только 1 байт
104+  CAD8              ;
105+  CAD8              ; FFC0h - чтение байта
106+  CAD8              ;   вход:
107+  CAD8              ;     a  = номер страницы
108+  CAD8              ;     hl = адрес байта в странице ДОЗУ
109+  CAD8              ;   выход:
110+  CAD8              ;     c  = считанный байт
111+  CAD8              ;
112+  CAD8              ; FFD0h - запись байта
113+  CAD8              ;   вход:
114+  CAD8              ;     a  = номер страницы
115+  CAD8              ;     hl = байта в странице ДОЗУ
116+  CAD8              ;     c  = записываемый байт
117+  CAD8              ;
118+  CAD8              ;----------------------------------------------------------------------------
119+  CAD8
120+  CAD8              driverByteStart: ; эта п/п копируется на FFC0h
121+  CAD8 32 FD FF                 ld      (IO_PAGE_RAMD), a
122+  CADB 4E                       ld      c, (hl)
123+  CADC 32 FC FF                 ld      (IO_PAGE_RAM), a
124+  CADF C9                       ret
125+  CAE0
126+  CAE0                          ; осталось места: 8 байт
127+  CAE0 00                       nop
128+  CAE1 00                       nop
129+  CAE2 00                       nop
130+  CAE3 00                       nop
131+  CAE4 00                       nop
132+  CAE5 00                       nop
133+  CAE6 00                       nop
134+  CAE7 00                       nop
135+  CAE8
136+  CAE8              driverByteWrite: ; эта п/п копируется на FFD0h
137+  CAE8 32 FD FF                 ld      (IO_PAGE_RAMD), a
138+  CAEB 71                       ld      (hl), c
139+  CAEC 32 FC FF                 ld      (IO_PAGE_RAM), a
140+  CAEF C9                       ret
141+  CAF0
142+  CAF0                          ; осталось места: 8 байт
143+  CAF0 00                       nop
144+  CAF1 00                       nop
145+  CAF2 00                       nop
146+  CAF3 00                       nop
147+  CAF4 00                       nop
148+  CAF5 00                       nop
149+  CAF6 00                       nop
150+  CAF7 00                       nop
151+  CAF8
152+  CAF8              driverByteEnd:
153+  CAF8
154+  CAF8              ; ---------------------------------------------------------------------------
155+  CAF8
156+  CAF8              ; Проверка, что драйверы влезаеют в 32 байта разделяемой памяти Специалиста-MX
157+  CAF8
158+  CAF8                  IF driverBlockWrite-driverBlockStart+bios_RAMDRead != bios_RAMDWrite
159+  CAF8 ~                    ASSERT 0
160+  CAF8 ~                    DISPLAY /l, "Error! Block briver entry point FFD0 has been shifted: ", driverBlockWrite-driverBlockStart+bios_RAMDRead, " != 0xFFD0"
161+  CAF8                  ENDIF
162+  CAF8
163+  CAF8                  IF driverByteWrite-driverByteStart+bios_RAMDRead != bios_RAMDWrite
164+  CAF8 ~                    ASSERT 0
165+  CAF8 ~                    DISPLAY /l, "Error! Byte briver entry point FFD0 has been shifted: ", driverByteWrite-driverByteStart+bios_RAMDRead, " != 0xFFD0"
166+  CAF8                  ENDIF
167+  CAF8
168+  CAF8                  IF driverBlockEnd-driverBlockStart > 32
169+  CAF8 ~                    ASSERT 0
170+  CAF8 ~                    DISPLAY /d, "Error! Block briver did not fit: ", driverBlockEnd-driverBlockStart, " > 32 bytes"
171+  CAF8                  ENDIF
172+  CAF8
173+  CAF8                  IF driverByteEnd-driverByteStart > 32
174+  CAF8 ~                    ASSERT 0
175+  CAF8 ~                    DISPLAY /d, "Error! Byte briver did not fit: ", driverByteEnd-driverByteStart, " > 32 bytes"
176+  CAF8                  ENDIF
177+  CAF8
