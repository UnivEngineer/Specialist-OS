100   C964                  INCLUDE "calcCS.inc"
  1+  C964              ;+---------------------------------------------------------------------------
  2+  C964              ; MXOS
  3+  C964              ; Расчет контрольной суммы
  4+  C964              ;
  5+  C964              ; На входе
