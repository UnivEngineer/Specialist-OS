124   D220                  INCLUDE "copyDescriptor.inc"
  1+  D220              ;----------------------------------------------------------------------------
  2+  D220              ; MXOS
  3+  D220              ; Копирование дескриптора файла (FILE_DESCRIPTOR)
  4+  D220              ;
  5+  D220              ; вход:
  6+  D220              ;  de = адрес откуда
  7+  D220              ;  hl = адрес куда
  8+  D220              ;
  9+  D220              ; выход:
 10+  D220              ;  de = адрес следующего дескриптора
 11+  D220              ;  hl = адрес следующего дескриптора
 12+  D220              ;
 13+  D220              ; 2022-02-11 SpaceEngineer
 14+  D220              ;----------------------------------------------------------------------------
 15+  D220
 16+  D220              copyDescriptor:
 17+  D220                          ; Копируем FILE_DESCR_SIZE байт из de в hl
 18+  D220 06 20                    ld      b, FILE_DESCR_SIZE
 19+  D222 1A           cfd_loop:   ld      a, (de)
 20+  D223 77                       ld      (hl), a
 21+  D224 23                       inc     hl
 22+  D225 13                       inc     de
 23+  D226 05                       dec     b
 24+  D227 C2 22 D2                 jp nz,  cfd_loop
 25+  D22A C9                       ret
 26+  D22B
 27+  D22B              ;----------------------------------------------------------------------------
 28+  D22B              ; MXOS
 29+  D22B              ; Проеобразование дескриптора файла в компактную форму
 30+  D22B              ; FILE_DESCRIPTOR -> FILE_INFO
 31+  D22B              ;
 32+  D22B              ; вход:
 33+  D22B              ;  de = адрес откуда
 34+  D22B              ;  hl = адрес куда
 35+  D22B              ;
 36+  D22B              ; выход:
 37+  D22B              ;  hl = адрес следующего описателя
 38+  D22B              ;
 39+  D22B              ;  de - сохраняется
 40+  D22B              ;
 41+  D22B              ; 2022-02-16 SpaceEngineer
 42+  D22B              ;----------------------------------------------------------------------------
 43+  D22B
 44+  D22B              copyDescriptorCompact:
 45+  D22B D5                       push    de
 46+  D22C
 47+  D22C                          ; Копируем имя файла + расширение + байт атрибутов
 48+  D22C 06 0C                    ld      b, FILE_NAME_LENGTH + 4
 49+  D22E 1A           cfdc_loop:  ld      a, (de)
 50+  D22F 77                       ld      (hl), a
 51+  D230 23                       inc     hl
 52+  D231 13                       inc     de
 53+  D232 05                       dec     b
 54+  D233 C2 2E D2                 jp nz,  cfdc_loop
 55+  D236
 56+  D236                          ; Копируем поле адреса загрузки
 57+  D236 EB                       ex      hl, de
 58+  D237 01 06 00                 ld      bc, FILE_DESCRIPTOR.loadAddress - FILE_DESCRIPTOR.attrib - 1   ; относительное смещение поля loadAddr
 59+  D23A 09                       add     hl, bc
 60+  D23B EB                       ex      hl, de
 61+  D23C
 62+  D23C 1A                       ld      a, (de)
 63+  D23D 77                       ld      (hl), a
 64+  D23E 23                       inc     hl
 65+  D23F 13                       inc     de
 66+  D240 1A                       ld      a, (de)
 67+  D241 77                       ld      (hl), a
 68+  D242 23                       inc     hl
 69+  D243
 70+  D243                          ; Копируем поле размера
 71+  D243 EB                       ex      hl, de
 72+  D244 01 09 00                 ld      bc, FILE_DESCRIPTOR.size - FILE_DESCRIPTOR.loadAddress - 1  ; относительное смещение поля size
 73+  D247 09                       add     hl, bc
 74+  D248 EB                       ex      hl, de
 75+  D249
 76+  D249 1A                       ld      a, (de)
 77+  D24A 77                       ld      (hl), a
 78+  D24B 23                       inc     hl
 79+  D24C 13                       inc     de
 80+  D24D 1A                       ld      a, (de)
 81+  D24E 77                       ld      (hl), a
 82+  D24F 23                       inc     hl
 83+  D250
 84+  D250 D1                       pop     de
 85+  D251 C9                       ret
 86+  D252
125   D252                  INCLUDE "printDecWord.inc"
  1+  D252              ;----------------------------------------------------------------------------
  2+  D252              ; MXOS DOS.SYS
  3+  D252              ; Вывод десятичного числа из de
  4+  D252              ; Перенесено из NC.COM
  5+  D252              ;
  6+  D252              ; вход:
  7+  D252              ;   de = число
  8+  D252              ;   b = дополнить ведущими символами: 20h - пробелами, 30h - нулями, 00h - не дополнять
  9+  D252              ;
 10+  D252              ; выход:
 11+  D252              ;   hl, de, bc - сохраняются
 12+  D252              ;
 13+  D252              ; 2013-12-18 Дизассемблировано vinxru
 14+  D252              ;----------------------------------------------------------------------------
 15+  D252
 16+  D252              printDecWord:
 17+  D252 D5                       push  de
 18+  D253 C5                       push  bc
 19+  D254 E5                       push  hl
 20+  D255 EB                       ex    de, hl
 21+  D256                          ; ld    b,  20h  ; b = маска кода символа, заменяет ведущие нули на (код_символа and маска)
 22+  D256 11 F0 D8                 ld    de, -10000
 23+  D259 CD 79 D2                 call  printDec1
 24+  D25C 11 18 FC                 ld    de, -1000
 25+  D25F CD 79 D2                 call  printDec1
 26+  D262 11 9C FF                 ld    de, -100
 27+  D265 CD 79 D2                 call  printDec1
 28+  D268 11 F6 FF                 ld    de, -10
 29+  D26B CD 79 D2                 call  printDec1
 30+  D26E 7D                       ld    a, l
 31+  D26F C6 30                    add   a, '0'
 32+  D271 4F                       ld    c, a
 33+  D272 CD 37 C0                 call  printChar
 34+  D275 E1                       pop   hl
 35+  D276 C1                       pop   bc
 36+  D277 D1                       pop   de
 37+  D278 C9                       ret
 38+  D279
 39+  D279              ; ---------------------------------------------------------------------------
 40+  D279
 41+  D279
 42+  D279              printDec1:  ; c = '0' + (hl / de), hl /= de;
 43+  D279 0E 2F                    ld    c, '0'-1
 44+  D27B
 45+  D27B 0C           loc_DB11:   inc   c
 46+  D27C 19                       add   hl, de
 47+  D27D DA 7B D2                 jp c, loc_DB11
 48+  D280
 49+  D280 7A                       ld    a, d        ; hl -= de;
 50+  D281 2F                       cpl
 51+  D282 57                       ld    d, a
 52+  D283 7B                       ld    a, e
 53+  D284 2F                       cpl
 54+  D285 5F                       ld    e, a
 55+  D286 13                       inc   de
 56+  D287 19                       add   hl, de
 57+  D288 79                       ld    a, c
 58+  D289
 59+  D289                          ; if (c!='0') b=0xFF; c&=b;
 60+  D289 FE 30                    cp    '0'
 61+  D28B CA 90 D2                 jp z, loc_DB26
 62+  D28E 06 FF                    ld    b, 0FFh   ; первый не ноль, меняем маску кода символа на 0FFh
 63+  D290 A0           loc_DB26:   and   b
 64+  D291 C8                       ret   z ; выходим если код символа 0
 65+  D292 4F                       ld    c, a
 66+  D293 C3 37 C0                 jp    printChar
 67+  D296
126   D296                  INCLUDE "math.inc"
  1+  D296              ;+---------------------------------------------------------------------------
  2+  D296              ; MXOS
  3+  D296              ; Математические фуннкции
  4+  D296              ;----------------------------------------------------------------------------
  5+  D296
  6+  D296              ;----------------------------------------------------------------------------
  7+  D296              ; Вычитание hl и de:
  8+  D296              ; hl = hl - de
  9+  D296              ;
 10+  D296              ; de, bc - сохраняется
 11+  D296              ;
 12+  D296              ; SpaceEngineer
 13+  D296              ;----------------------------------------------------------------------------
 14+  D296
 15+  D296              sub_hl_de:
 16+  D296 7D                   ld    a, l
 17+  D297 93                   sub   e
 18+  D298 6F                   ld    l, a
 19+  D299 7C                   ld    a, h
 20+  D29A 9A                   sbc   d
 21+  D29B 67                   ld    h, a
 22+  D29C C9                   ret
 23+  D29D
 24+  D29D              ;----------------------------------------------------------------------------
 25+  D29D              ; Деление hl на 2:
 26+  D29D              ; hl = hl / 2
 27+  D29D              ;
 28+  D29D              ; de, bc - сохраняется
 29+  D29D              ;
 30+  D29D              ; SpaceEngineer
 31+  D29D              ;----------------------------------------------------------------------------
 32+  D29D
 33+  D29D              div_hl_2:
 34+  D29D 7C                   ld  a, h
 35+  D29E B7                   or  a    ; сброс флага c
 36+  D29F 1F                   rra
 37+  D2A0 67                   ld  h, a
 38+  D2A1 7D                   ld  a, l
 39+  D2A2 1F                   rra
 40+  D2A3 6F                   ld  l, a
 41+  D2A4 C9                   ret
 42+  D2A5
 43+  D2A5              ;----------------------------------------------------------------------------
 44+  D2A5              ; Умножение hl на de:
 45+  D2A5              ; hl = hl * de
 46+  D2A5              ;
 47+  D2A5              ;
 48+  D2A5              ; На входе
 49+  D2A5              ;  hl, de - множители
 50+  D2A5              ;
 51+  D2A5              ; На выходе
 52+  D2A5              ;  hl - произведение
 53+  D2A5              ;
 54+  D2A5              ;  bc - сохраняется
 55+  D2A5              ;
 56+  D2A5              ; Взято из проекта c8080 VWarlock'a
 57+  D2A5              ; https://github.com/VWarlock/C8080
 58+  D2A5              ;----------------------------------------------------------------------------
 59+  D2A5
 60+  D2A5              mul_hl_de:
 61+  D2A5 C5                   push    bc
 62+  D2A6 44                   ld      b, h
 63+  D2A7 4D                   ld      c, l
 64+  D2A8 21 00 00             ld      hl, 0
 65+  D2AB 3E 11                ld      a, 17
 66+  D2AD 3D           _mul1:  dec     a
 67+  D2AE CA C8 D2             jp      z, pop_bc_ret
 68+  D2B1 29                   add     hl, hl
 69+  D2B2 EB                   ex      hl, de
 70+  D2B3 D2 BB D2             jp      nc, _mul2
 71+  D2B6 29                   add     hl, hl
 72+  D2B7 24                   inc     h
 73+  D2B8 C3 BC D2             jp      _mul3
 74+  D2BB 29           _mul2:  add     hl, hl
 75+  D2BC EB           _mul3:  ex      hl, de
 76+  D2BD D2 AD D2             jp      nc, _mul1
 77+  D2C0 09                   add     hl, bc
 78+  D2C1 D2 AD D2             jp      nc, _mul1
 79+  D2C4 14                   inc     d
 80+  D2C5 C3 AD D2             jp      _mul1
 81+  D2C8
 82+  D2C8              pop_bc_ret:
 83+  D2C8 C1                   pop     bc
 84+  D2C9 C9                   ret
 85+  D2CA
 86+  D2CA              ;----------------------------------------------------------------------------
 87+  D2CA              ; Деление hl на de:
 88+  D2CA              ; hl = hl / de
 89+  D2CA              ; de = hl % de
 90+  D2CA              ;
 91+  D2CA              ; На входе
 92+  D2CA              ;  hl - делимое
 93+  D2CA              ;  de - делитель
 94+  D2CA              ;
 95+  D2CA              ; На выходе
 96+  D2CA              ;  hl - частное
 97+  D2CA              ;  de - останок
 98+  D2CA              ;
 99+  D2CA              ;  bc - сохраняется
100+  D2CA              ;
101+  D2CA              ; Взято из проекта c8080 VWarlock'a
102+  D2CA              ; https://github.com/VWarlock/C8080
103+  D2CA              ;----------------------------------------------------------------------------
104+  D2CA
105+  D2CA              div_hl_de:
106+  D2CA C5                   push    bc
107+  D2CB EB                   ex      hl, de
108+  D2CC CD D1 D2             call    _div0
109+  D2CF C1                   pop     bc
110+  D2D0 C9                   ret
111+  D2D1
112+  D2D1 7C           _div0:  ld      a, h
113+  D2D2 B5                   or      l
114+  D2D3 C8                   ret     z
115+  D2D4 01 00 00             ld      bc, 0
116+  D2D7 C5                   push    bc
117+  D2D8 7B           _div1:  ld      a, e
118+  D2D9 95                   sub     L
119+  D2DA 7A                   ld      a, d
120+  D2DB 9C                   sbc     h
121+  D2DC DA E4 D2             jp      c, _div2
122+  D2DF E5                   push    hl
123+  D2E0 29                   add     hl, hl
124+  D2E1 D2 D8 D2             jp      nc, _div1
125+  D2E4 21 00 00     _div2:  ld      hl, 0
126+  D2E7 C1           _div3:  pop     bc
127+  D2E8 78                   ld      a, b
128+  D2E9 B1                   or      c
129+  D2EA C8                   ret     z
130+  D2EB 29                   add     hl, hl
131+  D2EC D5                   push    de
132+  D2ED 7B                   ld      a, e
133+  D2EE 91                   sub     c
134+  D2EF 5F                   ld      e, a
135+  D2F0 7A                   ld      a, d
136+  D2F1 98                   sbc     b
137+  D2F2 57                   ld      d, a
138+  D2F3 DA FB D2             jp      c, _div4
139+  D2F6 23                   inc     hl
140+  D2F7 C1                   pop     bc
141+  D2F8 C3 E7 D2             jp      _div3
142+  D2FB D1           _div4:  pop     de
143+  D2FC C3 E7 D2             jp      _div3
144+  D2FF
