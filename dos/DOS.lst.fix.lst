 25+  CFB1                          ; Цикл по секторам каталога
 26+  CFB1              fileFind_dirLoop:
 27+  CFB1                          ; Сохраняем номер сектора каталога
 28+  CFB1 D5                       push    de  ; [3]               ; de = номер сектора каталога
 29+  CFB2
 30+  CFB2                          ; Кэшируем сектор каталога
 31+  CFB2 E5                       push    hl  ; [4*]
 32+  CFB3 AF                       xor     a                       ; флаг - сектор не будет меняться
 33+  CFB4 CD 86 CC                 call    getSectorAddressInCache ; выход: hl = адрес сектора в буфере
 34+  CFB7 EB                       ex      hl, de                  ; de = адрес сектора в буфере
 35+  CFB8 E1                       pop     hl  ; [4*]              ; hl = адрес имени искомого файла
 36+  CFB9
 37+  CFB9                          ; Кол-во дескрипторов файлов в одном секторе каталога (мл. байт)
 38+  CFB9 3A 3C D3                 ld      a, (v_diskInfo.descrPerSector)
