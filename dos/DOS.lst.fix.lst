 98   C8A7                  INCLUDE "printHex.inc"
  1+  C8A7              ;+---------------------------------------------------------------------------
  2+  C8A7              ; MXOS
  3+  C8A7              ; Вывод 16-ричного числа на экран (слово)
  4+  C8A7              ;
  5+  C8A7              ; На входе
  6+  C8A7              ;  hl - число
  7+  C8A7              ;
  8+  C8A7              ; На выходе
  9+  C8A7              ;  все регистры сохраняются
 10+  C8A7              ;
 11+  C8A7              ; 2013-12-12 Дизассемблировано vinxru
 12+  C8A7              ;----------------------------------------------------------------------------
 13+  C8A7
 14+  C8A7              printHexWord:     ; Сохраняем регистры
 15+  C8A7 F5                       push  af
 16+  C8A8
 17+  C8A8                          ; Старший байт
 18+  C8A8 7C                       ld    a, h
 19+  C8A9 CD B2 C8                 call  printHexByte
 20+  C8AC
 21+  C8AC                          ; Младшйи байт
 22+  C8AC 7D                       ld    a, l
 23+  C8AD CD B2 C8                 call  printHexByte
 24+  C8B0
 25+  C8B0                          ; Восстаналиваем регистры
 26+  C8B0 F1                       pop   af
 27+  C8B1 C9                       ret
 28+  C8B2
 29+  C8B2              ;----------------------------------------------------------------------------
 30+  C8B2              ; Вывод 16-ричного числа на экран (байт)
 31+  C8B2              ;
 32+  C8B2              ; На входе
 33+  C8B2              ;  a - число
 34+  C8B2              ;
 35+  C8B2              ; На выходе
 36+  C8B2              ;  все регистры сохраняются
 37+  C8B2              ;----------------------------------------------------------------------------
 38+  C8B2
 39+  C8B2              printHexByte:     ; Сохраняем регистры
 40+  C8B2 C5                       push  bc
 41+  C8B3 F5                       push  af
 42+  C8B4
 43+  C8B4                          ; Сохраняем a для вывода второй цифры
 44+  C8B4 47                       ld    b, a
 45+  C8B5
 46+  C8B5                          ; Первая цифра - старшие 4 бита
 47+  C8B5 07                       rlca
 48+  C8B6 07                       rlca
 49+  C8B7 07                       rlca
 50+  C8B8 07                       rlca
 51+  C8B9 CD C3 C8                 call  printHexNibble
 52+  C8BC
 53+  C8BC                          ; Вторая цифра - младщие 4 бита
 54+  C8BC 78                       ld    a, b
 55+  C8BD CD C3 C8                 call  printHexNibble
 56+  C8C0
 57+  C8C0                          ; Восстаналиваем регистры
 58+  C8C0 F1                       pop   af
 59+  C8C1 C1                       pop   bc
 60+  C8C2 C9                       ret
 61+  C8C3
 62+  C8C3              ;----------------------------------------------------------------------------
 63+  C8C3              ; Вывод 16-ричного числа на экран (цифра)
 64+  C8C3              ;
 65+  C8C3              ; На входе
 66+  C8C3              ;  a - число, используются младшие 4 бита
 67+  C8C3              ;
 68+  C8C3              ; На выходе
 69+  C8C3              ;  c, a - изменяются, остальные регистры сохраняются
 70+  C8C3              ;----------------------------------------------------------------------------
 71+  C8C3
 72+  C8C3 E6 0F        printHexNibble:   and   0Fh
 73+  C8C5 C6 30                    add   a, '0'
