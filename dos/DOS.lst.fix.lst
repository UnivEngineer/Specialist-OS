101   C97B                  INCLUDE "reboot3.inc"
  1+  C97B              ;+---------------------------------------------------------------------------
  2+  C97B              ; MXOS
  3+  C97B              ; Обновление драйвера по адресу 0FFC0h и запуск NC.COM,
  4+  C97B              ; а также однократный запуск AUTOEXEC.BAT, если не нажата клавиша.
  5+  C97B              ;
  6+  C97B              ; 2013-12-12 Дизассемблировано vinxru
  7+  C97B              ;----------------------------------------------------------------------------
  8+  C97B
  9+  C97B              reboot3:    ; Инициализация стека
 10+  C97B 31 C0 FF                 ld      sp, STACK_ADDR
 11+  C97E
 12+  C97E                          ; Устанавливаем блочный драйвер
 13+  C97E 06 00                    ld      b, 0
 14+  C980 CD 96 CA                 call    setRAMDDriver
 15+  C983
 16+  C983                          ; Обновляем переменные
 17+  C983 21 00 C8                 ld      hl, j_reboot3
 18+  C986 22 E1 8F                 ld      (bios_vars.tapeError), hl
 19+  C989
 20+  C989              reboot3_0:
 21+  C989 C3 8C C9                 jp      reboot3_1
 22+  C98C
 23+  C98C              ; -------------------------------------
 24+  C98C              ; Код ниже будет выполнен лишь один раз после холодной перезагрузки.
 25+  C98C              ; То есть при теплой перезагрузке он не вызывается.
 26+  C98C
 27+  C98C              reboot3_1:
 28+  C98C                          ; Патчим предыдущую инструкцию - теперь она стала jp reboot3_2
 29+  C98C 21 C3 C9                 ld      hl, reboot3_2
 30+  C98F 22 8A C9                 ld      (reboot3_0+1), hl
 31+  C992
 32+  C992                          ; Устанавливаем побайтовый драйвер
 33+  C992 06 01                    ld      b, 1
 34+  C994 CD 96 CA                 call    setRAMDDriver
 35+  C997
 36+  C997                          ; Если в рам-диске по адресу 0FF00h (последний неполный сектор)
 37+  C997                          ; нет специальной метки, значит, не запускали форматирование
 38+  C997 21 BF FF                 ld      hl, 0FFBFh      ; адрес в странице
 39+  C99A AF                       xor     a               ; 0 страница
 40+  C99B CD C0 FF                 call    bios_RAMDRead
 41+  C99E 79                       ld      a, c            ; считанный байт в c
 42+  C99F FE 5A                    cp      5Ah
 43+  C9A1 CA B5 C9                 jp z,   skipFormat      ; метка есть - пропускаем форматирование
 44+  C9A4
 45+  C9A4                          ; Записываем метку
 46+  C9A4 AF                       xor     a               ; 0 страница
 47+  C9A5 0E 5A                    ld      c, 5Ah          ; записываемый байт
 48+  C9A7 CD D0 FF                 call    bios_RAMDWrite
 49+  C9AA
 50+  C9AA                          ; Устанавливаем блочный драйвер
 51+  C9AA 06 00                    ld      b, 0
 52+  C9AC CD 96 CA                 call    setRAMDDriver
 53+  C9AF
 54+  C9AF                          ; Запуск файла "A:FORMAT.BAT"
 55+  C9AF 21 31 D3                 ld      hl, pathFormatBat
 56+  C9B2 CD 25 CA                 call    fileExec
 57+  C9B5
 58+  C9B5              skipFormat:
 59+  C9B5                          ; Если нажата клавиша, пропустить запуск A:AUTOEX.BAT
 60+  C9B5 3A E1 FF                 ld      a, (IO_KEYB_B)
 61+  C9B8 E6 02                    and     2
 62+  C9BA CA C3 C9                 jp z,   reboot3_2
 63+  C9BD
 64+  C9BD                          ; Запуск файла A:AUTOEXEC.BAT
 65+  C9BD 21 22 D3                 ld      hl, pathAutoexecBat
 66+  C9C0 CD 25 CA                 call    fileExec
 67+  C9C3
 68+  C9C3              ; -------------------------------------
 69+  C9C3
 70+  C9C3              reboot3_2:
 71+  C9C3                          ; Запуск файла A:NC.COM
 72+  C9C3 21 19 D3                 ld      hl, pathNcCom
 73+  C9C6 CD 25 CA                 call    fileExec
 74+  C9C9
 75+  C9C9                          ; Теплая перезагрузка
 76+  C9C9 C3 00 C8                 jp      j_reboot3
 77+  C9CC
102   C9CC                  INCLUDE "fileExecBat.inc"
  1+  C9CC              ;+---------------------------------------------------------------------------
  2+  C9CC              ; MXOS
  3+  C9CC              ; Запустить BAT файл. Вызывается функцией fileExec
  4+  C9CC              ;
  5+  C9CC              ; 2013-12-12 Дизассемблировано vinxru
  6+  C9CC              ;----------------------------------------------------------------------------
  7+  C9CC
  8+  C9CC              execBat:
  9+  C9CC D1                       pop     de
 10+  C9CD
 11+  C9CD                          ; Устанавливаем адрес загрузки BAT-файла на BAT_BUFFER (= FC00h)
 12+  C9CD 21 00 E8                 ld      hl, BAT_BUFFER
 13+  C9D0 22 CD D2                 ld      (v_batPtr), hl
 14+  C9D3 EB                       ex      de, hl
 15+  C9D4
 16+  C9D4                          ; Изменяем адрес загрузки BAT-файла
 17+  C9D4                          ; TODO: это не работает с ром-диском (A: без поддержки записи). Поэтому
 18+  C9D4                          ; нельзя запустить BAT-файл с диска A:, если его адрес загрузки в каталоге
 19+  C9D4                          ; уже не прошит как FC00h (= BAT_BUFFER)
 20+  C9D4 21 9C D3                 ld      hl, v_curFileDescr
 21+  C9D7 0E 01                    ld      c, 1
 22+  C9D9 CD C5 D0                 call    fileGetSetAddr
 23+  C9DC DA 86 CA                 jp c,   badCommand
 24+  C9DF
 25+  C9DF                          ; Сохраняем имя BAT-файла
 26+  C9DF 21 9C D3                 ld      hl, v_curFileDescr
 27+  C9E2 11 A7 D3                 ld      de, v_curFileDescr + FILE_NAME_LENGTH + 3
 28+  C9E5 01 BC D3                 ld      bc, v_batFileDescr
 29+  C9E8 CD 97 C3                 call    memmove_bc_hl
 30+  C9EB
 31+  C9EB                          ; Сохраняем диск содержащий BAT-файл
 32+  C9EB 3A BC D2                 ld      a, (v_drive)
 33+  C9EE 32 F6 C9                 ld      (v_batDrive+1), a   ; самомодификация кода
 34+  C9F1
 35+  C9F1                          ; Этот цикл выполняется для каждой строки BAT-файла
 36+  C9F1              execBat_loop:
 37+  C9F1
 38+  C9F1                          ; Сохраняем текущий диск в регистре b
 39+  C9F1 3A BC D2                 ld      a, (v_drive)
 40+  C9F4 47                       ld      b, a
 41+  C9F5
 42+  C9F5              v_batDrive:
 43+  C9F5                          ; Выбрать диск содержащий BAT файл
 44+  C9F5 3E 01                    ld      a, 1 ; << сюда вместо 1 пишется диск, содержащий BAT файл
 45+  C9F7 CD C5 CB                 call    fileSelectDrive
 46+  C9FA
 47+  C9FA                          ; Загрузить BAT-файл в память
 48+  C9FA 21 BC D3                 ld      hl, v_batFileDescr
 49+  C9FD CD D0 CF                 call    fileLoad
 50+  CA00 2A CD D2                 ld      hl, (v_batPtr)
 51+  CA03
 52+  CA03                          ; Сохраняем начало строки
 53+  CA03 54                       ld      d, h
 54+  CA04 5D                       ld      e, l
 55+  CA05
 56+  CA05                          ; Ищем конец строки
 57+  CA05              execBat_0:
 58+  CA05 7E                       ld      a, (hl)
 59+  CA06 23                       inc     hl
 60+  CA07
 61+  CA07                          ; Найден конец строки, запускаем файл
 62+  CA07 FE 0D                    cp      0Dh
 63+  CA09 CA 17 CA                 jp z,   execBat_1
 64+  CA0C
 65+  CA0C                          ; Принимать также Unix-перевод строки. Файлы из Git и
 66+  CA0C                          ; современных редакторов часто заканчиваются байтом 0Ah.
 67+  CA0C FE 0A                    cp      0Ah
 68+  CA0E CA 17 CA                 jp z,   execBat_1
 69+  CA11
 70+  CA11                          ; Конец файла
 71+  CA11 FE FF                    cp      0FFh
 72+  CA13 C2 05 CA                 jp nz,  execBat_0
 73+  CA16 C9                       ret
 74+  CA17
 75+  CA17              ; ---------------------------------------------------------------------------
 76+  CA17
 77+  CA17              execBat_1:
 78+  CA17                          ; Сохраняем указатель
 79+  CA17 22 CD D2                 ld      (v_batPtr), hl
 80+  CA1A
 81+  CA1A                          ; Восстановление активного диска
 82+  CA1A 78                       ld      a, b
 83+  CA1B CD C5 CB                 call    fileSelectDrive
 84+  CA1E
 85+  CA1E                          ; Запустить файл
 86+  CA1E EB                       ex      de, hl
 87+  CA1F CD 25 CA                 call    fileExec
 88+  CA22
 89+  CA22 C3 F1 C9                 jp      execBat_loop
 90+  CA25
103   CA25                  INCLUDE "fileExec.inc"
  1+  CA25              ;+---------------------------------------------------------------------------
  2+  CA25              ; MXOS
  3+  CA25              ; Запустить файл
  4+  CA25              ;
  5+  CA25              ; На входе
  6+  CA25              ;  hl - ком строка в формате [Диск:]файл[ аргументы]
  7+  CA25              ;
  8+  CA25              ; На выходе
  9+  CA25              ;  сf - ошибка
 10+  CA25              ;
 11+  CA25              ; 2013-12-12 Дизассемблировано vinxru
 12+  CA25              ;----------------------------------------------------------------------------
 13+  CA25
 14+  CA25              fileExec:   ; Сюда будем записывать результат
 15+  CA25 11 00 FF                 ld      de, CMD_LINE
 16+  CA28
 17+  CA28                          ; Если первый символ меньше пробела, выходим c CF
 18+  CA28 7E                       ld      a, (hl)
 19+  CA29 FE 20                    cp      ' '
 20+  CA2B DA 8F CA                 jp      c, stc_ret
 21+  CA2E
 22+  CA2E                          ; Максимальный размер ком строки (+2 терминатора, итого 82h)
 23+  CA2E 0E 80                    ld      c, 80h
 24+  CA30
 25+  CA30              fileExec_0: ; Если символ меньше пробела, выходим
 26+  CA30 7E                       ld      a, (hl)
 27+  CA31 FE 20                    cp      20h
 28+  CA33 DA 3D CA                 jp c,   fileExec_1
 29+  CA36
 30+  CA36                          ; Копируем симовол из hl в de
 31+  CA36 12                       ld      (de),a
 32+  CA37 23                       inc     hl
 33+  CA38 13                       inc     de
 34+  CA39
 35+  CA39                          ; Повторяем 80h раз
 36+  CA39 0D                       dec     c
 37+  CA3A C2 30 CA                 jp nz,  fileExec_0
 38+  CA3D
 39+  CA3D              fileExec_1: ; В конец имени помещаем 13, 0
 40+  CA3D 3E 0D                    ld      a, 0Dh
 41+  CA3F 12                       ld      (de), a
 42+  CA40 13                       inc     de
 43+  CA41 AF                       xor     a
 44+  CA42 12                       ld      (de), a
 45+  CA43
 46+  CA43                          ; Выводим на экран 0Ah
 47+  CA43 CD 91 CA                 call    printCharA
 48+  CA46
 49+  CA46                          ; Выводим на экран имя файла
 50+  CA46 21 00 FF                 ld      hl, CMD_LINE
 51+  CA49 CD 18 C8                 call    j_printString
 52+  CA4C
 53+  CA4C                          ; Подготовка имени файла
 54+  CA4C 21 00 FF                 ld      hl, CMD_LINE
 55+  CA4F 11 9C D3                 ld      de, v_curFileDescr
 56+  CA52 CD 75 D1                 call    fileNamePrepare
 57+  CA55
 58+  CA55                          ; Запоминаем в стеке текущий адрес командной строки (начало списка аргументов)
 59+  CA55 E5                       push    hl
 60+  CA56
 61+  CA56                          ; Если это BAT файл
 62+  CA56 11 3E D3                 ld      de, aBat ; "BAT"
 63+  CA59 CD 2B CC                 call    cmpFileExt
 64+  CA5C CA CC C9                 jp z,   execBat
 65+  CA5F
 66+  CA5F                          ; Если это COM или EXE файл
 67+  CA5F CD 2B CC                 call    cmpFileExt
 68+  CA62 CA 6B CA                 jp z,   execExeCom
 69+  CA65 CD 2B CC                 call    cmpFileExt
 70+  CA68 C2 85 CA                 jp nz,  execError
 71+  CA6B
 72+  CA6B              execExeCom:
 73+  CA6B                          ; Вытаскиваем из стека текущий адрес командной строки (начало списка аргументов)
 74+  CA6B D1                       pop     de
 75+  CA6C
 76+  CA6C                          ; Загрузить файл
 77+  CA6C 21 9C D3                 ld      hl, v_curFileDescr
 78+  CA6F CD D0 CF                 call    fileLoad
 79+  CA72 DA 86 CA                 jp c,   badCommand
 80+  CA75
 81+  CA75                          ; Адрес командной строки
 82+  CA75 D5                       push    de
 83+  CA76
 84+  CA76                          ; Выводим на экран 0Ah
 85+  CA76                          ;call printCharA
 86+  CA76
 87+  CA76                          ; hl = указатель на адрес загрузки (= адрес запуска) файла
 88+  CA76 11 12 00                 ld      de, FILE_DESCRIPTOR.loadAddress   ; смещение поля с адресом загрузки
 89+  CA79 19                       add     hl, de
 90+  CA7A
 91+  CA7A                          ; de = адрес загрузки (= адрес запуска) файла
 92+  CA7A 5E                       ld      e, (hl)
 93+  CA7B 23                       inc     hl
 94+  CA7C 56                       ld      d, (hl)
 95+  CA7D
 96+  CA7D                          ; Адрес возврата
 97+  CA7D 21 83 CA                 ld      hl, defAppReturn
 98+  CA80 E3                       ex      (sp), hl
 99+  CA81
