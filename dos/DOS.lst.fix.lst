  9   0000                  INCLUDE "../include/mxos.inc"
  1+  0000              ;-----------------------------------------------------------------------
  2+  0000              ; MXOS
  3+  0000              ; Точки входа и настройки сборки MXOS
  4+  0000              ;
  5+  0000              ; Новая карта памяти:
  6+  0000              ;   8FDF-8FFF - [  32 B] Переменные
  7+  0000              ;   9000-BFFF - [12  KB] Экран
  8+  0000              ;   C000-DBFF - [7168 B] DOS.SYS
  9+  0000              ;   DC00-DDFF - [ 512 B] драйверные расширения (например, FlashSys.com)
 10+  0000              ;   DE00-DFFF - [ 512 B] Драйвер флеш-диска
 11+  0000              ;   E000-E7FF - [2048 B] Шрифт
 12+  0000              ;   E800-FAFF - [4864 B] Системные программы (NC.COM, E.COM, DL-RED.COM, FORMAT.COM, MON2.COM, ...)
 13+  0000              ;   FB00-FEFF - [1024 B] Дисковый кэш (fat + каталог)
 14+  0000              ;   FF00-FF81 - [ 130 B] Командная строка
 15+  0000              ;   FF82-FFBF - [  62 B] Стек
 16+  0000              ;   FFC0-FFEF - [  32 B] Непереключаемое ОЗУ, драйвер обмена с RAM диском
 17+  0000              ;   FFE0-FFFF - [  32 B] Оборудование
 18+  0000              ;
 19+  0000              ; Старая карта памяти:
 20+  0000              ;   8FDF-8FFF - [  32 B] Переменные
 21+  0000              ;   9000-BFFF - [12  KB] Экран
 22+  0000              ;   C000-CFFF - [4096 B] DOS.SYS
 23+  0000              ;   D000-E1FF - [4607 B] Системные программы (NC.COM, E.COM, DL-RED.COM)
 24+  0000              ;   E200-E5FF - [1024 B] Свободно (1024 байт)
 25+  0000              ;   E600-E7FF - [ 512 B] Драйвер магнитофона
 26+  0000              ;   E800-E8FF - [ 256 B] Свободно (256 байт)
 27+  0000              ;   E900-F0FF - [2048 B] Шрифт (можно отключить запуском ROMFNT.COM или опцией LOAD_FONT=0)
 28+  0000              ;   F100-F8FF - [2048 B] Системные программы (FORMAT.COM, MON2.COM, ...)
 29+  0000              ;   F900-F9FF - [ 256 B] Свободно (256 байт)
 30+  0000              ;   FA00-FAFF - [ 256 B] Драйвер флеш-диска
 31+  0000              ;   FB00-FEFF - [1024 B] Дисковый буфер (fat + каталог)
 32+  0000              ;   FF00-FF81 - [ 130 B] Командная строка
 33+  0000              ;   FF82-FFBF - [  62 B] Стек
 34+  0000              ;   FFC0-FFEF - [  32 B] Непереключаемое ОЗУ, драйвер обмена с RAM диском
 35+  0000              ;   FFE0-FFFF - [  32 B] Оборудование
 36+  0000              ;-----------------------------------------------------------------------
 37+  0000
 38+  0000
 39+  0000              ;-----------------------------------------------------------------------
 40+  0000              ; Конфигурация сборки
 41+  0000              ;-----------------------------------------------------------------------
 42+  0000
 43+  0000              NEW_MEMORY_MAP       =  1       ; Новая карта памяти
 44+  0000              RAMD_MAX_PAGE        =  16      ; Максимальное количество страниц RAM диска
 45+  0000              RAMD_PAGE_END        =  0FFBBh  ; Включить поддержку ДОЗУ большего чем 64 Кб
 46+  0000              ROM_64K              =  1       ; Включить поддержку ПЗУ 64 Кб Специалиста МХ2
 47+  0000              ENABLE_COLOR         =  1       ; Включить поддержку цвета
 48+  0000              EMBED_FONT           =  0       ; Встроить шрифт в программу (при запуске шрифт копируется на FONT_ADDR)
 49+  0000              LOAD_FONT            =  1       ; Загружать шрифт в ОЗУ
 50+  0000              COLOR_BIOS           =  0F0h    ; Цвет командной строки
 51+  0000              RAMFOS_COMPATIBILITY =  1       ; Совместимость с RAMFOS (WIP)
 52+  0000              BOOT_FROM_TAPE       =  0       ; Включить загрузку с ленты при нажатой клавише после сброса
 53+  0000
 54+  0000                  IF  NEW_MEMORY_MAP
 55+  0000              FONT_ADDR = 0E000h  ; Адрес шрфита
 56+  0000                  ELSE
 57+  0000 ~            FONT_ADDR = 0E900h  ; Адрес шрфита
 58+  0000                  ENDIF
 59+  0000
 60+  0000                  IF  LOAD_FONT
 61+  0000              FONT_ADDR_DIV_8 = FONT_ADDR/8
 62+  0000                  ELSE
 63+  0000 ~            FONT_ADDR_DIV_8 = -1
 64+  0000                  ENDIF
 65+  0000
 66+  0000              ;-----------------------------------------------------------------------
 67+  0000              ; Переменные ОС в подэкранном пространстве и их начальные значения
 68+  0000              ; Доступ к переменным из программ польователя:
 69+  0000              ; ld a, bios_vars.lastKey
 70+  0000              ;-----------------------------------------------------------------------
 71+  0000
 72+  0000                  STRUCT BIOS_VARIABLES
 73+  0000 ~            _reserv_1     DW      -1              ; 8FDFh -
 74+  0000 ~            tapeError     DW      0C800h          ; 8FE1h - Адрес, куда происходит переход при ошибке чтения с ленты
 75+  0000 ~            tapeAddr      DW      -1              ; 8FE3h - Адрес программы, загруженной с ленты
 76+  0000 ~            _reserv_2     DW      -1              ; 8FE5h -
 77+  0000 ~            charGen       DW      FONT_ADDR_DIV_8 ; 8FE7h - Адрес альтернативного знакогенератора / 8
 78+  0000 ~            cursorCfg     DB       21h ; 0A9h     ; 8FE9h - Внешний вид курсора (биты: 7 - мигание (если 0), 654 - положение (Y) от низа строки, 3210 - размер по высоте)
 79+  0000 ~            koi7          DB       0   ; 0FFh     ; 8FEAh - 0FFh = включен KOI-7, 0 = включен KOI-8
 80+  0000 ~            escMode       DB      -1              ; 8FEBh - Обработка ESC-последовательности
 81+  0000 ~            keyLocks      DB      0BAh ; 3Ah      ; 8FECh - Caps Lock или Рус/Lat (3A - прописные анг, BA - строчные анг, BB - прописные рус, 3B - строчные рус)
 82+  0000 ~            _reserv_3     DW      -1              ; 8FEDh -
 83+  0000 ~            lastLastKey   DB      -1              ; 8FEFh - Предпоследняя нажатая клавиша
 84+  0000 ~            lastKey       DB      -1              ; 8FF0h - Последняя нажатая клавиша
 85+  0000 ~            beepFreq      DB       5Fh            ; 8FF1h - Частота звукового сигнала (также влияет на длительность)
 86+  0000 ~            beepDuration  DB       20h            ; 8FF2h - Длительность звукового сигнала (сколько раз повторять посылку)
 87+  0000 ~            tapeInverse   DB      0FFh            ; 8FF3h - Признак инверсии данных с ленты
 88+  0000 ~            cursorDelay   DB       20h            ; 8FF4h - Задержка мигания курсора
 89+  0000 ~            antiBsDelay   DB      0E0h            ; 8FF5h - Задержка защиты от дребезга контактов клавиш
 90+  0000 ~            oldSP         DW      -1              ; 8FF6h - Используется для сохранения SP некоторыми функциями
 91+  0000 ~            ramPageCount  DB      RAMD_MAX_PAGE   ; 8FF8h - Количество детектированных 64кб страниц RAM-диска
 92+  0000 ~            diskWriteErr  DB       0              ; 8FF9h - Признак ошибки записи диска
 93+  0000 ~            inverse       DW       0              ; 8FFAh - Инвертирование текста (0=нормальный текст, 0FFFFh=инверсный)
 94+  0000 ~            cursorY       DB      -1              ; 8FFCh - Положение курсора по вертикали в пикселях
 95+  0000 ~            cursorX       DB      -1              ; 8FFDh - Положение курсора по горизонтали в пикселях / 2
 96+  0000 ~            writeDelay    DB      28h             ; 8FFEh - Скорость при записи на ленту
 97+  0000 ~            readDelay     DB      3Ch             ; 8FFFh - Скорость при чтении с ленты
 98+  0000                  ENDS
 99+  0000
100+  0000              ; Блок переменных BIOS начинается с адреса 8FDFh
101+  0000              bios_vars   BIOS_VARIABLES = 8FDFh
102+  0000
103+  0000              ;-----------------------------------------------------------------------
104+  0000              ; Стандартные точки входа ОС
105+  0000              ; Отмеченные [OLD] применять не рекомендуется
106+  0000              ; Отмеченные [MXOS2] - новые в MXOS 2
107+  0000              ;-----------------------------------------------------------------------
108+  0000
109+  0000              bios_init               = 0C000h ; Теплая перезагрузка
110+  0000
111+  0000              ; Устаревшие точки, лечше не применять
112+  0000              bios_keyScanOld         = 0C003h ; [OLD] Получить код нажатой клавиши, = bios_keyScan
113+  0000              bios_drawCursorOld      = 0C006h ; [OLD] Нарисовать/стереть курсор
114+  0000              bios_clearScreenOld     = 0C010h ; [OLD] Оистка экрана
115+  0000              bios_printCharOld       = 0C037h ; [OLD] Вывод символа на экран
116+  0000              bios_beep_Old           = 0C170h ; [OLD] Звуковой сигнал
117+  0000              bios_delay_l            = 0C18Fh ; [OLD] Задержка l циклов
118+  0000              bios_delay_b            = 0C190h ; [OLD] Задержка b циклов
119+  0000              bios_getchOld           = 0C337h ; [OLD] Ожидание ввода с клавиатуры
120+  0000              bios_tapeReadOld        = 0C377h ; [OLD] Чтение байта с магнитофона
121+  0000              bios_tapeWriteOld       = 0C3D0h ; [OLD] Запись байта на магнитофон
122+  0000              bios_cmp_hl_de          = 0C427h ; [OLD] Сравнить hl и de
123+  0000              bios_memcpy_bc_hl       = 0C42Dh ; [OLD] Скопировать блок памяти
124+  0000              bios_printStringOld     = 0C438h ; [OLD] Вывод строки на экран
125+  0000
126+  0000              ; Стандартные точки C800h
127+  0000              bios_reboot             = 0C800h ; Запустить NC.COM
128+  0000              bios_getch              = 0C803h ; Ожидание ввода с клавиатуры
129+  0000              bios_tapeRead           = 0C806h ; Чтение байта с магнитофона
130+  0000              bios_printChar          = 0C809h ; Вывод символа на экран
131+  0000              bios_tapeWrite          = 0C80Ch ; Запись байта на магнитофон
132+  0000              bios_input              = 0C80Fh ; Ввод строки с клавиатуры
133+  0000              bios_keyCheck           = 0C812h ; Получить код нажатой клавиши, = bios_keyScan
134+  0000              bios_printHexByte       = 0C815h ; Вывод HEX числа на экран (байт)
135+  0000              bios_printString        = 0C818h ; Вывод строки на экран
136+  0000              bios_keyScan            = 0C81Bh ; Получить код нажатой клавиши
137+  0000              bios_getCursorPos       = 0C81Eh ; Получить координаты курсора в hl (координаты в пикселях)
138+  0000              bios_setCursorPos       = 0C821h ; Установить координаты курсора из hl (координаты в пикселях)
139+  0000              bios_tapeLoad           = 0C824h ; Загрузить программу с магнитофона
140+  0000              bios_tapeSave           = 0C827h ; Сохранить программу на магнитофон
141+  0000              bios_calcCS             = 0C82Ah ; Расчет контрольной суммы
142+  0000              bios_printHexWord       = 0C82Dh ; Вывод HEX числа на экран (слово)
143+  0000              bios_getMemTop          = 0C830h ; Получить объем доступной памяти
144+  0000              bios_setMemTop          = 0C833h ; Установить объем доступной памяти
145+  0000              bios_printer            = 0C836h ; Напечатать байт на принтере
146+  0000                  IF RAMFOS_COMPATIBILITY
147+  0000              bios_strToHex           = 0C839h ; [MXOS2] Преобразвоние строки в HEX формате в число
148+  0000                  ELSE
149+  0000 ~            bios_rebootAlt          = 0C839h ; Запустить NC.COM
150+  0000                  ENDIF
151+  0000              bios_rebootAlt2         = 0C83Ch ; Запустить NC.COM
152+  0000              bios_fileList           = 0C83Fh ; Получить список файлов
153+  0000              bios_fileGetSetDrive    = 0C842h ; Получить/установить активное устройство
154+  0000              bios_fileCreate         = 0C845h ; Создать файл
155+  0000              bios_fileLoad           = 0C848h ; Загрузить файл по адресу из заголовка этого файла
156+  0000              bios_fileDelete         = 0C84Bh ; Удалить файл
157+  0000              bios_fileRename         = 0C84Eh ; Переименовать файл
158+  0000              bios_fileLoadInfo       = 0C851h ; Загрузить информацию о файле
159+  0000              bios_fileGetSetAddr     = 0C854h ; Получить/установить адрес загрузки файла
160+  0000              bios_fileGetSetAttr     = 0C857h ; Получить/установить атрибуты файла
161+  0000              bios_fileNamePrepare    = 0C85Ah ; Преобразовать имя файла во внутренний формат
162+  0000              bios_fileExec           = 0C85Dh ; Запустить файл
163+  0000              bios_installDriver      = 0C860h ; Установить драйвер накопителя
164+  0000              bios_diskDriver         = 0C863h ; Драйвер выбранного диска
165+  0000              bios_fileLoad2          = 0C866h ; Загрузить файл по адресу de
166+  0000
167+  0000              ; Новые точки C800h MXOS2
168+  0000              bios_printCharReal      = 0C869h ; [MXOS2] Вывод символа на экран (только реальные символы)
169+  0000              bios_printDecWord       = 0C86Ch ; [MXOS2] Вывод числа экран в десятичной форме
170+  0000              bios_setRAMDDriver      = 0C86Fh ; [MXOS2] Установить драйвр рам-диска
171+  0000              bios_getDriveFreeSpace  = 0C872h ; [MXOS2] Получить оставшийся свободный объем диска
172+  0000              bios_upperCase          = 0C875h ; [MXOS2] Перевод кода символа КОИ-8 в верхний регистр
173+  0000              bios_strcmp             = 0C878h ; [MXOS2] Сравнение строк, чувствительное к регистру
174+  0000              bios_stricmp            = 0C87Bh ; [MXOS2] Сравнение строк, нечувствительное к регистру
175+  0000              bios_sub_hl_de          = 0C87Eh ; [MXOS2] Вычитание hl и de: hl = hl - de
176+  0000              bios_div_hl_2           = 0C881h ; [MXOS2] Деление hl на 2: hl = hl / 2
177+  0000              bios_mul_hl_de          = 0C884h ; [MXOS2] Умножение hl на de: hl = hl * de
178+  0000              bios_div_hl_de          = 0C887h ; [MXOS2] Деление hl на de: hl = hl / de, de = hl % de
179+  0000
180+  0000              ;-----------------------------------------------------------------------
181+  0000              ; Адрес таблицы переходов драйвера магнитофона
182+  0000              ;-----------------------------------------------------------------------
183+  0000
184+  0000              TAPE_DRIVER_JUMPS = bios_tapeReadOld    ; старая таблица переходов магнитофона, сохранена для ABI
185+  0000
186+  0000              ;-----------------------------------------------------------------------
187+  0000              ; Непереключаемое ОЗУ ПК "Специалист-MX" (0FFC0h-0FFDF, 32 байта)
188+  0000              ;-----------------------------------------------------------------------
189+  0000
190+  0000              bios_RAMDRead   = 0FFC0h ; п/п чтения из ДОЗУ
191+  0000              bios_RAMDWrite  = 0FFD0h ; п/п записи в  ДОЗУ
192+  0000
193+  0000              ;-----------------------------------------------------------------------
194+  0000              ; Порты устройств ПК "Специалист-MX2" (0FFE0h-0FFFF, 32 байта)
195+  0000              ;-----------------------------------------------------------------------
196+  0000
197+  0000              IO_KEYB_A       =  0FFE0h   ; ВВ55 клавиатуры
198+  0000              IO_KEYB_B       =  0FFE1h
199+  0000              IO_KEYB_C       =  0FFE2h
200+  0000              IO_KEYB_MODE    =  0FFE3h
201+  0000              IO_PROG_A       =  0FFE4h   ; ВВ55 программатора/флеш диска
202+  0000              IO_PROG_B       =  0FFE5h
203+  0000              IO_PROG_C       =  0FFE6h
204+  0000              IO_PROG_MODE    =  0FFE7h
205+  0000              IO_FDD_CMD      =  0FFE8h   ; контроллер дисковода ВГ93
206+  0000              IO_FDD_TRACK    =  0FFE9h
207+  0000              IO_FDD_SECTOR   =  0FFEAh
208+  0000              IO_FDD_DATA     =  0FFEBh
209+  0000              IO_TIMER_CH0    =  0FFECh   ; таймер ВИ53
210+  0000              IO_TIMER_CH1    =  0FFEDh
211+  0000              IO_TIMER_CH2    =  0FFEEh
212+  0000              IO_TIMER_MODE   =  0FFEFh
213+  0000              IO_FDD_REQ      =  0FFF0h   ; контроллер дисковода
214+  0000              IO_FDD_MOTOR    =  0FFF1h
215+  0000              IO_FDD_SIDE     =  0FFF2h
216+  0000              IO_FDD_DRIVE    =  0FFF3h
217+  0000              IO_COLOR        =  0FFF8h   ; регистр цвета
218+  0000              IO_PAGE_RAM     =  0FFFCh   ; порт включения основного ОЗУ
219+  0000              IO_PAGE_RAMD    =  0FFFDh   ; порт включения ОЗУ RAM-дисков
220+  0000              IO_PAGE_ROM     =  0FFFEh   ; порт включения ПЗУ
221+  0000              IO_PAGE_STD     =  0FFFFh   ; порт включения STD режима
222+  0000
223+  0000              ;-----------------------------------------------------------------------
224+  0000              ; Структура файловой системы
225+  0000              ;-----------------------------------------------------------------------
226+  0000
227+  0000              ; Структура каталога
228+  0000              FILE_DESCR_SIZE  = 32   ; размер дескриптора файла в каталоге (байт)
229+  0000              FILE_NAME_LENGTH = 8    ; длина имени файла  (байт)
230+  0000              FAT_ITEM_SIZE    = 2    ; размер записи в таблице FAT (байт)
231+  0000
232+  0000              SECTOR_SIZE  = 00100h   ; размер сектора 256 байт
233+  0000              CLUSTER_SIZE = 00100h   ; размер кластера 256 байт
234+  0000
235+  0000              ; Специальные коды кластеров FAT
236+  0000              FAT12_BAD = 00FF7h  ; плохой кластер
237+  0000              FAT16_BAD = 0FFF7h
238+  0000              FAT12_EOC = 00FFFh  ; последний кластер файла
239+  0000              FAT16_EOC = 0FFFFh
240+  0000              FAT12_RES = 00FFFh  ; зарезервированный кластер
241+  0000              FAT16_RES = 0FFFFh
242+  0000
243+  0000              ;-----------------------------------------------------------------------
244+  0000              ; Десткриптор файла (одна запись в каталоге) FAT12/16/32
245+  0000              ;-----------------------------------------------------------------------
246+  0000
247+  0000                  STRUCT FILE_DESCRIPTOR  ; 32 байта
248+  0000 ~            name            BLOCK   FILE_NAME_LENGTH    ; смещение 00h, 8 байт  - имя файла
249+  0000 ~            ext             BLOCK   3                   ; смещение 08h, 3 байта - расширение имени файла
250+  0000 ~            attrib          BLOCK   1                   ; смещение 0Bh, 1 байт  - атрибуты файла
251+  0000 ~            ntReserved      BLOCK   1                   ; смещение 0Ch, 1 байт  - используются в Windows NT
252+  0000 ~            createTimeTenth BLOCK   1                   ; смещение 0Dh, 1 байт  - (только FAT32) время создания файла, десятки миллисекунд (0-199)
253+  0000 ~            createTime      BLOCK   2                   ; смещение 0Eh, 2 байта - (только FAT32) время создания файла, секунды*2 (0-43200)
254+  0000 ~            createDate      BLOCK   2                   ; смещение 10h, 2 байта - (только FAT32) дата  создания файла
255+  0000 ~            loadAddress     BLOCK   2  ; accDate        ; смещение 12h, 2 байта - начальный адрес загрузки в ОЗУ, он же и стартовый (!!! временный костыль, в FAT32 это accDate - дата доступа к файлу !!!)
256+  0000 ~            firstClusterHi  BLOCK   2                   ; смещение 14h, 2 байта - номер первого кластера в FAT, старшее слово
257+  0000 ~            writeTime       BLOCK   2                   ; смещение 16h, 2 байта - время модификации файла, секунды*2 (0-43200)
258+  0000 ~            writeDate       BLOCK   2                   ; смещение 18h, 2 байта - дата  модификации файла
259+  0000 ~            firstCluster    BLOCK   2                   ; смещение 1Ah, 2 байта - номер первого кластера в FAT, младшее слово
260+  0000 ~            size            BLOCK   4                   ; смещение 1Ch, 4 байта - размер файла в байтах
261+  0000                  ENDS
262+  0000
263+  0000              ;-----------------------------------------------------------------------
264+  0000              ; Информация о файле (компактный вариант дескриптора)
265+  0000              ; Почти совместимо с дескриптором оригинального Коммандера
266+  0000              ;-----------------------------------------------------------------------
267+  0000
268+  0000              FILE_INFO_SIZE = 16     ; размер структуры (байт)
269+  0000
270+  0000                  STRUCT FILE_INFO    ; 16 байт
271+  0000 ~            name            BLOCK   FILE_NAME_LENGTH    ; смещение 00h, 8 байт  - имя файла
272+  0000 ~            ext             BLOCK   3                   ; смещение 08h, 3 байта - расширение имени файла
273+  0000 ~            attrib          BLOCK   1                   ; смещение 0Bh, 1 байт  - атрибуты файла
274+  0000 ~            loadAddress     BLOCK   2                   ; смещение 0Eh, 2 байта - начальный адрес загрузки в ОЗУ, он же и стартовый
275+  0000 ~            size            BLOCK   2                   ; смещение 0Ch, 2 байта - размер файла в байтах
276+  0000                  ENDS
277+  0000
278+  0000              ;-----------------------------------------------------------------------
279+  0000              ; Информация об активном накопителе (диске)
280+  0000              ;-----------------------------------------------------------------------
281+  0000
282+  0000                  STRUCT DISK_INFO
283+  0000 ~            sectorSize          BLOCK   2   ; размер сектора, байт (256, 512, 1024)
284+  0000 ~            sectorsPerCluster   BLOCK   2   ; размер кластера, секторов (1, 2, 4, 8)
285+  0000 ~            resSectors          BLOCK   2   ; сколько секторов занимает зарезервированная область = первый сектор таблицы fat
286+  0000 ~            fatSectors          BLOCK   2   ; сколько секторов занимает таблица fat
287+  0000 ~            dirSectors          BLOCK   2   ; сколько секторов занимает корневой каталог
288+  0000 ~            totalSectors        BLOCK   2   ; сколько всего секторов на диске
289+  0000 ~            rootDirMaxFiles     BLOCK   2   ; максимум файлов в корневом каталоге
290+  0000 ~            descrPerSector      BLOCK   2   ; сколько дескрипторов файлов вмещается в один сектор
291+  0000 ~            fatNumCells         BLOCK   2   ; количество ячеек в таблице fat (= fatSectors * sectorSize / 2)
292+  0000 ~            dirStartSector      BLOCK   2   ; первый сектор корневого каталога
293+  0000 ~            dataStartSector     BLOCK   2   ; первый сектор области данных
294+  0000 ~            volumeLabel         BLOCK  12   ; метка тома и 0 в конце
295+  0000 ~            isValid             BLOCK   1   ; 0 = нет драйвера, 1 = диск не распознан, 2 = диск распознан, корректно отформатирован
296+  0000                  ENDS
297+  0000
298+  0000              DISK_NO_DRIVER = 0
299+  0000              DISK_INVALID   = 1
300+  0000              DISK_VALID     = 2
301+  0000
302+  0000              ;-----------------------------------------------------------------------
303+  0000              ; Буферы в памяти
304+  0000              ;-----------------------------------------------------------------------
305+  0000
306+  0000              ; Дисковый кэш
307+  0000              FAT_CACHE_ADDR = 0FB00h ; адрес кэша секторов fat в памяти
308+  0000              FAT_CACHE_SIZE = 1024   ; размер кэша в байтах
309+  0000              FAT_CACHE_CAPACITY = FAT_CACHE_SIZE / SECTOR_SIZE   ; сколько секторов вмещается в кэш
310+  0000
311+  0000              ; Буфер для загрузки BAT файла
312+  0000                  IF NEW_MEMORY_MAP
313+  0000              BAT_BUFFER = 0E800h
314+  0000                  ELSE
315+  0000 ~            BAT_BUFFER = 0FC00h
316+  0000                  ENDIF
317+  0000
318+  0000              ; Командная строка и стек
319+  0000              CMD_LINE   = 0FF00h  ; 192 байта, но в конце стек
320+  0000              STACK_ADDR = 0FFC0h  ; стек
321+  0000
322+  0000              ;-----------------------------------------------------------------------
323+  0000              ; Всякие полезности
324+  0000              ;-----------------------------------------------------------------------
325+  0000
326+  0000              ; Макрос для заполнения памяти от текущего адреса до указанного
327+  0000                  MACRO ORG_PAD adr
328+  0000 ~                     IF $ > adr
329+  0000 ~                       ; вывод сообщения об ошибке
330+  0000 ~                       ASSERT 0
331+  0000 ~                       DISPLAY /l, "Error! ORG_PAD failed! ", $, " is more than ", adr
332+  0000 ~                     ELSE
333+  0000 ~                       ; заполнение памяти
334+  0000 ~                       BLOCK adr-$, 0FFh
335+  0000 ~                     ENDIF
336+  0000 ~                     ORG adr
337+  0000                  ENDM
338+  0000
339+  0000                  MACRO ORG_PAD0 adr
340+  0000 ~                     IF $ > adr
341+  0000 ~                       ; вывод сообщения об ошибке
342+  0000 ~                       ASSERT 0
343+  0000 ~                       DISPLAY /l, "Error! ORG_PAD0 failed! ", $, " is more than ", adr
344+  0000 ~                     ELSE
345+  0000 ~                       ; заполнение памяти
346+  0000 ~                       BLOCK adr-$, 0
347+  0000 ~                     ENDIF
348+  0000 ~                     ORG adr
349+  0000                  ENDM
350+  0000
351+  0000              ; Макросы для проверки текущего адреса
352+  0000                  MACRO ASSERT_EQUAL adr
353+  0000 ~                     IF $ != adr
354+  0000 ~                       ASSERT 0
355+  0000 ~                       DISPLAY /l, "Error! Entry point has been shifted (", $, " != ", adr, ")"
356+  0000 ~                     ENDIF
357+  0000                  ENDM
358+  0000
359+  0000                  MACRO ASSERT_DONT_FIT adr
360+  0000 ~                     IF $ > adr
361+  0000 ~                       ASSERT 0
362+  0000 ~                       DISPLAY /l, "Error! Image did not fit (", $, " > ", adr, ")"
363+  0000 ~                     ENDIF
364+  0000                  ENDM
365+  0000
366+  0000              ;-----------------------------------------------------------------------
367+  0000              ; Конец
368+  0000              ;-----------------------------------------------------------------------
