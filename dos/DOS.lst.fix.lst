 25+  CBCB
 26+  CBCB              fileSelectDrive:
 27+  CBCB                          ; Максимум устройств - 1
 28+  CBCB E6 07                    and     7
 29+  CBCD
 30+  CBCD                          ; Если устройство не менялось, выходим
 31+  CBCD E5                       push    hl
 32+  CBCE 21 FF D2                 ld      hl, v_drive
 33+  CBD1 BF BE                    cp      a, (hl)
 34+  CBD3 E1                       pop     hl
 35+  CBD4 C8                       ret z
 36+  CBD5
 37+  CBD5                          ; Сохраняем выбранное устройство
 38+  CBD5 32 FF D2                 ld      (v_drive), a
 39+  CBD8
 40+  CBD8                          ; Пригодится ниже (a = a * 2)
 41+  CBD8 87                       add     a, a
 42+  CBD9
 43+  CBD9                          ; Сохраняем регистры
 44+  CBD9 E5                       push    hl
 45+  CBDA D5                       push    de
 46+  CBDB
 47+  CBDB                          ; Получаем точку входа драйвера
 48+  CBDB 6F                       ld      l, a
 49+  CBDC 26 00                    ld      h, 0
 50+  CBDE 11 1E D3                 ld      de, v_drives
 51+  CBE1 19                       add     hl, de
 52+  CBE2 5E                       ld      e, (hl)
 53+  CBE3 23                       inc     hl
 54+  CBE4 56                       ld      d, (hl)
 55+  CBE5 EB                       ex      de, hl
 56+  CBE6
 57+  CBE6                          ; Сохраняем её
 58+  CBE6 22 64 C8                 ld      (j_diskDriver+1), hl
 59+  CBE9
 60+  CBE9                          ; Восстаналвиаем a
 61+  CBE9 0F                       rrca
 62+  CBEA
 63+  CBEA                          ; Очищаем кэш fat
 64+  CBEA C5                       push    bc
 65+  CBEB CD 61 CC                 call    resetSectorCache
 66+  CBEE C1                       pop     bc
 67+  CBEF
 68+  CBEF                          ; Считываем загрузочный сектор и инициализируем структуру v_diskInfo
 69+  CBEF CD 1A CE                 call    fatReadBootSector
 70+  CBF2
 71+  CBF2                          ; Восстанавливаем регистры и выходим
 72+  CBF2 D1                       pop     de
 73+  CBF3 E1                       pop     hl
 74+  CBF4 C9                       ret
 75+  CBF5
108   CBF5                  INCLUDE "strcmp.inc"
  1+  CBF5              ;----------------------------------------------------------------------------
  2+  CBF5              ; MXOS
  3+  CBF5              ; Сравнение строк, чувстсвительное к регистру
  4+  CBF5              ;
  5+  CBF5              ; вход:
  6+  CBF5              ;  de = адрес строки 1
  7+  CBF5              ;  hl = адрес строки 2
  8+  CBF5              ;  c  = длина строки
  9+  CBF5              ;
 10+  CBF5              ; выход:
 11+  CBF5              ;  zf - строки равны
 12+  CBF5              ;
 13+  CBF5              ; регистры не сохраняются!
 14+  CBF5              ;
 15+  CBF5              ; 2022-02-11 SpaceEngineer
 16+  CBF5              ;----------------------------------------------------------------------------
 17+  CBF5
 18+  CBF5              strcmp:     ; Сравнение символов
 19+  CBF5 1A                       ld      a, (de)
 20+  CBF6 BE                       cp      (hl)
 21+  CBF7 C0                       ret nz          ; если символы не равны, выходим с флагом nz
 22+  CBF8 23                       inc     hl
 23+  CBF9 13                       inc     de
 24+  CBFA
 25+  CBFA                          ; Повтор цикла
 26+  CBFA 0D                       dec     c
 27+  CBFB C2 F5 CB                 jp nz,  strcmp
 28+  CBFE
 29+  CBFE                          ; Сравнили до конца и не вышли раньше - значит, строки равны
 30+  CBFE C9                       ret             ; выходим с флагом z
 31+  CBFF
 32+  CBFF              ;----------------------------------------------------------------------------
 33+  CBFF              ; MXOS
 34+  CBFF              ; Сравнение строк, нечувстсвительное к регистру
 35+  CBFF              ;
 36+  CBFF              ; вход:
 37+  CBFF              ;  hl = адрес строки 1
 38+  CBFF              ;  de = адрес строки 2
 39+  CBFF              ;  c  = длина строки
 40+  CBFF              ;
 41+  CBFF              ; выход:
 42+  CBFF              ;  zf = 1 - строки равны
 43+  CBFF              ;
 44+  CBFF              ; регистр bc сохраняется
 45+  CBFF              ;
 46+  CBFF              ; 2022-02-11 SpaceEngineer
 47+  CBFF              ;----------------------------------------------------------------------------
 48+  CBFF
 49+  CBFF C5           stricmp:    push    bc
 50+  CC00              stricmp_loop:
 51+  CC00                          ; Читаем символ из первой строки и переводим в верхний регистр
 52+  CC00 1A                       ld      a, (de)
 53+  CC01 CD 15 CC                 call    upperCase
 54+  CC04 47                       ld      b, a    ; сохраняем его в b
 55+  CC05
 56+  CC05                          ; Читаем символ из второй строки и переводим в верхний регистр
 57+  CC05 7E                       ld      a, (hl)
 58+  CC06 CD 15 CC                 call    upperCase
 59+  CC09
 60+  CC09                          ; Сравнение символов
 61+  CC09 B8                       cp      b
 62+  CC0A C2 13 CC                 jp nz,  stcicmp_exit    ; если символы не равны, выходим с флагом zf = 0
 63+  CC0D
 64+  CC0D                          ; Повтор цикла
 65+  CC0D 23                       inc     hl
 66+  CC0E 13                       inc     de
 67+  CC0F 0D                       dec     c
 68+  CC10 C2 00 CC                 jp nz,  stricmp_loop
 69+  CC13
 70+  CC13                          ; Сравнили до конца и не вышли раньше - значит, строки равны
 71+  CC13              stcicmp_exit:
 72+  CC13 C1                       pop     bc
 73+  CC14 C9                       ret             ; выходим с флагом zf = 1
 74+  CC15
 75+  CC15              ;----------------------------------------------------------------------------
 76+  CC15              ; MXOS
 77+  CC15              ; Преобразование кода символа КОИ-8 в верхний регистр.
 78+  CC15              ;
 79+  CC15              ; вход:
 80+  CC15              ;  a = символ
 81+  CC15              ;
 82+  CC15              ; выход:
 83+  CC15              ;  a = символ в верхнем регистре
 84+  CC15              ;
 85+  CC15              ; все регистры сохраняются
 86+  CC15              ;
 87+  CC15              ; 2022-02-11 SpaceEngineer
 88+  CC15              ;----------------------------------------------------------------------------
 89+  CC15
 90+  CC15              upperCase:  ; Цифры, знаки и прописные английские буквы - не меняем
 91+  CC15 FE 61                    cp      61h
 92+  CC17 D8                       ret c
 93+  CC18
 94+  CC18                          ; Строчные английские буквы - вычитаем 20h
 95+  CC18 FE 7B                    cp      7Bh
 96+  CC1A D2 20 CC                 jp nc,  upperCase1
 97+  CC1D D6 20                    sub     20h
 98+  CC1F C9                       ret
 99+  CC20
100+  CC20              upperCase1: ; Буква ё - прибавляем 10h
101+  CC20 FE A3                    cp      0A3h
102+  CC22 D2 28 CC                 jp nc,  upperCase2
103+  CC25 C6 10                    add     10h
104+  CC27 C9                       ret
105+  CC28
106+  CC28              upperCase2: ; Символы псевдографики - не меняем
107+  CC28 FE C0                    cp      0C0h
108+  CC2A D8                       ret c
109+  CC2B
110+  CC2B                          ; Заглавные русские буквы - не маняем
111+  CC2B FE E0                    cp      0E0h
112+  CC2D D0                       ret nc
113+  CC2E
114+  CC2E                          ; Строчные русские буквы - прибавляем 20h
115+  CC2E C6 20                    add     20h
116+  CC30 C9                       ret
117+  CC31
118+  CC31              ;+---------------------------------------------------------------------------
119+  CC31              ; MXOS
120+  CC31              ; Сравнение расширений файлов
121+  CC31              ;
122+  CC31              ; На входе
123+  CC31              ;  de - адрес расширения 1
124+  CC31              ;  v_curFileDescr - имя с расширением 2
125+  CC31              ;
126+  CC31              ; На выходе
127+  CC31              ;  zf = 0 - расширения равны
128+  CC31              ;  de = de+3
129+  CC31              ;
130+  CC31              ; 2013-12-12 Дизассемблировано vinxru
131+  CC31              ; 2022-02-11 Доработано SpaceEngineer
132+  CC31              ;----------------------------------------------------------------------------
133+  CC31
134+  CC31              cmpFileExt:
135+  CC31                          ; Адрес расширения
136+  CC31 21 E7 D3                 ld      hl, v_curFileDescr + FILE_NAME_LENGTH
137+  CC34 0E 03                    ld      c, 3   ; cравниваем 3 символа
138+  CC36 CD FF CB                 call    stricmp ; zf = 1 если равны
139+  CC39
140+  CC39                          ; Делаем так, чтобы на выходе функции de было
141+  CC39                          ; на 3 больше, чем на входе в функцию
142+  CC39 06 00                    ld      b, 0
143+  CC3B F5                       push    af
144+  CC3C EB                       ex      de, hl
145+  CC3D 09                       add     hl, bc
146+  CC3E EB                       ex      de, hl
147+  CC3F F1                       pop     af
148+  CC40
149+  CC40                          ; Выход
150+  CC40 C9                       ret
151+  CC41
109   CC41                  INCLUDE "fatCache.inc"
  1+  CC41              ;----------------------------------------------------------------------------
  2+  CC41              ; MXOS
  3+  CC41              ; Кэш секторов fat
  4+  CC41              ;
  5+  CC41              ; 2022-02-08 Разработано SpaceEngineer
  6+  CC41              ;----------------------------------------------------------------------------
  7+  CC41
  8+  CC41                  STRUCT  FAT_CACHE_DATA          ; размер структуры 8 байт
  9+  CC41 ~            number:         DW  0FFFFh          ; номер сектора
 10+  CC41 ~            address:        DW  FAT_CACHE_ADDR  ; адрес закешированного сектора в ОЗУ
 11+  CC41 ~            accessTime:     DW  0               ; последнее время обращения к сектору
 12+  CC41 ~            isModified:     DB  0               ; модифицирован ли сектор
 13+  CC41 ~            _align:         DB  0               ; для выравнивания
 14+  CC41                  ENDS
 15+  CC41
 16+  CC41              ; Массив из FAT_CACHE_CAPACITY структур длиной FAT_CACHE_DATA, инициализирован нулями
 17+  CC41 00 00 00...  cacheData:      BLOCK   FAT_CACHE_CAPACITY * FAT_CACHE_DATA, 0
 18+  CC61
 19+  CC61              ;----------------------------------------------------------------------------
 20+  CC61              ; MXOS
 21+  CC61              ; Инициализация кэша fat
 22+  CC61              ;
 23+  CC61              ; регисты НЕ сохраняются!
 24+  CC61              ;
 25+  CC61              ; 2022-02-08 Разработано SpaceEngineer
 26+  CC61              ;----------------------------------------------------------------------------
 27+  CC61
 28+  CC61              resetSectorCache:
 29+  CC61                      ; bc = системное время
 30+  CC61 CD 77 CD             call    getSystemTime
 31+  CC64
 32+  CC64                      ; В цикле записываем начальные значения во поля address
 33+  CC64 11 00 FB             ld      de, FAT_CACHE_ADDR      ; адрес буфера секторов
 34+  CC67 21 41 CC             ld      hl, cacheData           ; адрес первого элемента в массиве
 35+  CC6A 3E 04                ld      a,  FAT_CACHE_CAPACITY  ; счетчик цикла
 36+  CC6C
 37+  CC6C              resetCacheLoop:
 38+  CC6C                      ; Поле number = 0FFFFh
 39+  CC6C 36 FF                ld      (hl), 0FFh
 40+  CC6E 23                   inc     hl
 41+  CC6F 36 FF                ld      (hl), 0FFh
 42+  CC71 23                   inc     hl
 43+  CC72                      ; Поле address = de
 44+  CC72 73                   ld      (hl), e
 45+  CC73 23                   inc     hl
 46+  CC74 72                   ld      (hl), d
 47+  CC75 23                   inc     hl
 48+  CC76                      ; Поле accessTime = bc
 49+  CC76 71                   ld      (hl), c
 50+  CC77 23                   inc     hl
 51+  CC78 70                   ld      (hl), b
 52+  CC79 23                   inc     hl
 53+  CC7A                      ; Поле isModified = 0
 54+  CC7A 36 00                ld      (hl), 0
 55+  CC7C 23                   inc     hl
 56+  CC7D                      ; Поле isLoaded = 0
 57+  CC7D 36 00                ld      (hl), 0
 58+  CC7F 23                   inc     hl
 59+  CC80
 60+  CC80                      ; de += SECTOR_SIZE
 61+  CC80 14                   inc     d   ; это работает только с секторами по 256 байт
 62+  CC81
 63+  CC81                      ; Повтор чикла
 64+  CC81 3D                   dec     a
 65+  CC82 C2 6C CC             jp nz,  resetCacheLoop
 66+  CC85
 67+  CC85 C9                   ret
 68+  CC86
 69+  CC86              ;----------------------------------------------------------------------------
 70+  CC86              ; MXOS
 71+  CC86              ; Получение адреса закешированного сектора в памяти.
 72+  CC86              ; Если сектор не найден в кэше, он загружается с текущего накопителя.
 73+  CC86              ;
 74+  CC86              ; вход:
 75+  CC86              ;   de = номер сектора
 76+  CC86              ;   a  = 1 - установить флаг isModified сектора
 77+  CC86              ;
 78+  CC86              ; выход:
 79+  CC86              ;   hl = адрес сектора в буфере
 80+  CC86              ;
 81+  CC86              ;   регистры de, bc сохраняются
 82+  CC86              ;
 83+  CC86              ; 2022-02-08 Разработано SpaceEngineer
 84+  CC86              ;----------------------------------------------------------------------------
 85+  CC86
 86+  CC86              getSectorAddressInCache:
 87+  CC86 C5                   push    bc
 88+  CC87 D5                   push    de
 89+  CC88 47                   ld      b, a    ; b = isModified
 90+  CC89 EB                   ex      hl, de
 91+  CC8A
 92+  CC8A                      ; Находим сектор в кэше; если нету - кешируем
 93+  CC8A                      ; вход:  hl = номер сектора на диске
 94+  CC8A                      ; выход: hl = адрес сектора в ОЗУ
 95+  CC8A CD A7 CC             call    cacheSector
 96+  CC8D
 97+  CC8D D1                   pop     de
 98+  CC8E C1                   pop     bc
 99+  CC8F C9                   ret
100+  CC90
101+  CC90              ;----------------------------------------------------------------------------
102+  CC90              ; MXOS
103+  CC90              ; Получение адреса ячейки fat.
104+  CC90              ; Если сектор fat не найден в кэше, он загружается с текущего накопителя.
105+  CC90              ;
106+  CC90              ; вход:
107+  CC90              ;   de = номер ячейки fat
108+  CC90              ;   a  = 1 - установить флаг isModified сектора
109+  CC90              ;
110+  CC90              ; выход:
111+  CC90              ;   hl = адрес ячейки в буфере
112+  CC90              ;
113+  CC90              ; 2022-02-08 Разработано SpaceEngineer
114+  CC90              ;----------------------------------------------------------------------------
115+  CC90
116+  CC90              getFatCellAddress:
117+  CC90 C5                   push    bc
118+  CC91 47                   ld      b, a ; b = isModified
119+  CC92
120+  CC92                      ; Вычисляем номер сектора, где находится искомая ячейка fat
121+  CC92                      ; fatSectorNum  = (N * 2) / v_diskInfo.sectorSize + v_diskInfo.resSectors;
122+  CC92                      ; fatCellOffset = (N * 2) % v_diskInfo.sectorSize;
123+  CC92 2A 2E D3             ld      hl, (v_diskInfo.sectorSize)
124+  CC95 EB                   ex      hl, de
125+  CC96 29                   add     hl, hl      ; hl = N * 2
126+  CC97 CD CA D2             call    div_hl_de   ; выход: hl = номер сектора от начала fat; de = смещение ячейки в секторе
127+  CC9A D5                   push    de          ; de = смещение ячейки в секторе
128+  CC9B EB                   ex      hl, de
129+  CC9C 2A 32 D3             ld      hl, (v_diskInfo.resSectors)
130+  CC9F 19                   add     hl, de      ; hl += v_diskInfo.resSectors
131+  CCA0
132+  CCA0                      ; Находим сектор в кэше; если нету - кешируем
133+  CCA0                      ; вход:  hl = номер сектора на диске
134+  CCA0                      ; выход: hl = адрес сектора в ОЗУ
135+  CCA0 CD A7 CC             call    cacheSector
136+  CCA3
137+  CCA3                      ; Находим смещение ячейки fat в этом секторе
138+  CCA3 D1                   pop     de      ; de = смещение ячейки в секторе
139+  CCA4 19                   add     hl, de  ; hl = адрес ячейки в секторе
140+  CCA5
141+  CCA5 C1                   pop     bc
142+  CCA6 C9                   ret
143+  CCA7
144+  CCA7              ;----------------------------------------------------------------------------
145+  CCA7              ; MXOS
146+  CCA7              ; Поиск сектора в кэше. Если сектор не найден, то он загружается с накопителя.
147+  CCA7              ;
148+  CCA7              ; вход:
149+  CCA7              ;   hl = номер сектора
150+  CCA7              ;   b  = флаг модификации
151+  CCA7              ;
152+  CCA7              ; выход:
153+  CCA7              ;   hl = адрес начала сектора в памяти
154+  CCA7              ;
155+  CCA7              ; регистры de, bc сохраняются
156+  CCA7              ;
157+  CCA7              ; 2022-02-08 Разработано SpaceEngineer
158+  CCA7              ;----------------------------------------------------------------------------
159+  CCA7
160+  CCA7              cacheSector:
161+  CCA7                      ; Сохраняем регистры
162+  CCA7 D5                   push    de
163+  CCA8 C5                   push    bc
164+  CCA9
165+  CCA9                      ; Просматриваем массив структур cacheData в поисках сектора с номером hl
166+  CCA9 EB                   ex      hl, de                                      ; de = номер для поиска
167+  CCAA 21 41 CC             ld      hl, cacheData + FAT_CACHE_DATA.number       ; hl = адрес поля number в первом элементе массива
168+  CCAD 0E 04                ld      c,  FAT_CACHE_CAPACITY                      ; счетчик цикла
169+  CCAF              cff_FindSector:
170+  CCAF CD 83 CD             call    cmp_m_de            ; сравниваем [hl] и de
171+  CCB2 CA F2 CC             jp z,   cff_SectorFound     ; если равно, значит есть такой сектор в кэше
172+  CCB5 C5                   push    bc                  ; иначе переходим на следущий элемент массива
173+  CCB6 01 08 00             ld      bc, FAT_CACHE_DATA  ; bc = размер структуры FAT_CACHE_DATA
174+  CCB9 09                   add     hl, bc
175+  CCBA C1                   pop     bc
176+  CCBB 0D                   dec     c                   ; повтор цикла
177+  CCBC C2 AF CC             jp      nz, cff_FindSector
178+  CCBF
179+  CCBF                      ; Не не нашли сектор в массиве, загружаем его с накопителя на место наиболее давно использовавашегося
180+  CCBF D5                   push    de  ; de = номер сектора, который надо загрузить
181+  CCC0
182+  CCC0                      ; Ищем наиболее давно использовавашийся сектор (т.е. у которого самый маленький accessTime)
183+  CCC0 11 FF FF             ld      de, 0FFFFh                                  ; de = максимальный найденый accessTime сектора
184+  CCC3 21 45 CC             ld      hl, cacheData + FAT_CACHE_DATA.accessTime   ; hl = адрес поля accessTime в первом элементе массива
185+  CCC6 01 04 00             ld      bc, FAT_CACHE_CAPACITY                      ; b  = 0, c = счетчик цикла
186+  CCC9              cff_FindOldestSector:
187+  CCC9 CD 83 CD             call    cmp_m_de            ; сравниваем [hl] и de
188+  CCCC D2 D4 CC             jp nc,  cff_next            ; переход, если [hl] >= de
189+  CCCF 5E                   ld      e, (hl)             ; тут [hl] < de, запоминаем accessTime сектора в de
190+  CCD0 23                   inc     hl
191+  CCD1 56                   ld      d, (hl)
192+  CCD2 2B                   dec     hl
193+  CCD3 41                   ld      b, c                ; запоминаем итерацию цикла сектора в b
194+  CCD4              cff_next:
195+  CCD4 C5                   push    bc                  ; переходим на следущий элемент массива
196+  CCD5 01 08 00             ld      bc, FAT_CACHE_DATA  ; bc = размер структуры FAT_CACHE_DATA
197+  CCD8 09                   add     hl, bc
198+  CCD9 C1                   pop     bc
199+  CCDA 0D                   dec     c                   ; повтор цикла
200+  CCDB C2 C9 CC             jp      nz, cff_FindOldestSector
201+  CCDE
202+  CCDE                      ; Нашли наиболее давно использовавашийся сектор
203+  CCDE 3E 04                ld      a, FAT_CACHE_CAPACITY
204+  CCE0 90                   sub     b       ; a = индекс найденного сектора
205+  CCE1 17                   rla
206+  CCE2 17                   rla
207+  CCE3 17                   rla             ; a = a * 8 (размер структуры FAT_CACHE_DATA)
208+  CCE4 4F                   ld      c, a
209+  CCE5 06 00                ld      b, 0    ; bc = смещение сектора в массиве cacheData
210+  CCE7 21 41 CC             ld      hl, cacheData
211+  CCEA 09                   add     hl, bc  ; hl = адрес элемента массива
212+  CCEB
213+  CCEB                      ; Прежде чем загрузить новый сектор, старый надо сохранить, если его isModified не ноль
214+  CCEB CD 19 CD             call    saveSectorFromCache    ; записываем сектор на накопитель
215+  CCEE
216+  CCEE                      ; Загружаем новый сектор на место старого
217+  CCEE D1                   pop     de              ; de = номер сектора, который надо загрузить
218+  CCEF CD 06 CD             call    loadSectorToCache    ; загружаем сектор с накопителя
219+  CCF2
220+  CCF2                      ; Сектор найден или загружен, возвращаем его адрес
221+  CCF2                      ; Здесь hl = адрес элемента массива cacheData этого сектора
222+  CCF2              cff_SectorFound:
223+  CCF2
224+  CCF2 23                   inc     hl
225+  CCF3 23                   inc     hl      ; теперь hl = адрес поля address
226+  CCF4
227+  CCF4                      ; Читаем адрес сектора в de
228+  CCF4 5E                   ld      e, (hl)
229+  CCF5 23                   inc     hl
230+  CCF6 56                   ld      d, (hl) ; de = адрес сектора
231+  CCF7 23                   inc     hl      ; теперь hl = адрес поля accessTime
232+  CCF8
233+  CCF8                      ; Уcтанавливаем accessTime сектора
234+  CCF8 CD 77 CD             call    getSystemTime;  bc = системное время
235+  CCFB
236+  CCFB 71                   ld      (hl), c
237+  CCFC 23                   inc     hl
238+  CCFD 70                   ld      (hl), b ; de = адрес сектора
239+  CCFE 23                   inc     hl      ; теперь hl = адрес поля isModified
240+  CCFF
241+  CCFF                      ; Устанавливаем isModified, если в регистре b на входе в функцию был не ноль
242+  CCFF C1                   pop     bc      ; b = флаг модификации
243+  CD00 7E                   ld      a, (hl)
244+  CD01 B0                   or      b
245+  CD02 77                   ld      (hl), a
246+  CD03
247+  CD03                      ; hl = адрес сектора
248+  CD03 EB                   ex      hl, de
249+  CD04
250+  CD04                      ; Восстанавливаем регистры и выходим
251+  CD04 D1                   pop     de
252+  CD05 C9                   ret
253+  CD06
254+  CD06              ;----------------------------------------------------------------------------
255+  CD06              ; MXOS
256+  CD06              ; Загрузка сектора с накопителя в кэш
257+  CD06              ;
258+  CD06              ; вход:
259+  CD06              ;   hl = адрес структуры FAT_CACHE_DATA с описанием сектора
260+  CD06              ;   de = номер сектора
261+  CD06              ;
262+  CD06              ; регистры hl, de, bc сохраняются
263+  CD06              ;
264+  CD06              ; 2022-02-08 Разработано SpaceEngineer
265+  CD06              ;----------------------------------------------------------------------------
266+  CD06
267+  CD06              loadSectorToCache:
268+  CD06 E5                   push    hl
269+  CD07
270+  CD07                      ; Записываем номер сектора в структуру
271+  CD07 73                   ld      (hl), e
272+  CD08 23                   inc     hl
273+  CD09 72                   ld      (hl), d
274+  CD0A 23                   inc     hl      ; теперь hl = адрес поля address
275+  CD0B D5                   push    de
276+  CD0C
277+  CD0C                      ; Читаем в de адрес загрузки сектора
278+  CD0C 5E                   ld      e, (hl)
279+  CD0D 23                   inc     hl
280+  CD0E 56                   ld      d, (hl)
281+  CD0F 23                   inc     hl
282+  CD10
283+  CD10                      ; Загружаем сектор
284+  CD10                      ; Номер сектора = номер сектора, т.к. fat начинается с начала диска
285+  CD10 EB                   ex      hl, de  ; hl = адрес буфера
286+  CD11 D1                   pop     de      ; de = номер сектора
287+  CD12 06 02                ld      b, 2    ; режим - чтение
288+  CD14 CD 63 C8             call    j_diskDriver
289+  CD17
290+  CD17                      ; Восстанавливаем регситры и выходим
291+  CD17 E1                   pop     hl
292+  CD18 C9                   ret
293+  CD19
294+  CD19              ;----------------------------------------------------------------------------
295+  CD19              ; MXOS
296+  CD19              ; Запись сектора из кэша на накопитель, если его isModified не ноль
297+  CD19              ;
298+  CD19              ; вход:
299+  CD19              ;   hl = адрес структуры FAT_CACHE_DATA с описанием сектора
300+  CD19              ;
301+  CD19              ;   регистры hl, de, bc сохраняются
302+  CD19              ;
303+  CD19              ; 2022-02-08 Разработано SpaceEngineer
304+  CD19              ;----------------------------------------------------------------------------
305+  CD19
306+  CD19              saveSectorFromCache:
307+  CD19 E5                   push    hl
308+  CD1A D5                   push    de
309+  CD1B
310+  CD1B                      ; Проверяем, был ли изменен сектор
311+  CD1B C5                   push    bc
312+  CD1C 01 06 00             ld      bc, FAT_CACHE_DATA.isModified   ; bc = смещение поля isModified
313+  CD1F 09                   add     hl, bc      ; hl = адрес поля isModified
314+  CD20 C1                   pop     bc
315+  CD21 7E                   ld      a, (hl)     ; a = isModified
316+  CD22 B7                   or      a           ; a == 0?
317+  CD23 CA 39 CD             jp z,   ssfc_Exit   ; если isModified == 0, сектор не был изменен, и его не надо сохранять
318+  CD26
319+  CD26                      ; Обнуляем isModified
320+  CD26 36 00                ld      (hl), 0
321+  CD28
322+  CD28 2B                   dec     hl  ; теперь hl = адрес поля accessTime (ст. байт)
323+  CD29
324+  CD29 2B                   dec     hl
325+  CD2A 2B                   dec     hl  ; теперь hl = адрес поля address (ст. байт)
326+  CD2B
327+  CD2B                      ; Читаем в de адрес загрузки сектора
328+  CD2B 56                   ld      d, (hl)
329+  CD2C 2B                   dec     hl
330+  CD2D 5E                   ld      e, (hl)
331+  CD2E D5                   push    de  ; сохраняем его в стек
332+  CD2F
333+  CD2F 2B                   dec     hl  ; теперь hl = адрес поля number (ст. байт)
334+  CD30
335+  CD30                      ; Читаем в de номер сектора
336+  CD30 56                   ld      d, (hl)
337+  CD31 2B                   dec     hl
338+  CD32 5E                   ld      e, (hl)
339+  CD33
340+  CD33                      ; Записываем сектор
341+  CD33                      ; de = номер сектора
342+  CD33 E1                   pop     hl      ; hl = адрес загрузки сектора
343+  CD34 06 01                ld      b, 1    ; режим - запись
344+  CD36 CD 63 C8             call    j_diskDriver
345+  CD39
346+  CD39              ssfc_Exit:
347+  CD39                      ; Восстанавливаем регситры и выходим
348+  CD39 D1                   pop     de
349+  CD3A E1                   pop     hl
350+  CD3B C9                   ret
351+  CD3C
352+  CD3C              ;----------------------------------------------------------------------------
353+  CD3C              ; MXOS
354+  CD3C              ; Запись всех закешированных секторов на накопитель, если их isModified не ноль
355+  CD3C              ;
356+  CD3C              ; регистры hl, de, bc сохраняются
357+  CD3C              ;
358+  CD3C              ; 2022-02-08 Разработано SpaceEngineer
359+  CD3C              ;----------------------------------------------------------------------------
360+  CD3C
361+  CD3C              saveSectorCache:
362+  CD3C                      ; Сохраняем регситры
363+  CD3C E5                   push    hl
364+  CD3D D5                   push    de
365+  CD3E C5                   push    bc
366+  CD3F
367+  CD3F 21 41 CC             ld      hl, cacheData           ; hl = первый элемент в массиве cacheData
368+  CD42 11 08 00             ld      de, FAT_CACHE_DATA      ; de = размер элемента массива cacheData
369+  CD45 0E 04                ld      c,  FAT_CACHE_CAPACITY  ; счетчик цикла
370+  CD47              saveSectorCacheLoop:
371+  CD47 CD 19 CD             call    saveSectorFromCache     ; записываем сектор на накопитель
372+  CD4A 19                   add     hl, de
373+  CD4B 0D                   dec     c
374+  CD4C C2 47 CD             jp nz,  saveSectorCacheLoop
375+  CD4F
376+  CD4F                      ; Восстанавливаем регситры и выходим
377+  CD4F C1                   pop     bc
378+  CD50 D1                   pop     de
379+  CD51 E1                   pop     hl
380+  CD52 C9                   ret
381+  CD53
382+  CD53              ;----------------------------------------------------------------------------
383+  CD53              ; MXOS
384+  CD53              ; Вычисление номера сектора по номеру кластера
385+  CD53              ;
386+  CD53              ; вход:
387+  CD53              ;   de = номер кластера
388+  CD53              ;
389+  CD53              ; формула:
390+  CD53              ;   de = (de - 2) * v_diskInfo.sectorsPerCluster + v_diskInfo.dataStartSector
391+  CD53              ;
392+  CD53              ; выход:
393+  CD53              ;   de = номер сектора
394+  CD53              ;
395+  CD53              ;   регистры bc, hl сохраняются
396+  CD53              ;
397+  CD53              ; 2022-02-14 Разработано SpaceEngineer
398+  CD53              ;----------------------------------------------------------------------------
399+  CD53
400+  CD53              fatClusterToSector:
401+  CD53 E5                   push    hl
402+  CD54
403+  CD54 1B                   dec     de
404+  CD55 1B                   dec     de          ; de -= 2 (нумерация кластеров начинается с 2)
405+  CD56
406+  CD56 2A 30 D3             ld      hl, (v_diskInfo.sectorsPerCluster)
407+  CD59 CD A5 D2             call    mul_hl_de   ; hl = de * BPB_SecPerClus
408+  CD5C EB                   ex      hl, de
409+  CD5D
410+  CD5D 2A 42 D3             ld      hl, (v_diskInfo.dataStartSector)
411+  CD60 19                   add     hl, de
412+  CD61 EB                   ex      hl, de
413+  CD62
414+  CD62 E1                   pop     hl
415+  CD63 C9                   ret
416+  CD64
417+  CD64              ;----------------------------------------------------------------------------
418+  CD64              ; MXOS
419+  CD64              ; Начало цикла по файлам в каталоге
420+  CD64              ;
421+  CD64              ; выход:
422+  CD64              ;   de = номер первого сектора каталога
423+  CD64              ;   с  = количество секторов каталога (мл. байт)
424+  CD64              ;
425+  CD64              ;   остальные регистры сохраняются
426+  CD64              ;
427+  CD64              ; 2022-02-14 Разработано SpaceEngineer
428+  CD64              ;----------------------------------------------------------------------------
429+  CD64
430+  CD64              fatBeginDirLoop:
431+  CD64 EB                   ex      hl, de
432+  CD65 2A 40 D3             ld      hl, (v_diskInfo.dirStartSector)
433+  CD68 EB                   ex      hl, de                      ; de = номер первого сектора каталога
434+  CD69 3A 36 D3             ld      a, (v_diskInfo.dirSectors)  ; a = количество секторов каталога (мл. байт)
435+  CD6C 4F                   ld      c,  a                       ; с  = счетчик цикла
436+  CD6D C9                   ret
437+  CD6E
438+  CD6E              ;----------------------------------------------------------------------------
439+  CD6E              ; MXOS
440+  CD6E              ; Установка сектору каталога флага isModified
441+  CD6E              ;
442+  CD6E              ; вход:
443+  CD6E              ;  v_cachedSector - номер сектора
444+  CD6E              ;
445+  CD6E              ; выход:
446+  CD6E              ;   bc = системное время
447+  CD6E              ;
448+  CD6E              ;   регистр bc сохраняется
449+  CD6E              ;
450+  CD6E              ; 2022-02-08 Разработано SpaceEngineer
451+  CD6E              ;----------------------------------------------------------------------------
452+  CD6E
453+  CD6E              markDirSectorAsModified:
454+  CD6E 2A 0A D3             ld      hl, (v_cachedSector)
455+  CD71 EB                   ex      hl, de  ; de = номер сектора
456+  CD72 3E 01                ld      a, 1    ; флаг - сектор будет изменен
457+  CD74
458+  CD74                      ; Загрузка сектора в кэш; если сектор уже в кэше,
459+  CD74                      ; функция просто найдет его и изменит флаг
460+  CD74 C3 86 CC             jp      getSectorAddressInCache
461+  CD77
462+  CD77              ;----------------------------------------------------------------------------
463+  CD77              ; MXOS
464+  CD77              ; Получение текущего системного времени
465+  CD77              ;
466+  CD77              ; В "Специалисте" нет часов реального времени (RTC), поэтому системное время
467+  CD77              ; - это просто счетчик, увеличивающийся каждый раз при обращении. В будущем
468+  CD77              ; можно будет сделать вермя через таймер ВИ53, или через драйвер RTC, при его
469+  CD77              ; наличии в системе.
470+  CD77              ;
471+  CD77              ; выход:
472+  CD77              ;   bc = системное время
473+  CD77              ;
474+  CD77              ; все остальные регистры сохраняеюся
475+  CD77              ;
476+  CD77              ; 2022-02-08 Разработано SpaceEngineer
477+  CD77              ;----------------------------------------------------------------------------
478+  CD77
479+  CD77              getSystemTime:
480+  CD77 E5                   push    hl
481+  CD78 2A 1C D3             ld      hl, (v_fakeSystemTime)
482+  CD7B 23                   inc     hl
483+  CD7C 22 1C D3             ld      (v_fakeSystemTime), hl
484+  CD7F 44                   ld      b, h
485+  CD80 4D                   ld      c, l
486+  CD81 E1                   pop     hl
487+  CD82 C9                   ret
488+  CD83
489+  CD83              ;----------------------------------------------------------------------------
490+  CD83              ; MXOS
491+  CD83              ; Сравнение слова по адресу hl и de
492+  CD83              ; Псевдокод: cp [hl], de
493+  CD83              ;
494+  CD83              ; выход:
495+  CD83              ;   флаги c, z
496+  CD83              ;
497+  CD83              ; 2022-02-08 Разработано SpaceEngineer
498+  CD83              ;----------------------------------------------------------------------------
499+  CD83
500+  CD83              cmp_m_de:
501+  CD83 23                   inc   hl
502+  CD84 7E                   ld    a, (hl)
503+  CD85 2B                   dec   hl
504+  CD86 BA                   cp    d
505+  CD87 D8                   ret   c
506+  CD88 C0                   ret   nz
507+  CD89 7E                   ld    a, (hl)
508+  CD8A BB                   cp    e
509+  CD8B C9                   ret
510+  CD8C
110   CD8C                  INCLUDE "fatFindCluster.inc"
  1+  CD8C              ;+---------------------------------------------------------------------------
  2+  CD8C              ; MXOS
  3+  CD8C              ; Поиск свободного кластера
  4+  CD8C              ;
  5+  CD8C              ; На выходе
  6+  CD8C              ;  cf - ошибка
  7+  CD8C              ;  de - номер кластера
  8+  CD8C              ;  регистры bc, hl сохраняются
  9+  CD8C              ;
 10+  CD8C              ; 2013-12-12 Дизассемблировано vinxru
 11+  CD8C              ; 2022-02-04 Переработано SpaceEngineer
 12+  CD8C              ;----------------------------------------------------------------------------
 13+  CD8C
 14+  CD8C              fatFindClusterFirst:
 15+  CD8C                          ; Сохраняем регистры
 16+  CD8C E5                       push  hl
 17+  CD8D
 18+  CD8D                          ; de = номер первого кластера для поиска
 19+  CD8D                          ; Первые 2 ячейки fat зарезервированы
 20+  CD8D 11 02 00                 ld    de, 2
 21+  CD90
 22+  CD90 C3 99 CD                 jp    fatFindClusterCommon
 23+  CD93
 24+  CD93              ;----------------------------------------------------------------------------
 25+  CD93              ; Поиск следующего свободного кластера
 26+  CD93              ;
 27+  CD93              ; На выходе
 28+  CD93              ;  cf - ошибка
 29+  CD93              ;  de - номер кластера
 30+  CD93              ;  регистры bc, hl сохраняются
 31+  CD93              ;----------------------------------------------------------------------------
 32+  CD93
 33+  CD93              fatFindClusterNext:
 34+  CD93                          ; Сохраняем регистры
 35+  CD93 E5                       push    hl
 36+  CD94
 37+  CD94                          ; Предыдущий найденный кластер
 38+  CD94 2A 00 D3                 ld      hl, (v_findCluster)
 39+  CD97
 40+  CD97                          ; Начинаем поиск со следующего кластера
 41+  CD97 23                       inc     hl
 42+  CD98 EB                       ex      hl, de
 43+  CD99
 44+  CD99                          ; Ищем свободный кластер: перебераем все ячейки fat, пока не найдём 0
 45+  CD99              fatFindClusterCommon:
 46+  CD99 C5                       push    bc
 47+  CD9A 2A 3E D3                 ld      hl, (v_diskInfo.fatNumCells)
 48+  CD9D 44                       ld      b, h
 49+  CD9E 4D                       ld      c, l    ; bc = кол-во ячеек fat
 50+  CD9F
 51+  CD9F              fatFindClusterLoop:
 52+  CD9F                          ; Запоминаем номер последнего кластера в hl
 53+  CD9F 62                       ld      h, d
 54+  CDA0 6B                       ld      l, e
 55+  CDA1
 56+  CDA1                          ; de = fat[de]
 57+  CDA1 CD C0 CD                 call    fatReadCluster
 58+  CDA4
 59+  CDA4                          ; Сравниваем de с нулем
 60+  CDA4 7A                       ld      a, d
 61+  CDA5 B3                       or      e
 62+  CDA6 CA B8 CD                 jp z,   fatFindClusterOk  ; найден
 63+  CDA9
 64+  CDA9                          ; Следующий кластер
 65+  CDA9 54                       ld      d, h
 66+  CDAA 5D                       ld      e, l
 67+  CDAB 13                       inc     de
 68+  CDAC
 69+  CDAC                          ; Счётчик просмотренных ячеек fat
 70+  CDAC 0B                       dec     bc
 71+  CDAD 78                       ld      a, b
 72+  CDAE B1                       or      c
 73+  CDAF C2 9F CD                 jp nz,  fatFindClusterLoop  ; повтор цикла
 74+  CDB2
 75+  CDB2              ;---------------------------------------------------------------------------
 76+  CDB2
 77+  CDB2                          ; Свободный кластер не найден
 78+  CDB2                          ; Восстанавливаем регистры и выходим с a=1, CF=1, ZF=0
 79+  CDB2 C1                       pop     bc
 80+  CDB3 E1                       pop     hl
 81+  CDB4 3E 01                    ld      a, 1
 82+  CDB6 37                       scf
 83+  CDB7 C9                       ret
 84+  CDB8
 85+  CDB8              ;---------------------------------------------------------------------------
 86+  CDB8
 87+  CDB8                          ; Свободный кластер найден
 88+  CDB8              fatFindClusterOk:
 89+  CDB8                          ; Устаналиваем ZF=0. Номер кластера не может быть нулевым.
 90+  CDB8                          ; В случае ошибки мы тоже выходим с ZF=1
 91+  CDB8 B7                       or      a
 92+  CDB9
 93+  CDB9                          ; Для ускорения поиска сохраняем номер найденного кластера в v_findCluster
 94+  CDB9 22 00 D3                 ld      (v_findCluster), hl
 95+  CDBC EB                       ex      hl, de
 96+  CDBD
 97+  CDBD                          ; Восстанавливаем регистры и выходим с CF=0, ZF=0
 98+  CDBD C1                       pop     bc
 99+  CDBE E1                       pop     hl
100+  CDBF C9                       ret
101+  CDC0
111   CDC0                  INCLUDE "fatReadWriteCluster.inc"
  1+  CDC0              ;----------------------------------------------------------------------------
  2+  CDC0              ; MXOS
  3+  CDC0              ;
  4+  CDC0              ; Чтение номера кластера из таблицы fat
  5+  CDC0              ;
  6+  CDC0              ; вход:
  7+  CDC0              ;   de = номер ячейки, чтобы прочитать
  8+  CDC0              ;
  9+  CDC0              ; выход:
 10+  CDC0              ;   de = номер кластера, прочитанный из ячейки
 11+  CDC0              ;   hl, bc, a - сохраняются
 12+  CDC0              ;
 13+  CDC0              ; СИ аналог:
 14+  CDC0              ;   de = fat[de];
 15+  CDC0              ;
 16+  CDC0              ; 2022-02-04 SpaceEngineer
 17+  CDC0              ;----------------------------------------------------------------------------
 18+  CDC0
 19+  CDC0              fatReadCluster:
 20+  CDC0 E5                       push    hl
 21+  CDC1
 22+  CDC1                          ; вычисляем адрес ячейки, куда указывает de
 23+  CDC1 AF                       xor     a ; флаг - сектор fat не будет модифицироваться
 24+  CDC2 CD 90 CC                 call    getFatCellAddress
 25+  CDC5
 26+  CDC5                          ; читаем в de номер кластера из fat по адресу hl
 27+  CDC5 5E                       ld      e, (hl)
 28+  CDC6 23                       inc     hl
 29+  CDC7 56                       ld      d, (hl)
 30+  CDC8
 31+  CDC8                          ; восстанавливаем регистры и выходим
 32+  CDC8 E1                       pop     hl
 33+  CDC9 C9                       ret
 34+  CDCA
 35+  CDCA              ;----------------------------------------------------------------------------
 36+  CDCA              ; MXOS
 37+  CDCA              ;
 38+  CDCA              ; Запись номера кластера в таблицу fat и переход на следующий адрес ячейки
 39+  CDCA              ;
 40+  CDCA              ; вход:
 41+  CDCA              ;   hl = номер ячейки fat, куда писать
 42+  CDCA              ;   de = номер кластера, чтобы записать
 43+  CDCA              ;
 44+  CDCA              ; выход:
 45+  CDCA              ;   hl = de
 46+  CDCA              ;   bc, a - сохраняются
 47+  CDCA              ;
 48+  CDCA              ; СИ аналог:
 49+  CDCA              ;   fat[de] = hl;
 50+  CDCA              ;   hl = de;
 51+  CDCA              ;
 52+  CDCA              ; 2022-02-04 SpaceEngineer
 53+  CDCA              ;----------------------------------------------------------------------------
 54+  CDCA
 55+  CDCA              fatWriteCluster:
 56+  CDCA                          ; вычисляем адрес ячейки, куда указывает hl
 57+  CDCA D5                       push    de
 58+  CDCB EB                       ex      hl, de
 59+  CDCC 3E 01                    ld      a, 1 ; флаг - сектр fat будет модифицироваться
 60+  CDCE CD 90 CC                 call    getFatCellAddress
 61+  CDD1 D1                       pop     de
 62+  CDD2
 63+  CDD2                          ; записываем номер кластера из de в fat по адресу hl
 64+  CDD2 73                       ld      (hl), e
 65+  CDD3 23                       inc     hl
 66+  CDD4 72                       ld      (hl), d
 67+  CDD5
 68+  CDD5                          ; hl = de
 69+  CDD5 62                       ld      h, d
 70+  CDD6 6B                       ld      l, e
 71+  CDD7 C9                       ret
 72+  CDD8
 73+  CDD8              ;----------------------------------------------------------------------------
 74+  CDD8              ; MXOS
 75+  CDD8              ;
 76+  CDD8              ; Освобождение кластера в таблице fat
 77+  CDD8              ;
 78+  CDD8              ; вход:
 79+  CDD8              ;   de = номер кластера
 80+  CDD8              ;
 81+  CDD8              ; выход:
 82+  CDD8              ;   de = номер следующего кластера
 83+  CDD8              ;   hl, bc, a - сохраняются
 84+  CDD8              ;
 85+  CDD8              ; СИ аналог:
 86+  CDD8              ;   fat[de] = 0x0000;
 87+  CDD8              ;
 88+  CDD8              ; 2022-02-04 SpaceEngineer
 89+  CDD8              ;----------------------------------------------------------------------------
 90+  CDD8
 91+  CDD8              fatFreeCluster:
 92+  CDD8 E5                       push    hl
 93+  CDD9
 94+  CDD9                          ; вычисляем адрес ячейки, куда указывает hl
 95+  CDD9 D5                       push    de
 96+  CDDA EB                       ex      hl, de
 97+  CDDB 3E 01                    ld      a, 1 ; флаг - сектор fat будет модифицироваться
 98+  CDDD CD 90 CC                 call    getFatCellAddress
 99+  CDE0 D1                       pop     de
100+  CDE1
101+  CDE1                          ; читаем номер кластера из fat, и сразу записываем туда нули
102+  CDE1 5E                       ld      e, (hl)
103+  CDE2 36 00                    ld      (hl), 0
104+  CDE4 23                       inc     hl
105+  CDE5 56                       ld      d, (hl)
106+  CDE6 36 00                    ld      (hl), 0
107+  CDE8
108+  CDE8                          ; восстанавливаем регистры и выходим
109+  CDE8 E1                       pop     hl
110+  CDE9 C9                       ret
111+  CDEA
112+  CDEA
112   CDEA                  INCLUDE "fatGetFreeSpace.inc"
  1+  CDEA              ;----------------------------------------------------------------------------
  2+  CDEA              ; MXOS
  3+  CDEA              ; Определение свободного объема накопителя
  4+  CDEA              ;
  5+  CDEA              ; выход:
  6+  CDEA              ;   de = количество свободных кластеров
  7+  CDEA              ;
  8+  CDEA              ; 2022-02-09 Разработано SpaceEngineer
  9+  CDEA              ;----------------------------------------------------------------------------
 10+  CDEA
 11+  CDEA              getDriveFreeSpace:
 12+  CDEA                          ; Сохраняем регистры
 13+  CDEA E5                       push    hl
 14+  CDEB C5                       push    bc
 15+  CDEC
 16+  CDEC                          ; Счетчик свободных кластеров
 17+  CDEC 11 00 00                 ld      de, 0
 18+  CDEF
 19+  CDEF                          ; Кэшируем по очереди все секторы таблицы fat,
 20+  CDEF                          ; и подсчитываем общее коичество свободных кластеров в них
 21+  CDEF 2A 34 D3                 ld      hl, (v_diskInfo.fatSectors) ; hl = количество секторов fat на устройстве
 22+  CDF2 7D                       ld      a, l                        ; a  = количество секторов fat на устройстве (считаем, что их меньше 256)
 23+  CDF3 F5                       push    af
 24+  CDF4 2A 32 D3                 ld      hl, (v_diskInfo.resSectors) ; hl = номер сектора: начинаем с resSectors
 25+  CDF7              fatSectorsLoop:
 26+  CDF7 E5                       push    hl              ; hl = номер сектора
 27+  CDF8 06 00                    ld      b, 0            ; флаг - сектор не будет модифицироваться
 28+  CDFA CD A7 CC                 call    cacheSector     ; теперь hl = адрес буфера с загруженным сектором fat
 29+  CDFD
 30+  CDFD                          ; Цикл по кластерам сектора fat
 31+  CDFD 01 80 00                 ld      bc, SECTOR_SIZE/2   ; счетчик цикла
 32+  CE00              sectorClustersLoop:
 33+  CE00                          ; Читаем в a номер кластера из ячейки по адресу hl и сразу сравниваем с нулем
 34+  CE00 7E                       ld      a, (hl)
 35+  CE01 23                       inc     hl
 36+  CE02 B6                       or      (hl)
 37+  CE03 23                       inc     hl
 38+  CE04
 39+  CE04                          ; Если кластер пустой, увеличиваем счетчик свободных кластеров
 40+  CE04 C2 08 CE                 jp nz,  gdfs_nonEmpty
 41+  CE07 13                       inc     de
 42+  CE08              gdfs_nonEmpty:
 43+  CE08
 44+  CE08                          ; Повтор цикла по кластерам сектора fat
 45+  CE08 0B                       dec     bc  ; счетчик просмотренных кластеров сектора
 46+  CE09 78                       ld      a, b
 47+  CE0A B1                       or      c
 48+  CE0B C2 00 CE                 jp nz,  sectorClustersLoop
 49+  CE0E
 50+  CE0E                          ; Повтор цикла по секторам fat
 51+  CE0E E1                       pop     hl              ; hl = номер сектора
 52+  CE0F 23                       inc     hl              ; инкремент номера сектора
 53+  CE10
 54+  CE10 F1                       pop     af
 55+  CE11 3D                       dec     a               ; счетчик цикла
 56+  CE12 F5                       push    af
 57+  CE13
 58+  CE13 C2 F7 CD                 jp nz,  fatSectorsLoop  ; повтор цилкла по секторам
 59+  CE16
 60+  CE16                          ; Восстанавливаем регистры и выходим
 61+  CE16 F1                       pop     af
 62+  CE17 C1                       pop     bc
 63+  CE18 E1                       pop     hl
 64+  CE19
 65+  CE19 C9                       ret
 66+  CE1A
113   CE1A                  INCLUDE "fatReadBootSector.inc"
  1+  CE1A              ;----------------------------------------------------------------------------
  2+  CE1A              ; MXOS
  3+  CE1A              ; Считывание загрузочного сектора и инициализация структуры v_diskInfo.
  4+  CE1A              ; Подпрограмма затирает дисковый кэш!
  5+  CE1A              ;
  6+  CE1A              ; На выходе
  7+  CE1A              ;  cf - ошибка
  8+  CE1A              ;  регистры bc, de, hl сохраняются
  9+  CE1A              ;
 10+  CE1A              ; 2022-02-13 Разработано SpaceEngineer
 11+  CE1A              ;----------------------------------------------------------------------------
 12+  CE1A
 13+  CE1A              ; Структура загрузочного сектора FAT12/16
 14+  CE1A
 15+  CE1A                  STRUCT  FAT_BOOT_SECTOR
 16+  CE1A ~            BS_JmpBoot      BLOCK   3   ; смещение  00h,   3 байт - Jump instruction to the bootstrap code (x86 instruction): EBh, ??h, 90h (Short jump + NOP) or E9h, ??h, ??h (Near jump).
 17+  CE1A ~            BS_OEMName      BLOCK   8   ; смещение  03h,   8 байт - "MSWIN 4.1" is recommended but also "MSDOS 5.0" is often used.
 18+  CE1A ~            BPB_BytsPerSec  BLOCK   2   ; смещение  0Bh,   2 байт - Sector size in unit of byte. Valid values are 512, 1024, 2048, 4096. But most drivers use 512.
 19+  CE1A ~            BPB_SecPerClus  BLOCK   1   ; смещение  0Dh,   1 байт - Number of sectors per cluster. Valid values are 1, 2, 4, 8, ... 128.
 20+  CE1A ~            BPB_RsvdSecCnt  BLOCK   2   ; смещение  0Eh,   2 байт - Number of sectors in reserved area. This field hould be 1 on FAT12/16 volume.
 21+  CE1A ~            BPB_NumFATs     BLOCK   1   ; смещение  10h,   1 байт - Number of FATs. The value of this field should always be 2. On memory cards, it may be 1, but some FAT driver may not recognize such a volume properly.
 22+  CE1A ~            BPB_RootEntCnt  BLOCK   2   ; смещение  11h,   2 байт - Number of 32-byte directory entries in the root directory. For max compatibility, must be 512 on FAT16 volume.
 23+  CE1A ~            BPB_TotSec16    BLOCK   2   ; смещение  13h,   2 байт - Total number of sectors of the volume in old 16-bit field. If >= 0x10000, this field = 0, and the true value is set to BPB_TotSec32.
 24+  CE1A ~            BPB_Media       BLOCK   1   ; смещение  15h,   1 байт - Valid values are F0h, F8h ... FFh. The same value must be put in the lower 8-bits of FAT[0].
 25+  CE1A ~            BPB_FATSz16     BLOCK   2   ; смещение  16h,   2 байт - Number of sectors occupied by a FAT. The size of the FAT area becomes BPB_FATSz16 * BPB_NumFATs sectors.
 26+  CE1A ~            BPB_SecPerTrk   BLOCK   2   ; смещение  18h,   2 байт - Number of sectors per track. This field is relevant only for media that have geometry and used for only disk BIOS of IBM PC.
 27+  CE1A ~            BPB_NumHeads    BLOCK   2   ; смещение  1Ah,   2 байт - Number of heads. This field is relevant only for media that have geometry and used for only disk BIOS of IBM PC.
 28+  CE1A ~            BPB_HiddSec     BLOCK   4   ; смещение  1Ch,   4 байт - Number of hidden physical sectors preceding the FAT volume. Should always be 0 if the volume starts at the beginning of the storage.
 29+  CE1A ~            BPB_TotSec32    BLOCK   4   ; смещение  20h,   4 байт - Total number of sectors of the FAT volume in new 32-bit field.
 30+  CE1A ~            BS_DrvNum       BLOCK   1   ; смещение  24h,   1 байт - Drive number used by disk BIOS of IBM PC. This field is used in MS-DOS bootstrap, 0x00 for floppy disk and 0x80 for fixed disk.
 31+  CE1A ~            BS_Reserved     BLOCK   1   ; смещение  25h,   1 байт - Reserved (used by Windows NT). It should be set 0 when create the volume.
 32+  CE1A ~            BS_BootSig      BLOCK   1   ; смещение  26h,   1 байт - Extended boot signature (0x29). This is a signature byte indicates that the following three fields are present.
 33+  CE1A ~            BS_VolID        BLOCK   4   ; смещение  27h,   4 байт - Volume serial number used with BS_VolLab to track a volume on the removable storage. It enables to detect a wrong media change by FAT driver.
 34+  CE1A ~            BS_VolLab       BLOCK  11   ; смещение  2Bh,  11 байт - Volume label, matches volume label recorded in the root directory. When volume label is not present, "NO NAME " should be set.
 35+  CE1A ~            BS_FilSysType   BLOCK   8   ; смещение  36h,   8 байт - "FAT12   ", "FAT16   " or "FAT     ". Microsoft's FAT driver does not use this field to determine the FAT type.
 36+  CE1A ~            BS_BootCode     BLOCK 448   ; смещение  3Eh, 448 байт - Bootstrap program. It is platform dependent and filled with zero when not used.
 37+  CE1A ~            BS_BootSign     BLOCK   2   ; смещение 1FEh,   2 байт - 0xAA55. A boot signature indicating that this is a valid boot sector.
 38+  CE1A                  ENDS
 39+  CE1A
 40+  CE1A              ;----------------------------------------------------------------------------
 41+  CE1A
 42+  CE1A              fatReadBootSector:
 43+  CE1A                          ; Сохраняем регистры
 44+  CE1A E5                       push    hl
 45+  CE1B D5                       push    de
 46+  CE1C C5                       push    bc
 47+  CE1D
 48+  CE1D                          ; Помещаем значение DISK_NO_DRIVER в v_diskInfo.isValid
 49+  CE1D 3E 00                    ld      a, DISK_NO_DRIVER
 50+  CE1F 32 50 D3                 ld      (v_diskInfo.isValid), a
 51+  CE22
 52+  CE22                          ; Проверяем, установлен ли драйвер: сравниваем
 53+  CE22                          ; с адресом пустого драйвера diskDriverDummy
 54+  CE22 2A 64 C8                 ld      hl, (j_diskDriver + 1)  ; hl = адрес драйвера
 55+  CE25 3E CB                    ld      a, diskDriverDummy >> 8
 56+  CE27 BC                       cp      h
 57+  CE28 C2 31 CE                 jp nz,  frbs_DriverOk
 58+  CE2B 3E 9D                    ld      a, diskDriverDummy & 0FFh
 59+  CE2D BD                       cp      l
 60+  CE2E CA BB CE                 jp z,   frbs_Exit
 61+  CE31
 62+  CE31              frbs_DriverOk:
 63+  CE31                          ; Драйвер установлен; загружаем boot сектор в дисковый кэш, затирая его
 64+  CE31 21 00 FB                 ld      hl, FAT_CACHE_ADDR  ; адрес буфера
 65+  CE34 11 00 00                 ld      de, 0               ; номер сектора - 0
 66+  CE37 06 02                    ld      b, 2                ; режим драйвера - чтение
 67+  CE39 CD 63 C8                 call    j_diskDriver        ; читаем сектор в память
 68+  CE3C
 69+  CE3C                          ; Помещаем значение DISK_INVALID в v_diskInfo.isValid
 70+  CE3C 3E 01                    ld      a, DISK_INVALID
 71+  CE3E 32 50 D3                 ld      (v_diskInfo.isValid), a
 72+  CE41
 73+  CE41                          ; Проверяем, корректный ли это FAT12/16 диск:
 74+  CE41                          ; поле BS_FilSysType должно содержить текст "FAT"
 75+  CE41 21 36 FB                 ld      hl, FAT_CACHE_ADDR + FAT_BOOT_SECTOR.BS_FilSysType
 76+  CE44 11 8A D3                 ld      de, aFat
 77+  CE47 0E 03                    ld      c, 3
 78+  CE49 CD F5 CB                 call    strcmp
 79+  CE4C C2 BB CE                 jp nz,  frbs_Exit   ; это не FAT диск, или не отформатирован - выходим
 80+  CE4F
 81+  CE4F                          ; Помещаем значение DISK_VALID в v_diskInfo.isValid
 82+  CE4F 3E 02                    ld      a, DISK_VALID
 83+  CE51 32 50 D3                 ld      (v_diskInfo.isValid), a
 84+  CE54
 85+  CE54                          ; Копируем и рассчитываем необходимые значения
 86+  CE54 2A 0B FB                 ld      hl, (FAT_CACHE_ADDR + FAT_BOOT_SECTOR.BPB_BytsPerSec)
 87+  CE57 22 2E D3                 ld      (v_diskInfo.sectorSize), hl         ; размер сектора
 88+  CE5A
 89+  CE5A 3A 0D FB                 ld      a, (FAT_CACHE_ADDR + FAT_BOOT_SECTOR.BPB_SecPerClus)
 90+  CE5D 32 30 D3                 ld      (v_diskInfo.sectorsPerCluster), a
 91+  CE60 AF                       xor     a
 92+  CE61 32 31 D3                 ld      (v_diskInfo.sectorsPerCluster+1), a ; секторов на кластер (16-битным словом)
 93+  CE64
 94+  CE64 2A 13 FB                 ld      hl, (FAT_CACHE_ADDR + FAT_BOOT_SECTOR.BPB_TotSec16)
 95+  CE67 22 38 D3                 ld      (v_diskInfo.totalSectors), hl       ; сколько всего секторов на диске
 96+  CE6A
 97+  CE6A 2A 0E FB                 ld      hl, (FAT_CACHE_ADDR + FAT_BOOT_SECTOR.BPB_RsvdSecCnt)
 98+  CE6D 22 32 D3                 ld      (v_diskInfo.resSectors), hl         ; сколько секторов занимает зарезервированная область
 99+  CE70
100+  CE70 EB                       ex      hl, de
101+  CE71
102+  CE71 2A 16 FB                 ld      hl, (FAT_CACHE_ADDR + FAT_BOOT_SECTOR.BPB_FATSz16)
103+  CE74 22 34 D3                 ld      (v_diskInfo.fatSectors), hl         ; сколько секторов занимает таблица fat
104+  CE77
105+  CE77 19                       add     hl, de
106+  CE78 22 40 D3                 ld      (v_diskInfo.dirStartSector), hl     ; первый сектор корневого каталога
107+  CE7B E5                       push    hl
108+  CE7C
109+  CE7C 2A 11 FB                 ld      hl, (FAT_CACHE_ADDR + FAT_BOOT_SECTOR.BPB_RootEntCnt)
110+  CE7F 22 3A D3                 ld      (v_diskInfo.rootDirMaxFiles), hl    ; максимум файлов в корневом каталоге
111+  CE82
112+  CE82 2A 2E D3                 ld      hl, (v_diskInfo.sectorSize)
113+  CE85 11 20 00                 ld      de, FILE_DESCR_SIZE ; de = 32
114+  CE88 CD CA D2                 call    div_hl_de;
115+  CE8B 22 3C D3                 ld      (v_diskInfo.descrPerSector), hl     ; сколько дескрипторов файлов вмещается в один сектор
116+  CE8E
117+  CE8E EB                       ex      hl, de
118+  CE8F 2A 3A D3                 ld      hl, (v_diskInfo.rootDirMaxFiles)
119+  CE92 CD CA D2                 call    div_hl_de;
120+  CE95 22 36 D3                 ld      (v_diskInfo.dirSectors), hl         ; сколько секторов занимает корневой каталог
121+  CE98
122+  CE98 D1                       pop     de
123+  CE99 19                       add     hl, de
124+  CE9A 22 42 D3                 ld      (v_diskInfo.dataStartSector), hl    ; первый сектор области данных
125+  CE9D
126+  CE9D 2A 2E D3                 ld      hl, (v_diskInfo.sectorSize)
127+  CEA0 CD 9D D2                 call    div_hl_2
128+  CEA3 EB                       ex      hl, de
129+  CEA4 2A 34 D3                 ld      hl, (v_diskInfo.fatSectors)
130+  CEA7 CD A5 D2                 call    mul_hl_de;
131+  CEAA 22 3E D3                 ld      (v_diskInfo.fatNumCells), hl        ; количество ячеек в таблице fat (= fatSectors * sectorSize / 2)
132+  CEAD
133+  CEAD                          ; Копируем метку тома
134+  CEAD 21 2B FB                 ld      hl, FAT_CACHE_ADDR + FAT_BOOT_SECTOR.BS_VolLab          ; откуда - начало
135+  CEB0 11 36 FB                 ld      de, FAT_CACHE_ADDR + FAT_BOOT_SECTOR.BS_FilSysType      ; откуда - конец
136+  CEB3 01 44 D3                 ld      bc, v_diskInfo.volumeLabel                              ; куда
137+  CEB6 CD 2D C4                 call    memcpy_bc_hl
138+  CEB9 36 00                    ld      (hl), 0                                                 ; в конце байт-терминатор строки
139+  CEBB
140+  CEBB              frbs_Exit:  ; Восстанавливаем регистры и выходим
141+  CEBB C1                       pop     bc
142+  CEBC D1                       pop     de
143+  CEBD E1                       pop     hl
144+  CEBE C9                       ret
145+  CEBF
114   CEBF                  INCLUDE "fileCreate.inc"
  1+  CEBF              ;----------------------------------------------------------------------------
  2+  CEBF              ; MXOS
  3+  CEBF              ; Создать файл
  4+  CEBF              ;
  5+  CEBF              ; На входе
  6+  CEBF              ;  hl - адрес дескриптора файла в формате FAT (имя, фтрибуты, размер и т.д.)
  7+  CEBF              ;
  8+  CEBF              ; На выходе
  9+  CEBF              ;  сf - ошибка
 10+  CEBF              ;
 11+  CEBF              ; TODO: В случае нехватки места на диске, на нем остается неполный файл.
 12+  CEBF              ; Надо удалить то, что записали.
 13+  CEBF              ;
 14+  CEBF              ; 2013-12-12 Дизассемблировано vinxru
 15+  CEBF              ; 2022-02-11 Переработано SpaceEngineer
 16+  CEBF              ;----------------------------------------------------------------------------
 17+  CEBF
 18+  CEBF              ; Внутренний вход для потокового копирования.
 19+  CEBF              ; HL=FILE_DESCRIPTOR, DE=число 256-байтных кластеров.
 20+  CEBF              ; Создаёт запись каталога и FAT-цепочку, но не пишет данные.
 21+  CEBF              fileCreatePrepare:
 22+  CEBF 3E 01                    ld      a, 1
 23+  CEC1 32 AB CF                 ld      (v_fileCreatePrepare), a
 24+  CEC4 EB                       ex      de, hl
 25+  CEC5 22 06 D3                 ld      (v_input_end), hl
 26+  CEC8 EB                       ex      de, hl
 27+  CEC9 C3 D0 CE                 jp      fileCreateEntry
 28+  CECC
 29+  CECC              fileCreate: ; Сохраняем регистры
 30+  CECC AF                       xor     a
 31+  CECD 32 AB CF                 ld      (v_fileCreatePrepare), a
 32+  CED0
 33+  CED0              fileCreateEntry:
 34+  CED0 E5                       push    hl  ; [1]
 35+  CED1 C5                       push    bc  ; [2]
 36+  CED2 D5                       push    de  ; [3]
 37+  CED3
 38+  CED3                          ; Сохраняем адрес подготовленного дескриптора создаваемого файла
 39+  CED3 22 0C D3                 ld      (v_newDescrPtr), hl
 40+  CED6
 41+  CED6                          ; Если файл существует, то удаляем его
 42+  CED6 CD AC CF                 call    fileFind
 43+  CED9 D4 86 D0                 call nc,deleteFileInt
 44+  CEDC
 45+  CEDC                          ; de = номер первого сектора каталога
 46+  CEDC                          ; с  = количество секторов каталога (мл. байт)
 47+  CEDC CD 64 CD                 call    fatBeginDirLoop
 48+  CEDF
 49+  CEDF                          ; Цикл по секторам каталога
 50+  CEDF              fileCreate_dirLoop:
 51+  CEDF                          ; Сохраняем номер сектора каталога
 52+  CEDF D5                       push    de  ; [4]               ; de = номер сектора каталога
 53+  CEE0
 54+  CEE0                          ; Кэшируем сектор каталога
 55+  CEE0 AF                       xor     a                       ; флаг - сектор не будет меняться
 56+  CEE1 CD 86 CC                 call    getSectorAddressInCache ; выход: hl = адрес сектора в буфере
 57+  CEE4
 58+  CEE4                          ; Кол-во дескрипторов файлов в одном секторе каталога (мл. байт)
 59+  CEE4 3A 3C D3                 ld      a, (v_diskInfo.descrPerSector)
 60+  CEE7 47                       ld      b, a
 61+  CEE8
 62+  CEE8                          ; Размер дескриптора
 63+  CEE8 11 20 00                 ld      de, FILE_DESCR_SIZE
 64+  CEEB
 65+  CEEB                          ; Цикл по дескрипторам в закешированном секторе каталога
 66+  CEEB              fileCreate_sectorLoop:
 67+  CEEB 7E                       ld      a, (hl)                 ; читаем байт из каталога
 68+  CEEC 3C                       inc     a                       ; если байт = 0FFh, значит запись свободна
 69+  CEED CA 01 CF                 jp z,   fileCreate_placeFound   ; переход, если свободная запись найдена
 70+  CEF0
 71+  CEF0                          ; Вычисляем адрес следующего дескриптора
 72+  CEF0 19                       add     hl, de
 73+  CEF1
 74+  CEF1                          ; Еще остались файлы в секторе каталога?
 75+  CEF1 05                       dec     b
 76+  CEF2 C2 EB CE                 jp nz,  fileCreate_sectorLoop
 77+  CEF5
 78+  CEF5                          ; Еще остались секторы каталога?
 79+  CEF5                          ; Восстанавливаем номер сектора каталога
 80+  CEF5 D1                       pop     de  ; [4]   de = номер сектора каталога
 81+  CEF6 13                       inc     de  ;       следующий сектор каталога
 82+  CEF7
 83+  CEF7 0D                       dec     c
 84+  CEF8 C2 DF CE                 jp nz,  fileCreate_dirLoop
 85+  CEFB
 86+  CEFB                          ;-----------------------------------------------------------
 87+  CEFB                          ; Свободных записей нет
 88+  CEFB
 89+  CEFB                          ; Установка a=0, ZF=1
 90+  CEFB AF                       xor     a
 91+  CEFC
 92+  CEFC              stc_popDBH_ret:
 93+  CEFC                          ; Установка флага CF=1
 94+  CEFC 37                       scf
 95+  CEFD
 96+  CEFD              popDBH_ret: ; Восстановление регистров и выход
 97+  CEFD D1                       pop     de  ; [3]
 98+  CEFE C1                       pop     bc  ; [2]
 99+  CEFF E1                       pop     hl  ; [1]
100+  CF00 C9                       ret
101+  CF01
102+  CF01                          ;-----------------------------------------------------------
103+  CF01                          ; Свободная запись найдена
104+  CF01
105+  CF01              fileCreate_placeFound:
106+  CF01
107+  CF01                          ; Сохраняем найденный в кэше адрес свободного дескриптора
108+  CF01 22 08 D3                 ld      (v_cachedDescrPtr), hl
109+  CF04
110+  CF04                          ; Сохраняем номер сектора каталога
111+  CF04 D1                       pop     de  ; [4]   de = номер сектора каталога
112+  CF05 EB                       ex      hl, de
113+  CF06 22 0A D3                 ld      (v_cachedSector), hl
114+  CF09
115+  CF09                          ; Находим первый свободный кластер
116+  CF09 CD 8C CD                 call    fatFindClusterFirst ; de = первый свободный кластер
117+  CF0C DA FC CE                 jp c,   stc_popDBH_ret      ; если нет свободных кластеров - выходим с ошибкой
118+  CF0F
119+  CF0F                          ; Сохраняем его в переменную v_fileFirstCluster
120+  CF0F EB                       ex      hl, de
121+  CF10 22 02 D3                 ld      (v_fileFirstCluster), hl
122+  CF13 EB                       ex      hl, de
123+  CF14
