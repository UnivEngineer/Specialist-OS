  8+  CA9C
  9+  CA9C              ;----------------------------------------------------------------------------
 10+  CA9C              ; Установить драйвер доступа к ДОЗУ в окно разделяемой памяти
 11+  CA9C              ; Специалиста-MX (FFC0h-FFDEh)
 12+  CA9C              ;
 13+  CA9C              ; вход:
 14+  CA9C              ;  b = 0 - установить блочный драйвер, b = 1 - установить побайтовый драйвер
 15+  CA9C              ;
 16+  CA9C              ; 2022-02-02 SpaceEngineer
 17+  CA9C              ;----------------------------------------------------------------------------
 18+  CA9C
 19+  CA9C              setRAMDDriver:
 20+  CA9C E5                       push  hl
 21+  CA9D D5                       push  de
 22+  CA9E C5                       push  bc
 23+  CA9F F5                       push  af
 24+  CAA0 05                       dec   b
 25+  CAA1 CA AD CA                 jp z, setRAMDDriver_1
 26+  CAA4
 27+  CAA4                          ; Адреса блочного драйвера
 28+  CAA4 21 BE CA                 ld    hl, driverBlockStart
 29+  CAA7 11 DE CA                 ld    de, driverBlockEnd
 30+  CAAA C3 B3 CA                 jp    setRAMDDriver_2
 31+  CAAD
 32+  CAAD              setRAMDDriver_1:
 33+  CAAD                          ; Адреса побайтового драйвера
 34+  CAAD 21 DE CA                 ld    hl, driverByteStart
 35+  CAB0 11 FE CA                 ld    de, driverByteEnd
 36+  CAB3
 37+  CAB3                          ; Копируем драйвер на адрес bc = bios_RAMDRead = 0FFC0h
 38+  CAB3              setRAMDDriver_2:
 39+  CAB3 01 C0 FF                 ld    bc, bios_RAMDRead
 40+  CAB6 CD 2D C4                 call  memcpy_bc_hl
 41+  CAB9
 42+  CAB9                          ; Восстанавливаем регистры и выходим
 43+  CAB9 F1                       pop   af
 44+  CABA C1                       pop   bc
 45+  CABB D1                       pop   de
 46+  CABC E1                       pop   hl
 47+  CABD C9                       ret
 48+  CABE
 49+  CABE              ;----------------------------------------------------------------------------
 50+  CABE              ; Блочный драйвер, обрабатывает сразу блок 256 байт
 51+  CABE              ;
 52+  CABE              ; FFC0h - чтение 256-байтного блока
 53+  CABE              ;   вход:
 54+  CABE              ;     c = номер страницы
 55+  CABE              ;     d = номер блока
 56+  CABE              ;     e = 0
 57+  CABE              ;     hl = адрес буфера в памяти
 58+  CABE              ;
 59+  CABE              ; FFD0h - запись 256-байтного блока
 60+  CABE              ;   вход:
 61+  CABE              ;     c = номер страницы
 62+  CABE              ;     d = номер блока
 63+  CABE              ;     e = 0
 64+  CABE              ;     hl = адрес буфера в памяти
 65+  CABE              ;
 66+  CABE              ;----------------------------------------------------------------------------
 67+  CABE
 68+  CABE              ; Чтение 256-байтного блока с диска
 69+  CABE
 70+  CABE              driverBlockStart: ; эта п/п копируется на FFC0h
 71+  CABE 79                       ld      a, c
 72+  CABF 32 FD FF                 ld      (IO_PAGE_RAMD), a
 73+  CAC2 1A                       ld      a, (de)
 74+  CAC3 32 FC FF                 ld      (IO_PAGE_RAM), a
 75+  CAC6 77                       ld      (hl), a
 76+  CAC7 23                       inc     hl
 77+  CAC8 1C                       inc     e
 78+  CAC9 C2 C0 FF                 jp nz,  0FFC0h
 79+  CACC C9                       ret
 80+  CACD
 81+  CACD                          ; осталось места: 1 байт
 82+  CACD 00                       nop
 83+  CACE
 84+  CACE              ; Запись 256-байтного блока на диск
 85+  CACE
 86+  CACE              driverBlockWrite: ; эта п/п копируется на FFD0h
 87+  CACE 46                       ld      b, (hl)
 88+  CACF 79                       ld      a, c
 89+  CAD0 32 FD FF                 ld      (IO_PAGE_RAMD), a
 90+  CAD3 78                       ld      a, b
 91+  CAD4 12                       ld      (de), a
 92+  CAD5 32 FC FF                 ld      (IO_PAGE_RAM), a
 93+  CAD8 23                       inc     hl
 94+  CAD9 1C                       inc     e
 95+  CADA C2 D0 FF                 jp nz,  0FFD0h
 96+  CADD C9                       ret
 97+  CADE
 98+  CADE                          ; осталось места: 0 байт
 99+  CADE
100+  CADE              driverBlockEnd:
101+  CADE
102+  CADE              ;----------------------------------------------------------------------------
103+  CADE              ; Побайтовый драйвер, обрабатывает только 1 байт
104+  CADE              ;
105+  CADE              ; FFC0h - чтение байта
106+  CADE              ;   вход:
107+  CADE              ;     a  = номер страницы
108+  CADE              ;     hl = адрес байта в странице ДОЗУ
109+  CADE              ;   выход:
110+  CADE              ;     c  = считанный байт
111+  CADE              ;
112+  CADE              ; FFD0h - запись байта
113+  CADE              ;   вход:
114+  CADE              ;     a  = номер страницы
115+  CADE              ;     hl = байта в странице ДОЗУ
116+  CADE              ;     c  = записываемый байт
117+  CADE              ;
118+  CADE              ;----------------------------------------------------------------------------
119+  CADE
120+  CADE              driverByteStart: ; эта п/п копируется на FFC0h
121+  CADE 32 FD FF                 ld      (IO_PAGE_RAMD), a
122+  CAE1 4E                       ld      c, (hl)
123+  CAE2 32 FC FF                 ld      (IO_PAGE_RAM), a
124+  CAE5 C9                       ret
125+  CAE6
126+  CAE6                          ; осталось места: 8 байт
127+  CAE6 00                       nop
128+  CAE7 00                       nop
129+  CAE8 00                       nop
130+  CAE9 00                       nop
131+  CAEA 00                       nop
132+  CAEB 00                       nop
133+  CAEC 00                       nop
134+  CAED 00                       nop
135+  CAEE
136+  CAEE              driverByteWrite: ; эта п/п копируется на FFD0h
137+  CAEE 32 FD FF                 ld      (IO_PAGE_RAMD), a
138+  CAF1 71                       ld      (hl), c
139+  CAF2 32 FC FF                 ld      (IO_PAGE_RAM), a
140+  CAF5 C9                       ret
141+  CAF6
142+  CAF6                          ; осталось места: 8 байт
143+  CAF6 00                       nop
144+  CAF7 00                       nop
145+  CAF8 00                       nop
146+  CAF9 00                       nop
147+  CAFA 00                       nop
148+  CAFB 00                       nop
149+  CAFC 00                       nop
150+  CAFD 00                       nop
151+  CAFE
152+  CAFE              driverByteEnd:
153+  CAFE
154+  CAFE              ; ---------------------------------------------------------------------------
155+  CAFE
156+  CAFE              ; Проверка, что драйверы влезаеют в 32 байта разделяемой памяти Специалиста-MX
157+  CAFE
158+  CAFE                  IF driverBlockWrite-driverBlockStart+bios_RAMDRead != bios_RAMDWrite
159+  CAFE ~                    ASSERT 0
160+  CAFE ~                    DISPLAY /l, "Error! Block briver entry point FFD0 has been shifted: ", driverBlockWrite-driverBlockStart+bios_RAMDRead, " != 0xFFD0"
161+  CAFE                  ENDIF
162+  CAFE
163+  CAFE                  IF driverByteWrite-driverByteStart+bios_RAMDRead != bios_RAMDWrite
164+  CAFE ~                    ASSERT 0
165+  CAFE ~                    DISPLAY /l, "Error! Byte briver entry point FFD0 has been shifted: ", driverByteWrite-driverByteStart+bios_RAMDRead, " != 0xFFD0"
166+  CAFE                  ENDIF
167+  CAFE
168+  CAFE                  IF driverBlockEnd-driverBlockStart > 32
169+  CAFE ~                    ASSERT 0
170+  CAFE ~                    DISPLAY /d, "Error! Block briver did not fit: ", driverBlockEnd-driverBlockStart, " > 32 bytes"
171+  CAFE                  ENDIF
172+  CAFE
173+  CAFE                  IF driverByteEnd-driverByteStart > 32
174+  CAFE ~                    ASSERT 0
175+  CAFE ~                    DISPLAY /d, "Error! Byte briver did not fit: ", driverByteEnd-driverByteStart, " > 32 bytes"
176+  CAFE                  ENDIF
177+  CAFE
