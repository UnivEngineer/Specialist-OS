 39+  C7B5 E5                       push  hl
 40+  C7B6 E5                       push  hl
 41+  C7B7 E5                       push  hl
 42+  C7B8 E5                       push  hl
 43+  C7B9
 44+  C7B9                          ; Следующий столбец (sp += 20)
 45+  C7B9 21 14 00                 ld    hl, 14h
