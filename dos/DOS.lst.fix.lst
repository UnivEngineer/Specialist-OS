102   C9D2                  INCLUDE "fileExecBat.inc"
  1+  C9D2              ;+---------------------------------------------------------------------------
  2+  C9D2              ; MXOS
  3+  C9D2              ; Запустить BAT файл. Вызывается функцией fileExec
  4+  C9D2              ;
  5+  C9D2              ; 2013-12-12 Дизассемблировано vinxru
  6+  C9D2              ;----------------------------------------------------------------------------
  7+  C9D2
  8+  C9D2              execBat:
  9+  C9D2 D1                       pop     de
 10+  C9D3
 11+  C9D3                          ; Устанавливаем адрес загрузки BAT-файла на BAT_BUFFER (= FC00h)
 12+  C9D3 21 00 E8                 ld      hl, BAT_BUFFER
 13+  C9D6 22 10 D3                 ld      (v_batPtr), hl
 14+  C9D9 EB                       ex      de, hl
 15+  C9DA
 16+  C9DA                          ; Изменяем адрес загрузки BAT-файла
 17+  C9DA                          ; TODO: это не работает с ром-диском (A: без поддержки записи). Поэтому
 18+  C9DA                          ; нельзя запустить BAT-файл с диска A:, если его адрес загрузки в каталоге
 19+  C9DA                          ; уже не прошит как FC00h (= BAT_BUFFER)
 20+  C9DA 21 DF D3                 ld      hl, v_curFileDescr
 21+  C9DD 0E 01                    ld      c, 1
 22+  C9DF CD 08 D1                 call    fileGetSetAddr
 23+  C9E2 DA 8C CA                 jp c,   badCommand
 24+  C9E5
 25+  C9E5                          ; Сохраняем имя BAT-файла
 26+  C9E5 21 DF D3                 ld      hl, v_curFileDescr
 27+  C9E8 11 EA D3                 ld      de, v_curFileDescr + FILE_NAME_LENGTH + 3
 28+  C9EB 01 FF D3                 ld      bc, v_batFileDescr
 29+  C9EE CD 97 C3                 call    memmove_bc_hl
 30+  C9F1
 31+  C9F1                          ; Сохраняем диск содержащий BAT-файл
 32+  C9F1 3A FF D2                 ld      a, (v_drive)
 33+  C9F4 32 FC C9                 ld      (v_batDrive+1), a   ; самомодификация кода
 34+  C9F7
 35+  C9F7                          ; Этот цикл выполняется для каждой строки BAT-файла
 36+  C9F7              execBat_loop:
 37+  C9F7
 38+  C9F7                          ; Сохраняем текущий диск в регистре b
 39+  C9F7 3A FF D2                 ld      a, (v_drive)
 40+  C9FA 47                       ld      b, a
 41+  C9FB
 42+  C9FB              v_batDrive:
 43+  C9FB                          ; Выбрать диск содержащий BAT файл
 44+  C9FB 3E 01                    ld      a, 1 ; << сюда вместо 1 пишется диск, содержащий BAT файл
 45+  C9FD CD CB CB                 call    fileSelectDrive
 46+  CA00
 47+  CA00                          ; Загрузить BAT-файл в память
 48+  CA00 21 FF D3                 ld      hl, v_batFileDescr
 49+  CA03 CD 09 D0                 call    fileLoad
 50+  CA06 2A 10 D3                 ld      hl, (v_batPtr)
 51+  CA09
 52+  CA09                          ; Сохраняем начало строки
 53+  CA09 54                       ld      d, h
 54+  CA0A 5D                       ld      e, l
 55+  CA0B
 56+  CA0B                          ; Ищем конец строки
 57+  CA0B              execBat_0:
 58+  CA0B 7E                       ld      a, (hl)
 59+  CA0C 23                       inc     hl
 60+  CA0D
 61+  CA0D                          ; Найден конец строки, запускаем файл
 62+  CA0D FE 0D                    cp      0Dh
 63+  CA0F CA 1D CA                 jp z,   execBat_1
 64+  CA12
 65+  CA12                          ; Принимать также Unix-перевод строки. Файлы из Git и
 66+  CA12                          ; современных редакторов часто заканчиваются байтом 0Ah.
 67+  CA12 FE 0A                    cp      0Ah
 68+  CA14 CA 1D CA                 jp z,   execBat_1
 69+  CA17
 70+  CA17                          ; Конец файла
 71+  CA17 FE FF                    cp      0FFh
 72+  CA19 C2 0B CA                 jp nz,  execBat_0
 73+  CA1C C9                       ret
 74+  CA1D
 75+  CA1D              ; ---------------------------------------------------------------------------
 76+  CA1D
 77+  CA1D              execBat_1:
 78+  CA1D                          ; Сохраняем указатель
 79+  CA1D 22 10 D3                 ld      (v_batPtr), hl
 80+  CA20
 81+  CA20                          ; Восстановление активного диска
 82+  CA20 78                       ld      a, b
 83+  CA21 CD CB CB                 call    fileSelectDrive
 84+  CA24
 85+  CA24                          ; Запустить файл
 86+  CA24 EB                       ex      de, hl
 87+  CA25 CD 2B CA                 call    fileExec
 88+  CA28
 89+  CA28 C3 F7 C9                 jp      execBat_loop
