117+  D061 C5                       push    bc
118+  D062 D5                       push    de
119+  D063
120+  D063                          ; de = указатель на первое поле после расширения
121+  D063 01 0B 00                 ld      bc, FILE_DESCRIPTOR.attrib
122+  D066 09                       add     hl, bc
123+  D067 EB                       ex      de, hl
124+  D068
125+  D068                          ; Информация о файле, исключая имя
126+  D068 2A 0E D3                 ld      hl, (v_foundDescrPtr)
127+  D06B 09                       add     hl, bc
128+  D06C
129+  D06C                          ; Копируем дескриптор из hl в de, исключая имя и расширение
130+  D06C 06 15                    ld      b, FILE_DESCR_SIZE - FILE_NAME_LENGTH - 3
131+  D06E              fileLoadCDLoop:
132+  D06E 7E                       ld      a, (hl)
133+  D06F 12                       ld      (de), a
134+  D070 23                       inc     hl
135+  D071 13                       inc     de
136+  D072 05                       dec     b
137+  D073 C2 6E D0                 jp nz,  fileLoadCDLoop
138+  D076
139+  D076                          ; Выход CF=0
140+  D076 B7                       or      a
141+  D077 C3 FD CE                 jp      popDBH_ret
142+  D07A
117   D07A                  INCLUDE "fileDelete.inc"
  1+  D07A              ;+---------------------------------------------------------------------------
  2+  D07A              ; MXOS
  3+  D07A              ; Удаление файла
  4+  D07A              ;
  5+  D07A              ; На входе
  6+  D07A              ;  hl - имя файла
  7+  D07A              ;
  8+  D07A              ; На выходе
  9+  D07A              ;  cf - ошибка
 10+  D07A              ;  bc, de, hl - сохраняются
 11+  D07A              ;
 12+  D07A              ; 2013-12-12 Дизассемблировано vinxru
 13+  D07A              ; 2022-02-11 Переработано SpaceEngineer
 14+  D07A              ;----------------------------------------------------------------------------
 15+  D07A
 16+  D07A              fileDelete: ; Найти файл с именем из hl
 17+  D07A CD AC CF                 call    fileFind
 18+  D07D D8                       ret     c
 19+  D07E
 20+  D07E                          ; Удалить файл
 21+  D07E CD 86 D0                 call    deleteFileInt
 22+  D081
 23+  D081                          ; Сохранить изменения на диск
 24+  D081 CD 3C CD                 call    saveSectorCache
 25+  D084
 26+  D084                          ; Результат
 27+  D084 B7                       or      a
 28+  D085 C9                       ret
 29+  D086
 30+  D086              ; ---------------------------------------------------------------------------
 31+  D086
 32+  D086              deleteFileInt:
 33+  D086                          ; Сохраняем регистры
 34+  D086 E5                       push    hl
 35+  D087 C5                       push    bc
 36+  D088 D5                       push    de
 37+  D089
 38+  D089                          ; Помечаем файл в кэше, как удаленный, заменяя первую букву его имени на 0FFh
 39+  D089 2A 08 D3                 ld      hl, (v_cachedDescrPtr)
 40+  D08C 36 FF                    ld      (hl), 0FFh
 41+  D08E E5                       push    hl
 42+  D08F
 43+  D08F                          ; Ставим сектору каталога флаг isModified
 44+  D08F CD 6E CD                 call    markDirSectorAsModified
 45+  D092
 46+  D092                          ; Получаем первый кластер файла в de
 47+  D092 E1                       pop     hl
 48+  D093 11 1A 00                 ld      de, FILE_DESCRIPTOR.firstCluster
 49+  D096 19                       add     hl, de
 50+  D097 5E                       ld      e, (hl)
 51+  D098 23                       inc     hl
 52+  D099 56                       ld      d, (hl)
 53+  D09A
 54+  D09A              deleteFileLoop:
 55+  D09A 62                       ld      h, d
 56+  D09B 6B                       ld      l, e
 57+  D09C
 58+  D09C                          ; Обнуляем кластер номер de и получаем номер
 59+  D09C                          ; следующиего кластера файла в de
 60+  D09C CD D8 CD                 call    fatFreeCluster
 61+  D09F
 62+  D09F                          ; Если это был не последний кластер, продолжаем.
 63+  D09F 7A                       ld      a, d
 64+  D0A0 BC                       cp      h
 65+  D0A1 C2 9A D0                 jp nz,  deleteFileLoop
 66+  D0A4 7B                       ld      a, e
 67+  D0A5 BD                       cp      l
 68+  D0A6 C2 9A D0                 jp nz,  deleteFileLoop
 69+  D0A9
 70+  D0A9                          ; Восстаналиваем регистры и выходим
 71+  D0A9 C3 FD CE                 jp      popDBH_ret
 72+  D0AC
118   D0AC                  INCLUDE "fileRename.inc"
  1+  D0AC              ;+---------------------------------------------------------------------------
  2+  D0AC              ; MXOS
  3+  D0AC              ; Переименовать файл в пределах текущего диска.
  4+  D0AC              ;
  5+  D0AC              ; Вход:
  6+  D0AC              ;   hl - старое имя;
  7+  D0AC              ;   de - новое имя.
  8+  D0AC              ; Выход:
  9+  D0AC              ;   CF - ошибка;
 10+  D0AC              ;   bc, de, hl разрушаются.
 11+  D0AC              ;
 12+  D0AC              ; Важно: поиск нового имени может вытеснить сектор исходного дескриптора из
 13+  D0AC              ; кэша. Поэтому перед записью имени исходный файл ищется повторно.
 14+  D0AC              ;----------------------------------------------------------------------------
 15+  D0AC
 16+  D0AC              fileRename:
 17+  D0AC                          ; Найти исходный файл.
 18+  D0AC CD AC CF                 call    fileFind
 19+  D0AF D8                       ret c
 20+  D0B0
 21+  D0B0                          ; Переименование в то же имя ничего не меняет.
 22+  D0B0 E5                       push    hl
 23+  D0B1 D5                       push    de
 24+  D0B2 0E 0B                    ld      c, FILE_NAME_LENGTH + 3
 25+  D0B4 CD FF CB                 call    stricmp
 26+  D0B7 D1                       pop     de
 27+  D0B8 E1                       pop     hl
 28+  D0B9 C8                       ret z
 29+  D0BA
 30+  D0BA                          ; Сохранить входные регистры для общего выхода popDBH_ret.
 31+  D0BA E5                       push    hl
 32+  D0BB C5                       push    bc
 33+  D0BC D5                       push    de
 34+  D0BD
 35+  D0BD                          ; Если файл с новым именем уже существует, удалить его.
 36+  D0BD EB                       ex      de, hl                  ; hl = новое, de = старое
 37+  D0BE CD AC CF                 call    fileFind
 38+  D0C1 D4 86 D0                 call nc,deleteFileInt
 39+  D0C4
 40+  D0C4                          ; Повторно найти исходный файл: предыдущий поиск мог вытеснить
 41+  D0C4                          ; его сектор и сделать v_cachedDescrPtr недействительным.
 42+  D0C4 EB                       ex      de, hl                  ; hl = старое, de = новое
 43+  D0C5 CD AC CF                 call    fileFind
 44+  D0C8 DA FD CE                 jp c,   popDBH_ret
 45+  D0CB
 46+  D0CB                          ; hl = новое имя, de = актуальный дескриптор исходного файла.
 47+  D0CB 2A 08 D3                 ld      hl, (v_cachedDescrPtr)
 48+  D0CE EB                       ex      de, hl
 49+  D0CF
 50+  D0CF 0E 0B                    ld      c, FILE_NAME_LENGTH + 3
 51+  D0D1              fileRenameCopyName:
 52+  D0D1 7E                       ld      a, (hl)
 53+  D0D2 12                       ld      (de), a
 54+  D0D3 23                       inc     hl
 55+  D0D4 13                       inc     de
 56+  D0D5 0D                       dec     c
 57+  D0D6 C2 D1 D0                 jp nz,  fileRenameCopyName
 58+  D0D9
 59+  D0D9 CD 6E CD                 call    markDirSectorAsModified
 60+  D0DC CD 3C CD                 call    saveSectorCache
 61+  D0DF B7                       or      a
 62+  D0E0 C3 FD CE                 jp      popDBH_ret
119   D0E3                  INCLUDE "fileGetSetAttr.inc"
  1+  D0E3              ;+---------------------------------------------------------------------------
  2+  D0E3              ; MXOS
  3+  D0E3              ; Получение/изменение атрибутов файла
  4+  D0E3              ;
  5+  D0E3              ; На входе
  6+  D0E3              ;   hl - имя файла
  7+  D0E3              ;   с  - 0=чтение, 1=изменение
  8+  D0E3              ;   b  - новые атрибуты (если c==1)
  9+  D0E3              ;
 10+  D0E3              ; На выходе
 11+  D0E3              ;   cf - ошибка
 12+  D0E3              ;   a  - атрибуты
 13+  D0E3              ;   bc, de, hl - сохраняются
 14+  D0E3              ;
 15+  D0E3              ; 2013-12-12 Дизассемблировано vinxru
 16+  D0E3              ; 2022-01-31 Доработано SpaceEngineer
 17+  D0E3              ;----------------------------------------------------------------------------
 18+  D0E3
 19+  D0E3              fileGetSetAttr:
 20+  D0E3 C5                       push    bc
 21+  D0E4 47                       ld      b, a
 22+  D0E5
 23+  D0E5                          ; Ищем файл с именем в hl. Если найден, то переходим
 24+  D0E5 CD AC CF                 call    fileFind
 25+  D0E8 D2 ED D0                 jp nc,  fileGetSetAt_0
 26+  D0EB
 27+  D0EB                          ; Ошибка, выходим
 28+  D0EB C1                       pop     bc
 29+  D0EC C9                       ret
 30+  D0ED
 31+  D0ED              ; ---------------------------------------------------------------------------
 32+  D0ED
 33+  D0ED              fileGetSetAt_0:
 34+  D0ED E5                       push    hl
 35+  D0EE
 36+  D0EE                          ; Получаем адрес байта атрибутов
 37+  D0EE D5                       push    de
 38+  D0EF 2A 08 D3                 ld      hl, (v_cachedDescrPtr)
 39+  D0F2 11 0B 00                 ld      de, FILE_DESCRIPTOR.attrib
 40+  D0F5 19                       add     hl, de
 41+  D0F6 D1                       pop     de
 42+  D0F7
 43+  D0F7                          ; Проверяем режим
 44+  D0F7 79                       ld      a, c
 45+  D0F8 0D                       dec     c ; ZF=1 если режим 1
 46+  D0F9 C2 03 D1                 jp nz,  fileGetSetAt_1
 47+  D0FC
 48+  D0FC                          ; Устанавливаем атрибуты
 49+  D0FC 70                       ld      (hl), b
 50+  D0FD
 51+  D0FD                          ; Ставим сектору каталога флаг isModified
 52+  D0FD CD 6E CD                 call    markDirSectorAsModified
 53+  D100
 54+  D100                          ; Сохраняем изменения на диск
 55+  D100 CD 3C CD                 call    saveSectorCache
 56+  D103
 57+  D103              fileGetSetAt_1:
 58+  D103                          ; Читаем атрибуты
 59+  D103 7E                       ld      a, (hl)
 60+  D104
 61+  D104                          ; Восстанавливаем регистры и выходим ;! А тут точно CF==0 будет?
 62+  D104 B7                       or      a
 63+  D105 E1                       pop     hl
 64+  D106 C1                       pop     bc
 65+  D107 C9                       ret
 66+  D108
120   D108                  INCLUDE "fileGetSetAddr.inc"
  1+  D108              ;+---------------------------------------------------------------------------
  2+  D108              ; MXOS
  3+  D108              ; Получение/изменение адреса загрузки файла
  4+  D108              ;
  5+  D108              ; На входе
  6+  D108              ;   hl - имя файла
  7+  D108              ;   с  - 0=чтение, 1=изменение
  8+  D108              ;   de - адрес
  9+  D108              ;
 10+  D108              ; На выходе
 11+  D108              ;   de - адрес
 12+  D108              ;   bc, hl - сохраняются
 13+  D108              ;
 14+  D108              ; 2013-12-12 Дизассемблировано vinxru
 15+  D108              ; 2022-01-31 Доработано SpaceEngineer
 16+  D108              ;----------------------------------------------------------------------------
 17+  D108
 18+  D108              fileGetSetAddr:   ; Ищем файл с именем в hl
 19+  D108 CD AC CF                 call    fileFind
 20+  D10B D8                       ret c
 21+  D10C
 22+  D10C E5                       push    hl
 23+  D10D
 24+  D10D                          ; Получаем адрес длины файла
 25+  D10D D5                       push    de
 26+  D10E 2A 08 D3                 ld      hl, (v_cachedDescrPtr)
 27+  D111 11 12 00                 ld      de, FILE_DESCRIPTOR.loadAddress
 28+  D114 19                       add     hl, de
 29+  D115 D1                       pop     de
 30+  D116
 31+  D116                          ; Проверяем режим
 32+  D116 79                       ld      a, c
 33+  D117 0D                       dec     c ; ZF=1 если режим 1
 34+  D118 C2 27 D1                 jp nz,  fileGetSetAd_0
 35+  D11B
 36+  D11B                          ; Заменяем адрес загрузки
 37+  D11B 73                       ld      (hl), e
 38+  D11C 23                       inc     hl
 39+  D11D 72                       ld      (hl), d
 40+  D11E
 41+  D11E                          ; Ставим сектору каталога флаг isModified
 42+  D11E CD 6E CD                 call    markDirSectorAsModified
 43+  D121
 44+  D121                          ; Сохраняем изменения на диск
 45+  D121 CD 3C CD                 call    saveSectorCache
 46+  D124
 47+  D124                          ; Выходим
 48+  D124 E1                       pop     hl
 49+  D125 B7                       or      a
 50+  D126 C9                       ret
 51+  D127
 52+  D127              fileGetSetAd_0:
 53+  D127                          ; Читаем адрес загрузки
 54+  D127 5E                       ld      e, (hl)
 55+  D128 23                       inc     hl
 56+  D129 56                       ld      d, (hl)
 57+  D12A
 58+  D12A                          ; Выходим
 59+  D12A E1                       pop     hl
 60+  D12B B7                       or      a
 61+  D12C C9                       ret
 62+  D12D
121   D12D                  INCLUDE "fileGetInfoAddr.inc"
  1+  D12D              ;+---------------------------------------------------------------------------
  2+  D12D              ; MXOS
  3+  D12D              ; Получить указатель на информацию о a==1
  4+  D12D              ;
  5+  D12D              ; На входе
  6+  D12D              ;   c - любое число
  7+  D12D              ;
  8+  D12D              ; На выходе
  9+  D12D              ;   b, de - сохраняются
 10+  D12D              ;   hl - указатель на дескриптор после расширения
 11+  D12D              ;   zf - если a==1
 12+  D12D              ;   a = c
 13+  D12D              ;   c = c-1
 14+  D12D              ;
 15+  D12D              ; 2013-12-12 Дизассемблировано vinxru
 16+  D12D              ;----------------------------------------------------------------------------
 17+  D12D
 18+  D12D              ;fileGetInfoAddr:
 19+  D12D              ;            push de
 20+  D12D              ;
 21+  D12D              ;            ; Помещаем в hl адрес информации о файле
 22+  D12D              ;            ld    hl, (v_foundDescrPtr)
 23+  D12D              ;            ld    de, FILE_DESCRIPTOR.attrib
 24+  D12D              ;            add   scf
 25+  D12D              ;
 26+  D12D              ;            ; Помещаем в a режим
 27+  D12D              ;            ld    a, c
 28+  D12D              ;
 29+  D12D              ;            ; ZF=1 если режим 1
 30+  D12D              ;            dec c
 31+  D12D              ;
 32+  D12D              ;            pop de
 33+  D12D              ;            ret
 34+  D12D              ;
 35+  D12D
122   D12D                  INCLUDE "fileList.inc"
  1+  D12D              ;+---------------------------------------------------------------------------
  2+  D12D              ; MXOS
  3+  D12D              ; Получить список файлов каталога.
  4+  D12D              ; Функция копирует в буфер уомпактные описатели файлов (FILE_INFO).
  5+  D12D              ;
  6+  D12D              ; На входе
  7+  D12D              ;  hl - адрес буфера
  8+  D12D              ;  de - размер буфера (макс. количество описателей файлов)
  9+  D12D              ;  bc - с какого дескриптора начинать заполнение буфера
 10+  D12D              ;
 11+  D12D              ; На выходе
 12+  D12D              ;  de - сколько всего дескрипторов в каталоге
 13+  D12D              ;
 14+  D12D              ;  bc, hl - сохраняются
 15+  D12D              ;
 16+  D12D              ; 2013-12-12 Дизассемблировано vinxru
 17+  D12D              ; 2022-02-11 Переработано SpaceEngineer
 18+  D12D              ;----------------------------------------------------------------------------
 19+  D12D
 20+  D12D              fileList:   ; Если нет драйвера или диск не отформатирован -
 21+  D12D                          ; формируем пустой список и выходим
 22+  D12D 3A 50 D3                 ld      a, (v_diskInfo.isValid)
 23+  D130 FE 02                    cp      DISK_VALID
 24+  D132 CA 3B D1                 jp z,   fileListOk
 25+  D135
 26+  D135                          ; В начало буфера помещаем символ 0FFh
 27+  D135 36 FF                    ld      (hl), 0FFh
 28+  D137
 29+  D137                          ; Возвращаем количество файлов в директории в de (ноль)
 30+  D137 11 00 00                 ld      de, 0
 31+  D13A C9                       ret
 32+  D13B
 33+  D13B              fileListOk: ; Сохранение регистров
 34+  D13B C5                       push    bc  ; [1]
 35+  D13C E5                       push    hl  ; [2]
 36+  D13D
 37+  D13D                          ; В de - максимум файлов, но его надо еще ограничить размером каталога
 38+  D13D 2A 3A D3                 ld      hl, (v_diskInfo.rootDirMaxFiles)
 39+  D140 CD 89 C3                 call    cmp_hl_de_2
 40+  D143 DA 47 D1                 jp c,   fl_min
 41+  D146 EB                       ex      hl, de
 42+  D147              fl_min:     ; Сохраняем максимум файлов
 43+  D147 22 16 D3                 ld      (v_dirMaxFiles), hl
 44+  D14A
 45+  D14A                          ; Сохраняем номер первого файла
 46+  D14A 60                       ld      h, b
 47+  D14B 69                       ld      l, c
 48+  D14C 22 14 D3                 ld      (v_dirFirstFile), hl
 49+  D14F
 50+  D14F                          ; Обнуляем счетчики файлов
 51+  D14F 21 00 00                 ld      hl, 0
 52+  D152 22 18 D3                 ld      (v_dirListedFiles), hl
 53+  D155 22 1A D3                 ld      (v_dirTotalFiles),  hl
 54+  D158
 55+  D158 E1                       pop     hl  ; [2]
 56+  D159 E5                       push    hl  ; [2]
 57+  D15A
 58+  D15A                          ; de = номер первого сектора каталога
 59+  D15A                          ; с  = количество секторов каталога (мл. байт)
 60+  D15A CD 64 CD                 call    fatBeginDirLoop
 61+  D15D
 62+  D15D                          ; Цикл по секторам каталога
 63+  D15D              fileList_dirLoop:
 64+  D15D                          ; Сохраняем номер сектора каталога
 65+  D15D D5                       push    de  ; [3]               ; de = номер сектора каталога
 66+  D15E
 67+  D15E                          ; Кэшируем сектор каталога
 68+  D15E E5                       push    hl  ; [4]
 69+  D15F AF                       xor     a                       ; флаг - сектор не будет меняться
 70+  D160 CD 86 CC                 call    getSectorAddressInCache ; выход: hl = адрес сектора в буфере
 71+  D163 EB                       ex      hl, de                  ; de = адрес сектора в буфере
 72+  D164 E1                       pop     hl  ; [4]
 73+  D165
 74+  D165                          ; Кол-во дескрипторов файлов в одном секторе каталога (мл. байт)
 75+  D165 3A 3C D3                 ld      a, (v_diskInfo.descrPerSector)
 76+  D168 47                       ld      b, a
 77+  D169
 78+  D169                          ; Цикл по дескрипторам в закешированном секторе каталога
 79+  D169              fileList_sectorLoop:
 80+  D169                          ; Если первый символ = FFh, дескриптор пустой
 81+  D169 1A                       ld      a, (de)
 82+  D16A 3C                       inc     a
 83+  D16B CA 9E D1                 jp z,   fileList_nextDescr
 84+  D16E
 85+  D16E E5                       push    hl  ; [4]
 86+  D16F D5                       push    de  ; [5]
 87+  D170
 88+  D170                          ; Увеличиваем счетчик общего количества файлов в каталоге
 89+  D170 2A 1A D3                 ld      hl, (v_dirTotalFiles)
 90+  D173 23                       inc     hl
 91+  D174 22 1A D3                 ld      (v_dirTotalFiles), hl
 92+  D177
 93+  D177                          ; Если не дошли до первого файла (v_dirTotalFiles < v_dirFirstFile),
 94+  D177                          ; то продолжаем сканирование каталога без копирования дескриптора в буфер
 95+  D177 EB                       ex      hl, de
 96+  D178 2A 14 D3                 ld      hl, (v_dirFirstFile)
 97+  D17B CD 27 C4                 call    cmp_hl_de
 98+  D17E D2 9C D1                 jp nc,  fileList_skipCopy
 99+  D181
100+  D181                          ; Если буфер уже заполнен (v_dirListedFiles >= v_dirMaxFiles),
101+  D181                          ; то продолжаем сканирование каталога без копирования дескриптора в буфер
102+  D181 2A 16 D3                 ld      hl, (v_dirMaxFiles)
103+  D184 EB                       ex      hl, de
104+  D185 2A 18 D3                 ld      hl, (v_dirListedFiles)
105+  D188 CD 27 C4                 call    cmp_hl_de
106+  D18B D2 9C D1                 jp nc,  fileList_skipCopy
107+  D18E
108+  D18E                          ; Увеличиваем счетчик скопированных дескрипторов
109+  D18E 23                       inc     hl
110+  D18F 22 18 D3                 ld      (v_dirListedFiles), hl
111+  D192
112+  D192 D1                       pop     de  ; [5]
113+  D193 E1                       pop     hl  ; [4]
114+  D194
115+  D194                          ; Копируем дескриптор из de в hl
116+  D194 C5                       push    bc  ; [4]
117+  D195                          ;call    copyDescriptor
118+  D195 CD 2B D2                 call    copyDescriptorCompact
119+  D198 C1                       pop     bc  ; [4]
120+  D199
121+  D199                          ; copyDescriptor смещает de, поэтому код расчета
122+  D199                          ; адреса следующего дескриптора надо перепрыгнуть
123+  D199                          ;jp      fileList_next
124+  D199 C3 9E D1                 jp      fileList_nextDescr
125+  D19C
126+  D19C              fileList_skipCopy:
127+  D19C D1                       pop     de  ; [5]
128+  D19D E1                       pop     hl  ; [4]
129+  D19E
130+  D19E              fileList_nextDescr:
131+  D19E                          ; Вычисляем адрес следующего дескриптора
132+  D19E E5                       push    hl  ; [4]
133+  D19F 21 20 00                 ld      hl, FILE_DESCR_SIZE
134+  D1A2 19                       add     hl, de
135+  D1A3 EB                       ex      de, hl
136+  D1A4 E1                       pop     hl  ; [4]
137+  D1A5
138+  D1A5              fileList_next:
139+  D1A5                          ; Еще остались файлы в секторе каталога?
140+  D1A5 05                       dec     b
141+  D1A6 C2 69 D1                 jp nz,  fileList_sectorLoop
142+  D1A9
143+  D1A9                          ; Еще остались секторы каталога?
144+  D1A9                          ; Восстанавливаем номер сектора каталога
145+  D1A9 D1                       pop     de  ; [3]   de = номер сектора каталога
146+  D1AA 13                       inc     de  ;       следующий сектор каталога
147+  D1AB 0D                       dec     c
148+  D1AC C2 5D D1                 jp nz,  fileList_dirLoop
149+  D1AF
150+  D1AF              fileList_exit
151+  D1AF                          ; Завершение и выход
152+  D1AF                          ; В конец буфера помещаем символ 0FFh
153+  D1AF 36 FF                    ld      (hl), 0FFh
154+  D1B1
155+  D1B1                          ; Возвращаем количество файлов в директории в de
156+  D1B1 2A 1A D3                 ld      hl, (v_dirTotalFiles)
157+  D1B4 EB                       ex      hl, de
158+  D1B5
159+  D1B5 E1                       pop     hl  ; [2]
160+  D1B6 C1                       pop     bc  ; [1]
161+  D1B7 C9                       ret
162+  D1B8
123   D1B8                  INCLUDE "fileNamePrepare.inc"
  1+  D1B8              ;+---------------------------------------------------------------------------
  2+  D1B8              ; MXOS
  3+  D1B8              ; Подготовить имя файла для функций ОС
  4+  D1B8              ;
  5+  D1B8              ; На входе
  6+  D1B8              ;  hl - исходное имя
  7+  D1B8              ;  de - буфер для результата (P_INPUT_WIDTH + 3 байт)
  8+  D1B8              ;
  9+  D1B8              ; 2013-12-12 Дизассемблировано vinxru
 10+  D1B8              ;----------------------------------------------------------------------------
 11+  D1B8
 12+  D1B8              fileNamePrepare:
 13+  D1B8                          ; Сохраняем регистры
 14+  D1B8 C5                       push    bc
 15+  D1B9 D5                       push    de
 16+  D1BA
 17+  D1BA                          ; Если второй символ исходной строки ':', то меняем диск
 18+  D1BA 23                       inc     hl
 19+  D1BB 7E                       ld      a, (hl)
 20+  D1BC FE 3A                    cp      ':'
 21+  D1BE 2B                       dec     hl
 22+  D1BF C2 CC D1                 jp nz,  fileNamePr_1
 23+  D1C2
 24+  D1C2                          ; Меняем диск
 25+  D1C2 7E                       ld      a, (hl)
 26+  D1C3 D6 41                    sub     'A'
 27+  D1C5 E5                       push    hl
 28+  D1C6 CD CB CB                 call    fileSelectDrive
 29+  D1C9 E1                       pop     hl
 30+  D1CA
 31+  D1CA                          ; Диск не входит в имя файла
 32+  D1CA 23                       inc     hl
 33+  D1CB 23                       inc     hl
 34+  D1CC
 35+  D1CC              fileNamePr_1:
 36+  D1CC                          ; b = длина имени, c = 3 - длина расширения
 37+  D1CC 01 03 08                 ld      bc, (FILE_NAME_LENGTH << 8) + 3
 38+  D1CF
 39+  D1CF                          ; Копируем текст до точки, пробела или конца строки, не более FILE_NAME_LENGTH символов.
 40+  D1CF              fileNamePr_2:
 41+  D1CF 7E                       ld      a, (hl)
 42+  D1D0 A7                       and     a
 43+  D1D1 F2 D6 D1                 jp p,   fileNamePr_3
 44+  D1D4 D6 40                    sub     40h         ; проеобразование KOI?
 45+  D1D6              fileNamePr_3:
 46+  D1D6 FE 21                    cp      ' '+1
 47+  D1D8 DA F6 D1                 jp c,   fileNamePr_5
 48+  D1DB 23                       inc     hl
 49+  D1DC FE 2E                    cp      '.'
 50+  D1DE CA F6 D1                 jp z,   fileNamePr_5
 51+  D1E1 12                       ld      (de), a
 52+  D1E2 13                       inc     de
 53+  D1E3 05                       dec     b
 54+  D1E4 C2 CF D1                 jp nz,  fileNamePr_2
 55+  D1E7
 56+  D1E7                          ; Пропускаем текст до точки, пробела или конца строки
 57+  D1E7              fileNamePr_4:
 58+  D1E7 7E                       ld      a, (hl)
 59+  D1E8 FE 21                    cp      ' '+1
 60+  D1EA DA F9 D1                 jp c,   fileNamePr_6
 61+  D1ED 23                       inc     hl
 62+  D1EE FE 2E                    cp      '.'
 63+  D1F0 C2 E7 D1                 jp nz,  fileNamePr_4
 64+  D1F3 C3 F9 D1                 jp      fileNamePr_6
 65+  D1F6
 66+  D1F6              ; ---------------------------------------------------------------------------
 67+  D1F6
 68+  D1F6              fileNamePr_5:
 69+  D1F6                          ; Имя короче FILE_NAME_LENGTH символов
 70+  D1F6                          ; Заполняем недостающие символы имени пробелами
 71+  D1F6 CD C7 C3                 call    memset_de_20_b
 72+  D1F9
 73+  D1F9                          ; Копируем текст до пробела или конца строки, не более 3 символов.
 74+  D1F9              fileNamePr_6:
 75+  D1F9 7E                       ld      a, (hl)
 76+  D1FA A7                       and     a
 77+  D1FB F2 00 D2                 jp p,   fileNamePr_7
 78+  D1FE D6 40                    sub     40h         ; проеобразование KOI?
 79+  D200              fileNamePr_7:
 80+  D200 FE 21                    cp      ' '+1
 81+  D202 DA 19 D2                 jp c,   fileNamePr_11
 82+  D205 12                       ld      (de),a
 83+  D206 23                       inc     hl
 84+  D207 13                       inc     de
 85+  D208 0D                       dec     c
 86+  D209 C2 F9 D1                 jp nz,  fileNamePr_6
 87+  D20C
 88+  D20C              fileNamePr_8:
 89+  D20C                          ; Пропускаем текст до пробела или конца строки
 90+  D20C 7E                       ld      a, (hl)
 91+  D20D FE 20                    cp      ' '
 92+  D20F DA 16 D2                 jp c,   fileNamePr_10
 93+  D212 23                       inc     hl
 94+  D213 C2 0C D2                 jp nz,  fileNamePr_8
 95+  D216
 96+  D216              ;fileNamePr_9:
 97+  D216              ;            ; Пропускаем текст до пробела или конца строки
 98+  D216              ;            ; Почему то дублируется код
 99+  D216              ;            ld      a, (hl)
100+  D216              ;            cp      ' '
101+  D216              ;            jp c,   fileNamePr_10
102+  D216              ;            inc     hl
103+  D216              ;            jp z,   fileNamePr_9
104+  D216              ;            dec     hl
105+  D216
106+  D216              fileNamePr_10:    ; Восстанавливаем регистры и выходим
107+  D216 D1                       pop     de
108+  D217 C1                       pop     bc
109+  D218 C9                       ret
110+  D219
111+  D219              ; ---------------------------------------------------------------------------
112+  D219
113+  D219              fileNamePr_11:
114+  D219                          ; Заполняем недостающие символы расширения пробелами
115+  D219 41                       ld      b, c
116+  D21A CD C7 C3                 call    memset_de_20_b
117+  D21D
118+  D21D                          ; Восстанавливаем регистры и выходим
119+  D21D D1                       pop     de
120+  D21E C1                       pop     bc
121+  D21F C9                       ret
