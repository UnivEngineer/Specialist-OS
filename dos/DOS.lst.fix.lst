101   C981                  INCLUDE "reboot3.inc"
  1+  C981              ;+---------------------------------------------------------------------------
  2+  C981              ; MXOS
  3+  C981              ; Обновление драйвера по адресу 0FFC0h и запуск NC.COM,
  4+  C981              ; а также однократный запуск AUTOEXEC.BAT, если не нажата клавиша.
  5+  C981              ;
  6+  C981              ; 2013-12-12 Дизассемблировано vinxru
  7+  C981              ;----------------------------------------------------------------------------
  8+  C981
  9+  C981              reboot3:    ; Инициализация стека
 10+  C981 31 C0 FF                 ld      sp, STACK_ADDR
 11+  C984
 12+  C984                          ; Устанавливаем блочный драйвер
 13+  C984 06 00                    ld      b, 0
 14+  C986 CD 9C CA                 call    setRAMDDriver
 15+  C989
 16+  C989                          ; Обновляем переменные
 17+  C989 21 00 C8                 ld      hl, j_reboot3
 18+  C98C 22 E1 8F                 ld      (bios_vars.tapeError), hl
 19+  C98F
 20+  C98F              reboot3_0:
 21+  C98F C3 92 C9                 jp      reboot3_1
 22+  C992
 23+  C992              ; -------------------------------------
 24+  C992              ; Код ниже будет выполнен лишь один раз после холодной перезагрузки.
 25+  C992              ; То есть при теплой перезагрузке он не вызывается.
 26+  C992
 27+  C992              reboot3_1:
 28+  C992                          ; Патчим предыдущую инструкцию - теперь она стала jp reboot3_2
 29+  C992 21 C9 C9                 ld      hl, reboot3_2
 30+  C995 22 90 C9                 ld      (reboot3_0+1), hl
 31+  C998
 32+  C998                          ; Устанавливаем побайтовый драйвер
 33+  C998 06 01                    ld      b, 1
 34+  C99A CD 9C CA                 call    setRAMDDriver
 35+  C99D
 36+  C99D                          ; Если в рам-диске по адресу 0FF00h (последний неполный сектор)
 37+  C99D                          ; нет специальной метки, значит, не запускали форматирование
 38+  C99D 21 BF FF                 ld      hl, 0FFBFh      ; адрес в странице
 39+  C9A0 AF                       xor     a               ; 0 страница
 40+  C9A1 CD C0 FF                 call    bios_RAMDRead
 41+  C9A4 79                       ld      a, c            ; считанный байт в c
 42+  C9A5 FE 5A                    cp      5Ah
 43+  C9A7 CA BB C9                 jp z,   skipFormat      ; метка есть - пропускаем форматирование
 44+  C9AA
 45+  C9AA                          ; Записываем метку
 46+  C9AA AF                       xor     a               ; 0 страница
 47+  C9AB 0E 5A                    ld      c, 5Ah          ; записываемый байт
 48+  C9AD CD D0 FF                 call    bios_RAMDWrite
 49+  C9B0
 50+  C9B0                          ; Устанавливаем блочный драйвер
 51+  C9B0 06 00                    ld      b, 0
 52+  C9B2 CD 9C CA                 call    setRAMDDriver
 53+  C9B5
 54+  C9B5                          ; Запуск файла "A:FORMAT.BAT"
 55+  C9B5 21 74 D3                 ld      hl, pathFormatBat
 56+  C9B8 CD 2B CA                 call    fileExec
 57+  C9BB
 58+  C9BB              skipFormat:
 59+  C9BB                          ; Если нажата клавиша, пропустить запуск A:AUTOEX.BAT
 60+  C9BB 3A E1 FF                 ld      a, (IO_KEYB_B)
 61+  C9BE E6 02                    and     2
 62+  C9C0 CA C9 C9                 jp z,   reboot3_2
 63+  C9C3
 64+  C9C3                          ; Запуск файла A:AUTOEXEC.BAT
 65+  C9C3 21 65 D3                 ld      hl, pathAutoexecBat
 66+  C9C6 CD 2B CA                 call    fileExec
 67+  C9C9
 68+  C9C9              ; -------------------------------------
 69+  C9C9
 70+  C9C9              reboot3_2:
 71+  C9C9                          ; Запуск файла A:NC.COM
 72+  C9C9 21 5C D3                 ld      hl, pathNcCom
 73+  C9CC CD 2B CA                 call    fileExec
 74+  C9CF
 75+  C9CF                          ; Теплая перезагрузка
 76+  C9CF C3 00 C8                 jp      j_reboot3
