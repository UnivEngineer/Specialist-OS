103   CA2B                  INCLUDE "fileExec.inc"
  1+  CA2B              ;+---------------------------------------------------------------------------
  2+  CA2B              ; MXOS
  3+  CA2B              ; Запустить файл
  4+  CA2B              ;
  5+  CA2B              ; На входе
  6+  CA2B              ;  hl - ком строка в формате [Диск:]файл[ аргументы]
  7+  CA2B              ;
  8+  CA2B              ; На выходе
  9+  CA2B              ;  сf - ошибка
 10+  CA2B              ;
 11+  CA2B              ; 2013-12-12 Дизассемблировано vinxru
 12+  CA2B              ;----------------------------------------------------------------------------
 13+  CA2B
 14+  CA2B              fileExec:   ; Сюда будем записывать результат
 15+  CA2B 11 00 FF                 ld      de, CMD_LINE
 16+  CA2E
 17+  CA2E                          ; Если первый символ меньше пробела, выходим c CF
 18+  CA2E 7E                       ld      a, (hl)
 19+  CA2F FE 20                    cp      ' '
 20+  CA31 DA 95 CA                 jp      c, stc_ret
 21+  CA34
 22+  CA34                          ; Максимальный размер ком строки (+2 терминатора, итого 82h)
 23+  CA34 0E 80                    ld      c, 80h
