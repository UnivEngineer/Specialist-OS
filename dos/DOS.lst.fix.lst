 55+  CA55 11 DF D3                 ld      de, v_curFileDescr
 56+  CA58 CD B8 D1                 call    fileNamePrepare
 57+  CA5B
 58+  CA5B                          ; Запоминаем в стеке текущий адрес командной строки (начало списка аргументов)
 59+  CA5B E5                       push    hl
 60+  CA5C
 61+  CA5C                          ; Если это BAT файл
