 44+  C582                          ; Продолжаем загрузку системы
 45+  C582 C3 00 C8                 jp      j_reboot3
 46+  C585
 47+  C585                      ELSE
 48+  C585 ~
 49+  C585 ~                        ; Если не нажата ни одна клавиша, продолжаем загрузку системы
