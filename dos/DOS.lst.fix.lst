 17+  CFAC              fileFind:   ; Сохраняем регистры
 18+  CFAC C5                       push    bc  ; [1]
 19+  CFAD D5                       push    de  ; [2]
 20+  CFAE
 21+  CFAE                          ; de = номер первого сектора каталога
 22+  CFAE                          ; с  = количество секторов каталога (мл. байт)
 23+  CFAE CD 64 CD                 call    fatBeginDirLoop
