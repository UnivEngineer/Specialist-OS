 48+  CA4C
 49+  CA4C                          ; Выводим на экран имя файла
 50+  CA4C 21 00 FF                 ld      hl, CMD_LINE
 51+  CA4F CD 18 C8                 call    j_printString
 52+  CA52
 53+  CA52                          ; Подготовка имени файла
