120+  D019
121+  D019              ; ---------------------------------------------------------------------------
122+  D019              ; Получить информацию о файле (дескриптор)
123+  D019              ;
124+  D019              ; На входе
125+  D019              ;  hl - имя
126+  D019              ;
127+  D019              ; На выходе
128+  D019              ;  bc, de, hl - сохраняются
129+  D019              ;  v_foundDescrPtr - адрес копии дескриптора найденного файла
130+  D019              ;  cf - ошибка
131+  D019              ;----------------------------------------------------------------------------
132+  D019
133+  D019              fileLoadInfo:
134+  D019                          ; Ищем файл с именем в hl
135+  D019 CD 73 CF                 call    fileFind
136+  D01C D8                       ret c
137+  D01D
138+  D01D              ; ---------------------------------------------------------------------------
139+  D01D
140+  D01D              fileLoadExit:
141+  D01D                          ; Сохраняем регистры
142+  D01D E5                       push    hl
143+  D01E C5                       push    bc
144+  D01F D5                       push    de
145+  D020
146+  D020                          ; de = указатель на первое поле после расширения
147+  D020 01 0B 00                 ld      bc, FILE_DESCRIPTOR.attrib
148+  D023 09                       add     hl, bc
149+  D024 EB                       ex      de, hl
150+  D025
151+  D025                          ; Информация о файле, исключая имя
152+  D025 2A CB D2                 ld      hl, (v_foundDescrPtr)
153+  D028 09                       add     hl, bc
154+  D029
155+  D029                          ; Копируем дескриптор из hl в de, исключая имя и расширение
156+  D029 06 15                    ld      b, FILE_DESCR_SIZE - FILE_NAME_LENGTH - 3
157+  D02B              fileLoadCDLoop:
158+  D02B 7E                       ld      a, (hl)
159+  D02C 12                       ld      (de), a
160+  D02D 23                       inc     hl
161+  D02E 13                       inc     de
162+  D02F 05                       dec     b
163+  D030 C2 2B D0                 jp nz,  fileLoadCDLoop
164+  D033
165+  D033                          ; Выход CF=0
166+  D033 B7                       or      a
167+  D034 C3 E6 CE                 jp      popDBH_ret
168+  D037
117   D037                  INCLUDE "fileDelete.inc"
  1+  D037              ;+---------------------------------------------------------------------------
  2+  D037              ; MXOS
  3+  D037              ; Удаление файла
  4+  D037              ;
  5+  D037              ; На входе
  6+  D037              ;  hl - имя файла
  7+  D037              ;
  8+  D037              ; На выходе
  9+  D037              ;  cf - ошибка
 10+  D037              ;  bc, de, hl - сохраняются
 11+  D037              ;
 12+  D037              ; 2013-12-12 Дизассемблировано vinxru
 13+  D037              ; 2022-02-11 Переработано SpaceEngineer
 14+  D037              ;----------------------------------------------------------------------------
 15+  D037
 16+  D037              fileDelete: ; Найти файл с именем из hl
 17+  D037 CD 73 CF                 call    fileFind
 18+  D03A D8                       ret     c
 19+  D03B
 20+  D03B                          ; Удалить файл
 21+  D03B CD 43 D0                 call    deleteFileInt
 22+  D03E
 23+  D03E                          ; Сохранить изменения на диск
 24+  D03E CD 36 CD                 call    saveSectorCache
 25+  D041
 26+  D041                          ; Результат
 27+  D041 B7                       or      a
 28+  D042 C9                       ret
 29+  D043
 30+  D043              ; ---------------------------------------------------------------------------
 31+  D043
 32+  D043              deleteFileInt:
 33+  D043                          ; Сохраняем регистры
 34+  D043 E5                       push    hl
 35+  D044 C5                       push    bc
 36+  D045 D5                       push    de
 37+  D046
 38+  D046                          ; Помечаем файл в кэше, как удаленный, заменяя первую букву его имени на 0FFh
 39+  D046 2A C5 D2                 ld      hl, (v_cachedDescrPtr)
 40+  D049 36 FF                    ld      (hl), 0FFh
 41+  D04B E5                       push    hl
 42+  D04C
 43+  D04C                          ; Ставим сектору каталога флаг isModified
 44+  D04C CD 68 CD                 call    markDirSectorAsModified
 45+  D04F
 46+  D04F                          ; Получаем первый кластер файла в de
 47+  D04F E1                       pop     hl
 48+  D050 11 1A 00                 ld      de, FILE_DESCRIPTOR.firstCluster
 49+  D053 19                       add     hl, de
 50+  D054 5E                       ld      e, (hl)
 51+  D055 23                       inc     hl
 52+  D056 56                       ld      d, (hl)
 53+  D057
 54+  D057              deleteFileLoop:
 55+  D057 62                       ld      h, d
 56+  D058 6B                       ld      l, e
 57+  D059
 58+  D059                          ; Обнуляем кластер номер de и получаем номер
 59+  D059                          ; следующиего кластера файла в de
 60+  D059 CD D2 CD                 call    fatFreeCluster
 61+  D05C
 62+  D05C                          ; Если это был не последний кластер, продолжаем.
 63+  D05C 7A                       ld      a, d
 64+  D05D BC                       cp      h
 65+  D05E C2 57 D0                 jp nz,  deleteFileLoop
 66+  D061 7B                       ld      a, e
 67+  D062 BD                       cp      l
 68+  D063 C2 57 D0                 jp nz,  deleteFileLoop
 69+  D066
 70+  D066                          ; Восстаналиваем регистры и выходим
 71+  D066 C3 E6 CE                 jp      popDBH_ret
 72+  D069
118   D069                  INCLUDE "fileRename.inc"
  1+  D069              ;+---------------------------------------------------------------------------
  2+  D069              ; MXOS
  3+  D069              ; Переименовать файл в пределах текущего диска.
  4+  D069              ;
  5+  D069              ; Вход:
  6+  D069              ;   hl - старое имя;
  7+  D069              ;   de - новое имя.
  8+  D069              ; Выход:
  9+  D069              ;   CF - ошибка;
 10+  D069              ;   bc, de, hl разрушаются.
 11+  D069              ;
 12+  D069              ; Важно: поиск нового имени может вытеснить сектор исходного дескриптора из
 13+  D069              ; кэша. Поэтому перед записью имени исходный файл ищется повторно.
 14+  D069              ;----------------------------------------------------------------------------
 15+  D069
 16+  D069              fileRename:
 17+  D069                          ; Найти исходный файл.
 18+  D069 CD 73 CF                 call    fileFind
 19+  D06C D8                       ret c
 20+  D06D
 21+  D06D                          ; Переименование в то же имя ничего не меняет.
 22+  D06D E5                       push    hl
 23+  D06E D5                       push    de
 24+  D06F 0E 0B                    ld      c, FILE_NAME_LENGTH + 3
 25+  D071 CD F9 CB                 call    stricmp
 26+  D074 D1                       pop     de
 27+  D075 E1                       pop     hl
 28+  D076 C8                       ret z
 29+  D077
 30+  D077                          ; Сохранить входные регистры для общего выхода popDBH_ret.
 31+  D077 E5                       push    hl
 32+  D078 C5                       push    bc
 33+  D079 D5                       push    de
 34+  D07A
 35+  D07A                          ; Если файл с новым именем уже существует, удалить его.
 36+  D07A EB                       ex      de, hl                  ; hl = новое, de = старое
 37+  D07B CD 73 CF                 call    fileFind
 38+  D07E D4 43 D0                 call nc,deleteFileInt
 39+  D081
 40+  D081                          ; Повторно найти исходный файл: предыдущий поиск мог вытеснить
 41+  D081                          ; его сектор и сделать v_cachedDescrPtr недействительным.
 42+  D081 EB                       ex      de, hl                  ; hl = старое, de = новое
 43+  D082 CD 73 CF                 call    fileFind
 44+  D085 DA E6 CE                 jp c,   popDBH_ret
 45+  D088
 46+  D088                          ; hl = новое имя, de = актуальный дескриптор исходного файла.
 47+  D088 2A C5 D2                 ld      hl, (v_cachedDescrPtr)
 48+  D08B EB                       ex      de, hl
 49+  D08C
 50+  D08C 0E 0B                    ld      c, FILE_NAME_LENGTH + 3
 51+  D08E              fileRenameCopyName:
 52+  D08E 7E                       ld      a, (hl)
 53+  D08F 12                       ld      (de), a
 54+  D090 23                       inc     hl
 55+  D091 13                       inc     de
 56+  D092 0D                       dec     c
 57+  D093 C2 8E D0                 jp nz,  fileRenameCopyName
 58+  D096
 59+  D096 CD 68 CD                 call    markDirSectorAsModified
 60+  D099 CD 36 CD                 call    saveSectorCache
 61+  D09C B7                       or      a
 62+  D09D C3 E6 CE                 jp      popDBH_ret
119   D0A0                  INCLUDE "fileGetSetAttr.inc"
  1+  D0A0              ;+---------------------------------------------------------------------------
  2+  D0A0              ; MXOS
  3+  D0A0              ; Получение/изменение атрибутов файла
  4+  D0A0              ;
  5+  D0A0              ; На входе
  6+  D0A0              ;   hl - имя файла
  7+  D0A0              ;   с  - 0=чтение, 1=изменение
  8+  D0A0              ;   b  - новые атрибуты (если c==1)
  9+  D0A0              ;
 10+  D0A0              ; На выходе
 11+  D0A0              ;   cf - ошибка
 12+  D0A0              ;   a  - атрибуты
 13+  D0A0              ;   bc, de, hl - сохраняются
 14+  D0A0              ;
 15+  D0A0              ; 2013-12-12 Дизассемблировано vinxru
 16+  D0A0              ; 2022-01-31 Доработано SpaceEngineer
 17+  D0A0              ;----------------------------------------------------------------------------
 18+  D0A0
 19+  D0A0              fileGetSetAttr:
 20+  D0A0 C5                       push    bc
 21+  D0A1 47                       ld      b, a
 22+  D0A2
 23+  D0A2                          ; Ищем файл с именем в hl. Если найден, то переходим
 24+  D0A2 CD 73 CF                 call    fileFind
 25+  D0A5 D2 AA D0                 jp nc,  fileGetSetAt_0
 26+  D0A8
 27+  D0A8                          ; Ошибка, выходим
 28+  D0A8 C1                       pop     bc
 29+  D0A9 C9                       ret
 30+  D0AA
 31+  D0AA              ; ---------------------------------------------------------------------------
 32+  D0AA
 33+  D0AA              fileGetSetAt_0:
 34+  D0AA E5                       push    hl
 35+  D0AB
 36+  D0AB                          ; Получаем адрес байта атрибутов
 37+  D0AB D5                       push    de
 38+  D0AC 2A C5 D2                 ld      hl, (v_cachedDescrPtr)
 39+  D0AF 11 0B 00                 ld      de, FILE_DESCRIPTOR.attrib
 40+  D0B2 19                       add     hl, de
 41+  D0B3 D1                       pop     de
 42+  D0B4
 43+  D0B4                          ; Проверяем режим
 44+  D0B4 79                       ld      a, c
 45+  D0B5 0D                       dec     c ; ZF=1 если режим 1
 46+  D0B6 C2 C0 D0                 jp nz,  fileGetSetAt_1
 47+  D0B9
 48+  D0B9                          ; Устанавливаем атрибуты
 49+  D0B9 70                       ld      (hl), b
 50+  D0BA
 51+  D0BA                          ; Ставим сектору каталога флаг isModified
 52+  D0BA CD 68 CD                 call    markDirSectorAsModified
 53+  D0BD
 54+  D0BD                          ; Сохраняем изменения на диск
 55+  D0BD CD 36 CD                 call    saveSectorCache
 56+  D0C0
 57+  D0C0              fileGetSetAt_1:
 58+  D0C0                          ; Читаем атрибуты
 59+  D0C0 7E                       ld      a, (hl)
 60+  D0C1
 61+  D0C1                          ; Восстанавливаем регистры и выходим ;! А тут точно CF==0 будет?
 62+  D0C1 B7                       or      a
 63+  D0C2 E1                       pop     hl
 64+  D0C3 C1                       pop     bc
 65+  D0C4 C9                       ret
 66+  D0C5
120   D0C5                  INCLUDE "fileGetSetAddr.inc"
  1+  D0C5              ;+---------------------------------------------------------------------------
  2+  D0C5              ; MXOS
  3+  D0C5              ; Получение/изменение адреса загрузки файла
  4+  D0C5              ;
  5+  D0C5              ; На входе
  6+  D0C5              ;   hl - имя файла
  7+  D0C5              ;   с  - 0=чтение, 1=изменение
  8+  D0C5              ;   de - адрес
  9+  D0C5              ;
 10+  D0C5              ; На выходе
 11+  D0C5              ;   de - адрес
 12+  D0C5              ;   bc, hl - сохраняются
 13+  D0C5              ;
 14+  D0C5              ; 2013-12-12 Дизассемблировано vinxru
 15+  D0C5              ; 2022-01-31 Доработано SpaceEngineer
 16+  D0C5              ;----------------------------------------------------------------------------
 17+  D0C5
 18+  D0C5              fileGetSetAddr:   ; Ищем файл с именем в hl
 19+  D0C5 CD 73 CF                 call    fileFind
 20+  D0C8 D8                       ret c
 21+  D0C9
 22+  D0C9 E5                       push    hl
 23+  D0CA
 24+  D0CA                          ; Получаем адрес длины файла
 25+  D0CA D5                       push    de
 26+  D0CB 2A C5 D2                 ld      hl, (v_cachedDescrPtr)
 27+  D0CE 11 12 00                 ld      de, FILE_DESCRIPTOR.loadAddress
 28+  D0D1 19                       add     hl, de
 29+  D0D2 D1                       pop     de
 30+  D0D3
 31+  D0D3                          ; Проверяем режим
 32+  D0D3 79                       ld      a, c
 33+  D0D4 0D                       dec     c ; ZF=1 если режим 1
 34+  D0D5 C2 E4 D0                 jp nz,  fileGetSetAd_0
 35+  D0D8
 36+  D0D8                          ; Заменяем адрес загрузки
 37+  D0D8 73                       ld      (hl), e
 38+  D0D9 23                       inc     hl
 39+  D0DA 72                       ld      (hl), d
 40+  D0DB
 41+  D0DB                          ; Ставим сектору каталога флаг isModified
 42+  D0DB CD 68 CD                 call    markDirSectorAsModified
 43+  D0DE
 44+  D0DE                          ; Сохраняем изменения на диск
 45+  D0DE CD 36 CD                 call    saveSectorCache
 46+  D0E1
 47+  D0E1                          ; Выходим
 48+  D0E1 E1                       pop     hl
 49+  D0E2 B7                       or      a
 50+  D0E3 C9                       ret
 51+  D0E4
 52+  D0E4              fileGetSetAd_0:
 53+  D0E4                          ; Читаем адрес загрузки
 54+  D0E4 5E                       ld      e, (hl)
 55+  D0E5 23                       inc     hl
 56+  D0E6 56                       ld      d, (hl)
 57+  D0E7
 58+  D0E7                          ; Выходим
 59+  D0E7 E1                       pop     hl
 60+  D0E8 B7                       or      a
 61+  D0E9 C9                       ret
 62+  D0EA
121   D0EA                  INCLUDE "fileGetInfoAddr.inc"
  1+  D0EA              ;+---------------------------------------------------------------------------
  2+  D0EA              ; MXOS
  3+  D0EA              ; Получить указатель на информацию о a==1
  4+  D0EA              ;
  5+  D0EA              ; На входе
  6+  D0EA              ;   c - любое число
  7+  D0EA              ;
  8+  D0EA              ; На выходе
  9+  D0EA              ;   b, de - сохраняются
 10+  D0EA              ;   hl - указатель на дескриптор после расширения
 11+  D0EA              ;   zf - если a==1
 12+  D0EA              ;   a = c
 13+  D0EA              ;   c = c-1
 14+  D0EA              ;
 15+  D0EA              ; 2013-12-12 Дизассемблировано vinxru
 16+  D0EA              ;----------------------------------------------------------------------------
 17+  D0EA
 18+  D0EA              ;fileGetInfoAddr:
 19+  D0EA              ;            push de
 20+  D0EA              ;
 21+  D0EA              ;            ; Помещаем в hl адрес информации о файле
 22+  D0EA              ;            ld    hl, (v_foundDescrPtr)
 23+  D0EA              ;            ld    de, FILE_DESCRIPTOR.attrib
 24+  D0EA              ;            add   scf
 25+  D0EA              ;
 26+  D0EA              ;            ; Помещаем в a режим
 27+  D0EA              ;            ld    a, c
 28+  D0EA              ;
 29+  D0EA              ;            ; ZF=1 если режим 1
 30+  D0EA              ;            dec c
 31+  D0EA              ;
 32+  D0EA              ;            pop de
 33+  D0EA              ;            ret
 34+  D0EA              ;
 35+  D0EA
122   D0EA                  INCLUDE "fileList.inc"
  1+  D0EA              ;+---------------------------------------------------------------------------
  2+  D0EA              ; MXOS
  3+  D0EA              ; Получить список файлов каталога.
  4+  D0EA              ; Функция копирует в буфер уомпактные описатели файлов (FILE_INFO).
  5+  D0EA              ;
  6+  D0EA              ; На входе
  7+  D0EA              ;  hl - адрес буфера
  8+  D0EA              ;  de - размер буфера (макс. количество описателей файлов)
  9+  D0EA              ;  bc - с какого дескриптора начинать заполнение буфера
 10+  D0EA              ;
 11+  D0EA              ; На выходе
 12+  D0EA              ;  de - сколько всего дескрипторов в каталоге
 13+  D0EA              ;
 14+  D0EA              ;  bc, hl - сохраняются
 15+  D0EA              ;
 16+  D0EA              ; 2013-12-12 Дизассемблировано vinxru
 17+  D0EA              ; 2022-02-11 Переработано SpaceEngineer
 18+  D0EA              ;----------------------------------------------------------------------------
 19+  D0EA
 20+  D0EA              fileList:   ; Если нет драйвера или диск не отформатирован -
 21+  D0EA                          ; формируем пустой список и выходим
 22+  D0EA 3A 0D D3                 ld      a, (v_diskInfo.isValid)
 23+  D0ED FE 02                    cp      DISK_VALID
 24+  D0EF CA F8 D0                 jp z,   fileListOk
 25+  D0F2
 26+  D0F2                          ; В начало буфера помещаем символ 0FFh
 27+  D0F2 36 FF                    ld      (hl), 0FFh
 28+  D0F4
 29+  D0F4                          ; Возвращаем количество файлов в директории в de (ноль)
 30+  D0F4 11 00 00                 ld      de, 0
 31+  D0F7 C9                       ret
 32+  D0F8
 33+  D0F8              fileListOk: ; Сохранение регистров
 34+  D0F8 C5                       push    bc  ; [1]
 35+  D0F9 E5                       push    hl  ; [2]
 36+  D0FA
 37+  D0FA                          ; В de - максимум файлов, но его надо еще ограничить размером каталога
 38+  D0FA 2A F7 D2                 ld      hl, (v_diskInfo.rootDirMaxFiles)
 39+  D0FD CD 89 C3                 call    cmp_hl_de_2
 40+  D100 DA 04 D1                 jp c,   fl_min
 41+  D103 EB                       ex      hl, de
 42+  D104              fl_min:     ; Сохраняем максимум файлов
 43+  D104 22 D3 D2                 ld      (v_dirMaxFiles), hl
 44+  D107
 45+  D107                          ; Сохраняем номер первого файла
 46+  D107 60                       ld      h, b
 47+  D108 69                       ld      l, c
 48+  D109 22 D1 D2                 ld      (v_dirFirstFile), hl
 49+  D10C
 50+  D10C                          ; Обнуляем счетчики файлов
 51+  D10C 21 00 00                 ld      hl, 0
 52+  D10F 22 D5 D2                 ld      (v_dirListedFiles), hl
 53+  D112 22 D7 D2                 ld      (v_dirTotalFiles),  hl
 54+  D115
 55+  D115 E1                       pop     hl  ; [2]
 56+  D116 E5                       push    hl  ; [2]
 57+  D117
 58+  D117                          ; de = номер первого сектора каталога
 59+  D117                          ; с  = количество секторов каталога (мл. байт)
 60+  D117 CD 5E CD                 call    fatBeginDirLoop
 61+  D11A
 62+  D11A                          ; Цикл по секторам каталога
 63+  D11A              fileList_dirLoop:
 64+  D11A                          ; Сохраняем номер сектора каталога
 65+  D11A D5                       push    de  ; [3]               ; de = номер сектора каталога
 66+  D11B
 67+  D11B                          ; Кэшируем сектор каталога
 68+  D11B E5                       push    hl  ; [4]
 69+  D11C AF                       xor     a                       ; флаг - сектор не будет меняться
 70+  D11D CD 80 CC                 call    getSectorAddressInCache ; выход: hl = адрес сектора в буфере
 71+  D120 EB                       ex      hl, de                  ; de = адрес сектора в буфере
 72+  D121 E1                       pop     hl  ; [4]
 73+  D122
 74+  D122                          ; Кол-во дескрипторов файлов в одном секторе каталога (мл. байт)
 75+  D122 3A F9 D2                 ld      a, (v_diskInfo.descrPerSector)
 76+  D125 47                       ld      b, a
 77+  D126
 78+  D126                          ; Цикл по дескрипторам в закешированном секторе каталога
 79+  D126              fileList_sectorLoop:
 80+  D126                          ; Если первый символ = FFh, дескриптор пустой
 81+  D126 1A                       ld      a, (de)
 82+  D127 3C                       inc     a
 83+  D128 CA 5B D1                 jp z,   fileList_nextDescr
 84+  D12B
 85+  D12B E5                       push    hl  ; [4]
 86+  D12C D5                       push    de  ; [5]
 87+  D12D
 88+  D12D                          ; Увеличиваем счетчик общего количества файлов в каталоге
 89+  D12D 2A D7 D2                 ld      hl, (v_dirTotalFiles)
 90+  D130 23                       inc     hl
 91+  D131 22 D7 D2                 ld      (v_dirTotalFiles), hl
 92+  D134
 93+  D134                          ; Если не дошли до первого файла (v_dirTotalFiles < v_dirFirstFile),
 94+  D134                          ; то продолжаем сканирование каталога без копирования дескриптора в буфер
 95+  D134 EB                       ex      hl, de
 96+  D135 2A D1 D2                 ld      hl, (v_dirFirstFile)
 97+  D138 CD 27 C4                 call    cmp_hl_de
 98+  D13B D2 59 D1                 jp nc,  fileList_skipCopy
 99+  D13E
100+  D13E                          ; Если буфер уже заполнен (v_dirListedFiles >= v_dirMaxFiles),
101+  D13E                          ; то продолжаем сканирование каталога без копирования дескриптора в буфер
102+  D13E 2A D3 D2                 ld      hl, (v_dirMaxFiles)
103+  D141 EB                       ex      hl, de
104+  D142 2A D5 D2                 ld      hl, (v_dirListedFiles)
105+  D145 CD 27 C4                 call    cmp_hl_de
106+  D148 D2 59 D1                 jp nc,  fileList_skipCopy
107+  D14B
108+  D14B                          ; Увеличиваем счетчик скопированных дескрипторов
109+  D14B 23                       inc     hl
110+  D14C 22 D5 D2                 ld      (v_dirListedFiles), hl
111+  D14F
112+  D14F D1                       pop     de  ; [5]
113+  D150 E1                       pop     hl  ; [4]
114+  D151
115+  D151                          ; Копируем дескриптор из de в hl
116+  D151 C5                       push    bc  ; [4]
117+  D152                          ;call    copyDescriptor
118+  D152 CD E8 D1                 call    copyDescriptorCompact
119+  D155 C1                       pop     bc  ; [4]
120+  D156
121+  D156                          ; copyDescriptor смещает de, поэтому код расчета
122+  D156                          ; адреса следующего дескриптора надо перепрыгнуть
123+  D156                          ;jp      fileList_next
124+  D156 C3 5B D1                 jp      fileList_nextDescr
125+  D159
126+  D159              fileList_skipCopy:
127+  D159 D1                       pop     de  ; [5]
128+  D15A E1                       pop     hl  ; [4]
129+  D15B
130+  D15B              fileList_nextDescr:
131+  D15B                          ; Вычисляем адрес следующего дескриптора
132+  D15B E5                       push    hl  ; [4]
133+  D15C 21 20 00                 ld      hl, FILE_DESCR_SIZE
134+  D15F 19                       add     hl, de
135+  D160 EB                       ex      de, hl
136+  D161 E1                       pop     hl  ; [4]
137+  D162
138+  D162              fileList_next:
139+  D162                          ; Еще остались файлы в секторе каталога?
140+  D162 05                       dec     b
141+  D163 C2 26 D1                 jp nz,  fileList_sectorLoop
142+  D166
143+  D166                          ; Еще остались секторы каталога?
144+  D166                          ; Восстанавливаем номер сектора каталога
145+  D166 D1                       pop     de  ; [3]   de = номер сектора каталога
146+  D167 13                       inc     de  ;       следующий сектор каталога
147+  D168 0D                       dec     c
148+  D169 C2 1A D1                 jp nz,  fileList_dirLoop
149+  D16C
150+  D16C              fileList_exit
151+  D16C                          ; Завершение и выход
152+  D16C                          ; В конец буфера помещаем символ 0FFh
153+  D16C 36 FF                    ld      (hl), 0FFh
154+  D16E
155+  D16E                          ; Возвращаем количество файлов в директории в de
156+  D16E 2A D7 D2                 ld      hl, (v_dirTotalFiles)
157+  D171 EB                       ex      hl, de
158+  D172
159+  D172 E1                       pop     hl  ; [2]
160+  D173 C1                       pop     bc  ; [1]
161+  D174 C9                       ret
162+  D175
123   D175                  INCLUDE "fileNamePrepare.inc"
  1+  D175              ;+---------------------------------------------------------------------------
  2+  D175              ; MXOS
  3+  D175              ; Подготовить имя файла для функций ОС
  4+  D175              ;
  5+  D175              ; На входе
  6+  D175              ;  hl - исходное имя
  7+  D175              ;  de - буфер для результата (P_INPUT_WIDTH + 3 байт)
  8+  D175              ;
  9+  D175              ; 2013-12-12 Дизассемблировано vinxru
 10+  D175              ;----------------------------------------------------------------------------
 11+  D175
 12+  D175              fileNamePrepare:
 13+  D175                          ; Сохраняем регистры
 14+  D175 C5                       push    bc
 15+  D176 D5                       push    de
 16+  D177
 17+  D177                          ; Если второй символ исходной строки ':', то меняем диск
 18+  D177 23                       inc     hl
 19+  D178 7E                       ld      a, (hl)
 20+  D179 FE 3A                    cp      ':'
 21+  D17B 2B                       dec     hl
 22+  D17C C2 89 D1                 jp nz,  fileNamePr_1
 23+  D17F
 24+  D17F                          ; Меняем диск
 25+  D17F 7E                       ld      a, (hl)
 26+  D180 D6 41                    sub     'A'
 27+  D182 E5                       push    hl
 28+  D183 CD C5 CB                 call    fileSelectDrive
 29+  D186 E1                       pop     hl
 30+  D187
 31+  D187                          ; Диск не входит в имя файла
 32+  D187 23                       inc     hl
 33+  D188 23                       inc     hl
 34+  D189
 35+  D189              fileNamePr_1:
 36+  D189                          ; b = длина имени, c = 3 - длина расширения
 37+  D189 01 03 08                 ld      bc, (FILE_NAME_LENGTH << 8) + 3
 38+  D18C
 39+  D18C                          ; Копируем текст до точки, пробела или конца строки, не более FILE_NAME_LENGTH символов.
 40+  D18C              fileNamePr_2:
 41+  D18C 7E                       ld      a, (hl)
 42+  D18D A7                       and     a
 43+  D18E F2 93 D1                 jp p,   fileNamePr_3
 44+  D191 D6 40                    sub     40h         ; проеобразование KOI?
 45+  D193              fileNamePr_3:
 46+  D193 FE 21                    cp      ' '+1
 47+  D195 DA B3 D1                 jp c,   fileNamePr_5
 48+  D198 23                       inc     hl
 49+  D199 FE 2E                    cp      '.'
 50+  D19B CA B3 D1                 jp z,   fileNamePr_5
 51+  D19E 12                       ld      (de), a
 52+  D19F 13                       inc     de
 53+  D1A0 05                       dec     b
 54+  D1A1 C2 8C D1                 jp nz,  fileNamePr_2
 55+  D1A4
 56+  D1A4                          ; Пропускаем текст до точки, пробела или конца строки
 57+  D1A4              fileNamePr_4:
 58+  D1A4 7E                       ld      a, (hl)
 59+  D1A5 FE 21                    cp      ' '+1
 60+  D1A7 DA B6 D1                 jp c,   fileNamePr_6
 61+  D1AA 23                       inc     hl
 62+  D1AB FE 2E                    cp      '.'
 63+  D1AD C2 A4 D1                 jp nz,  fileNamePr_4
 64+  D1B0 C3 B6 D1                 jp      fileNamePr_6
 65+  D1B3
 66+  D1B3              ; ---------------------------------------------------------------------------
 67+  D1B3
 68+  D1B3              fileNamePr_5:
 69+  D1B3                          ; Имя короче FILE_NAME_LENGTH символов
 70+  D1B3                          ; Заполняем недостающие символы имени пробелами
 71+  D1B3 CD C7 C3                 call    memset_de_20_b
 72+  D1B6
 73+  D1B6                          ; Копируем текст до пробела или конца строки, не более 3 символов.
 74+  D1B6              fileNamePr_6:
 75+  D1B6 7E                       ld      a, (hl)
 76+  D1B7 A7                       and     a
 77+  D1B8 F2 BD D1                 jp p,   fileNamePr_7
 78+  D1BB D6 40                    sub     40h         ; проеобразование KOI?
 79+  D1BD              fileNamePr_7:
 80+  D1BD FE 21                    cp      ' '+1
 81+  D1BF DA D6 D1                 jp c,   fileNamePr_11
 82+  D1C2 12                       ld      (de),a
 83+  D1C3 23                       inc     hl
 84+  D1C4 13                       inc     de
 85+  D1C5 0D                       dec     c
 86+  D1C6 C2 B6 D1                 jp nz,  fileNamePr_6
 87+  D1C9
 88+  D1C9              fileNamePr_8:
 89+  D1C9                          ; Пропускаем текст до пробела или конца строки
 90+  D1C9 7E                       ld      a, (hl)
 91+  D1CA FE 20                    cp      ' '
 92+  D1CC DA D3 D1                 jp c,   fileNamePr_10
 93+  D1CF 23                       inc     hl
 94+  D1D0 C2 C9 D1                 jp nz,  fileNamePr_8
 95+  D1D3
 96+  D1D3              ;fileNamePr_9:
 97+  D1D3              ;            ; Пропускаем текст до пробела или конца строки
 98+  D1D3              ;            ; Почему то дублируется код
 99+  D1D3              ;            ld      a, (hl)
100+  D1D3              ;            cp      ' '
101+  D1D3              ;            jp c,   fileNamePr_10
102+  D1D3              ;            inc     hl
103+  D1D3              ;            jp z,   fileNamePr_9
104+  D1D3              ;            dec     hl
105+  D1D3
106+  D1D3              fileNamePr_10:    ; Восстанавливаем регистры и выходим
107+  D1D3 D1                       pop     de
108+  D1D4 C1                       pop     bc
109+  D1D5 C9                       ret
110+  D1D6
111+  D1D6              ; ---------------------------------------------------------------------------
112+  D1D6
113+  D1D6              fileNamePr_11:
114+  D1D6                          ; Заполняем недостающие символы расширения пробелами
115+  D1D6 41                       ld      b, c
116+  D1D7 CD C7 C3                 call    memset_de_20_b
117+  D1DA
118+  D1DA                          ; Восстанавливаем регистры и выходим
119+  D1DA D1                       pop     de
120+  D1DB C1                       pop     bc
121+  D1DC C9                       ret
122+  D1DD
124   D1DD                  INCLUDE "copyDescriptor.inc"
  1+  D1DD              ;----------------------------------------------------------------------------
  2+  D1DD              ; MXOS
  3+  D1DD              ; Копирование дескриптора файла (FILE_DESCRIPTOR)
  4+  D1DD              ;
  5+  D1DD              ; вход:
  6+  D1DD              ;  de = адрес откуда
  7+  D1DD              ;  hl = адрес куда
  8+  D1DD              ;
  9+  D1DD              ; выход:
 10+  D1DD              ;  de = адрес следующего дескриптора
 11+  D1DD              ;  hl = адрес следующего дескриптора
 12+  D1DD              ;
 13+  D1DD              ; 2022-02-11 SpaceEngineer
 14+  D1DD              ;----------------------------------------------------------------------------
 15+  D1DD
 16+  D1DD              copyDescriptor:
 17+  D1DD                          ; Копируем FILE_DESCR_SIZE байт из de в hl
 18+  D1DD 06 20                    ld      b, FILE_DESCR_SIZE
 19+  D1DF 1A           cfd_loop:   ld      a, (de)
 20+  D1E0 77                       ld      (hl), a
 21+  D1E1 23                       inc     hl
 22+  D1E2 13                       inc     de
 23+  D1E3 05                       dec     b
 24+  D1E4 C2 DF D1                 jp nz,  cfd_loop
 25+  D1E7 C9                       ret
 26+  D1E8
 27+  D1E8              ;----------------------------------------------------------------------------
 28+  D1E8              ; MXOS
 29+  D1E8              ; Проеобразование дескриптора файла в компактную форму
 30+  D1E8              ; FILE_DESCRIPTOR -> FILE_INFO
 31+  D1E8              ;
 32+  D1E8              ; вход:
 33+  D1E8              ;  de = адрес откуда
 34+  D1E8              ;  hl = адрес куда
 35+  D1E8              ;
 36+  D1E8              ; выход:
 37+  D1E8              ;  hl = адрес следующего описателя
 38+  D1E8              ;
 39+  D1E8              ;  de - сохраняется
 40+  D1E8              ;
 41+  D1E8              ; 2022-02-16 SpaceEngineer
 42+  D1E8              ;----------------------------------------------------------------------------
 43+  D1E8
 44+  D1E8              copyDescriptorCompact:
 45+  D1E8 D5                       push    de
 46+  D1E9
 47+  D1E9                          ; Копируем имя файла + расширение + байт атрибутов
 48+  D1E9 06 0C                    ld      b, FILE_NAME_LENGTH + 4
 49+  D1EB 1A           cfdc_loop:  ld      a, (de)
 50+  D1EC 77                       ld      (hl), a
 51+  D1ED 23                       inc     hl
 52+  D1EE 13                       inc     de
 53+  D1EF 05                       dec     b
 54+  D1F0 C2 EB D1                 jp nz,  cfdc_loop
 55+  D1F3
 56+  D1F3                          ; Копируем поле адреса загрузки
 57+  D1F3 EB                       ex      hl, de
 58+  D1F4 01 06 00                 ld      bc, FILE_DESCRIPTOR.loadAddress - FILE_DESCRIPTOR.attrib - 1   ; относительное смещение поля loadAddr
 59+  D1F7 09                       add     hl, bc
 60+  D1F8 EB                       ex      hl, de
 61+  D1F9
 62+  D1F9 1A                       ld      a, (de)
 63+  D1FA 77                       ld      (hl), a
 64+  D1FB 23                       inc     hl
 65+  D1FC 13                       inc     de
 66+  D1FD 1A                       ld      a, (de)
 67+  D1FE 77                       ld      (hl), a
 68+  D1FF 23                       inc     hl
 69+  D200
 70+  D200                          ; Копируем поле размера
 71+  D200 EB                       ex      hl, de
 72+  D201 01 09 00                 ld      bc, FILE_DESCRIPTOR.size - FILE_DESCRIPTOR.loadAddress - 1  ; относительное смещение поля size
 73+  D204 09                       add     hl, bc
 74+  D205 EB                       ex      hl, de
 75+  D206
 76+  D206 1A                       ld      a, (de)
 77+  D207 77                       ld      (hl), a
 78+  D208 23                       inc     hl
 79+  D209 13                       inc     de
 80+  D20A 1A                       ld      a, (de)
 81+  D20B 77                       ld      (hl), a
 82+  D20C 23                       inc     hl
 83+  D20D
 84+  D20D D1                       pop     de
 85+  D20E C9                       ret
 86+  D20F
125   D20F                  INCLUDE "printDecWord.inc"
  1+  D20F              ;----------------------------------------------------------------------------
  2+  D20F              ; MXOS DOS.SYS
  3+  D20F              ; Вывод десятичного числа из de
  4+  D20F              ; Перенесено из NC.COM
  5+  D20F              ;
  6+  D20F              ; вход:
  7+  D20F              ;   de = число
  8+  D20F              ;   b = дополнить ведущими символами: 20h - пробелами, 30h - нулями, 00h - не дополнять
  9+  D20F              ;
 10+  D20F              ; выход:
 11+  D20F              ;   hl, de, bc - сохраняются
 12+  D20F              ;
 13+  D20F              ; 2013-12-18 Дизассемблировано vinxru
 14+  D20F              ;----------------------------------------------------------------------------
 15+  D20F
 16+  D20F              printDecWord:
 17+  D20F D5                       push  de
 18+  D210 C5                       push  bc
 19+  D211 E5                       push  hl
 20+  D212 EB                       ex    de, hl
 21+  D213                          ; ld    b,  20h  ; b = маска кода символа, заменяет ведущие нули на (код_символа and маска)
 22+  D213 11 F0 D8                 ld    de, -10000
 23+  D216 CD 36 D2                 call  printDec1
 24+  D219 11 18 FC                 ld    de, -1000
 25+  D21C CD 36 D2                 call  printDec1
 26+  D21F 11 9C FF                 ld    de, -100
 27+  D222 CD 36 D2                 call  printDec1
 28+  D225 11 F6 FF                 ld    de, -10
 29+  D228 CD 36 D2                 call  printDec1
 30+  D22B 7D                       ld    a, l
 31+  D22C C6 30                    add   a, '0'
 32+  D22E 4F                       ld    c, a
 33+  D22F CD 37 C0                 call  printChar
 34+  D232 E1                       pop   hl
 35+  D233 C1                       pop   bc
 36+  D234 D1                       pop   de
 37+  D235 C9                       ret
 38+  D236
 39+  D236              ; ---------------------------------------------------------------------------
 40+  D236
 41+  D236
 42+  D236              printDec1:  ; c = '0' + (hl / de), hl /= de;
 43+  D236 0E 2F                    ld    c, '0'-1
 44+  D238
 45+  D238 0C           loc_DB11:   inc   c
 46+  D239 19                       add   hl, de
 47+  D23A DA 38 D2                 jp c, loc_DB11
 48+  D23D
 49+  D23D 7A                       ld    a, d        ; hl -= de;
 50+  D23E 2F                       cpl
 51+  D23F 57                       ld    d, a
 52+  D240 7B                       ld    a, e
 53+  D241 2F                       cpl
 54+  D242 5F                       ld    e, a
 55+  D243 13                       inc   de
 56+  D244 19                       add   hl, de
 57+  D245 79                       ld    a, c
 58+  D246
 59+  D246                          ; if (c!='0') b=0xFF; c&=b;
 60+  D246 FE 30                    cp    '0'
 61+  D248 CA 4D D2                 jp z, loc_DB26
 62+  D24B 06 FF                    ld    b, 0FFh   ; первый не ноль, меняем маску кода символа на 0FFh
 63+  D24D A0           loc_DB26:   and   b
 64+  D24E C8                       ret   z ; выходим если код символа 0
 65+  D24F 4F                       ld    c, a
 66+  D250 C3 37 C0                 jp    printChar
 67+  D253
126   D253                  INCLUDE "math.inc"
  1+  D253              ;+---------------------------------------------------------------------------
  2+  D253              ; MXOS
  3+  D253              ; Математические фуннкции
  4+  D253              ;----------------------------------------------------------------------------
  5+  D253
  6+  D253              ;----------------------------------------------------------------------------
  7+  D253              ; Вычитание hl и de:
  8+  D253              ; hl = hl - de
  9+  D253              ;
 10+  D253              ; de, bc - сохраняется
 11+  D253              ;
 12+  D253              ; SpaceEngineer
 13+  D253              ;----------------------------------------------------------------------------
 14+  D253
 15+  D253              sub_hl_de:
 16+  D253 7D                   ld    a, l
 17+  D254 93                   sub   e
 18+  D255 6F                   ld    l, a
 19+  D256 7C                   ld    a, h
 20+  D257 9A                   sbc   d
 21+  D258 67                   ld    h, a
 22+  D259 C9                   ret
 23+  D25A
 24+  D25A              ;----------------------------------------------------------------------------
 25+  D25A              ; Деление hl на 2:
 26+  D25A              ; hl = hl / 2
 27+  D25A              ;
 28+  D25A              ; de, bc - сохраняется
 29+  D25A              ;
 30+  D25A              ; SpaceEngineer
 31+  D25A              ;----------------------------------------------------------------------------
 32+  D25A
 33+  D25A              div_hl_2:
 34+  D25A 7C                   ld  a, h
 35+  D25B B7                   or  a    ; сброс флага c
 36+  D25C 1F                   rra
 37+  D25D 67                   ld  h, a
 38+  D25E 7D                   ld  a, l
 39+  D25F 1F                   rra
 40+  D260 6F                   ld  l, a
 41+  D261 C9                   ret
 42+  D262
 43+  D262              ;----------------------------------------------------------------------------
 44+  D262              ; Умножение hl на de:
 45+  D262              ; hl = hl * de
 46+  D262              ;
 47+  D262              ;
 48+  D262              ; На входе
 49+  D262              ;  hl, de - множители
 50+  D262              ;
 51+  D262              ; На выходе
 52+  D262              ;  hl - произведение
 53+  D262              ;
 54+  D262              ;  bc - сохраняется
 55+  D262              ;
 56+  D262              ; Взято из проекта c8080 VWarlock'a
 57+  D262              ; https://github.com/VWarlock/C8080
 58+  D262              ;----------------------------------------------------------------------------
 59+  D262
 60+  D262              mul_hl_de:
 61+  D262 C5                   push    bc
 62+  D263 44                   ld      b, h
 63+  D264 4D                   ld      c, l
 64+  D265 21 00 00             ld      hl, 0
 65+  D268 3E 11                ld      a, 17
 66+  D26A 3D           _mul1:  dec     a
 67+  D26B CA 85 D2             jp      z, pop_bc_ret
 68+  D26E 29                   add     hl, hl
 69+  D26F EB                   ex      hl, de
 70+  D270 D2 78 D2             jp      nc, _mul2
 71+  D273 29                   add     hl, hl
 72+  D274 24                   inc     h
 73+  D275 C3 79 D2             jp      _mul3
 74+  D278 29           _mul2:  add     hl, hl
 75+  D279 EB           _mul3:  ex      hl, de
 76+  D27A D2 6A D2             jp      nc, _mul1
 77+  D27D 09                   add     hl, bc
 78+  D27E D2 6A D2             jp      nc, _mul1
 79+  D281 14                   inc     d
 80+  D282 C3 6A D2             jp      _mul1
 81+  D285
 82+  D285              pop_bc_ret:
 83+  D285 C1                   pop     bc
 84+  D286 C9                   ret
 85+  D287
 86+  D287              ;----------------------------------------------------------------------------
 87+  D287              ; Деление hl на de:
 88+  D287              ; hl = hl / de
 89+  D287              ; de = hl % de
 90+  D287              ;
 91+  D287              ; На входе
 92+  D287              ;  hl - делимое
 93+  D287              ;  de - делитель
 94+  D287              ;
 95+  D287              ; На выходе
 96+  D287              ;  hl - частное
 97+  D287              ;  de - останок
 98+  D287              ;
 99+  D287              ;  bc - сохраняется
100+  D287              ;
101+  D287              ; Взято из проекта c8080 VWarlock'a
102+  D287              ; https://github.com/VWarlock/C8080
103+  D287              ;----------------------------------------------------------------------------
104+  D287
105+  D287              div_hl_de:
106+  D287 C5                   push    bc
107+  D288 EB                   ex      hl, de
108+  D289 CD 8E D2             call    _div0
109+  D28C C1                   pop     bc
110+  D28D C9                   ret
111+  D28E
112+  D28E 7C           _div0:  ld      a, h
113+  D28F B5                   or      l
114+  D290 C8                   ret     z
115+  D291 01 00 00             ld      bc, 0
116+  D294 C5                   push    bc
117+  D295 7B           _div1:  ld      a, e
118+  D296 95                   sub     L
119+  D297 7A                   ld      a, d
120+  D298 9C                   sbc     h
121+  D299 DA A1 D2             jp      c, _div2
122+  D29C E5                   push    hl
123+  D29D 29                   add     hl, hl
124+  D29E D2 95 D2             jp      nc, _div1
125+  D2A1 21 00 00     _div2:  ld      hl, 0
126+  D2A4 C1           _div3:  pop     bc
127+  D2A5 78                   ld      a, b
128+  D2A6 B1                   or      c
129+  D2A7 C8                   ret     z
130+  D2A8 29                   add     hl, hl
131+  D2A9 D5                   push    de
132+  D2AA 7B                   ld      a, e
133+  D2AB 91                   sub     c
134+  D2AC 5F                   ld      e, a
135+  D2AD 7A                   ld      a, d
136+  D2AE 98                   sbc     b
137+  D2AF 57                   ld      d, a
138+  D2B0 DA B8 D2             jp      c, _div4
139+  D2B3 23                   inc     hl
140+  D2B4 C1                   pop     bc
