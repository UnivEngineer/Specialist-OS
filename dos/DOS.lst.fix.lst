 73+  CFD8 CD 20 D2                 call    copyDescriptor
 74+  CFDB
 75+  CFDB                          ; Восстаналиваем регистры
 76+  CFDB E1                       pop     hl  ; [5]   hl = адрес имени искомого файла
 77+  CFDC C1                       pop     bc  ; [4]   c  = счетчик секторов
 78+  CFDD
 79+  CFDD                          ; Сохраняем номер сектора каталога в переменную v_cachedSector
 80+  CFDD D1                       pop     de  ; [3]   de = номер сектора каталога
 81+  CFDE EB                       ex      hl, de
 82+  CFDF 22 0A D3                 ld      (v_cachedSector), hl
 83+  CFE2 EB                       ex      hl, de
 84+  CFE3
 85+  CFE3                          ; Восстаналиваем регистры и выходим с CF=0
 86+  CFE3 D1                       pop     de  ; [2]
 87+  CFE4 C1                       pop     bc  ; [1]
 88+  CFE5 B7                       or      a   ;       для выхода с флагом
 89+  CFE6 C9                       ret
 90+  CFE7                          ;-----------------------------------------------------------
 91+  CFE7
 92+  CFE7              fileFind_next:
 93+  CFE7                          ; Вычисляем адрес следующего дескриптора файла
 94+  CFE7 D1                       pop     de  ; [6]   de = адрес дескриптора файла в кэше
 95+  CFE8 21 20 00                 ld      hl, FILE_DESCR_SIZE
 96+  CFEB 19                       add     hl, de
 97+  CFEC EB                       ex      de, hl
 98+  CFED
 99+  CFED                          ; Восстанавливаем адрес искомого имени
100+  CFED E1                       pop     hl  ; [5]   hl = адрес имени искомого файла
101+  CFEE
102+  CFEE                          ; Еще остались файлы в секторе каталога?
103+  CFEE 05                       dec     b
104+  CFEF C2 BE CF                 jp nz,  fileFind_sectorLoop
105+  CFF2
106+  CFF2                          ; Еще остались секторы каталога?
107+  CFF2 C1                       pop     bc  ; [4]   c  = счетчик секторов
108+  CFF3
109+  CFF3                          ; Восстанавливаем номер сектора каталога
110+  CFF3 D1                       pop     de  ; [3]   de = номер сектора каталога
111+  CFF4 13                       inc     de  ;       следующий сектор каталога
112+  CFF5
113+  CFF5 0D                       dec     c
114+  CFF6 C2 B1 CF                 jp nz,  fileFind_dirLoop
115+  CFF9
