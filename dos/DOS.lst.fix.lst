 27+  CA37 FE 20                    cp      20h
 28+  CA39 DA 43 CA                 jp c,   fileExec_1
 29+  CA3C
 30+  CA3C                          ; Копируем симовол из hl в de
 31+  CA3C 12                       ld      (de),a
 32+  CA3D 23                       inc     hl
 33+  CA3E 13                       inc     de
 34+  CA3F
 35+  CA3F                          ; Повторяем 80h раз
